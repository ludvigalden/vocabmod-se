# Allowlist: everything is ignored except the paths the repository ships.
/*
!/.gitignore
!/.github/
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/Cargo.lock
!/Cargo.toml
!/CITATION.cff
!/CONTRIBUTING.md
!/LICENSE
!/LICENSES/
!/README.md
!/README.sv.md
!/SECURITY.md
!/content/
!/assets/
/assets/figures/dist/*
!/assets/figures/dist/vocab-coverage-standard.csv
!/assets/figures/dist/vocab-coverage-standard.svg
/assets/index/
/assets/omop/
!/pkg/
!/schema/
!/vocab/
!/publiccode.yml
!/sources.kdl
!/tests/
!/tools/
/tools/ci/
/assets/*.pdf
