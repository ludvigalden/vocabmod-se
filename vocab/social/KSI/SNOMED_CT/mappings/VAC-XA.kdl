// KSI social-service codes to SNOMED CT mappings, codes VAC-XA
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "ksi-snomed-ct" version="2026.1"
    source system="KSI" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "VAC.1" source="VAC" target="SNOMED_CT:410316001" relationship=related_to {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source VAC SNOMED CT 410316001 = the KSI parent/domain concept for behaviors and habits regarding
        narcotics (the topic itself, no intervention method). Target (Procedure) is the broadest
        standard substance-use procedure concept and the closest defensible target for the narcotics-use
        behavior domain (narcotics use = substance use). Source is a behavior DOMAIN, not a procedure or
        disorder; the target is a counseling-about-that-domain procedure, so related (the target is
        about the source domain), weak. 410316001 verified in source/athena/SNOMED/concepts.tdl.
        """
}
