// KSI social-service codes to SNOMED CT mappings, codes SJB-VAB
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "ksi-snomed-ct" version="2026.1"
    source system="KSI" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "SJB.PH.ZZ.1" source="SJB.PH.ZZ" target="SNOMED_CT:229608007" relationship=equivalent {
