mapping "YAC.90.ZZ.1" source="YAC.90.ZZ" target="SNOMED_CT:224106008" relationship=related_to {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source YAC.90.ZZ SNOMED CT 224106008 = a SE social-service contact-FAMILY intervention for
        children/youth: a support/respite family that a child visits regularly to give the birth family
        relief (NOT a foster placement — the child is not removed into the kontaktfamilj's care). Target
