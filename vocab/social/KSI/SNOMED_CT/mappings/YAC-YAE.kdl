// KSI social-service codes to SNOMED CT mappings, codes YAC-YAE
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "ksi-snomed-ct" version="2026.1"
    source system="KSI" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "YAC.1" source="YAC" target="SNOMED_CT:408997006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source YAC SNOMED CT 408997006 = the top-level category for interventions/measures for children and
        young people under the Swedish Social Services Act (SoL) and the Care of Young Persons Act
        (LVU). Target (regime/therapy, sv) is the standard concept for care-of-youth regimes. Why this
        target: closest standard concept for the care-of-young-persons axis; the source is a two-statute
        (SoL+LVU) parent category spanning voluntary and compulsory measures. Why broader: substantial
        breadth mismatch — SNOMED CT adolescent care is a clinical/health regime concept whereas the source
        is a social-services multi-statute category including compulsory care; no SoL/LVU-anchored
        standard concept exists; per §1 low tier. Athena-local; no web.
        """
}
mapping "YAC.05.ZZ.1" source="YAC.05.ZZ" target="SNOMED_CT:183425000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source YAC.05.ZZ SNOMED CT 183425000 = voluntary (consensual) social care of a person under 21
        under the Swedish Social Services Act (SoL) — non-institutional or institutional care provided
        with the youth's/guardian's consent. Target (regime/therapy, sv) is the standard social-care
        regime concept. Why this target: closest standard concept for a social-care regime; SNOMED CT
        408997006 is the age-banded alternative but more clinical. Why broader: large breadth mismatch —
        SNOMED CT social care covers all social-care regimes (adults, elders, disability, all statutes)
        whereas the source is voluntary SoL care of under-21s; no SoL-anchored standard concept; per §1
        low tier. Athena-local; no web.
        """
}
mapping "YAC.25.ZZ.1" source="YAC.25.ZZ" target="SNOMED_CT_SE_EXT:393791000052102" relationship=source_is_narrower_than_target {
    confidence 3 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source YAC.25.ZZ SNOMED CT 393791000052102 = family home / foster home placement (a child/young
        person placed in a private family household under SoL or LVU — the cross-statute familjehem
        placement category). Target (finding, sv, SE extension rf2-se) — the Swedish synonym is a direct
        match. Why this target: purpose-built SE concept whose Swedish synonym exactly denotes
        family-home living; the SE concept spans all Swedish-statute family-home placements (broader).
        Why broader: one-level broader (target covers all family-home living including adult foster-home
        contexts; source is the child/youth SoL/LVU placement) with exact-synonym support and SE
        provenance. Athena-local; no web.
        """
}
mapping "YAC.30.ZZ.1" source="YAC.30.ZZ" target="SNOMED_CT_SE_EXT:393821000052109" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 3 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source YAC.30.ZZ SNOMED CT 393821000052109 = emergency/on-call home (a child/young person placed
        urgently in a registered jourhem household for immediate short-term care, typically pending
        investigation or longer placement, under SoL/LVU). Target (finding, sv, SE extension rf2-se) —
        the Swedish synonym is a *direct exact* match. Why this target: purpose-built SE concept whose
        Swedish synonym exactly denotes jourhem placement. Why broader (not exact): the SE finding spans
        all emergency-foster-home contexts (including adult situations), of which the source is the
        child/youth SoL/LVU jourhem placement — a one-level broader relation with exact-synonym support
        and SE provenance per §1 high tier. Athena-local; no web.
        """
}
mapping "YAC.40.ZZ.1" source="YAC.40.ZZ" target="SNOMED_CT:25881000087103" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source YAC.40.ZZ SNOMED CT 25881000087103 = Swedish social-service supervised/supportive living
        placement, typically for young adults or adults transitioning toward independent housing (a
        placement SETTING delivered by social services, not a clinical finding). Target SNOMED CT 3656379
        (concept_code 25881000087103) =, the closest standard concept in the social-context/findings
        branch covering supervised housing. Broader: the target subsumes the source (supportive housing
        is the general category; stödboende is one SE-specific form). Weak : the SE concept is a
        social-services placement category with legal/social-services framing (SoL/LVU context), whereas
        the SNOMED CT concept is a patient-circumstance finding; only an aspect-level / loose overlap is
        defensible.
        """
}
mapping "YAC.45.ZZ.1" source="YAC.45.ZZ" target="SNOMED_CT:228122001" relationship=related_to {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source YAC.45.ZZ SNOMED CT 228122001 = publicly-run HVB home, a Swedish residential care/treatment
        home for children/youth (a placement SETTING with a public operator). Target SNOMED CT 4332046
        (concept_code 228122001) =, a patient-circumstance finding denoting a child being cared for in a
        residential setting. Related (not broader/narrower): the source is a placement-type/setting
        category with a Swedish administrative/legal scope, the target is a patient-circumstance
        finding; they are clinically associated (an HVB placement implies residential care) but are not
        the same kind of concept and the SNOMED CT term carries no public/private operator distinction.
        Weak : loose association only, recorded as a lead.
        """
}
