// KSI social-service codes to SNOMED CT mappings, codes XAA-YAB
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "ksi-snomed-ct" version="2026.1"
    source system="KSI" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "XAA.1" source="XAA" target="SNOMED_CT:410606002" relationship=related_to effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source XAA SNOMED CT 410606002 = initiating a case and making a preliminary assessment, the KSI
        parent for intake/pre-screening of social-service matters. Target (Procedure, standard) is the
        general SNOMED CT concept for social-service procedural activity. The source bundles Swedish
        intake/pre-screening acts that are associated with but not identical to a clinical
        social-service procedure, so related, weak. 410606002 verified present in
        source/athena/SNOMED/concepts.tdl.
        """
}
mapping "XAA.04.00.1" source="XAA.04.00" target="SNOMED_CT:410619003" relationship=related_to {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source XAA.04.00 SNOMED CT 410619003 = initiating a case through an application (a client applies
        to trigger a social-service matter). Target (Procedure, standard) is the SNOMED CT concept for an
        application procedure. The source is a Swedish-administrative application-for-service act
        associated with but not identical to the SNOMED CT Application procedure (which is broader and not
        social-service-specific), so related, weak. 410619003 verified present in
        source/athena/SNOMED/concepts.tdl.
        """
}
mapping "XAA.04.05.1" source="XAA.04.05" target="SNOMED_CT:312040009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        KSI = initiate via application for intervention under the Swedish Social Services Act (SoL).
        SNOMED CT 312040009 (@sv: ansökan om finansiering med hjälp av socialtjänsten) is the direct
        Swedish-extension equivalent for an application to social services for support/financial
        intervention under SoL. High tier exact; not because is slightly broader than but the
        application-to-social-services axis is identical.
        """
}
mapping "XAA.04.15.1" source="XAA.04.15" target="SNOMED_CT:410619003" relationship=related_to {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source XAA.04.15 SNOMED CT 410619003 = initiating a case through an application for an intervention
        under LSS (Swedish Act concerning Support and Service for Persons with Certain Functional
        Impairments). Target (Procedure, standard). The source is a Swedish-law-specific (LSS)
        application-for-service act; the SNOMED CT Application procedure is the closest standard concept
        but is jurisdiction-neutral and not LSS-specific, so related, weak. 410619003 verified in
        source/athena/SNOMED/concepts.tdl.
        """
}
