// KSI retrieval adjudication mappings to SNOMED CT, codes SA1.AA.ZZ-YAE.20.65
// Each mapping records a third blinded tie-break pass;
// targets referenced by code only.
// Individual Swedish activity titles quoted in the rationales below are quotations from
// E-hälsomyndigheten, Klassifikation av socialtjänstens insatser och aktiviteter (KSI),
// release 2026 (published by Socialstyrelsen until June 2026). They serve as
// adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "ksi-snomed-ct-retrieval" version="2026.1"
    source system="KSI" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
