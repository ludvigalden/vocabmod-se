mapping "SM.1" source="SM" target="d5" relationship=equivalent {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source SM is the KSI chapter heading for Self-care; child
 SM1 carries @ICF: d5. Target ICF d5 is the ICF Activities & Participation
 chapter 5 (Self-care) root, same domain. High tier: exact chapter equivalence vs local ICF
 mirror, KSI national framing precludes.
 """ suspect=quoted-text
}
