mapping "SN-SP.1" source="SN-SP" target="d6" relationship=equivalent {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source SN-SP is the KSI chapter heading for Domestic life; child
 SN1 carries @ICF: d6. Target ICF d6 is the ICF Activities & Participation chapter 6
 (Domestic life) root, same domain. High tier: exact chapter equivalence vs local ICF mirror, KSI
 national framing precludes.
 """ suspect=quoted-text
}
