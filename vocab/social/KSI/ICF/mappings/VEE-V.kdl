// KSI social-service codes to ICF mappings, codes VEE-V
// Several sources map to the same target; each mapping is its own assertion.
context {
 collection "ksi-icf" version="2026.1"
 source system="KSI" release="2026"
 target system="ICF"
}
defaults {
 mappings {
 preference "primary"
 assessment-method "source-default-granularity"
 }
}
mapping "VEE.1" source="VEE" target="d5708A" relationship=related_to {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source VEE = behaviors and habits regarding oral health.
 Target ICF d5708A (Looking after one's oral health) is the Swedish ICF
 extension concept that is the exact topical home for oral health. The KSI source is a
 behavioral/social-service framing of the same domain (an about-relationship), so related, weak
 rather than exact_match (different granularity axis: activity-vs-function). d5708A verified
 present in ICF mirror.
 """ suspect=quoted-text
}
mapping "VEE.AM.ZZ.1" source="VEE.AM.ZZ" target="d5708A" relationship=related_to {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source VEE.AM.ZZ = observation activity
 regarding oral-health behavior. Target ICF d5708A (oral health care).
 Source is an observation ABOUT oral-health behavior; related, weak. d5708A verified in ICF
 mirror.
 """ suspect=quoted-text
}
mapping "VEE.AS.ZZ.1" source="VEE.AS.ZZ" target="d5708A" relationship=related_to {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
