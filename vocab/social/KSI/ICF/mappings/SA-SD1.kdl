// KSI social-service codes to ICF mappings, codes SA-SD1
// Several sources map to the same target; each mapping is its own assertion.
context {
 collection "ksi-icf" version="2026.1"
 source system="KSI" release="2026"
 target system="ICF"
}
defaults {
 mappings {
 preference "primary"
 assessment-method "source-default-granularity"
 }
}
mapping "SA-SC.1" source="SA-SC" target="d1" relationship=equivalent effect=omitted quality=60 {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source SA-SC is the KSI chapter heading
 for the Learning & applying knowledge domain; its first-level child SA1 carries the explicit KSI
 crosswalk @ICF: d1. Target ICF d1 is the ICF Activities &
 Participation chapter 1 root, denoting the same activity/participation chapter. Same clinical
 domain at the same chapter granularity. High tier : exact chapter-level term equivalence against
 the local ICF mirror, but KSI is a Swedish national intervention vocabulary layered over ICF
 rather than an Athena 'Maps to' crosswalk, so not the crosswalk-verified tier.
 """ suspect=quoted-text
}
mapping "SA1.1" source="SA1" target="d1" relationship=equivalent {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
}
