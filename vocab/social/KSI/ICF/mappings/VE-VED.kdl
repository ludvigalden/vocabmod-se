// KSI social-service codes to ICF mappings, codes VE-VED
// Several sources map to the same target; each mapping is its own assertion.
context {
 collection "ksi-icf" version="2026.1"
 source system="KSI" release="2026"
 target system="ICF"
}
defaults {
 mappings {
 preference "primary"
 assessment-method "source-default-granularity"
 }
}
assessment "VE2.omop" source="VE2" outcome=no_match target-system="OMOP_EXT"
assessment "VE2.AC.ZZ.omop" source="VE2.AC.ZZ" outcome=no_match target-system="OMOP_EXT"
assessment "VE2.AM.ZZ.omop" source="VE2.AM.ZZ" outcome=no_match target-system="OMOP_EXT"
mapping "VE2.AS.ZZ.1" source="VE2.AS.ZZ" target="d570" relationship=related_to {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
 Source VE2.AS.ZZ = a Swedish social-service
 ACTIVITY (investigative/assessment conversation) about 'other behaviors and habits' not covered
 by the specific VEA/VEB/VEE subdomains. Target ICF d570 (Looking
 after one's health) is the parent self-care/health-management concept under which d5703-diet,
 d5704-physical-activity, d5708A-oral sit; the residual the imported designation bucket maps to this parent.
 Source is an assessment ABOUT the d570 concept (counseling on it), not a case of it, so related
 per the about/counseling pattern (weak). d570 verified present in
 source/function/ICF/concepts.tdl.
 """ suspect=quoted-text
}
mapping "VE2.AT.ZZ.1" source="VE2.AT.ZZ" target="d570" relationship=related_to {
 confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
 comment "en" """
