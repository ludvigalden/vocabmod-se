// ICF retrieval adjudication mappings to LOINC, codes d7504-e320
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual Swedish category titles quoted in the rationales below are quotations from
// the Swedish edition of the WHO International Classification of Functioning, Disability
// and Health (translation rights Socialstyrelsen; published by E-hälsomyndigheten),
// release 2026. They serve as adjudication evidence for the individual mappings; the
// classification itself is not redistributed.
context {
    collection "icf-loinc-retrieval" version="2026.1"
    source system="ICF" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d7504.retr.1" source="d7504" target="106400-5" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF activity category (d7504 informal relationships with peers, English designation given); candidate 1091101 (LOINC Observation) preserves the peer-relationship topic."
}
mapping "d7601.retr.1" source="d7601" target="106398-1" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF activity category (d7601 child-parent relationships, child-side engagement); candidate 1092356 (LOINC Observation) preserves the child-side relation."
}
mapping "d7602.retr.1" source="d7602" target="106399-9" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF activity category (d7602 sibling relationships, English designation given); candidate 1091841 (LOINC Observation) matches the source."
}
mapping "d9100.retr.1" source="d9100" target="99106-7" relationship=source_is_broader_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF activity category (d9100 informal associations, English designation given); candidate 1989020 club/organization meeting attendance (LOINC Observation) preserves the association-membership core. Omissions recorded: engagement beyond meeting attendance, survey framing."
}
mapping "e2251.retr.1" source="e2251" target="46685-4" relationship=equivalent preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
     rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF e2251 humidity (Fuktighet); candidate D is LOINC observation measuring humidity as such."
}
mapping "e320.retr.1" source="e320" target="76872-1" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this LOINC concept. Evidence: ICF e320 support from friends (Stöd från vänner); candidate B is LOINC/PROMIS item 'I get support from my friends'."
}
