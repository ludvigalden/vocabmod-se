// ICF retrieval adjudication mappings to SNOMED CT, codes b1263-s7401
// Each mapping records a third blinded tie-break pass;
// targets referenced by code only.
// Individual Swedish category titles quoted in the rationales below are quotations from
// the Swedish edition of the WHO International Classification of Functioning, Disability
// and Health (translation rights Socialstyrelsen; published by E-hälsomyndigheten),
// release 2026. They serve as adjudication evidence for the individual mappings; the
// classification itself is not redistributed.
context {
    collection "icf-snomed-ct-retrieval" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "b1263.retr.1" source="b1263" target="365118007" relationship=source_is_broader_than_target preference=alternative {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Blinded rubric adjudication, third tie-break pass: the two prior blinded passes each chose a different defensible target; this pass recorded both as equally defensible alternatives. Evidence: designation text. Omissions recorded: psychological stability beyond mood stability (other personality/temperament aspects)."
}
