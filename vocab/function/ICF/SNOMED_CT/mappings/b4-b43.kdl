// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes b4-b43
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
assessment "b4.omop" source="b4" outcome=no_match target-system="OMOP_EXT"
mapping "b410.1" source="b410" target="SNOMED_CT:86185002" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b410 SNOMED CT 86185002 = ICF b410 Heart functions: the body functions of the heart,
        including b4100 heart rate, b4101 heart rhythm, b4102 contraction of ventricles, b4103 pumping
        of ventricles, b4104 cardiac output, b4105 blood pressure. Target =, active RF2 production. This
        is the direct SNOMED CT observable that captures heart-as-a-function and is the closest standard
        equivalent of ICF b410; it is the functional observable where 25848009 Increased/43650005
        Decreased/1148838007 105981003 are its valued/pathological correlates. Broader rather than exact
        only because ICF b410 is a multi-child function block (b4100-b4105) where the SNOMED CT concept is
        a single flat observable, and ICF uses (Hjärtfunktioner) vs SNOMED CT. High tier : direct
        term-and-scope match (cardiac function = heart functions) verified active in the mirror, but
        one-level-broader in model granularity with no independent Athena crosswalk re-verified.
        """
}
mapping "b410-b429.1" source="b410-b429" target="SNOMED_CT:86185002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b410-b429 SNOMED CT 86185002 = ICF block b410-b429 Functions of the cardiovascular system:
        the block-level grouping of heart functions (b410) AND blood vessel functions (b415) AND
        heart/blood-vessel functions (b420-b429). Target =, active. No single SNOMED CT observable exists
        (733741005 is an *finding*, not the function observable; 268902002 is inactive/D); the nearest
        standard ancestor that contains the heart-function core of this block is cardiac function.
        Broader (moderate): a block-level cardiovascular-system grouping mapped up to the heart-function
        observable is a deeper climb than the b410 chapter map, and the target covers only the heart
        (b410) axis fully — the blood-vessel axes (b415/b420) are only partially contained — but cardiac
        function is the nearest defensible ancestor and the dominant axis. Per the rubric, the moderate
        tier applies for this best-available but looser block-level map.
        """
}
mapping "b4100.1" source="b4100" target="SNOMED_CT:364075005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b4100 SNOMED CT 364075005 = ICF b4100 Heart rate functions: the heart sub-function of the
        rate (beats per unit time) at which the heart contracts. Target =, active RF2 production. Exact
        1:1 equivalence: identical clinical concept (heart rate as a cardiac function), confirmed by
        literal FSN term match; ICF = heart rate = SNOMED CT. The SNOMED CT concept is the direct functional
        observable where 78564009, 428531008, 10675001/76863003 111972009/248630007 abnormal are its
        valued correlates. (The legacy 76539000 is inactive/D; 364075005 is the active heart-rate
        observable.) exact_match: same concept, term-verified.
        """
}
mapping "b4101.1" source="b4101" target="SNOMED_CT:364074009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b4101 SNOMED CT 364074009 = ICF b4101 Heart rhythm functions: the heart sub-function of the
        rhythmic pattern of cardiac contraction (regularity of the heartbeat, the underlying rhythm).
        Target =, active RF2 production. No dedicated observable exists in SNOMED CT as a single concept:
        the legacy 76539000 is inactive/D (valid_end 2006-07-31), and the active heart-rhythm
        observables are 364074009 251149006. 364074009 is the closest functional observable (it captures
        the regularity-of-rhythm axis that is the clinical core of the heart-rhythm function). Broader
        rather than exact: the SNOMED CT concept is specifically the *regularity* of heart rhythm (one axis
        of the broader ICF b4101 heart-rhythm function, which also encompasses rhythm pattern/type), and
        the active rhythm-function concept was retired. High tier : the closest active defensible
        heart-rhythm observable, term-verified, direct cardiac domain, but one-level-broader (regularity
        axis only) with no independent crosswalk; 251149006 is the alternate axis but equally
        one-level-broader.
        """
}
mapping "b4102.1" source="b4102" target="SNOMED_CT:8997002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b4102 SNOMED CT 8997002 = ICF b4102: the heart sub-function of the contraction FORCE of the
        ventricular muscles (the strength/inotropy of ventricular contraction that ejects blood). Target
        =, active RF2 production, a direct child of 111973004 86185002. This is the only SNOMED CT
        observable that names the ventricular-contraction function as such (sibling to 59972007); no
        dedicated / observable exists in the mirror (the legacy 373129009/432439005 inotrope hits are
        substances/findings, not functions). Broader rather than exact: 8997002 denotes the ventricular
        systole/contraction-phase function, which captures the contraction axis but not the ICF
        (inotropic strength) specificity the source asserts. Low tier : the closest defensible
        ventricular-contraction observable, term-verified active in both mirrors, but it models the
        contraction phase rather than the contraction-force function, and there is no independent Athena
        crosswalk; real doubt remains. (404986003 Cardiac pump effectiveness considered: it is a global
        pump-effectiveness observable, one step further from the ventricular-contraction-force function
        than 8997002.)
        """
}
mapping "b4103.1" source="b4103" target="SNOMED_CT:251053005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b4103 SNOMED CT 251053005 = ICF b4103: the heart sub-function of the BLOOD SUPPLY to the
        heart (the coronary/perfusion supply that nourishes the myocardium). Target =, active RF2
        production. This is the direct SNOMED CT functional observable for blood supply/perfusion to the
        heart muscle and is the closest standard equivalent of ICF b4103; the adjacent 427751006 is a
        defect-measurement concept, not the perfusion function. Broader rather than exact only because
        ICF b4103 frames (the supply function) where SNOMED CT frames (the perfusion observable), and ICF
        uses (heart's blood supply) vs SNOMED CT — same clinical domain, slightly different framing. High
        tier : direct term-and-scope match (myocardial perfusion = heart blood supply), verified active
        in both mirrors, but one-level model-granularity difference and no independent Athena crosswalk
        re-verified.
        """
}
