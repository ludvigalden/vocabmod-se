// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d4-d43
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d4.1" source="d4" target="SNOMED_CT:363803005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d4 SNOMED CT 363803005 = ICF d4 Mobility: the Activities&Participation chapter root for
        general mobility activities (changing/maintaining body position, carrying/moving/handling
        objects, walking/moving around). Target =, active RF2 production, SNOMED CT's direct observable for
        the mobility axis (parent of ability-to-assume-and-maintain-a-position, ability-to-walk,
        ability-to-transfer-location, etc.). subsumes the whole d4 Mobility chapter (body position +
        object handling + walking/moving); one-level broader because SNOMED CT frames the observable rather
        than the activity-instance and spans all d4 sub-blocks. Broader (high): direct verified SNOMED CT
        observable match on the mobility axis, one-level broader; mirrors the chapter-root precedent (d3
        -> 288574004 at; d1 -> 69998004 at). mapping_type=broader.
        """
}
