// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, code b
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
assessment "b.omop" source="b" outcome=no_match target-system="OMOP_EXT"
