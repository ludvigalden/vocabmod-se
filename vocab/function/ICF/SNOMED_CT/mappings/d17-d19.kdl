// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d17-d19
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d170.1" source="d170" target="SNOMED_CT:12261009" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d170 SNOMED CT 12261009 = ICF d170 Writing: producing written language. Target =, active RF2
        production (sv synonym), SNOMED CT's direct observable for the writing activity. Both denote the
        writing-of-text concept. Exact-equivalent : direct verified SNOMED CT observable match with a
        direct sv-synonym match (/) confirming 1:1 equivalence. mapping_type=exact_match.
        """
}
mapping "d1700.1" source="d1700" target="SNOMED_CT:12261009" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d1700 SNOMED CT 12261009 = ICF d1700 Using general skills and strategies in the writing
        process: the 4-level child of d170 for applying general writing-process skills/strategies.
        Target =, active RF2 production (d170 parent maps here exactly). SNOMED CT has no concept; the
        writing observable subsumes the writing act but loses the process-skills/strategy qualifier.
        Broader (low): writing subsumes the activity axis but the source's process-skill/strategy
        specificity is outside any SNOMED CT concept; deep climb as for the d160 regional subdivisions.
        mapping_type=broader.
        """
}
