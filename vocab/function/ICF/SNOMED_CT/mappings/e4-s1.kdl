mapping "s11008.1" source="s11008" target="SNOMED_CT:314139009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source s11008 SNOMED CT 314139009 = ICF residual under the cortical-lobe structures block. No
        specific SNOMED CT concept exists for the residual; the legitimate ancestor is (Athena 4195655),
        which subsumes every cortical-lobe structure. Target legitimately subsumes the source; broader,
        high.
        """
}
