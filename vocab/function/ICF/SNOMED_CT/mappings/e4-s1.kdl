mapping "s.1" source="s" target="SNOMED_CT:123037004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source s SNOMED CT 123037004 = ICF Body Structures component root (the entire body-structures
        chapter anchor). Target = (Athena concept_id 4048384), the SNOMED CT top-level anatomical
        body-structure concept which is ancestor of all body-structure concepts. Direct conceptual
        equivalent of the ICF Body Structures root; exact_match.
        """
}
mapping "s1.1" source="s1" target="SNOMED_CT:25087005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source s1 SNOMED CT 25087005 = ICF Chapter 1 body-structures block: structures of the nervous
        system. Target = (Athena concept_id 4096246); SE synonym confirms equivalence. Direct 1:1
        conceptual equivalent; exact_match.
        """
}
