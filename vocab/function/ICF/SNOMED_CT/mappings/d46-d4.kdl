// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d46-d4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d460.1" source="d460" target="SNOMED_CT:301438001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d460 SNOMED CT 301438001 = ICF d460 Moving around in different locations: walking/moving
        around in the home, outside the home and in other buildings (the 3rd-level block spanning
        d4600-d4602 by location). Target =, active RF2 production, the SNOMED CT ancestor whose children
        include 301496004 (mobilize indoors), 301562008 (mobilize outside), 714998007 (mobilize in home)
        — exactly the d460 location-based constituent acts. SNOMED CT has no single concept that bundles
        all locations; 301438001 is the nearest common ancestor that fully subsumes every d460
        location-based act. Broader (high): one-level broader, the target fully contains every clinical
        meaning of the source (all location-based mobilization modes are children of 301438001); mirrors
        the d410/d455 one-level-broader precedent where SNOMED CT's axis concept subsumes the source's
        specific mode. mapping_type=broader.
        """
}
