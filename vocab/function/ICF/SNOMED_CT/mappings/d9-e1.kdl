// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d9-e1
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
assessment "d9.omop" source="d9" outcome=no_match target-system="OMOP_EXT"
mapping "d910.1" source="d910" target="SNOMED_CT:737353005" relationship=related_to {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d910 SNOMED CT 737353005 = ICF activity — engaging in community/social life. Target. Same
        participation domain but a substantial framing mismatch: the target is a disability/difficulty
        finding, whereas the source is the (positive) activity of engaging in community life. Recorded
        as a weak related lead (participation domain), not an equivalence; a reviewer should note SNOMED CT
        lacks a positive community-participation activity concept. Confidence weak.
        """
}
