// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d14-d16
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d140.1" source="d140" target="SNOMED_CT:309250007" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d140 SNOMED CT 309250007 = ICF d140 Learning to read: the activity of learning to read
        written language (parent of d1400-d1402; child of d130-d159 Basic learning). Target =, active
        RF2 production, SE synonym, parent is 405019005. The SNOMED CT function observable denotes the same
        clinical concept as the ICF reading-ability axis -- the SE term is a direct Swedish match for
        the source's läsning axis; SNOMED CT frames it as the (acquired) ability where ICF frames the
        parallel learning activity, but both denote the read-function axis. exact_match : direct
        verified function-observable match on the identical reading-ability axis, SE-synonym confirmed,
        same level of specificity. mapping_type=exact_match.
        """
}
