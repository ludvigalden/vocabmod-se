// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes s3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "s3.1" source="s3" target="SNOMED_CT:110724007" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source s3 SNOMED CT 110724007 74262004 = ICF Chapter 3 chapter root: structures involved in voice
        and speech. This is a heterogeneous classification grouping spanning the larynx, pharynx, oral
        cavity (incl. tongue, palate, teeth), nasal cavity and respiratory structures. SNOMED CT has no
        single body-structure concept. Per the partial multi-component rule, emit the two dominant
        component groupings: SNOMED CT 110724007 (Athena 4007135) = covers the phonatory/airway axis (the
        core voice source); SNOMED CT 74262004 (Athena 4253672) = Oral cavity structure covers the
        articulatory/resonatory axis. Each partial target covers one slice of the multi-part chapter
        root; neither subsumes the whole. Low tier : the chapter root is a classification grouping, not
        a single anatomical concept, so each component is a defensible-but-loose lead. (69536005)
        alternative was considered and rejected as too coarse.
        """
}
mapping "s3.2" source="s3" target="SNOMED_CT:74262004" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
