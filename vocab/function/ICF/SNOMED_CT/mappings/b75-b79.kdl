// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes b75-b79
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "b750.1" source="b750" target="SNOMED_CT:87572000" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b750 SNOMED CT 87572000 = ICF b750 Motor reflex functions: functions of involuntary
        contraction/relaxation triggered by muscle stretch (the stretch/tendon-reflex family, parent of
        b7500). Target =, active RF2 (63177006) and the tendon/jerk reflexes sit. Broader (moderate):
        SNOMED CT has no observable as such -- motor reflexes are modelled as the specific reflex
        observables (stretch 63177006, dynamic stretch 16468003, biceps/triceps jerk reflexes, etc.) --
        so the general reflex observable is the best containing concept. The target subsumes b750 (motor
        reflexes are reflexes) at one ancestor climb; moderate tier because the target is markedly
        broader than the motor-reflex subfamily. mapping_type=broader.
        """
}
mapping "b750-b789.1" source="b750-b789" target="SNOMED_CT:52479005" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b750-b789 SNOMED CT 52479005 = ICF block b750-b789 Functions related to movement: the
        block-level grouping of motor-reflex functions (b750), involuntary-movement-reaction functions
        (b755), control of voluntary-movement functions (b760), involuntary-movement functions (b765)
        and the b769/b780-b789 residuals. Target =, active RF2 production. No single SNOMED CT observable
        exists; the nearest containing standard ancestor spanning reflex, voluntary-control and
        involuntary-movement axes is the general motor-function observable (children include gross motor
        282716004 and fine motor 284363000 functions). Broader (low): a block-level movement-functions
        grouping mapped up to the whole motor-function observable is a deep climb -- the target also
        subsumes non-movement motor axes -- but it is the nearest defensible ancestor. Per the
        chapter/block precedent (b710-b729, b730-b749) the block-level map is
        moderate-or-lower; low chosen because the block is broad and the target is markedly broader than
        just. mapping_type=broader.
        """
}
mapping "b7500.1" source="b7500" target="SNOMED_CT:63177006" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b7500 SNOMED CT 63177006 = ICF b7500 Stretch reflex functions: functions of involuntary
        contraction triggered by stretching a muscle (the myotatic/tendon-jerk reflex). Target =, active
        RF2 production, the direct SNOMED CT concept for the stretch reflex (parent of dynamic stretch
        16468003 and static stretch 76245007). Exact term and concept match: the SNOMED CT concept carries
        the Swedish synonym (verified in synonyms.tdl, sctid 63177006), identical to the ICF source
        name, and the clinical scope (myotatic/muscle-spindle reflex) is 1:1. exact_match at.
        """
}
mapping "b7501.1" source="b7501" target="SNOMED_CT:87572000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b7501 SNOMED CT 87572000 = ICF b7501: the specific motor-reflex function of reflexes
        GENERATED BY NOXIOUS/HARMFUL stimuli (nociceptive withdrawal reflexes, a child of b750
        Involuntary movement reaction functions). Target =, active RF2 production 20260701, the generic
        SNOMED CT reflex observable. No dedicated or function-observable exists in the mirror: SNOMED CT's
        reflex observables are anatomically/physiologically specific (stretch reflex 63177006, postural
        reflex 6252006, etc.) and SNOMED CT 87572000 249974003 is a finding pattern, not a reflex function.
        Broader (low): the generic Reflex observable is a deep climb — it subsumes the source but adds
        every other reflex class (pupillary, tendon, autonomic) far beyond the motor noxious-stimulus
        reflex; it is nonetheless the nearest defensible standard ancestor. mapping_type=broader.
        """
}
mapping "b7502.1" source="b7502" target="SNOMED_CT:87572000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b7502 SNOMED CT 87572000 = ICF b7502: the specific motor-reflex function of reflexes
        generated by OTHER EXTERNAL stimuli (visual, auditory, tactile startle/orienting reflexes, a
        child of b750). Target =, active RF2 production 20260701, the generic SNOMED CT reflex observable.
        No dedicated or function-observable exists in the mirror: SNOMED CT models startle as a
        predisposition finding (286703002/286704008) or as a seizure precipitant, not as a motor-reflex
        function, and orienting/auditory reflexes are not framed as motor-reflex functions either.
        Broader (low): the generic Reflex observable is a deep climb that subsumes the source but adds
        every other reflex class; nearest defensible standard ancestor. mapping_type=broader.
        """
}
assessment "b7508.omop" source="b7508" outcome=no_match target-system="OMOP_EXT"
assessment "b7509.omop" source="b7509" outcome=no_match target-system="OMOP_EXT"
mapping "b755.1" source="b755" target="SNOMED_CT:7205007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b755 SNOMED CT 7205007 = ICF b755 Involuntary movement reaction functions: the body
        functions that produce involuntary reactions such as postural adjustments, righting, equilibrium
        and balance reactions to changes in body position and the environment. Target =, active RF2
        production 20260701, the function-framed SNOMED CT observable for the equilibrium/balance function
        — the closest function-framed match for the postural-balance-reaction axis that dominates ICF
        b755. No dedicated function-observable exists; sibling candidates (6252006, 87572000) are
        observables of the reflex component rather than the whole reaction function. Broader (low):
        7205007 captures the equilibrium-reaction sub-axis but the source spans the full class of
        involuntary movement reactions (righting, supporting, protective, postural), so the target
        subsumes the dominant axis while leaving other reaction subtypes outside; function framing
        matches, nearest defensible standard concept. mapping_type=broader.
        """
}
mapping "b760.1" source="b760" target="SNOMED_CT:249960005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b760 SNOMED CT 249960005 = ICF b760 Control of voluntary movement functions: the body
        functions that control voluntary movement (isolated, coordinated, support, coordination). Target
        =, active RF2 production 20260701, the SNOMED CT observable that names control of movement — the
        direct term-and-scope match for ICF b760's control-of-voluntary-movement framing. No dedicated
        function-observable distinct from 249960005 exists in the mirror; sibling 106164003. Broader
        rather than exact: 249960005 denotes control of movement as an observable where ICF b760 frames
        it as a FUNCTION spanning the whole voluntary-movement-control class (isolated, coordinated,
        support, coordination), and the observable fully contains the source domain but is one level
        away in model framing; no independent Athena crosswalk re-verified. High tier : direct
        term-and-scope match (control of movement = control of voluntary movement) verified active in
        the mirror, one-level-broader in model framing. mapping_type=broader.
        """
}
mapping "b7600.1" source="b7600" target="SNOMED_CT:249960005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b7600 SNOMED CT 249960005 = ICF b7600: the specific function of control of ISOLATED
        voluntary movements (single-joint / single-limb movements executed separately, a child of b760).
        Target =, active RF2 production 20260701. No dedicated function-observable exists in the mirror;
        the closest function-framed observables (284363000, 78718001) name adjacent but non-equivalent
        domains. Broader (low): 249960005 (generic control of movement) subsumes the
        isolated-movement-control function but adds every other movement-control framing (complex,
        coordinated, gait); it is the nearest defensible standard ancestor at a one-level climb,
        term-verified active. mapping_type=broader.
        """
}
mapping "b7601.1" source="b7601" target="SNOMED_CT:106164003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b7601 SNOMED CT 106164003 = ICF b7601: the specific function of control of
        COMPOUND/COORDINATED voluntary movements (multi-joint synergistic movements, a child of b760).
        Target =, active RF2 production 20260701, the function-framed SNOMED CT observable that names motor
        coordination — the closest function-framed match for the coordinated-movement-control axis. No
        dedicated observable exists; sibling 370980007. Broader rather than exact (low): 106164003 names
        the motor-coordination function where ICF b7601 frames the control of compound voluntary
        movements; the target captures the coordination sub-axis but the ICF source is specifically the
        control (not the execution) of compound movements, so there is both a control-vs-coordination
        and a function-observable gap. Nearest defensible standard concept, term-verified active.
        mapping_type=broader.
        """
}
