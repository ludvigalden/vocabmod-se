// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes s6
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "s6.1" source="s6" target="SNOMED_CT:21514008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source s6 SNOMED CT 21514008 = ICF chapter-6 root: structures related to the genitourinary system
        (köns- och urinorganens system = genital and urinary organs system = genitourinary system).
        Target SNOMED CT 4069509 (concept_code 21514008) =, the canonical SNOMED CT body structure combining
        genital and urinary systems. Exact 1:1 equivalence (SNOMED CT has a single combined genitourinary
        concept, unlike chapter 5). Exact-equivalent tier. Resolved via Athena-local mirror.
        """
}
