// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d5-d56
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d5.1" source="d5" target="SNOMED_CT:286850002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d5 SNOMED CT 286850002 = ICF chapter d5 Self-care: the second-level chapter for caring for
        oneself (washing/drying, caring for body/skin/teeth/hair/nails, toileting, dressing). Target =,
        active RF2 production (Athena 4113625) (286852005) (286854006) (286855007) function observables
        that the d5 children map to. Broader (high): the target legitimately subsumes the
        personal-hygiene core of the d5 chapter, but d5 also spans toileting and dressing which the
        single observable does not cover, so it is one-level broader than the chapter root; mirrors the
        d1 chapter-root precedent (69998004, broader). mapping_type=broader.
        """
}
