mapping "b130.1" source="b130" target="SNOMED_CT:247750002" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source ICF b130 SNOMED CT 247750002 (Energy and drive functions) = the ICF block-spanning mental
