// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes b1-b13
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "b1.1" source="b1" target="SNOMED_CT:285231000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1 SNOMED CT 285231000 = ICF chapter b1 Mental functions (the entire mental-functions
        chapter: consciousness b110, orientation b114, intellect b117, psychosocial b122,
        temperament/personality b126, cognitive b140-b189, etc.). Target (Athena 4111207) =, active
        standard, Swedish synonym. The SNOMED CT mental-function observable is the direct chapter-level
        equivalent of ICF b1 and fully subsumes every b1 sub-chapter (in the SNOMED CT observable hierarchy
        it sits under 18373002). Broader rather than exact only because ICF b1 is a multi-block
        classification chapter (b110-b189) and the SNOMED CT concept is a single flat observable;
        one-level-broader. High tier : direct term-and-scope match, verified active in both mirrors via
        the sctid_to_athena_id crosswalk, but no independent Athena crosswalk re-verified.
        """
}
mapping "b110.1" source="b110" target="SNOMED_CT:248217000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b110 SNOMED CT 248217000 (Consciousness functions) = ICF b110: the mental functions of the
        state of awareness and alertness, including maintain, sustain, and quality of consciousness.
        Target (Athena 4093831) =, active standard, Swedish synonym. This is the active SNOMED CT
        observable capturing consciousness as a state/function (the older 3551008 is inactive/D). The
        SNOMED CT concept models the consciousness state where ICF models the function of maintaining it;
        the target fully subsumes the source's domain. Broader: SNOMED CT does not separate from. High tier
        : strong term + Swedish-synonym match and verified crosswalk; one-level-broader in model
        granularity.
        """
}
mapping "b110-b139.1" source="b110-b139" target="SNOMED_CT:285231000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b110-b139 SNOMED CT 285231000 = ICF block b110-b139 Global mental functions: the block-level
        grouping of global mental functions (consciousness b110, orientation b114, intellect b117,
        psychosocial b122, temperament/personality b126, energy/drive b130). Target (Athena 4111207) =,
        active standard, Swedish synonym. The SNOMED CT mental-function observable is the nearest standard
        ancestor that fully contains the whole global-mental-functions block. Broader (moderate): a
        block-level ICF grouping mapped up to the chapter-level SNOMED CT observable is a deeper climb than
        the b1 chapter map, and the source is a deliberately coarse block anchor, so per the rubric the
        moderate tier applies.
        """
}
mapping "b1100.1" source="b1100" target="SNOMED_CT:248217000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1100 SNOMED CT 248217000 = ICF b1100: mental functions of MAINTAINING consciousness and
        wakefulness (the function that sustains the awake/alert state). Target (Athena 4093831) =,
        active standard, sv. SNOMED CT has no dedicated observable; the consciousness-state observable is
        the nearest ancestor and fully contains the source. Broader, low tier : the specific
        sub-function (maintaining) is not modelled separately in SNOMED CT, so the map loses the
        maintain/continuity/quality distinction the ICF code makes.
        """
}
