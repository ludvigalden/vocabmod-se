// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d3-d34
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d3.1" source="d3" target="SNOMED_CT:288574004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d3 SNOMED CT 288574004 = ICF d3 Communication: the Activities&Participation chapter root for
        general communication activities (receiving/producing messages via language/signs/symbols).
        Target =, active RF2 production, SE synonym; SNOMED CT's direct observable for the communication
        axis. subsumes the whole d3 communication chapter (receptive + expressive + verbal + non-verbal
        + device use); one-level broader because SNOMED CT frames the ability rather than the
        activity-instance and spans all communication modes. Broader (high): direct verified SNOMED CT
        observable match on the communication axis, one-level broader; mirrors the d1 -> 69998004
        chapter-root precedent at. mapping_type=broader.
        """
}
mapping "d310.1" source="d310" target="SNOMED_CT:405019005" relationship=source_is_narrower_than_target {
