// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d1-d13
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d1.1" source="d1" target="SNOMED_CT:69998004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d1 SNOMED CT 69998004 = ICF chapter d1 Learning and applying knowledge: the second-level
        chapter for learning, applying learned knowledge, thinking, and reading/writing/calculation.
        Target =, active RF2 production, SNOMED CT's direct function concept for the learning axis. SNOMED CT
        frames it as the learning-function observable (the central axis of the d1 chapter) rather than
        the full learning+applying+thinking+literacy chapter; the target legitimately subsumes the
        learning axis but the chapter also spans applying knowledge, thinking and literacy which the
        single observable does not cover. Broader (high): direct SNOMED CT function-observable match for
        the chapter's core axis, one-level broader because the chapter is wider than learning alone;
        mirrors the b715/b720/b735 parent-level precedent (broader for the direct-observable match of
        the same axis). mapping_type=broader.
        """
}
