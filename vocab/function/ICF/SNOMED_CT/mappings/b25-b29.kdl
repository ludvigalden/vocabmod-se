// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes b25-b29
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "b250.1" source="b250" target="SNOMED_CT:397627001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b250 SNOMED CT 397627001 = ICF b250 Taste functions. Target SNOMED CT 4265873 (sctid 397627001)
        =, active RF2 production. Exact 1:1 equivalence: identical clinical concept (taste as a sensory
        function), literal FSN term match. exact_match.
        """
}
mapping "b250-b279.1" source="b250-b279" target="SNOMED_CT:106148006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b250-b279 SNOMED CT 106148006 = ICF block b250-b279 Additional sensory functions: the
        block-level grouping of the remaining (non-vision, non-hearing/vestibular) sensory functions —
        taste b250, smell b255, proprioception b260, touch b265, temperature-and-other-stimuli b270.
        Target SNOMED CT 4024711 (sctid 106148006) =, active standard, the direct SNOMED CT observable for
        sensory function. Broader (multi-level): every b250-b279 sub-function is a sensory function, and
        the SNOMED CT concept fully subsumes the entire block, but it sits many levels above (a block-level
        ICF grouping mapped up to the chapter-equivalent SNOMED CT observable). Low tier : defensible
        block-level ancestor lead — is the closest standard concept to the block title and the
        enumerated children each get their own tighter function-level proposals (b250 Taste, b255 Smell,
        etc.) — but loose because a block anchor is classification scaffolding and the climb is deep.
        Recorded as broader rather than no_match because is a direct, defensible term-and-scope match
        for the block.
        """
}
