}
mapping "b260.1" source="b260" target="SNOMED_CT:397641005" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b260 SNOMED CT 397641005 = ICF b260 Proprioceptive function: the sensory function sensing
        the relative position of body parts and movement (position-and-movement sense). Target SNOMED CT
        4265876 (sctid 397641005) =, active RF2 production. This is the direct SNOMED CT function-level
        concept for proprioception (position-and-movement sense); it captures exactly what ICF b260
        denotes. Assessed exact_match at high tier rather than : the SNOMED CT FSN spells out where ICF
        uses the single term, a minor terminology nuance; term-and-scope verified active in both
        mirrors, no independent Athena crosswalk re-verified.
        """
}
