// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes b16-b18
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "b160.1" source="b160" target="SNOMED_CT:88952004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b160 SNOMED CT 88952004 (Thought functions) = ICF b160: the specific mental functions of
        thinking (pace/form/content/control of thought, b1600-b1603). Target (Athena 4230784) =, active
        standard. 1:1 scope equivalence: ICF and SNOMED CT denote the same construct, and the SNOMED CT
        sub-hierarchy includes the same children (form of thinking 44831001, speed of thought 247626007,
        thought content 363877005) that ICF b160 enumerates. Exact_match : identical clinical concept,
        verified active in both mirrors via the sctid_to_athena_id crosswalk.
        """
}
mapping "b1600.1" source="b1600" target="SNOMED_CT:247626007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1600 SNOMED CT 247626007 (Tempo of thought / rate of thinking) = ICF b1600: mental
        functions governing the SPEED/rate/pace at which thoughts succeed one another. Target (Athena
        4085508) =, active standard, Swedish synonym (thought speed), English synonyms /. The SNOMED CT
        concept directly names the same construct. Broader rather than exact (high): SNOMED CT is an
        observable whereas ICF b1600 is explicitly a FUNCTION construct (the regulatory function
        governing thought tempo) — same domain, paradigm-broader; the target fully subsumes the source.
        High tier: strong Swedish-synonym and English-synonym match and verified crosswalk.
        """
}
mapping "b1601.1" source="b1601" target="SNOMED_CT:44831001" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1601 SNOMED CT 44831001 (Form of thought) = ICF b1601: mental functions governing the
        FORM/organization/structure of thought (logical flow, goal-directedness, continuity). Target
        (Athena 4259259) =, active standard. The SNOMED CT concept directly names the same construct (form
        of thought). Broader rather than exact (high): SNOMED CT is an observable whereas ICF b1601 is the
        FUNCTION governing thought form — paradigm-broader; the target fully subsumes the source's
        domain. High tier: direct term match (ICF =) and verified crosswalk.
        """
}
mapping "b1602.1" source="b1602" target="SNOMED_CT:363877005" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1602 SNOMED CT 363877005 (Content of thought) = ICF b1602: mental functions governing the
        CONTENT of thought (what the thoughts are about, including presence of
        obsessions/compulsions/delusions as content disturbances). Target (Athena 4238641) =, active
        standard, Swedish synonym. The SNOMED CT concept directly names the same construct. Broader rather
        than exact (high): SNOMED CT is an observable (the content itself, around which findings like
        55956009 are recorded) whereas ICF b1602 is the FUNCTION governing thought content —
        paradigm-broader; the target fully subsumes the source's domain. High tier: direct
        Swedish-synonym match and verified crosswalk.
        """
}
mapping "b1603.1" source="b1603" target="SNOMED_CT:88952004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1603 SNOMED CT 88952004 (Control of thought) = ICF b1603: mental functions governing
        voluntary CONTROL over one's thought processes (the ability to direct, stop, or dismiss
        thoughts; its disturbance is thought insertion/broadcast/blocking). Target (Athena 4230784) =,
        active standard. SNOMED CT has no dedicated observable (the only control-of-thought concept is
        1332403005, a pathological finding, not a function); the thinking-function parent observable is
        the nearest ancestor and fully contains the source. Broader, low tier : the specific control
        sub-function is not modelled separately in SNOMED CT, so the map loses the control/volition
        distinction the ICF code makes — real specificity loss.
        """
}
mapping "b1608.1" source="b1608" target="SNOMED_CT:88952004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1608 SNOMED CT 88952004 = ICF b1608: other specified thought functions — a
        specified-but-uncoded residual under b160. Target (Athena 4230784) =, active standard. The
        thinking-function parent observable fully subsumes any specified thought sub-function. Broader,
        low tier : residual source (heterogeneous by definition), mapped to the verified parent
        observable.
        """
}
mapping "b1609.1" source="b1609" target="SNOMED_CT:88952004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1609 SNOMED CT 88952004 = ICF b1609: unspecified thought functions — thought function,
        unspecified aspect. Target (Athena 4230784) =, active standard. The thinking-function observable
        is the correct unspecified-level target and fully subsumes the source. Broader, low tier :
        unspecified residual mapped to the verified parent observable.
        """
}
mapping "b164.1" source="b164" target="SNOMED_CT:311507007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b164 SNOMED CT 311507007 (Higher-level cognitive functions) = ICF b164: the higher-level
        (executive) cognitive functions — abstraction, organization and planning, time management,
        cognitive flexibility, insight, judgment (b1640-b1644). Target (Athena 4207631) = (a broad class
        including abstraction b1640 and insight b1644 which are not strictly), while names the narrower
        subset; however the SNOMED CT concept is the closest standard function-level grouping of higher
        cognition and its child hierarchy (planning, goal-setting, awareness) substantially overlaps ICF
        b164's children. The target captures the executive core of higher cognition; the broader
        (non-executive) higher functions like pure abstraction are only implicit. High tier: strong
        scope overlap, verified active in both mirrors via the sctid_to_athena_id crosswalk; one-level
        broader because is slightly wider than.
        """
}
mapping "b1640.1" source="b1640" target="SNOMED_CT:363878000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b1640 SNOMED CT 363878000 = ICF b1640: the higher cognitive function of ABSTRACTION /
        abstract thinking (the ability to form abstract concepts and reason symbolically, beyond the
        concrete). Target (Athena 4239427) =, active standard, Swedish synonym (ability to think
        abstractly). The SNOMED CT concept directly names the same construct (the active replacement for
        the now-inactive 58092009). Broader rather than exact (high): SNOMED CT models abstract thinking as
        an ABILITY/observable, whereas ICF b1640 models it as a higher cognitive FUNCTION —
        paradigm-broader; the target fully subsumes the source's domain. High tier: direct
        Swedish-synonym match and verified crosswalk.
        """
}
mapping "b1641.1" source="b1641" target="SNOMED_CT:312011006" relationship=source_is_narrower_than_target {
