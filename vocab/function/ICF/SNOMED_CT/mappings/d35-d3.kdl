// ICF codes, Socialstyrelsen inventory to SNOMED CT mappings, codes d35-d3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icf-snomed-ct" version="2026.1"
    source system="ICF" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "d350.1" source="d350" target="SNOMED_CT:288633005" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d350 SNOMED CT 288633005 = ICF d350 Conversation: starting, sustaining and ending an
        interaction/dialogue; exchanging thoughts and ideas through conversation. Target =, active RF2
        production (sv), SNOMED CT's direct observable for the conversation ability and the parent of
        initiate/maintain/terminate-conversation. Both denote the conversation concept; ICF frames the
        activity, SNOMED CT the ability, same axis. Exact-equivalent : direct verified SNOMED CT observable
        match with an exact sv-synonym match (/) confirming 1:1 equivalence; mirrors the d166/d170
        exact-sv-synonym precedent. mapping_type=exact_match.
        """
}
mapping "d350-d369.1" source="d350-d369" target="SNOMED_CT:288574004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source d350-d369 SNOMED CT 288574004 = ICF block d350-d369 Conversation and use of communication
        devices and techniques: the block-level grouping of conversation (d350-d359) and use of
        communication devices/techniques (d360-d369). Target =, active RF2 production (sv), SNOMED CT's top
        observable for the communication ability axis (parent of receptive, expressive, verbal,
        non-verbal communication and device-use). No single SNOMED CT concept spans the block's full range
        (conversation + device/technique use); ability-to-communicate is the nearest defensible standard
        ancestor spanning the block's dominant theme (communication). Broader (low):
        ability-to-communicate subsumes the block's communication axis and is markedly broader (deep
        climb, partial coverage of conversation-specifics and device-use); consistent with the
        block-level map precedent (d110-d129 -> 311520005 at, d160-d179 -> 69998004 at).
        mapping_type=broader.
        """
}
