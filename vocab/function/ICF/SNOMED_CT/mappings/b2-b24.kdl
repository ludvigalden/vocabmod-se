mapping "b2108.1" source="b2108" target="SNOMED_CT:281004000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b2108 SNOMED CT 281004000 = ICF residual under b210 Synfunktioner (visual functions) — a
        heterogeneous residual bucket for visual functions not elsewhere classified. Target SNOMED CT
        4094031 (sctid 281004000) =, active, the parent visual-function concept. Broader: the target
        subsumes the residual bucket's domain (all are visual functions). Low tier: residual source with
        no concrete content; the map climbs to the chapter parent and loses any specific clinical
        meaning. Per rubric, a residual bucket maps to its parent at low confidence rather than no_match
        when a defensible parent exists.
        """
}
mapping "b2109.1" source="b2109" target="SNOMED_CT:281004000" relationship=source_is_narrower_than_target {
