mapping "b235.1" source="b235" target="SNOMED_CT:249982003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source b235 SNOMED CT 249982003 = ICF b235 Vestibular functions: the sensory functions of the inner
