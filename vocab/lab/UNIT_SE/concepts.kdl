// Swedish laboratory units, misc: codes with no filename-safe letter range; -N names number the parts in file order
context {
    system "UNIT_SE" release="2017"
}
defaults {
    concepts {
        status "active"
        class "unit"
    }
}
concept "%" {
    name "en" "Percent"
}
concept "E" {
    name "en" "Arbitrary unit (Swedish enhet)"
}
concept "E/ml" {
    name "en" "Arbitrary unit per milliliter"
}
concept "ELISA U/ml" {
    name "en" "ELISA unit per milliliter"
}
concept "IE" {
    name "en" "International unit (Swedish IE)"
}
concept "IE/ml" {
    name "en" "International unit per milliliter"
}
concept "Ospecificerad" {
    name "en" "Unspecified unit (Swedish)"
}
concept "anti-Xa IE" {
    name "en" "Anti-factor Xa international unit (mapped to generic IU)"
}
concept "anti-Xa IE/ml" {
    name "en" "Anti-factor Xa international unit per milliliter"
}
concept "enheter" {
    name "en" "Arbitrary units (Swedish enheter, plural)"
}
concept "enheter/ml" {
    name "en" "Arbitrary unit per milliliter (Swedish plural)"
}
concept "mg/24 timmar" {
    name "en" "Milligram per 24 hours"
}
concept "mikrog/24 timmar" {
    name "en" "Microgram per 24 hours"
}
concept "mikrog/dos" {
    name "en" "Microgram per dose"
}
concept "mikrog/ml" {
    name "en" "Microgram per milliliter"
}
