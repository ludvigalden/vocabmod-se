// Swedish laboratory units to OMOP concept mappings, misc: codes with no filename-safe letter range, -N parts numbered in file order
context {
    collection "unit-se-omop-ext" version="2026.1"
    source system="UNIT_SE" release="2017"
    target system="OMOP_EXT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
omop-binding "%.omop" concept="%" omop="OMOP_EXT:8554"
omop-binding "E.omop" concept="E" omop="OMOP_EXT:9260"
omop-binding "E/ml.omop" concept="E/ml" omop="OMOP_EXT:8980"
omop-binding "ELISA U/ml.omop" concept="ELISA U/ml" omop="OMOP_EXT:9426"
omop-binding "IE.omop" concept="IE" omop="OMOP_EXT:8718"
omop-binding "IE/ml.omop" concept="IE/ml" omop="OMOP_EXT:8985"
assessment "Ospecificerad.omop" source="Ospecificerad" outcome=no_match target-system="UCUM"
omop-binding "anti-Xa IE.omop" concept="anti-Xa IE" omop="OMOP_EXT:8718"
omop-binding "anti-Xa IE/ml.omop" concept="anti-Xa IE/ml" omop="OMOP_EXT:8985"
omop-binding "enheter.omop" concept="enheter" omop="OMOP_EXT:9260"
omop-binding "enheter/ml.omop" concept="enheter/ml" omop="OMOP_EXT:8980"
omop-binding "mg/24 timmar.omop" concept="mg/24 timmar" omop="OMOP_EXT:8909"
omop-binding "mikrog/24 timmar.omop" concept="mikrog/24 timmar" omop="OMOP_EXT:8906"
omop-binding "mikrog/dos.omop" concept="mikrog/dos" omop="OMOP_EXT:45890998"
omop-binding "mikrog/ml.omop" concept="mikrog/ml" omop="OMOP_EXT:8859"
