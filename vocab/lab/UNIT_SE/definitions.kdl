// Swedish laboratory units: the Swedish laboratory unit spellings normalized in the source dataset. Each unit
// is bound to its OMOP unit concept (omop-ext/, official OHDSI ids) and mapped to its UCUM code
// (ucum/) where the data supplies one.
system "UNIT_SE" kind=local distribution=published publisher="ludvig-alden" default-locale="sv" {
    name "en" "Swedish laboratory measurement units"
}
release "2017" system="UNIT_SE" label-source=registry
context {
    system "UNIT_SE" release="2017"
}
category "unit" {
    name "en" "Unit"
}
collection "unit-se-omop-ext" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "Swedish laboratory units to OMOP concepts"
    authors "ludvig-alden"
    source system="UNIT_SE" release="2017"
    target system="OMOP_EXT"
    defaults {
        mappings {
            claim-scope "unit-se-omop-ext@2026.1"
        }
    }
    import "OMOP_EXT/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
collection "unit-se-ucum" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "Swedish laboratory units to UCUM"
    authors "ludvig-alden"
    source system="UNIT_SE" release="2017"
    target system="UCUM" release="2.2"
    defaults {
        mappings {
            relationship "equivalent"
        }
    }
    import "UCUM/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts.kdl" kind=fragment
