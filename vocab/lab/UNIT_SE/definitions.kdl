// Swedish laboratory units: the Swedish laboratory unit spellings normalized in the source dataset. Each unit
// is bound to its OMOP unit concept (omop-ext/, official OHDSI ids) and mapped to its UCUM code
// (ucum/) where the data supplies one.
system "UNIT_SE" kind=local distribution=published publisher="ludvig-alden" default-locale="sv" {
    name "en" "Swedish laboratory measurement units"
}
release "2017" system="UNIT_SE" label-source=registry
context {
    system "UNIT_SE" release="2017"
}
category "unit" {
    name "en" "Unit"
}
import "concepts.kdl" kind=fragment
