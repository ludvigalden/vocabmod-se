// Swedish hospital local laboratory test codes, codes P-D-P-L
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P-D-DIMER (ELISA)" {
    comment "en" "P-D-Dimer (ELISA) = D-dimer in plasma by ELISA; P- = plasma."
}
concept "P-D-DIMER KVANT*" {
    name "sv" "P-D-DIMER KVANT"
    comment "en" "P- = plasma; D-dimer quantitative. DDU vs FEU reporting units are lab-specific."
}
concept "P-DRVV CONFIRM KVOT" {
    comment "en" "P-dRVV Confirm kvot = diluted Russell viper venom test confirm ratio in plasma."
}
concept "P-DRVVT CONFIRM KVOT" {
    comment "en" """
        P- = plasma. dRVVT = dilute Russell viper venom test  confirm kvot = confirm ratio for lupus
        anticoagulant.
        """
}
concept "P-DRVVT CONFIRM PAT" {
    comment "en" """
        P- = plasma. dRVVT confirm pat = confirmatory dRVVT on patient sample for lupus anticoagulant 
        panel concept includes both aPTT and dRVVT with reflex.
        """
}
concept "P-DRVVT CONFIRM REF" {
    comment "en" """
        P-dRVVT Confirm ref = diluted Russel viper venom test confirmatory reflex in plasma 
        Screen-to-confirm ratio is the standard interpretation.
        """
}
concept "P-DRVVT MIXNING KVOT" {
    comment "en" "dRVVT mixing ratio (lupus anticoagulant confirmatory test)."
}
concept "P-DRVVT MIXNING PAT" {
    comment "en" """
        P-dRVVT Mixning pat = plasma dRVVT mixing study with patient plasma. Lupus anticoagulant
        confirmatory mix.
        """
}
concept "P-DRVVT MIXNING REF" {
    comment "en" """
        P-dRVVT Mixning ref = dRVVT mixing confirmation/reference. Base RVRT exists but not specific
        mixing study variant.
        """
}
concept "P-DRVVT SCREEN KVOT" {
    comment "en" """
        P- = plasma; dRVVT screen kvot = dilute Russell viper venom time screen ratio. no exact dRVVT
        screen ratio concept.
        """
}
concept "P-DRVVT SCREEN PAT" {
    comment "en" "P- = plasma. dRVVT screen for lupus anticoagulant. pat = patient sample."
}
concept "P-DRVVT SCREEN REF" {
    comment "en" "dRVVT screen is a LA test. panel code captures the screening purpose."
}
concept "P-DRVVT TOTAL KVOT" {
    comment "en" "P- = plasma. dRVVT total kvot = dRVVT ratio (actual/normal)."
}
concept "P-ERYTROPOIETIN(EPO)" {
    comment "en" "EPO in serum or plasma."
}
concept "P-ETANOLGELTEST" {
    comment "en" "P-Etanolgeltest = ethanol gel test in plasma  screen method is closest."
}
concept "P-FAKTOR IX:C" {
    comment "en" """
        Factor IX:C = coagulation factor IX activity. P- = plasma (platelet poor). actual/normal ratio
        is standard Swedish reporting.
        """
}
concept "P-FAKTOR V" {
    comment "en" "P- = plasma  Faktor V = coagulation Factor V activity."
}
concept "P-FAKTOR VII:C" {
    comment "en" "P-Faktor VII:C = factor VII coagulation activity in plasma."
}
concept "P-FAKTOR VIII SUBSTR" {
    comment "en" "P- = plasma."
}
concept "P-FAKTOR XI"
concept "P-FAKTOR XII" {
    comment "en" "Factor XII (Hageman factor) activity in plasma."
}
concept "P-FAKTOR XIII" {
    comment "en" "P- = plasma  Faktor XIII = coagulation Factor XIII."
}
concept "P-FETTSYROR FRIA" {
    comment "en" "P- = plasma. Fettsyror fria = free fatty acids = NEFA. moles/volume preferred."
}
concept "P-FIBRIN, LÖSLIGT" {
    comment "en" """
        Soluble fibrin (fibrin monomer) in plasma. Method not specified in source. 40702-3 uses
        hemagglutination  Neither fibrin monomer code.
        """
}
concept "P-FIBRIN-D-DIMER" {
    name "sv" "P-Fibrin-D-Dimer"
    variant "P-D-DIMER" kind=raw
    comment "en" """
        Catalogued at: Lab B, Lab D, Lab E. Swedish code does not specify FEU vs DDU.
        Coagulation - D-dimer in Plasma.
        """
}
concept "P-FIBRIND-DIMER(PNA)" {
    name "sv" "P-FIBRIND-DIMER"
    comment "en" """
        P- = plasma. FibrinD-Dimer = D-dimer. PNA = POC. Fibrin D-dimer FEU in Platelet poor plasma.
        Point-of-care measurement.
        """
}
concept "P-FIBRINOGEN" {
    comment "en" "P- = plasma."
}
concept "P-FIBRINOGEN*" {
    comment "en" "P- = plasma. Asterisk is lab notation."
}
concept "P-GLUKOS" {
    name "sv" "P-Glukos"
    variant "FP-GLUKOS" kind=raw
    variant "GLUKOS(P)" kind=raw
    variant "P-GLUKOS (PNA)" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. Common ED test -
        plasma glucose. Common ED test - glucose in plasma. P-Glukos = plasma glucose.
        """
}
concept "P-GLUKOS LOK, FASTEV" {
    comment "en" """
        P-Glukos lok fastev = local capillary plasma glucose fasting. capillary fasting not available.
        """
}
concept "P-GLUKOS LOKALT-KAP"
concept "P-GLUKOS LOKALT-VEN" {
    comment "en" "Plasma glucose from local venous sample."
}
concept "P-GLUKOS, FASTEVÄRDE"
concept "P-HB" {
    comment "en" "P-Hb = free hemoglobin in plasma (hemolysis marker)."
}
concept "P-HEMOGLOBIN, PLASMA"
concept "P-HISTAMIN"
concept "P-HIT-TROMBOCYTAGG." {
    name "sv" "P-HIT-TROMBOCYTAGG"
    comment "en" "HIT = heparin-induced thrombocytopenia; Trombocytagg; = platelet antibodies."
}
concept "P-HOMOCYSTEIN" {
    comment "en" "P- = plasma. homocystein = homocysteine. Moles/volume is the standard SI unit."
}
concept "P-KALIUM" {
    name "sv" "P-Kalium"
    variant "KALIUM(P)" kind=raw
    variant "S-KALIUM" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. P-=plasma;
        potassium in serum/plasma. Common ED test - serum potassium. Common ED test - potassium. Common
        ED test - potassium in plasma.
        """
}
concept "P-KREATININ" {
    name "sv" "P-Kreatinin"
    variant "KREATININ(P)" kind=raw
    variant "P/S-KREATININ" kind=raw
    variant "S-KREATININ" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. P- = plasma.
        Common ED test - serum creatinine. Common ED test - creatinine. Common ED test - creatinine in
        plasma. P/S- prefix = plasma or serum. S- = serum creatinine.
        """
}
concept "P-KROMOGRANIN A" {
    comment "en" "Neuroendocrine tumör marker."
}
concept "P-KROMOGRANIN-A IEMA" {
    comment "en" "P-Kromogranin-A by IEMA."
}
concept "P-LAKTAT"
concept "P-LAMOTRIGIN"
concept "P-LD" {
    name "sv" "P-LD"
    comment "en" """
        Lactate dehydrogenase (LDH/LD) in Serum or Plasma. General tissue damage marker, elevated in
        hemolysis, liver disease, malignancy. P- prefix (plasma) clinically equivalent to S- prefix
        (serum). No Lab C equivalent mapped. Lactate dehydrogenase in Serum or Plasma. P- prefix
        (plasma) clinically equivalent to S- prefix (serum). Common tissue damage marker (hemolysis,
        liver disease, malignancy).
        """
}
concept "P-LEVO-DOPA" {
    comment "en" "P- = plasma. Levodopa TDM."
}
concept "P-LUPUS ANTIKOAG." {
    name "sv" "P-LUPUS ANTIKOAG"
    comment "en" """
        P- = plasma. Lupus antikoagulant = lupus anticoagulant  panel code covers the standard screening
        approach.
        """
}
