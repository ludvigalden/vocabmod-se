// Swedish hospital local laboratory test codes, codes P-M-P-U
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P-MEROPENEM" {
    comment "en" "P- = plasma. Meropenem therapeutic drug monitoring."
}
concept "P-METOXINORADRENALIN" {
    comment "en" "Metoxinoradrenalin = normetanephrine (O-methylated metabolite of norepinephrine)."
}
concept "P-MOTILIN" {
    comment "en" "Motilin (gastrointestinal hormone)."
}
concept "P-MYKOFENOLSYRA" {
    comment "en" "Mykofenolsyra = mycophenolic acid. Drug monitoring for transplant immunosuppression."
}
concept "P-MYOGLOBIN"
concept "P-NATRIUM" {
    name "sv" "P-Natrium"
    variant "NATRIUM(P)" kind=raw
    variant "S-NATRIUM" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. P- prefix =
        plasma. exact analyte+specimen match to Serum or Plasma sodium. Common ED test - serum sodium.
        Common ED test - sodium. Common ED test - sodium in plasma. S- = serum. natrium = sodium.
        """
}
concept "P-NGAL" {
    comment "en" "P- = plasma. NGAL = neutrophil gelatinase-associated lipocalin (kidney injury biomarker)."
}
concept "P-NORADREN STUDIER" {
    name "sv" "P-NORADREN"
    comment "en" "P-Noradren Studier = norepinephrine in plasma (research/studies). Specimen is plasma."
}
concept "P-NORADRENALIN" {
    comment "en" "P- = plasma."
}
concept "P-NPY" {
    comment "en" "P-NPY = neuropeptide Y in plasma. Rare analyte."
}
concept "P-NT-PROBNP" {
    name "sv" "P-NT-proBNP"
    comment "en" "NT-proBNP = N-terminal pro-B-type natriuretic peptide."
}
concept "P-OXYTOCIN"
concept "P-PAI-1-AKTIVITET" {
    comment "en" "PAI-1 activity. Specimen uncertainty (P- vs PPP)."
}
concept "P-PAI-1-ANTIGEN" {
    comment "en" "P-PAI-1-Antigen = plasma PAI-1 antigen. units/volume variant."
}
concept "P-PK" {
    comment "en" "P-PK = plasma prothrombin complex (INR in Swedish)."
}
concept "P-PK (INR)" {
    name "sv" "P-PK (INR)"
    comment "en" """
        Coagulation - INR (International Normalized Ratio) in Plasma. Swedish term PK =
        protrombinkomplex. Specimen type: plasma based on P- prefix.
        """
}
concept "P-PK LAB G" {
    comment "en" "P-PK=plasma prothrombin complex (INR)."
}
concept "P-PLASMINOGEN" {
    comment "en" "P- = plasma."
}
concept "P-PP" {
    comment "en" """
        P-PP = pancreatic polypeptide in plasma. PP abbreviation is standard for pancreatic polypeptide.
        Web search confirms.
        """
}
concept "P-PROCALCITONIN" {
    comment "en" "P- = plasma. procalcitonin (sepsis marker)."
}
concept "P-PROTEIN C"
concept "P-PROTEIN S FRITT" {
    comment "en" "P- = plasma. fritt = free."
}
concept "P-PROTROMBIN F1+2" {
    comment "en" """
        P-Protrombin F1+2 = prothrombin fragment 1+2 in plasma. Coagulation activation marker.
        Units/volume match.
        """
}
concept "P-PROTROMBINFR 1+2" {
    comment "en" "P-Protrombinfr 1+2 = prothrombin fragment 1+2 in plasma."
}
concept "P-PTH-RELATED PEPTID" {
    comment "en" "P- = plasma. PTH-related peptide = parathyroid hormone-related protein."
}
concept "P-PTHSTAT" {
    comment "en" "P-PTHstat = PTH stat (urgent) in plasma."
}
concept "P-PTK (SPA)"
concept "P-PYRIDOXAL-5-FOSFAT" {
    comment "en" "Pyridoxal-5-phosphate = active vitamin B6 form."
}
concept "P-Q10" {
    comment "en" "P-Q10 = coenzyme Q10 (ubiquinone) in plasma."
}
concept "P-RENIN" {
    comment "en" "P- = plasma. Renin reported as enzymatic activity or mass  both."
}
concept "P-RENIN AKTIVITET" {
    comment "en" """
        P-Renin aktivitet = plasma renin activity. Unspecified collection condition. baseline is best
        guess. Neither is Uncertain posture/timing context.
        """
}
concept "P-RIVAROXABAN" {
    comment "en" "P- = plasma  Rivaroxaban = direct oral anticoagulant."
}
concept "P-SOMATOSTATIN" {
    comment "en" "P-Somatostatin = plasma somatostatin. Rare neuroendocrine marker."
}
concept "P-STAND.BIKARBONAT" {
    comment "en" "P-Stand.Bikarbonat = standardized bicarbonate from blood gas. Blood bicarbonate is closest."
}
concept "P-TAT" {
    comment "en" "TAT = Thrombin-Antithrombin complex. P- prefix = plasma."
}
concept "P-TPA ANTIGEN 0-PROV" {
    comment "en" """
        P-tPA Antigen = tissue plasminogen activator antigen in plasma. 0-prov = baseline/fasting
        sample.
        """
}
concept "P-TPA BIO" {
    comment "en" "tPA biological (antigen) in plasma  tissue-type plasminogen activator Ag."
}
concept "P-TROMBINTID" {
    comment "en" "P- = plasma; trombintid = thrombin time. Generic TT code. specimen implied by P- prefix."
}
concept "P-TROPONIN I"
concept "P-TROPONIN I (PNA)" {
    comment "en" """
        Troponin I.cardiac in Serum or Plasma. Point-of-care measurement. P- prefix indicates plasma
        specimen. Troponin I.cardiac in Serum or Plasma. Point-of-care measurement.
        """
}
concept "P-TROPONIN T" {
    name "sv" "P-Troponin T"
    variant "P-TROPONIN T, HS" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab D, Lab E. P- = plasma. hs-Troponin T
        dominates modern ED practice  both. Troponin T with P- prefix. Same analyte as abbreviated TnT
        entry. Common ED test - cardiac troponin T, high-sensitivity. Common ED test - cardiac troponin
        T, high-sensitivity. Replaces removed Swedish full-text entry 'Troponin T, plasma'. Common ED
        test - high-sensitivity troponin T. Common ED test - Troponin T.
        """
}
concept "P-TROPONIN T HS" {
    name "sv" "P-Troponin T HS"
}
concept "P-TT (DABIGATRAN)" {
    comment "en" "P- = plasma. TT = thrombin time. for dabigatran monitoring."
}
concept "P-URAT" {
    name "sv" "P-Urat"
    comment "en" """
        P-Urat = uric acid in plasma. Urate (uric acid) in Serum or Plasma. Metabolic marker for gout
        assessment. P- prefix (plasma) clinically equivalent to S- prefix (serum).
        """
}
concept "P-URAT," {
    comment "en" "P-Urat = uric acid in plasma."
}
concept "P-UREA" {
    name "sv" "P-Urea"
}
