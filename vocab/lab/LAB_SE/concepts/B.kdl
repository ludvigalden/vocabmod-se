// Swedish hospital local laboratory test codes, codes B
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "B(P)-CRP (PNA)" {
    name "sv" "B(P)-CRP"
    comment "en" "CRP is specimen-independent clinically. serum/plasma standard matches well."
}
concept "B-6-MMPN" {
    comment "en" """
        B-6-MMPN = 6-methylmercaptopurine nucleotide metabolite (thiopurine monitoring). RBC
        measurement.
        """
}
concept "B-6-MMPN/ERC" {
    comment "en" "B- = whole blood; ERC = erythrocytes."
}
concept "B-6-TGN" {
    comment "en" "B-6-TGN = 6-thioguanine nucleotide in whole blood (measured in RBCs)  thiopurine metabolite."
}
concept "B-6-TGN/ERC"
concept "B-ABE (AKOM)" {
    name "sv" "B-ABE"
    comment "en" """
        B- = blood; ABE = abnormal hemoglobin erythrocytes; HbF (fetal hemoglobin) fraction. AKOM = akut
        omstandighet (acute)  ratio preferred over Kleihauer-Betke method variant (also.
        """
}
concept "B-ABNORMTHB" {
    comment "en" """
        B-AbnormtHb = abnormal hemoglobin in blood. Hb electrophoresis interpretation covers
        thalassemia/hemoglobinopathy variants.
        """
}
concept "B-BASOFILA" {
    name "sv" "B-Basofila"
    comment "en" """
        B- = whole blood. Basofila = basophils  Automated count standard. Differential WBC - Basophils
        in Blood.
        """
}
concept "B-BASOFILA, %" {
    comment "en" "B- prefix = whole blood; Basofila = basophils."
}
concept "B-BLASTER" {
    comment "en" "B- = whole blood. blaster = blasts (immature blood cells)."
}
concept "B-BLY" {
    comment "en" "B- = whole blood. Bly = lead. Standard occupational/environmental test."
}
concept "B-COHB (AKOM)" {
    name "sv" "B-COHB"
    comment "en" """
        B- = whole blood. CoHb = carboxyhemoglobin. AKOM = emergency lab qualifier. Fraction of total.
        """
}
concept "B-CRP" {
    comment "en" "B- = blood; CRP in whole blood."
}
concept "B-CRP (PNA)" {
    name "sv" "B-CRP (PNA)"
    comment "en" """
        Swedish B- prefix indicates whole blood but CRP is routinely reported in Serum/Plasma 
        high-frequency code across 3 hospitals.
        """
}
concept "B-CRP AVD/MOTT." {
    comment "en" "B-CRP = whole blood CRP. Ward/outpatient setting."
}
concept "B-CYKLOSPORIN"
concept "B-CYKLOSPORINE" {
    comment "en" "Cyclosporine TDM in whole blood."
}
concept "B-EOSINOFILA" {
    name "sv" "B-Eosinofila"
    comment "en" "Differential WBC - Eosinophils in Blood."
}
concept "B-EOSINOFILA, %" {
    comment "en" """
        B- = blood, Eosinofila = eosinophils, % = percentage (fraction of leukocytes). Automated count
        is standard.
        """
}
concept "B-EOSINOFILA,%" {
    comment "en" "B-Eosinofila,% = eosinophil percentage in blood."
}
concept "B-EPK" {
    comment "en" "B- = whole blood. EPK = erytrocytförlängt konto (RBC count)  routine automated."
}
concept "B-EPK LAB G" {
    comment "en" "B-Erytrocyter at Lab G  automated count."
}
concept "B-ERYTROBLASTER" {
    comment "en" "Erythroblasts = nucleated erythrocytes."
}
concept "B-ERYTROCYTBEDÖMNING" {
    comment "en" "Erytrocytbedomning = erythrocyte assessment/evaluation; broad term."
}
concept "B-EVEROLIMUS" {
    comment "en" "immunosuppressant TDM  B- = blood."
}
concept "B-EVF" {
    name "sv" "B-EVF"
    comment "en" "EVF=erythrocyt volym fraction=hematocrit; B-=whole blood."
}
concept "B-EVF LAB G" {
    comment "en" "B- = whole blood. EVF = hematocrit. Lab G is the hospital/site name suffix."
}
concept "B-EVF, CENTRIFUGERA" {
    comment "en" """
        B- = whole blood. EVF = erythrocyte volume fraction (hematocrit)  centrifugera may indicate spun
        method but automated is routine standard.
        """
}
concept "B-EVF, CENTRIFUGERAT" {
    comment "en" """
        B- = whole blood. EVF = erythrocyte volume fraction (hematocrit). centrifugerat = centrifuged.
        Automated hematocrit is the clinical standard.
        """
}
concept "B-FOLAT" {
    comment "en" "B-Folat = whole blood folate."
}
concept "B-G-6-PD SCREENING" {
    comment "en" "B-G-6-PD Screening = G6PD screening in blood. Presence test is closer to 'screening'."
}
concept "B-GALAKTOSIDAS(FIB)" {
    comment "en" "b-Galaktosidas(Fib) = beta-galactosidase in fibroblasts."
}
concept "B-GALAKTOSIDAS(LYC)"
concept "B-GLUKOS (HEMOCUE)" {
    name "sv" "B-GLUKOS"
    comment "en" "Blood glucose by HemoCue point-of-care device."
}
concept "B-HB (PNA)"
concept "B-HB LAB G" {
    comment "en" "B-Hb at Lab G site  hemoglobin in blood."
}
concept "B-HB(HEMOCUE)" {
    comment "en" "B-Hb = hemoglobin in blood. HemoCue is POC method  Hgb mass/volume in blood."
}
concept "B-HBA0" {
    comment "en" "B- = blood. HbA0 = adult hemoglobin A. match."
}
concept "B-HBA1C" {
    comment "en" "B-=whole blood."
}
concept "B-HBA1C (IFCC)" {
    comment "en" "B- = blood."
}
concept "B-HBA1C (PNA)" {
    comment "en" "B-HbA1c = glycated hemoglobin in blood."
}
concept "B-HBA1C LAB G" {
    comment "en" """
        B-=whole blood; HbA1c at Lab G. same analyte as B-HBA1c 
        Lab G is lab site designation.
        """
}
concept "B-HBA2" {
    comment "en" "B- = whole blood."
}
concept "B-HBF" {
    comment "en" "HbF mass/volume in blood."
}
concept "B-HEMOGLOBIN" {
    name "sv" "B-Hemoglobin"
    variant "B-HB" kind=raw
    variant "B-HB LAB E" kind=raw
    variant "HB(B)" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. B- prefix = whole
        blood. Common ED test - blood hemoglobin. Common ED test - blood hemoglobin (B-prefix
        convention). Hospital-specific variant - Hemoglobin (Lab E notation). Common ED test -
        hemoglobin in blood (Lab F notation with specimen type). B-Hb: whole blood hemoglobin. B- = whole
        blood, Hb = hemoglobin. Lab E suffix is hospital notation, not analyte info.
        """
}
concept "B-HEMOGLOBIN (NÄRLAB)" {
    comment "en" "B-Hemoglobin = Hgb in blood  närlab = near-patient lab."
}
concept "B-HEMOGLOBIN A" {
    comment "en" "B- = whole blood. Hemoglobin A fraction of total."
}
concept "B-HEMOGLOBIN A2" {
    comment "en" "B- prefix = whole blood."
}
concept "B-HEMOGLOBIN S" {
    comment "en" """
        Hemoglobin S fraction (sickle cell) in blood by electrophoresis. Low frequency (n=44) at
        Lab B.
        """
}
concept "B-HISTAMIN" {
    comment "en" "B-Histamin=histamine in whole blood."
}
concept "B-KADMIUM" {
    comment "en" "B- = blood, Kadmium = cadmium."
}
concept "B-LAKTAT" {
    comment "en" "B- = whole blood; Laktat = lactate."
}
concept "B-LEUKOCYTBEDÖMNING"
concept "B-LEUKOCYTER" {
    name "sv" "B-Leukocyter"
    variant "B-LEUKOCYTER LAB E" kind=raw
    variant "B-LPK" kind=raw
    variant "LEUKOCYTER(B)" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. 6690-2 (by
        Automated count) preferred over unspecified-method 26464-8 Swedish B-Leukocyter = WBC in whole
        blood. Common ED test - white blood cell count. Common ED test - leukocyte particle count.
        Hospital-specific variant - Leukocytes (Lab E notation). Common ED test - leukocytes in
        blood.
        """
}
concept "B-LEUKOCYTER (NÄRLAB)" {
    comment "en" """
        WBC from near-patient testing (närlab). Same analyte as B-Leukocyter. automated count code
        appropriate.
        """
}
concept "B-LEUKOCYTER LOKALT" {
    comment "en" "B- = blood. lokalt = local POC  automated count is closest standard."
}
concept "B-LEUKOCYTER, MONO" {
    comment "en" "Monocytes manual count from external lab."
}
concept "B-LEUKOCYTER, POLY" {
    comment "en" "Mature neutrophil count in blood."
}
concept "B-LPK (PNA)" {
    name "sv" "B-LPK"
    comment "en" "B- = whole blood; LPK = trombocyter/platelets."
}
concept "B-LUC%" {
    name "sv" "B-LUC"
}
concept "B-LYMF.VAKUOLISERADE" {
    comment "en" "B- = blood. Vacuolated lymphocytes, a morphological finding on blood smear."
}
concept "B-LYMFOCYTER" {
    name "sv" "B-Lymfocyter"
    comment "en" """
        Lymphocytes count in whole blood by automated count. Identical term at Lab B and
        Lab C (B-Lymfocyter).
        """
}
concept "B-LYMFOCYTER, %" {
    comment "en" "B-Lymfocyter, % = lymphocyte percentage in whole blood. ratio match."
}
concept "B-MEGAKARYOCYTER" {
    comment "en" """
        B- = blood; Megakaryocyter = megakaryocytes; rare in peripheral blood, typically bone marrow;
        strict = bone marrow manual count.
        """
}
concept "B-METAMYELOCYT" {
    comment "en" "B-=whole blood."
}
concept "B-METAMYELOCYTER"
concept "B-MONOCYTER" {
    name "sv" "B-Monocyter"
    comment "en" """
        S- prefix absent in code; desc shows B- prefix = whole blood. 2026-04-23. Same correction as
        Lab A. Monocytes count in whole blood. Identical term at Lab B and Lab C
        (B-Monocyter).
        """
}
concept "B-MONOCYTER,%" {
    comment "en" """
        B- = whole blood. monocyter,% = monocyte percentage. Monocytes/Leukocytes ratio = percentage of
        differential. Automated count is standard for hospital labs.
        """
}
concept "B-MYELOCYTER" {
    comment "en" "B-Myelocyter = myelocytes in whole blood."
}
concept "B-NEUT.SEGMENTERADE" {
    comment "en" """
        B-=whole blood; neutrophils.segmenterade=segmented neutrophils; automated count is standard lab
        method.
        """
}
concept "B-NEUTRO.STAVKÄRNIGA" {
    comment "en" "Stavkärniga = band/stab neutrophils."
}
concept "B-NEUTROFILA" {
    name "sv" "B-Neutrofila"
    comment "en" """
        B- = whole blood. Neutrofila = neutrophils. Automated count is standard. Differential WBC -
        Neutrophils in Blood.
        """
}
concept "B-NEUTROFILA, %" {
    comment "en" "B- = whole blood  neutrophil % = neutrophils/leukocytes ratio by automated count."
}
concept "B-NEUTROFILA, ANTAL" {
    comment "en" "B- = whole blood; Neutrofila = neutrophils. antal = count  routine automated."
}
concept "B-PCO2 (AKOM)" {
    name "sv" "B-PCO2"
    comment "en" """
        B-pCO2 = blood gas pCO2. AKOM = akut omhandlande (acute management). Adjusted-to-actual-temp is
        and preferred over plain pCO2.
        """
}
concept "B-PETH 16:0/18:1" {
    comment "en" """
        B-PEth 16:0/18:1 = phosphatidylethanol homolog in whole blood (alcohol biomarker). general PEth
        in Blood as strict.
        """
}
concept "B-PH (AKOM)" {
    name "sv" "B-PH"
    comment "en" "B- = whole blood. pH from blood gas. AKOM = acute care."
}
concept "B-PLASMACELLER" {
    comment "en" "B- = whole blood, plasma cell count. Absolute count preferred over fraction  Neither."
}
concept "B-PLOT" {
    comment "en" "B-Plot = platelets in blood (Plot = Swedish abbreviation for blodplättar/platelets)."
}
concept "B-PROLYMFOCYTER" {
    comment "en" "B- = blood; Prolymfocyter = prolymphocytes. Unspecified count preferred."
}
concept "B-PROMONOCYTER" {
    comment "en" "B- = whole blood. Promonocyte count (hematology differential)."
}
concept "B-PROMYELOCYTER" {
    comment "en" "B-Promyelocyter = promyelocytes in whole blood (differential count)."
}
concept "B-RAPAMYCIN" {
    comment "en" "B-Rapamycin = rapamycin (sirolimus) in whole blood."
}
concept "B-RET. ANTAL" {
    comment "en" "B-Ret  antal = reticulocyte count in whole blood."
}
concept "B-RETIKULOCYTER" {
    comment "en" "B- = whole blood, Retikulocyter = reticulocytes. Routine count without method qualifier."
}
concept "B-SEZARYCELLER" {
    comment "en" "Sezary cells (malignant T-cells) in blood by microscopy."
}
concept "B-SIROLIMUS"
concept "B-SR" {
    name "sv" "B-SR"
    comment "en" """
        B-SR = blood SR (sedimentation rate). Generic ESR. no method specified. Erythrocyte
        sedimentation rate (ESR/SR) by Westergren method in whole blood. Common ED inflammation marker.
        B- prefix indicates whole blood specimen. No Lab C equivalent mapped.
        """
}
concept "B-SR LAB G" {
    comment "en" "B-SR = blood sedimentation rate = ESR. Westergren is the universal standard method."
}
concept "B-STAND.BIKARBONAT" {
    comment "en" "B-Stand.Bikarbonat = standard bicarbonate in blood (whole blood)."
}
concept "B-STBIC (AKOM)" {
    name "sv" "B-STBIC"
    comment "en" "B-StBic (AKOM) = standard bicarbonate/base deficit in whole blood for acid-base status."
}
concept "B-SULFONAMIDER" {
    comment "en" "B- = blood, Sulfonamider = sulfonamides. Specimen discrepancy (blood vs serum/plasma)."
}
concept "B-TACROLIMUS (FK506)"
concept "B-TPK (PNA)" {
    name "sv" "B-TPK"
}
concept "B-TROMBOCYTER" {
    name "sv" "B-Trombocyter"
    variant "B-TPK" kind=raw
    variant "B-TROMBOCYTER LAB E" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. Hospital-specific
        variant - Platelets (Lab E notation). B-TPK=Trombocyter whole blood. Platelets in whole blood
        by automated count.
        """
}
concept "B-TROMBOCYTER LOKALT" {
    comment "en" "Platelet count in whole blood, local POC measurement."
}
concept "B-ÖVRIGA CELLER" {
    comment "en" "B-Övriga celler = other/unclassified cells in blood diff. automated count."
}
concept "B-ÖVRIGA LEUKOCYTER" {
    comment "en" "B-Övriga leukocyter = other leukocytes in blood (not further classified)."
}
concept "BCR-ABL1 MUTATION"
concept "BCR-ABL1 T(9;22)" {
    comment "en" "BCR-ABL1 t(9."
}
concept "BCR/ABL MRNA P190" {
    comment "en" """
        p190 = BCR-ABL1 e1a2 fusion transcript (ALL-specific). e1a2 not separately coded in reference.
        """
}
concept "BCRABL1 RNA"
concept "BCRABL1/ABL1 P190" {
    comment "en" "BCR-ABL1/ABL1 p190 ratio = e1a2 (p190) fusion transcript."
}
concept "BCRABL1/ABL1 P210" {
    comment "en" """
        BCRABL1/ABL1 p210 = BCR-ABL1 major (p210) fusion transcript ratio to control (ABL1)  ratio
        concept.
        """
}
concept "BCRABL1/ABL1 P210 IS" {
    comment "en" "BCR-ABL1/ABL1 p210 IS ratio on International Scale."
}
concept "BENM-HEMOSIDERIN" {
    comment "en" """
        Benm-Hemosiderin = bone marrow hemosiderin stain  Prussian blue stain is standard method for
        iron stores in marrow.
        """
}
concept "BENM-LKC-ALP" {
    comment "en" """
        Benm-Lkc-ALP = bone marrow leukocyte alkaline phosphatase (LAP score). Bone ALP fraction is a
        related but different analyte.
        """
}
concept "BENMÄRG CD34" {
    comment "en" "CD34+ stem cell count in bone marrow."
}
concept "BENMÄRG, DIFFERENTIALRÄKNING" {
    comment "en" "Benmärg = bone marrow. differentialräkning = differential count."
}
concept "BENMÄRGSSKÖRD CD34"
concept "BETA-ENDORFIN" {
    comment "en" "No specimen prefix. assumed serum/plasma standard. Research analyte."
}
concept "BFU-E, CFU-GM" {
    comment "en" """
        BFU-E, CFU-GM = burst-forming unit-erythroid and colony-forming unit-granulocyte macrophage
        (hematopoietic stem cell cultures). no BFU-E concept.
        """
}
concept "BIOINTAKT PTH SNABB" {
    comment "en" "Biointact is the precise match (moles/volume)."
}
concept "BIOPSI IMMUNOFENOTYP" {
    comment "en" "Biopsy immunophenotyping (flow cytometry). doesn't specify specimen type (biopsy vs blood)."
}
concept "BLOD CD34"
concept "BLODGRUPPERING" {
    comment "en" """
        Blodgruppering = blood typing. General ABO group as strict. The Swedish term covers ABO+Rh
        grouping broadly.
        """
}
concept "BLODTRYCK DIASTOLISKT - NEDRE" {
    name "sv" "Blodtryck diastoliskt-nedre"
    variant "BLODTRYCK DIASTOLISKT" kind=abbrev
    comment "en" """
        Catalogued at: Lab A, Lab F. Vital sign: Diastolic blood pressure - Blood pressure
        measurement. Vital sign - Diastolic blood pressure. Unspecified method.
        """
}
concept "BLODTRYCK SYSTOLISKT - OVRE" {
    name "sv" "Blodtryck systoliskt - ovre"
}
concept "BLODTRYCK SYSTOLISKT - ÖVRE" {
    name "sv" "Blodtryck systoliskt - övre"
    variant "BLODTRYCK SYSTOLISKT" kind=abbrev
    comment "en" """
        Catalogued at: Lab A, Lab F. Swedish: systolic BP upper value. Dual: panel is best
        available. Vital sign: Systolic blood pressure - Blood pressure measurement. Vital sign -
        Systolic blood pressure. Blodtryck systoliskt = systolic BP; no generic systolic BP. 2026-04-23.
        Direct Swedish-English translation. Clinical Observation class.
        """
}
concept "BLODVOLYM" {
    comment "en" "Blodvolym = blood volume. Swedish term does not specify method."
}
concept "BLÖDN.TID LAB G" {
    comment "en" """
        Blödn.tid Lab G = bleeding time (historical coagulation test). Lab G = Swedish method
        variant.
        """
}
concept "BMI" {
    comment "en" "BMI. (vitals/clinical observation)."
}
concept "BMI ENL MNA" {
    comment "en" "BMI calculated per MNA (Mini Nutritional Assessment). No specimen or method modifier."
}
