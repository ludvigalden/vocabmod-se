// Swedish hospital local laboratory test codes, codes S-C-S-G
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S-C-PEPTID"
concept "S-C1-ESTERASINHIBIT." {
    name "sv" "S-C1-ESTERASINHIBIT"
    comment "en" "S-C1-Esterasinhibit. = serum C1 esterase inhibitor mass."
}
concept "S-CA LAB G" {
    name "sv" "S-CA"
    comment "en" "S-Ca Lab G = serum calcium from Lab G hospital lab variant."
}
concept "S-CA JON PH 7,4"
concept "S-CA125" {
    comment "en" "Tumör marker CA-125  S-prefix = serum."
}
concept "S-CA19-9"
concept "S-CALCITONIN"
concept "S-CALCIUM, JONISERAT" {
    comment "en" "Same analyte as S-CA JON PH 7,4. ionized calcium in serum  pH 7.4 standard."
}
concept "S-CALCIUM,JON.OKORR." {
    name "sv" "S-CALCIUM,JON.OKORR"
    comment "en" """
        S- = serum. jon.okorr = joniserad okorrigerad = ionized uncorrected. ISE method is standard for
        ionized Ca measurement.
        """
}
concept "S-CDT DISIALO(HPLC)" {
    comment "en" "S-CDT disialo(HPLC) = CDT disialo fraction by HPLC."
}
concept "S-CEA"
concept "S-CERULOPLASMIN" {
    comment "en" "S- = serum. ceruloplasmin."
}
concept "S-CG+FRI BETAPEPTID" {
    comment "en" "S-CG=C-peptide."
}
concept "S-CITALOPRAM" {
    comment "en" "S- = serum. citalopram therapeutic drug monitoring."
}
concept "S-CK" {
    comment "en" "Total creatine kinase (CK) in serum."
}
concept "S-CK LAB G" {
    comment "en" "CK = creatine kinase. total CK. Lab G = Lab G lab tag."
}
concept "S-CK-MB" {
    comment "en" "S- = serum."
}
concept "S-COPEPTIN-PROAVP" {
    comment "en" "Copeptin (CT-proAVP) in serum."
}
concept "S-CRP LAB G" {
    name "sv" "S-CRP"
    comment "en" """
        S-CRP at Lab G hospital. Same analyte as CRP. hospital name is site qualifier only.
        Specimen mismatch (serum vs blood).
        """
}
concept "S-CRP NYCOCARD" {
    comment "en" "S- = serum; CRP = C-reactive protein."
}
concept "S-CRP, KÄNSLIG"
concept "S-CYSTATIN C" {
    comment "en" "Serum cystatin C, renal function marker."
}
concept "S-DEKANOYLKARNITIN" {
    comment "en" "S-Dekanoylkarnitin = C10 acylcarnitine in serum."
}
concept "S-DESMETYLCITALOPRAM" {
    comment "en" "S- = serum; desmetylcitalopram = norcitalopram. mass/vol preferred  neither."
}
concept "S-DESMETYLFLUOXETIN" {
    comment "en" "S- = serum."
}
concept "S-DESMETYLIMIPRAMIN" {
    comment "en" """
        Desmetylimipramin = desipramine (active metabolite of imipramine). Trough qualifier may not
        apply to all samples.
        """
}
concept "S-DESMETYLVENLAFAXIN" {
    comment "en" "S-Desmetylvenlafaxin = O-desmethylvenlafaxine in serum  active metabolite of venlafaxine."
}
concept "S-DHEA-SULFAT" {
    comment "en" "S- = serum."
}
concept "S-DIBUCAINHÄMNING"
concept "S-DIGITOXIN"
concept "S-DIGOXIN" {
    comment "en" "S- = serum."
}
concept "S-ERYTROPOIETIN(EPO)"
concept "S-ETANOL" {
    comment "en" "Swedish: ethanol concentration in serum. Direct match."
}
concept "S-ETYLENGLYKOL" {
    comment "en" "S-Etylenglykol = ethylene glycol toxicology in serum."
}
concept "S-FENYTOIN" {
    comment "en" "Phenytoin therapeutic drug monitoring."
}
concept "S-FERRITIN" {
    name "sv" "S-Ferritin"
    comment "en" "Iron studies - Ferritin in Serum."
}
concept "S-FLUOXETIN" {
    comment "en" "Fluoxetine TDM  only moles/volume available in serum/plasma."
}
concept "S-FOLAT" {
    name "sv" "S-Folat"
    comment "en" "S- prefix = serum. Vitamin - Folate in Serum."
}
concept "S-FOLAT LAB G" {
    comment "en" "S- = serum. Folat = folate."
}
concept "S-FOSFAT"
concept "S-FOSFAT LAB G" {
    comment "en" "S- = serum; Fosfat = phosphate."
}
concept "S-FRIA KAPPA-KEDJOR"
concept "S-FRIA LAMBDA-KEDJOR" {
    comment "en" "S-Fria Lambda-kedjor = serum free lambda light chains (monoclonal gammopathy)."
}
concept "S-FRITT T3" {
    comment "en" """
        S-Fritt T3 = free T3 in serum  both Moles/volume and Mass/volume variants Moles/volume preferred
        as SI unit.
        """
}
concept "S-FRITT T4" {
    comment "en" "S-Fritt T4 = free thyroxine in serum."
}
concept "S-FSH" {
    comment "en" """
        S-FSH = follicle stimulating hormone in serum. Follitropin = FSH synonym  Units/volume is
        standard reporting unit.
        """
}
concept "S-G GT LAB G" {
    name "sv" "S-G GT"
    comment "en" "Lab G hospital variant of GGT."
}
concept "S-GAD ANTIKROPPAR" {
    comment "en" "S- = serum. GAD antikroppar = GAD65 antibodies  as Units/volume in Serum."
}
concept "S-GALLSYROR" {
    comment "en" """
        Gallsyror=bile acids. liver function test  Serum rather than Serum or Plasma but close match.
        """
}
concept "S-GAMMA-GT" {
    comment "en" "S- prefix = serum. gamma-GT = GGT."
}
concept "S-GASTRIN" {
    comment "en" "S-Gastrin = gastrin in serum."
}
concept "S-GLYCEROL"
