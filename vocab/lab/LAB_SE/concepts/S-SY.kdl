// Swedish hospital local laboratory test codes, codes S-SY
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S/P-IGF-1 (TOTAL)" {
    comment "en" "S/P- = serum or plasma."
}
concept "S/P-INSULIN" {
    comment "en" "S/P- = serum or plasma. basic insulin measurement."
}
concept "S/P-INSULIN, FRITT" {
    comment "en" "S/P-Insulin, fritt = free insulin in serum or plasma."
}
concept "S/P-PROCALCITONIN"
concept "SATURATION" {
    name "sv" "Saturation"
}
concept "SATURATION MED SYRGAS" {
    comment "en" "SpO2 with oxygen supplement; Specimen unclear (arterial vs venous vs pulse ox)."
}
concept "SS18 (SYT)(18Q11.2)" {
    comment "en" """
        SS18/SYT synovial sarcoma translocation. Source code does not distinguish SSX1 vs SSX2 partner.
        SSX1 more common  Neither.
        """
}
concept "STUDIE SALIV-KORTISOL"
concept "SVETT KLORID BERÄKN." {
    name "sv" "SVETT KLORID BERÄKN"
    comment "en" "Svett klorid = sweat chloride. cystic fibrosis diagnostic test."
}
concept "SVETT KLORID ELEKTR." {
    name "sv" "SVETT KLORID ELEKTR"
}
concept "SVETT KLORID TITR." {
    name "sv" "SVETT KLORID TITR"
    comment "en" "Sweat chloride test (cystic fibrosis diagnostic)."
}
concept "SVETT NATRIUM" {
    comment "en" "Svett = sweat. sodium in sweat (cystic fibrosis screening)."
}
concept "SYRGAS, NEWS" {
    comment "en" "Syrgas = oxygen gas. NEWS score component. FiO2/oxygen delivery is the measured quantity."
}
