// Swedish hospital local laboratory test codes, codes P
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P(AB)-BILIRUBIN(PNA)" {
    name "sv" "P(AB)-BILIRUBIN"
}
concept "P(AB)-CA JON PH 7,4" {
    comment "en" "Ionized calcium adjusted to pH 7.4 in arterial blood."
}
concept "P(AB)-CAJON OKOR/PNA" {
    name "sv" "P(AB)-CAJON OKOR"
    comment "en" """
        CaJon okor=ionized calcium (korrigerad=corrected) in plasma from arterial blood (PNA)  ISE
        method match is standard clinical approach.
        """
}
concept "P(AB)-CAJON OKORR." {
    name "sv" "P(AB)-CAJON OKORR"
    comment "en" "Ionized calcium arterial uncorrected (okorr.=okorrigerad=uncorrected)."
}
concept "P(AB)-GLUKOS"
concept "P(AB)-GLUKOS (PNA)" {
    comment "en" "PNA = point-of-care. Generic Glucose in Blood used as best match."
}
concept "P(AB)-GLUKOS /PNA" {
    comment "en" """
        P(aB)- = point-of-care blood gas plasma from arterial blood. Glucose is specimen-independent.
        """
}
concept "P(AB)-KALIUM"
concept "P(AB)-KALIUM (PNA)" {
    comment "en" "is moles/vol."
}
concept "P(AB)-KALIUM /PNA" {
    comment "en" "P(aB)- = plasma from arterial blood. /PNA = POC. Potassium in Blood is best available match."
}
concept "P(AB)-KLORID (PNA)" {
    name "sv" "P(AB)-KLORID"
    comment "en" "Blood specimen is closest  minor specimen mismatch."
}
concept "P(AB)-KREATININ /PNA" {
    name "sv" "P(AB)-KREATININ"
}
concept "P(AB)-LAKTAT" {
    comment "en" "P(aB)- = plasma from arterial blood gas sample. generic blood lactate is closest."
}
concept "P(AB)-LAKTAT (PNA)" {
    comment "en" "P(aB) = plasma (arterial blood). specimen variant not differentiated."
}
concept "P(AB)-LAKTAT /PNA"
concept "P(AB)-NATRIUM"
concept "P(AB)-NATRIUM (PNA)"
concept "P(AB)-NATRIUM /PNA" {
    comment "en" "P(aB)- = plasma from arterial blood. /PNA = POC  Serum or Plasma covers both."
}
concept "P(AB)CAJON OKORR PNA" {
    comment "en" """
        P(aB) = plasma from arterial blood; CaJon = ionized calcium. okorr = uncorrected. PNA =
        point-of-care.
        """
}
concept "P(KB)-CA JON OKORR." {
    name "sv" "P(KB)-CA JON OKORR"
    comment "en" "Ionized calcium uncorrected."
}
concept "P(KB)-CA JON PH 7,4" {
    comment "en" """
        P(kB)-Ca Jon pH 7.4 = ionized calcium adjusted to pH 7.4 from capillary/whole blood.
        kB=capillary POC. Serum/Plasma covers.
        """
}
concept "P(KB)-GLUKOS" {
    comment "en" "P(kB) = plasma from capillary blood."
}
concept "P(KB)-KALIUM"
concept "P(KB)-KALIUM (PNA)" {
    comment "en" "P(kB)- = plasma from capillary blood. POC. Potassium in Blood best available."
}
concept "P(KB)-KETON, 3-HB (PNA)" {
    name "sv" "P(KB)-KETON, 3-HB"
    comment "en" "P(kB)-Keton 3-HB = 3-hydroxybutyrate in plasma (POC). but low precision."
}
concept "P(KB)-KLORID (PNA)" {
    name "sv" "P(KB)-KLORID"
    comment "en" "P(kB) = plasma from capillary blood. chloride; PNA = POC."
}
concept "P(KB)-LAKTAT" {
    comment "en" "P(kB)- = plasma from capillary blood. laktat = lactate. Serum/Plasma covers it."
}
concept "P(KB)-LAKTAT (PNA)" {
    comment "en" """
        P(kB)-Laktat = plasma from capillary blood lactate POC. S/P version preferred over venous plasma
        specific.
        """
}
concept "P(KB)-NATRIUM" {
    comment "en" "P(kB)- = plasma from capillary blood. sodium in serum/plasma."
}
concept "P(KB)-NATRIUM (PNA)"
concept "P(VB)-BILIRUBIN(PNA)" {
    name "sv" "P(VB)-BILIRUBIN"
}
concept "P(VB)-CAJON OKOR/PNA" {
    name "sv" "P(VB)-CAJON OKOR"
    comment "en" "CaJon okor=ionized calcium uncorrected. PNA=POC blood gas  ISE method match."
}
concept "P(VB)-CAJON OKORR." {
    name "sv" "P(VB)-CAJON OKORR"
    comment "en" """
        CaJon = Ca joniserat = ionized calcium. okorr. = okorrigerad = uncorrected (not
        albumin-adjusted). P(VB)- = POC plasma from venous blood.
        """
}
concept "P(VB)-CAJONOK/RÖR" {
    name "sv" "P(VB)-CAJONOK"
    comment "en" "Ionized calcium in blood. P(VB) = plasma from venous blood."
}
concept "P(VB)-GLUKOS"
concept "P(VB)-GLUKOS (PNA)" {
    comment "en" "P(vB)=plasma from venous blood."
}
concept "P(VB)-GLUKOS/RÖR"
concept "P(VB)-KALIUM" {
    comment "en" "Plasma from venous blood."
}
concept "P(VB)-KALIUM (PNA)" {
    comment "en" "Potassium in Blood appropriate."
}
concept "P(VB)-KALIUM/RÖR" {
    comment "en" "P(vB) = plasma from venous blood tube  Potassium in serum/plasma is standard."
}
concept "P(VB)-KLORID (PNA)" {
    name "sv" "P(VB)-KLORID"
    comment "en" "P(vB)-Klorid = plasma chloride from venous blood gas."
}
concept "P(VB)-KREATININ/PNA" {
    name "sv" "P(VB)-KREATININ"
    comment "en" "Plasma creatinine from venous blood (PNA)."
}
concept "P(VB)-LAKTAT" {
    comment "en" "P(vB)- = plasma from venous blood. Mass/volume in Blood is best match."
}
concept "P(VB)-LAKTAT (PNA)" {
    comment "en" """
        P(vB) = plasma from venous blood. Laktat = lactate. Lactate in Blood is best available match.
        """
}
concept "P(VB)-LAKTAT/RÖR" {
    comment "en" "P(VB)- = point-of-care venous blood gas. /rör = tube sample  Lactate in blood is."
}
concept "P(VB)-NATRIUM (PNA)" {
    comment "en" "P(vB)=plasma from venous blood gas."
}
concept "P(VB)-NATRIUM/RÖR"
concept "P(VB)CAJON OKORR PNA" {
    comment "en" """
        P(vB) = plasma from venous blood; CaJon = ionized Ca; okorr = uncorrected. POC  pH-adjusted
        variant is best available.
        """
}
