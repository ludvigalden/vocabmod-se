// Swedish hospital local laboratory test codes, codes UG-US
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "UGT1A1 GENOTYP" {
    comment "en" "UGT1A1 genotyping."
}
concept "URINODLING SCREEN" {
    comment "en" """
        Urine culture screening. General bacteria identification by culture is 'Screen' qualifier not
        captured.
        """
}
concept "URINVOLYM L"
concept "URINVOLYM ML" {
    comment "en" "Urinvolym mL = urine volume in mL."
}
concept "UROVYSION" {
    comment "en" "UroVysion = FDA-approved FISH test for bladder cancer detection in urine."
}
concept "USP6(17P13)"
