// Swedish hospital local laboratory test codes, codes P-V
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P-VEGF(A)"
concept "P-VIP"
concept "P-VWF ANTIGEN" {
    comment "en" "P- = plasma. VWF Antigen = von Willebrand factor antigen."
}
concept "P-VWF-AKTIVITET"
concept "P-VWF:AKT (GP1BA)"
concept "P-VWF:ANTIGEN" {
    comment "en" "panel concept used as best proxy."
}
concept "P-VWF:CB"
concept "P-VWF:RCO"
concept "P-VWF:RCOF" {
    comment "en" "vWF ristocetin cofactor in plasma."
}
