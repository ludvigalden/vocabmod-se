// Swedish hospital local laboratory test codes, codes P-P-C
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P- APCR B"
concept "P- APCR+" {
    comment "en" """
        P- = plasma. APCR+ = activated protein C resistance screening (positive result). Presence vs
        ratio reporting unclear.
        """
}
concept "P- DRVV CONFIRM REF" {
    comment "en" """
        dRVV Confirm = confirmatory dilute Russell viper venom test for lupus anticoagulant.
        confirm/verify step not separately coded.
        """
}
concept "P- DRVV KVOT" {
    comment "en" """
        P-dRVV kvot = dilute Russell viper venom time ratio in plasma (lupus anticoagulant screening).
        """
}
concept "P- DRVV REF" {
    comment "en" "dRVV ref = dilute Russell viper venom time reference ratio (LA screening)."
}
concept "P- DRVV SCREEN" {
    comment "en" "P- = plasma. dRVV screen = dilute Russell viper venom test for lupus anticoagulant."
}
concept "P- DRVV SP 1+1" {
    comment "en" "dRVVT screening test for lupus anticoagulant."
}
concept "P- DRVV SP 1+1 KVOT" {
    comment "en" """
        dRVV Sp 1+1 kvot = dRVVT screen/confirm with 1:1 PNP mix ratio  Screen concept is mix concept
        more precise but.
        """
}
concept "P- DRVV SP 1+1 REF." {
    name "sv" "P- DRVV SP 1+1 REF"
    comment "en" "P- = plasma."
}
concept "P- DRVV TID" {
    comment "en" "P-dRVV tid = dilute Russell viper venom time for lupus anticoagulant."
}
concept "P- DRVV-TID" {
    comment "en" """
        P- = plasma. dRVV-tid = dilute Russell viper venom time  used for lupus anticoagulant screening.
        """
}
concept "P-3-HYDROXISMÖRSYRA" {
    comment "en" "P-3-Hydroxismorsyra = plasma 3-hydroxyisobutyrate (metabolic marker)."
}
concept "P-3-METOXYTYRAMIN" {
    comment "en" "Plasma 3-methoxytyramine. catecholamine metabolite for pheochromocytoma workup."
}
concept "P-ACETOACETAT"
concept "P-ACTH" {
    comment "en" "ACTH = corticotropin  P- = plasma."
}
concept "P-ADH" {
    comment "en" "P-ADH = antidiuretic hormone (vasopressin) in plasma  mass/volume in Serum/Plasma preferred."
}
concept "P-AKTIVT RENIN" {
    comment "en" """
        Active (direct) renin = renin concentration (mass/volume). Posture not specified. supine default
        Neither.
        """
}
concept "P-AKUT ATIII SNABB" {
    comment "en" "P- = plasma. akut ATIII snabb = urgent rapid antithrombin III."
}
concept "P-ALAT" {
    name "sv" "P-ALAT"
    variant "S-ALAT" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D. P- prefix = plasma. S- = serum.
        ALAT = ALT.
        """
}
concept "P-ALBUMIN" {
    name "sv" "P-Albumin"
    variant "S-ALBUMIN" kind=raw
    comment "en" """
        Catalogued at: Lab B, Lab C, Lab D. P- = plasma  exact analyte+specimen match.
        S- = serum  exact analyte+specimen match.
        """
}
concept "P-ALDO/RENIN KVOT" {
    comment "en" "P-Aldo/Renin Kvot = aldosterone-to-renin ratio in plasma. exact specimen match."
}
concept "P-ALDOSTERON"
concept "P-AMMONIUMJON" {
    comment "en" "P- = plasma."
}
concept "P-ANTI-XA AKTIVITET" {
    comment "en" "P- = plasma. Anti-Xa aktivitet = anti-factor Xa activity for heparin monitoring."
}
concept "P-ANTI-XA AKTIVITET (LMH)" {
    comment "en" "LMH=low molecular weight heparin  specimen mismatch Nonbiological vs Plasma."
}
concept "P-ANTITROMBIN"
concept "P-ANTITROMBIN (XA)" {
    comment "en" "P- = plasma. antithrombin (Xa) = anti-Xa activity measured by chromogenic substrate."
}
concept "P-APC-RESISTENS (FUNKTIONELL METOD)" {
    comment "en" "P- = plasma. Time Ratio result is Presence variant also but less informative."
}
concept "P-APC-RESISTENS (FV)"
concept "P-APCR A" {
    comment "en" "APCR test. Ratio vs presence uncertain  Both."
}
concept "P-APCR-" {
    name "sv" "P-APCR"
    comment "en" "Swedish: APC resistance test in plasma (APCR- = negative result)."
}
concept "P-APIXABAN" {
    comment "en" "P-=plasma. apixaban is a direct oral anticoagulant (DOAC)  drug level monitoring."
}
concept "P-APT-TID" {
    name "sv" "P-APT-tid"
    variant "P-APTT" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D. P- prefix = plasma. P-APTT =
        activated partial thromboplastin time in plasma.
        """
}
concept "P-APT-TID LAB G" {
    comment "en" "P-APT-tid = plasma APTT (activated partial thromboplastin time)."
}
concept "P-APTT MIXNING" {
    comment "en" """
        P-APTT Mixning = APTT mixing study in plasma  mixing study uses 1:1 pooled normal plasma to
        differentiate factor deficiency from inhibitor.
        """
}
concept "P-ASAT" {
    name "sv" "P-ASAT"
    variant "S-ASAT" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D. ASAT = aspartate
        aminotransferase. P- = plasma. ASAT=AST. 2026-04-23. S-prefix = serum in Swedish lab
        nomenclature.
        """
}
concept "P-BENSYLPENICILLIN" {
    comment "en" "Swedish: benzylpenicillin (=Penicillin G) concentration in plasma. Direct match."
}
concept "P-BILIRUBIN" {
    name "sv" "P-Bilirubin"
    variant "S-BILIRUBIN" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D. P- prefix = plasma. Swedish
        standard reports bilirubin in µmol/L (moles/volume)  Both variants. S- prefix = serum.
        """
}
concept "P-BNP" {
    comment "en" "BNP = B-type natriuretic peptide  P- = plasma."
}
concept "P-C18:0" {
    comment "en" "C18:0 = stearic acid (octadecanoate). fatty acid profiling  P-prefix = plasma."
}
concept "P-C18:1" {
    comment "en" "C18:1 = oleic acid (monounsaturated)."
}
concept "P-C18:2 (N-6)" {
    comment "en" "P- = plasma. linoleoylcarnitine C18:2 (n-6). Fatty acid oxidation panel."
}
concept "P-C22:6 (N-3)" {
    comment "en" "P-C22:6 (n-3) = plasma docosahexaenoic acid (DHA). Exact fatty acid match."
}
concept "P-C24:0/C22:0" {
    comment "en" "P-=plasma; C24:0/C22:0=VLCFA ratio (peroxisomal disorder marker, Zellweger spectrum)."
}
concept "P-C26:0" {
    comment "en" "Plasma C26:0 very long chain fatty acid."
}
concept "P-CAJON (AKOM)" {
    name "sv" "P-CAJON"
    comment "en" """
        P-CaJon (AKOM) = ionized calcium in plasma (AKOM = acute care context). ISE method as strict.
        Lab F test catalogue confirms CaJon = joniserat calcium.
        """
}
concept "P-CALCIUM" {
    name "sv" "P-Calcium"
    variant "S-CALCIUM" kind=raw
    comment "en" "Catalogued at: Lab B, Lab C, Lab D. S- prefix = serum."
}
concept "P-CEFOTAXIM" {
    comment "en" "Swedish: cefotaxime (antibiotic) concentration in plasma. Direct match."
}
concept "P-CHITOTRIOSIDAS" {
    comment "en" "P-Chitotriosidas = chitotriosidase in plasma  Gaucher disease marker."
}
concept "P-CRP" {
    name "sv" "P-CRP"
    variant "CRP(P)" kind=raw
    variant "P/S-CRP" kind=raw
    variant "S-CRP" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab B, Lab C, Lab D, Lab E, Lab F. Common ED test -
        C-reactive protein. Common ED test - CRP. Common ED test - CRP in plasma (Lab F notation).
        P/S-CRP. S- prefix = serum.
        """
}
concept "P-CRP (PNA)" {
    comment "en" "P- = plasma. CRP in serum/plasma is standard match."
}
concept "P-CRP, KÄNSLIG" {
    comment "en" "P- = plasma. känslig = sensitive."
}
concept "P-CRP, SNABBMETOD" {
    comment "en" "P-CRP snabbmetod = rapid CRP in plasma."
}
concept "P-CYSTATIN C" {
    name "sv" "P-Cystatin C"
    comment "en" """
        P- = plasma. 2026-04-23. P-prefix = plasma. Cystatin C kidney function marker in Serum or
        Plasma. Superior to creatinine for GFR estimation in elderly patients. P- prefix (plasma)
        clinically equivalent to S- prefix (serum) for this analyte. No Lab C equivalent mapped.
        """
}
