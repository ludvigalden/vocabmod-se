// Swedish hospital local laboratory test codes, codes S-U-S
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S-URAT" {
    comment "en" "S-Urat = serum uric acid/urate."
}
concept "S-URAT LAB G" {
    comment "en" "S- = serum. Urate = uric acid  Lab G = Lab C internal qualifier."
}
concept "S-UREA" {
    comment "en" "S-Urea = urea in serum  Standard clinical urea nitrogen test."
}
concept "S-UREA LAB G" {
    comment "en" "S-Urea from Lab G satellite lab. Standard urea nitrogen."
}
concept "S-VALPROAT" {
    comment "en" "S- = serum. valproat = valproate (valproic acid, antiepileptic drug monitoring)."
}
concept "S-VANCOMYCIN" {
    comment "en" "S-Vancomycin = serum vancomycin drug level."
}
concept "S-VEGF(A)" {
    comment "en" "S-=serum; VEGF(A)=vascular endothelial growth factor A."
}
concept "S-VENLAFAXIN" {
    comment "en" "S-Venlafaxin = serum venlafaxine drug level."
}
concept "S-VENLAFAXIN-N-DMET" {
    comment "en" "Venlafaxine + N-desmethylvenlafaxine (ODV) metabolite TDM in serum."
}
concept "S-ZINK" {
    comment "en" "S-=serum."
}
concept "S-ZIPRASIDON" {
    comment "en" "Ziprasidone TDM in serum."
}
concept "S-ZUKLOPENTIXOL" {
    comment "en" """
        S- = serum. zuklopentixol = zuclopenthixol (Swedish spelling of clopenthixol, antipsychotic
        TDM). Moles/volume as alt.
        """
}
concept "S-ÖSTRADIOL" {
    comment "en" """
        S-Östradiol = estradiol in serum  High-sensitivity method is appropriate for clinical estradiol.
        """
}
