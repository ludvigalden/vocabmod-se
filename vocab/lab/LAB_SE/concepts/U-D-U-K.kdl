// Swedish hospital local laboratory test codes, codes U-D-U-K
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "U-DEXTROPROP. SCREEN" {
    comment "en" """
        Dextropropoxyphene = propoxyphene active enantiomer. dextropropoxyphene-specific variant not in
        OMOP standard.
        """
}
concept "U-DEXTROPROPOXYF V" {
    comment "en" "U-Dextropropoxyf V = dextropropoxyphene (verified) in urine."
}
concept "U-DEXTROPROPOXYFEN" {
    comment "en" "U-Dextropropoxyfen = dextropropoxyphene in urine. Presence as strict (screening)."
}
concept "U-EPITEL" {
    comment "en" """
        U-Epitel = epithelial cells in urine sediment. microscopy count preferred over volume-based
        count.
        """
}
concept "U-ERYTROCYTER" {
    comment "en" "U- prefix = urine."
}
concept "U-ERYTROCYTER /BLOD (PNA)" {
    name "sv" "U-ERYTROCYTER /BLOD"
    comment "en" "U- = urine; erytrocyter = RBC."
}
concept "U-ERYTROCYTER/BLOD" {
    comment "en" "U- prefix = urine."
}
concept "U-ETANOL" {
    comment "en" "Swedish: ethanol concentration in urine."
}
concept "U-ETYLMORFIN" {
    comment "en" "U-Etylmorfin = ethylmorphine in urine. Straightforward drug monitoring."
}
concept "U-FENCYKLIDIN" {
    comment "en" "Phencyclidine (PCP) in urine."
}
concept "U-FENCYKLIDIN SCREEN" {
    comment "en" "PCP/drug screen."
}
concept "U-FENTIAZINDERIVAT" {
    comment "en" """
        Fentiazinderivat = phenothiazine derivative. Screen method matches typical toxicology workflow 
        Neither.
        """
}
concept "U-FOSFAT"
concept "U-FRITT KARNITIN" {
    comment "en" "U-Fritt karnitin = free carnitine in urine  metabolic screening."
}
concept "U-GHB" {
    comment "en" "U- = urine. GHB = gamma-hydroxybutyrate  exact specimen+analyte."
}
concept "U-GHB VERIF" {
    comment "en" "GHB urine confirmation test."
}
concept "U-GLUKOS" {
    comment "en" "Standard glucose in urine."
}
concept "U-GLUKOS (PNA)" {
    comment "en" "Glucose mass/volume in urine."
}
concept "U-GLYCEROL" {
    comment "en" "Urine glycerol."
}
concept "U-HCG GRAVTEST" {
    comment "en" "Swedish: hCG pregnancy test (gravtest) in urine. Direct qualitative match."
}
concept "U-HEMOGLOBIN" {
    comment "en" "U-Hemoglobin = urine hemoglobin. test strip method."
}
concept "U-HEMOGLOBIN TESTREMSA" {
    comment "en" "U-Hemoglobin testremsa = urine hemoglobin by test strip."
}
concept "U-HVA" {
    comment "en" """
        HVA = homovanillic acid (dopamine metabolite, neuroblastoma/catecholamine workup). Specimen type
        uncertain (24h vs random)  Neither.
        """
}
concept "U-HVA/KREATININ" {
    comment "en" """
        U-=urine; HVA=homovanillic acid (dopamine metabolite); ratio to creatinine normalizes
        concentration.
        """
}
concept "U-HYALINA CYLINDRAR" {
    comment "en" "Hyaline casts in urine sediment. Both Quantitative vs presence uncertain."
}
concept "U-HYDROXYPROLIN" {
    comment "en" "U-Hydroxyprolin = hydroxyproline in urine. Collagen turnover marker."
}
concept "U-HYDROXYPROLIN/KREA" {
    comment "en" "U-Hydroxyprolin/krea = urine hydroxyproline/creatinine ratio. Bone resorption marker."
}
concept "U-IG KAPPAKEDJOR" {
    comment "en" "U-=urine  Ig kappakedjor=immunoglobulin kappa light chains."
}
concept "U-IMMUNGLOBULIN G" {
    comment "en" "U- = urine. Method unspecified."
}
concept "U-IMMUNOGLOBULIN G" {
    comment "en" "U-Immunoglobulin G = IgG in urine. Straightforward proteinuria assessment."
}
concept "U-ISOPROPANOL" {
    comment "en" "U-Isopropanol = isopropanol in urine."
}
concept "U-KALIUM" {
    comment "en" "Urinary potassium."
}
concept "U-KAPPA" {
    comment "en" """
        U-Kappa = total kappa chains in urine. code does not specify free  both total 27365-6 and free
        38176-4 are.
        """
}
concept "U-KARNITIN, ACYL/KRE" {
    comment "en" """
        U- = urine. Acyl/Kre = acylcarnitine to free carnitine ratio (creatinine-corrected). Molar ratio
        preferred  Neither.
        """
}
concept "U-KARNITIN,TOTAL/KRE" {
    comment "en" """
        U-Karnitin,total/kre = total carnitine/creatinine ratio in urine. ratio and molar ratio variants
        exist  neither.
        """
}
concept "U-KATINON" {
    comment "en" "Katinon is Swedish colloquial/old term for catecholamines."
}
concept "U-KETOBEMIDON, VERIF" {
    comment "en" "U- = urine; Ketobemidon = ketobemidone (Swedish opioid); verif = verification/confirmatory."
}
concept "U-KHAT" {
    comment "en" "Khat contains cathinone."
}
concept "U-KLORID" {
    comment "en" "Chloride in urine."
}
concept "U-KODEIN" {
    comment "en" "U- = urine. kodein = codeine. Drug monitoring."
}
concept "U-KOKAIN" {
    comment "en" "U-=urine; kokain=cocaine."
}
concept "U-KOKAIN SCREEN" {
    comment "en" "U- = urine; Kokain = cocaine; Screen = screening method explicitly stated."
}
concept "U-KOKAINMETA. SCREEN" {
    comment "en" "Kokainmeta. screen = cocaine metabolite screen. Other metabolites best match."
}
concept "U-KOKAINMETA. VERIF" {
    comment "en" """
        Kokainmetabolit = cocaine metabolite (benzoylecgonine). verif = verification/confirmatory 
        Mass/vol is confirmatory qualifier more precise but.
        """
}
concept "U-KOKAINMETABOLITER" {
    comment "en" "U- = urine."
}
concept "U-KOKAINMETABOLITV" {
    comment "en" """
        U-KokainmetabolitV = urine cocaine metabolite verification/qualitative. V suffix = verification.
        """
}
concept "U-KORTISOL" {
    comment "en" "U-Kortisol = urine cortisol. 24h mass/time is standard."
}
concept "U-KORTISOL/KREATININ" {
    comment "en" """
        U-Kortisol/kreatinin = cortisol-to-creatinine ratio in urine  standard spot urine cortisol
        assessment.
        """
}
