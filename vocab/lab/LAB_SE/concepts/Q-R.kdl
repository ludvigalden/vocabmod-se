// Swedish hospital local laboratory test codes, codes Q-R
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "QFRAKT" {
    comment "en" "qFrakt = quantitative functional C1-esterase inhibitor in plasma."
}
concept "REF-TROMBINTID" {
    comment "en" "Swedish: reference thrombin time."
}
concept "RET(B)-MCH" {
    comment "en" """
        Ret(B)- = reticulocyte parameter in blood. MCH = mean corpuscular hemoglobin  automated count
        preferred over generic MCH (not.
        """
}
concept "RISP + 9-OH-RISP" {
    comment "en" """
        Risperidone + 9-OH-risperidone therapeutic drug monitoring panel. Specimen not specified in code
        but serum/plasma is standard.
        """
}
