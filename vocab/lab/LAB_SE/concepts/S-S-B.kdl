// Swedish hospital local laboratory test codes, codes S-S-B
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S- MMP-9 TOT"
concept "S-11-DEOXIKORTISOL"
concept "S-17A-HYDROXYPROGEST" {
    comment "en" "S- = serum."
}
concept "S-9-OH-RISPERIDON" {
    comment "en" "S-9-OH-Risperidon = 9-hydroxyrisperidone (active risperidone metabolite) in serum."
}
concept "S-ACE" {
    comment "en" "ACE activity in serum."
}
concept "S-ACETON" {
    comment "en" "S- = serum. Aceton = acetone."
}
concept "S-ACETYLKARNITIN" {
    comment "en" "Newborn screening / fatty acid oxidation disorder marker."
}
concept "S-ACYLKARNITINER" {
    comment "en" "S- = serum."
}
concept "S-ADIPONEC (STUDIER)" {
    name "sv" "S-ADIPONEC"
    comment "en" "Research-use analyte."
}
concept "S-ALAT LAB G" {
    name "sv" "S-ALAT"
    comment "en" "S-ALAT = alanine aminotransferase (ALT) in serum."
}
concept "S-ALB. LAB G" {
    name "sv" "S-ALB"
    comment "en" "S- = serum; Alb. = albumin. Lab G = site suffix."
}
concept "S-ALDOSTERON" {
    comment "en" "S- = serum. aldosteron = aldosterone."
}
concept "S-ALFA1-ANTITRYPSIN" {
    comment "en" "S-alfa1-Antitrypsin = serum alpha-1-antitrypsin."
}
concept "S-ALFA1-FETOPROTEIN" {
    comment "en" "S- = serum. alfa1-fetoprotein = AFP."
}
concept "S-ALFA2MAKROGLOBULIN" {
    comment "en" "S-alfa2Makroglobulin = serum alpha-2-macroglobulin."
}
concept "S-ALP" {
    name "sv" "S-ALP"
}
concept "S-ALP LAB G" {
    comment "en" "S- = serum. ALP = alkaline phosphatase. Lab G = hospital site suffix."
}
concept "S-ALP-ISOENZYMER" {
    comment "en" "S- = serum. ALP isoenzyme panel. panel code."
}
concept "S-ALUMINIUM" {
    comment "en" "S- = serum. aluminum level."
}
concept "S-AMH" {
    comment "en" "S-AMH = serum anti-Mullerian hormone."
}
concept "S-AMIKACIN" {
    comment "en" "Amikacin TDM in serum  generic timing match."
}
concept "S-AMITRIPTYLIN"
concept "S-AMYLAS TOTAL"
concept "S-AMYLAS,PANKREAS-" {
    name "sv" "S-Amylas,pankreas"
    comment "en" "pankreas- suffix = pancreatic amylase. Amylase.pancreatic in Serum or Plasma."
}
concept "S-ANDROSTENDION" {
    comment "en" "S- = serum. Androstendion = androstenedione."
}
concept "S-ANTI-GD1A IGG" {
    comment "en" """
        Anti-GD1a IgG antibody associated with Guillain-Barre syndrome. Titer vs units/volume uncertain 
        Neither.
        """
}
concept "S-ANTI-GD1A IGM" {
    comment "en" """
        S-=serum. anti-GD1a IgM=ganglioside GD1a IgM antibody  anti-ganglioside antibodies used in
        Guillain-Barre syndrome workup.
        """
}
concept "S-ANTI-GD1B IGG" {
    comment "en" """
        Anti-GD1b IgG = ganglioside antibody associated with Guillain-Barre syndrome. Exact
        analyte+isotype match to GD1b IgG Ab Titer in Serum.
        """
}
concept "S-ANTI-GD1B IGM" {
    comment "en" "Swedish: anti-GD1b IgM antibody in serum. Direct analyte+isotype+specimen match."
}
concept "S-ANTI-GM1 IGG" {
    comment "en" "S- = serum. Anti-GM1 IgG antibody (neurology, GBS/CIDP panel). Units/volume is standard."
}
concept "S-ANTI-GM1 IGM" {
    comment "en" "S- = serum; anti-GM1 IgM = ganglioside GM1 IgM antibody."
}
concept "S-ANTI-GM2 IGG" {
    comment "en" "Anti-GM2 IgG antibody  S-prefix = serum."
}
concept "S-ANTI-GM2 IGM" {
    comment "en" "Anti-GM2 IgM in serum."
}
concept "S-ANTI-GQ1B IGG" {
    comment "en" "S- = serum. anti-GQ1b IgG antibody titer (Miller Fisher syndrome)."
}
concept "S-ANTI-LK1 IGG" {
    comment "en" """
        LK1 likely = LKM1 (liver kidney microsomal type 1). Anti-LKM1 IgG is autoimmune hepatitis
        marker.
        """
}
concept "S-ANTI-LK1 IGM" {
    comment "en" "LKM-1 antibody."
}
concept "S-ANTI-SULFATID IGG"
concept "S-ANTI-SULFATID IGM" {
    comment "en" "Anti-sulfatide IgM in serum. Assessed for peripheral neuropathy."
}
concept "S-ANTI-TYREOGLOBULI" {
    comment "en" "S-anti-tyreoglobuli = thyroglobulin antibody in serum (thyroid cancer follow-up)."
}
concept "S-ANTI-TYREOGLOBULIN" {
    comment "en" "S-=serum  anti-thyreoglobulin=anti-thyroglobulin antibody."
}
concept "S-ANTI-TYROPEROXIDA" {
    comment "en" "IgG-specific TPO antibody  best available match."
}
concept "S-ANTI-TYROPEROXIDAS"
concept "S-APOA1 (WLAB)" {
    name "sv" "S-APOA1"
    comment "en" "S- = serum; ApoA1 = apolipoprotein A-I."
}
concept "S-APOB (WLAB)" {
    name "sv" "S-APOB"
    comment "en" "S- = serum. ApoB = apolipoprotein B. Both ApoB-100 is the major isoform."
}
concept "S-APOB/APOA1 (WLAB)" {
    name "sv" "S-APOB/APOA1"
    comment "en" "Neither ApoB/A1 ratio variant is."
}
concept "S-APOLIPOPROTEIN B" {
    comment "en" "S- = serum  ApoB-100 is the clinically measured form."
}
concept "S-APOLIPOPROTEINA1"
concept "S-ASAT LAB G" {
    name "sv" "S-ASAT"
    comment "en" "ASAT = AST. Lab G suffix = Lab G hospital lab tag, irrelevant to analyte."
}
concept "S-B12" {
    name "sv" "S-B12"
    comment "en" """
        Swedish labs typically report B12 in pmol/L. S- prefix = serum  Both. Vitamin - Cobalamin
        (Vitamin B12) in Serum.
        """
}
concept "S-B12 LAB G" {
    comment "en" """
        S-B12 = serum vitamin B12. Lab G is a hospital/location reference, not a method  Both
        moles/volume and mass/volume.
        """
}
concept "S-B2MIKROGLOB(NEPH)"
concept "S-BARBITURATER" {
    comment "en" "S- = serum. barbiturater = barbiturates. Drug screening/quantification."
}
concept "S-BENSODIAZEP KVAL" {
    comment "en" "Qualitative benzodiazepine screen in serum."
}
concept "S-BENSODIAZEP. KVAN" {
    comment "en" """
        S-=serum; bensodiazep. kvan=benzodiazepines quantitative screening  class-level measurement not
        drug-specific.
        """
}
concept "S-BETA2MIKROGLOBULIN" {
    comment "en" "S-Beta2mikroglobulin = beta-2-microglobulin in serum."
}
concept "S-BIL, KONJUGERAT" {
    comment "en" "S-Bil Konjugerat = conjugated (direct) bilirubin in serum."
}
concept "S-BUPRENORFIN" {
    comment "en" "S- = serum. buprenorfin = buprenorphine."
}
concept "S-BUTYRYLKARNITIN" {
    comment "en" """
        S-=serum. butyrylkarnitin=butyrylcarnitine (C4 acylcarnitine)  newborn screening and fatty acid
        oxidation disorder workup.
        """
}
