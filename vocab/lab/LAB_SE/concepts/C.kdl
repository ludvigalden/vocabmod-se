// Swedish hospital local laboratory test codes, codes C
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "C-REAKTIVT PROTEIN" {
    name "sv" "C-Reaktivt Protein"
    variant "CRP" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab C. Common ED test - C-reactive protein. Common ED
        test - CRP (full Swedish name).
        """
}
concept "C1-ESTERASINHIBITOR" {
    comment "en" """
        C1-Esterasinhibitor = C1 esterase inhibitor; Swedish notation ambiguous between mass and
        functional ratio.
        """
}
concept "C24:0/C22:0" {
    comment "en" """
        Swedish: C24:0/C22:0 ratio (tetracosanoate/docosanoate). Direct match to VLCFA panel ratio used
        in peroxisomal disorder screening.
        """
}
concept "C26:0/C22:0" {
    comment "en" """
        Very long chain fatty acid ratio (adrenoleukodystrophy/Zellweger screening). Molar ratio in
        serum/plasma.
        """
}
concept "CDKN2A (9P21)" {
    comment "en" """
        CDKN2A (9p21) = CDKN2A tumör suppressor gene deletion testing. Melanoma/pancreatic cancer
        predisposition.
        """
}
concept "CEBPA MUTATION" {
    comment "en" """
        CEBPA mutation = CCAAT/enhancer-binding protein alpha gene mutation analysis (AML diagnostic).
        nominal identifier as alt.
        """
}
concept "CELLER-FISH 3" {
    comment "en" "FISH on cells from blood/marrow  3-probe panel interpretation."
}
concept "CKMB (STRATUS)" {
    name "sv" "CKMB"
    comment "en" "CK-MB mass in serum/plasma."
}
concept "CLOT LYSIS ASSAY"
concept "CO3-STEN" {
    comment "en" """
        CO3-sten=carbonate content in gallstone/urinary stone analysis. panel-level match  uncertain
        specific analyte.
        """
}
concept "CRP LOKALT KAP/VEN" {
    comment "en" """
        CRP lokalt = local/POC CRP; kap/ven = capillary or venous blood. standard CRP (1988-0) not in DB
        hs-CRP.
        """
}
concept "CRP QUICREAD" {
    comment "en" "QuicRead = rapid POC CRP."
}
concept "CSV-5-HIAA, KORR" {
    comment "en" "Csv- = CSF. 5-HIAA corrected for CSF sampling artifact."
}
concept "CSV-ABSORBANS415" {
    comment "en" "CSF absorbance at 415nm detects bilirubin/xanthochromia."
}
concept "CSV-ACE" {
    comment "en" "Csv- = CSF."
}
concept "CSV-ACHE" {
    comment "en" "Acetylcholinesterase  CSF specimen mismatch but best available."
}
concept "CSV-ALBUMIN" {
    comment "en" "Csv-Albumin = albumin concentration in CSF."
}
concept "CSV-ANTI-GA1 IGG" {
    comment "en" "GA1 = asialo-GM1 ganglioside; Csv- = CSF."
}
concept "CSV-ANTI-GA1 IGM" {
    comment "en" "Csv- = CSF. anti-GA1 = anti-ganglioside GM1; IgM. Presence in CSF best match."
}
concept "CSV-ANTI-GD1A IGG"
concept "CSV-ANTI-GD1B IGG" {
    comment "en" "Csv- = CSF specimen. anti-GD1b IgG."
}
concept "CSV-ANTI-GD1B IGM" {
    comment "en" """
        Csv-=cerebrospinal fluid; anti-GD1b IgM=ganglioside GD1b IgM antibody; no CSF-specific GD1b IgM
        concept.
        """
}
concept "CSV-ANTI-GM1 IGG" {
    comment "en" "Csv- = CSF; Anti-GM1 IgG. best available is Serum variant."
}
concept "CSV-ANTI-GM1 IGM" {
    comment "en" "Swedish: anti-GM1 IgM antibody in CSF."
}
concept "CSV-ANTI-GM2 IGG" {
    comment "en" "Csv- = CSF. Anti-GM2 IgG antibody (neurology panel)."
}
concept "CSV-ANTI-GM2 IGM" {
    comment "en" "Csv- = CSF; anti-GM2 IgM."
}
concept "CSV-ANTI-GQ1B IGG" {
    comment "en" "Anti-GQ1b IgG in CSF  Miller-Fisher syndrome/Guillain-Barre workup."
}
concept "CSV-ANTI-GQ1B IGM" {
    comment "en" "Anti-GQ1b IgM in CSF."
}
concept "CSV-ANTISULFATID IGG" {
    comment "en" "Csv- = CSF; anti-sulfatide IgG. Specimen mismatch."
}
concept "CSV-B-AMYLOID 42/40 X10" {
    comment "en" """
        Csv-b-Amyloid 42/40 x10 = amyloid beta 42/40 ratio in CSF (x10 is a scaling factor, same
        analyte).
        """
}
concept "CSV-BETA-2-MIKROGLOB" {
    comment "en" "Csv = CSF."
}
concept "CSV-BETA-AMYLOID"
concept "CSV-BETA-AMYLOIDX-40"
concept "CSV-BETA-AMYLOIDX-42" {
    comment "en" "Csv-beta-Amyloidx-42 = amyloid beta x-42 peptide in CSF (Alzheimer biomarker)."
}
concept "CSV-BETA-ENDORFIN" {
    comment "en" "Csv-=CSF; beta-endorfin=beta-endorphin."
}
concept "CSV-CXCL13" {
    comment "en" "Csv-CXCL13 = CXCL13 (B-cell attracting chemokine) in CSF. Neuroinflammatory marker."
}
concept "CSV-ERYTROCYTER" {
    comment "en" "Csv-Erytrocyter = erythrocyte count in cerebrospinal fluid."
}
concept "CSV-FOSFO-TAU" {
    comment "en" "Csv-Fosfo-tau = phosphorylated tau (p-tau181) in CSF, key Alzheimer biomarker."
}
concept "CSV-GD1A" {
    comment "en" "Anti-GD1a in CSF. Titer in CSF is best match."
}
concept "CSV-GD1B" {
    comment "en" "Csv- = CSF. anti-GD1b IgG antibody in CSF. Rare neuroimmunology test."
}
concept "CSV-GD3" {
    comment "en" "Csv- = CSF. GD3 ganglioside antibody  paraneoplastic panel."
}
concept "CSV-GT1B"
concept "CSV-HMPG" {
    comment "en" "Csv-HMPG = 3-methoxy-4-hydroxyphenylglycol (MHPG) in CSF, a catecholamine metabolite."
}
concept "CSV-HVA"
concept "CSV-LAKTAT" {
    comment "en" "Csv = cerebrospinal fluid  lactate in CSF."
}
concept "CSV-LEUKOCYTER MONO" {
    comment "en" """
        Csv- = cerebrospinal fluid. Leukocyter Mono = monocyte differential  CSF monocytes by manual
        count exact but.
        """
}
concept "CSV-LEUKOCYTER POLY" {
    comment "en" "Csv = CSF; Poly = polymorphonuclear leukocytes = neutrophils. neutrophils is and preferred."
}
concept "CSV-LYMFOCYTER" {
    comment "en" "Csv- = cerebrospinal fluid. Manual count lymphocytes."
}
concept "CSV-MONOCYTER" {
    comment "en" "Csv- = cerebrospinal fluid. monocytes differential in CSF by manual count."
}
concept "CSV-NEUTROFILA" {
    comment "en" "Csv=cerebrospinal fluid  differential count."
}
concept "CSV-NFL" {
    comment "en" "Csv- = CSF. NFL = neurofilament light chain."
}
concept "CSV-NPY" {
    comment "en" "Csv- = CSF; NPY = neuropeptide Y."
}
concept "CSV-NSE" {
    comment "en" "Csv- = cerebrospinal fluid. NSE = neuron-specific enolase (tumör marker)."
}
concept "CSV-OREXIN-A" {
    comment "en" "Csv-Orexin-A = orexin-A (hypocretin-1) in CSF. Narcolepsy diagnostic."
}
concept "CSV-PYRUVAT" {
    comment "en" "Csv- = CSF. Pyruvat = pyruvate  exact specimen match."
}
concept "CSV-S-100" {
    comment "en" "S100 protein (S100B) in CSF. Csv- prefix = cerebrospinal fluid."
}
concept "CSV-S-100XXXXXXXXXXXXXXXXXXXXXXXXXX" {
    comment "en" "Csv- = CSF, S-100 = S100 calcium binding protein B. Code has trailing padding."
}
concept "CSV-TAU" {
    comment "en" "Csv- = cerebrospinal fluid  Tau protein in CSF for neurodegenerative workup."
}
concept "CSV-TAU-PROTEIN" {
    comment "en" "Csv-Tau-protein = CSF tau protein."
}
concept "CVB-PO2 (PNA)" {
    name "sv" "CVB-PO2"
    comment "en" "cvB = central venous blood  pO2 from venous blood gas."
}
concept "CVB-SYRGASMÄTT.(PNA)" {
    name "sv" "CVB-SYRGASMÄTT"
}
concept "CYP2D6-GENOTYP" {
    comment "en" "CYP2D6-genotyp = CYP2D6 pharmacogenetic genotype."
}
concept "CYSTINSTEN" {
    comment "en" "Cystinsten = cystine stone analysis. Stone composition assessment."
}
concept "CYTOGENETIK, BENMÄRG" {
    comment "en" "Cytogenetics = karyotype analysis. Bone marrow specimen."
}
concept "CYTOGENETIK, BLOD"
