// Swedish hospital local laboratory test codes, codes U-5-U-C
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "U-5-HIAA" {
    comment "en" """
        U- = urine; 5-HIAA for carcinoid. Units uncertain (Swedish labs may report mass or moles) 
        moles/volume is.
        """
}
concept "U-5-HIAA/KREATININ" {
    comment "en" "U-5-HIAA/kreatinin = 5-HIAA to creatinine ratio in urine. mass ratio."
}
concept "U-6-MONOACETYLMORFIN" {
    comment "en" "U-6-Monoacetylmorfin = heroin metabolite in urine."
}
concept "U-7AMINO-KLONAZEPAM" {
    comment "en" "U- = urine; 7amino-klonazepam = 7-aminoclonazepam (clonazepam metabolite). generic as alt."
}
concept "U-7AMINO-NITRAZEPAM" {
    comment "en" "U-prefix = urine  7-amino metabolite of nitrazepam (benzodiazepine)."
}
concept "U-A-HYDROXY-ALPRAZOL" {
    comment "en" """
        U-alpha-hydroxy-alprazol = alpha-hydroxyalprazolam (alprazolam metabolite) in urine 
        confirmatory method implied.
        """
}
concept "U-ACETOACETAT" {
    comment "en" "U-acetoacetat  quantitative mass/volume preferred over qualitative presence."
}
concept "U-ACETOACETAT (PNA)" {
    comment "en" "U- = urine. Mass/volume best match."
}
concept "U-ACETON" {
    comment "en" """
        U- = urine; aceton = acetone. Uncertain whether qualitative or quantitative  presence test is.
        """
}
concept "U-ACYLKARNITIN" {
    comment "en" "Acylcarnitine in urine  metabolic screening for fatty acid oxidation disorders."
}
concept "U-ADH" {
    comment "en" "U- = urine. ADH = antidiuretic hormone = vasopressin  mass/volume match."
}
concept "U-ADRENALIN" {
    comment "en" "U- prefix = urine; Adrenalin = epinephrine."
}
concept "U-ADRENALIN/KREAT." {
    name "sv" "U-ADRENALIN/KREAT"
    comment "en" """
        U-Adrenalin/kreat = epinephrine/creatinine ratio in urine. catecholamines is broader parent
        class.
        """
}
concept "U-ALB/KREA-KVOT MORG" {
    comment "en" "U-Alb/Krea-kvot morg = albumin/creatinine ratio in morning urine."
}
concept "U-ALBUMIN" {
    comment "en" "Standard random urine albumin."
}
concept "U-ALBUMIN (PNA)" {
    comment "en" "U-Albumin = urine albumin. PNA indicates POC. Microalbumin is clinical standard term."
}
concept "U-ALBUMIN/KREAT" {
    comment "en" "Standard ACR."
}
concept "U-ALBUMIN/KREATININ KVOT" {
    comment "en" "Albumin/creatinine ratio in urine (ACR)."
}
concept "U-ALBUMIN/MIN" {
    comment "en" """
        U-Albumin/min = albumin excretion rate per minute in urine. Best rate match is 24h mass/time.
        """
}
concept "U-ALBUMIN/U-KREATININ INDEX" {
    comment "en" "Urine albumin-to-creatinine ratio (ACR)."
}
concept "U-ALDOSTERON" {
    comment "en" "U-Aldosteron = urine aldosterone. 24h urine mass/time is standard clinical practice."
}
concept "U-ALDOSTERON/KREA" {
    comment "en" "Aldosteron/krea = aldosterone/creatinine ratio in urine. Spot urine ratio."
}
concept "U-ALFA1MIKRO(IMMAGE)" {
    comment "en" "U- = urine. alpha-1-microglobulin (Immage platform)."
}
concept "U-ALFA1MIKRO/KREAT" {
    comment "en" "U-alfa1Mikro/Kreat = urine alpha-1-microglobulin/creatinine ratio."
}
concept "U-AMFETAMIN" {
    comment "en" "U-Amfetamin = amphetamine drug screening in urine."
}
concept "U-AMFETAMINER" {
    comment "en" """
        U- = urine. amfetaminer = amphetamines  mass/volume preferred over screen presence variant
        (also.
        """
}
concept "U-AMFETAMINER SCREEN" {
    comment "en" "U-Amfetaminer screen = urine amphetamine screening."
}
concept "U-AMORFA SALTER" {
    comment "en" """
        U-Amorfa salter = amorphous salts/crystals in urine sediment. actual specimen may be general
        amorphous.
        """
}
concept "U-AMYLAS" {
    comment "en" "U- = urine. amylas = amylase."
}
concept "U-BARBITURAT. SCREEN"
concept "U-BARBITURATER" {
    comment "en" "U-Barbiturater."
}
concept "U-BENSODIAZEP./KREA" {
    comment "en" "Benzodiazepine/creatinine ratio in urine  creatinine-corrected drug screening."
}
concept "U-BENSODIAZEP.SCREEN" {
    comment "en" "U-Bensodiazep.screen = urine benzodiazepine screening. screen method match."
}
concept "U-BENSODIAZEPIN./KR" {
    comment "en" "U- = urine."
}
concept "U-BENSODIAZEPINER" {
    comment "en" "Benzodiazepines screening in urine. Presence vs quantitative uncertain  Both."
}
concept "U-BENSODIAZEPINER V" {
    comment "en" "U- = urine; V = verification/confirmatory."
}
concept "U-BETA-2-MIKROGLOB" {
    comment "en" "U-beta-2-Mikroglob = beta-2-microglobulin in urine."
}
concept "U-BILIRUBIN" {
    comment "en" "U-Bilirubin = urine bilirubin."
}
concept "U-BLY" {
    comment "en" "U-Bly = lead (bly) in urine."
}
concept "U-BUPRENORFIN" {
    comment "en" "U-Buprenorfin."
}
concept "U-CALCIUM" {
    comment "en" "U-Calcium = urine calcium."
}
concept "U-CANNABINOIDER" {
    comment "en" "U- = urine; Cannabinoider = cannabinoids; generic term likely screen."
}
concept "U-CANNABINOIDER V" {
    comment "en" "U-=urine; cannabinoider V=cannabinoids screening; V likely means verification/screening."
}
concept "U-CANNABINOIDER/KRE" {
    comment "en" "U- = urine. Cannabinoider/Kre = cannabinoids/creatinine ratio."
}
concept "U-CANNABIS" {
    comment "en" "Cannabis screening in urine."
}
concept "U-CANNABIS SCREEN"
concept "U-CANNABIS VERIF." {
    name "sv" "U-CANNABIS VERIF"
    comment "en" "U- = urine. Cannabis; Verif; = verification/confirmatory method explicitly stated."
}
concept "U-CANNABIS/KREA" {
    comment "en" """
        Swedish: cannabis screen with creatinine correction in urine. using cannabinoids screen as best
        available.
        """
}
concept "U-CD" {
    comment "en" "U-Cd = urine cadmium (heavy metal). Uncertain whether 24h or spot."
}
concept "U-CD/KREATININ" {
    comment "en" "Cadmium/creatinine ratio for occupational exposure monitoring."
}
concept "U-CENTRALSTIM. AMFETAMINER" {
    comment "en" "U-Centralstim. amfetaminer = central stimulant amphetamines screening in urine. screen."
}
concept "U-CENTRALSTIMUL.V" {
    comment "en" """
        U-=urine; centralstimul.V=central stimulant screening/verification; umbrella term for
        amphetamines cocaine etc.
        """
}
concept "U-CENTRALSTIMULANTIA" {
    comment "en" "Central stimulants = broad stimulant drug screen."
}
concept "U-CG KVAL." {
    name "sv" "U-CG KVAL"
    comment "en" "U-CG kval; = urine chorionic gonadotropin qualitative (pregnancy test)."
}
concept "U-CU" {
    comment "en" "Copper in urine for Wilson disease monitoring."
}
