// Swedish hospital local laboratory test codes, codes S-H-S-K
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S-HALOPERIDOL" {
    comment "en" "S-Haloperidol = haloperidol therapeutic drug monitoring in serum."
}
concept "S-HAPTOGLOBIN" {
    comment "en" "S- prefix = serum."
}
concept "S-HCG" {
    comment "en" "Serum hCG (total choriogonadotropin)."
}
concept "S-HDL-KOL (WLAB)" {
    name "sv" "S-HDL-KOL"
    comment "en" "S-HDL-Kol = HDL cholesterol in serum  WLAB is lab source, not method qualifier."
}
concept "S-HDL-KOL. LAB G" {
    comment "en" """
        S-HDL-Kol. Lab G = HDL cholesterol in serum. Lab G is a historical Lab C lab
        method reference.
        """
}
concept "S-HDL-KOLESTEROL" {
    name "sv" "S-HDL-Kolesterol"
    comment "en" """
        S- prefix = serum; HDL cholesterol measurement, routine. S-prefix = serum. Lipid panel - HDL
        cholesterol in Serum.
        """
}
concept "S-HEPCIDIN (STUDIER)" {
    name "sv" "S-HEPCIDIN"
    comment "en" "Hepcidin (iron regulator)  studied/research use."
}
concept "S-HEXANOYLKARNITIN" {
    comment "en" "Swedish: hexanoylcarnitine (C6 acylcarnitine) in serum. Direct match."
}
concept "S-HOLOTRANSKOBALAMIN"
concept "S-IGD"
concept "S-IGE" {
    comment "en" "S- = serum. total IgE."
}
concept "S-IGF-1 (ADVANTAGE)" {
    comment "en" "S- = serum. IGF-1 by Advantage platform. Method suffix ignored."
}
concept "S-IGF-1 (IMMULITE)" {
    comment "en" """
        S- = serum. IGF-1 = insulin-like growth factor 1 (somatomedin C). somatomedins is a broader
        term.
        """
}
concept "S-IGFBP-1"
concept "S-IGFBP-3" {
    comment "en" "S-IGFBP-3 = IGF binding protein 3 in serum."
}
concept "S-IGM" {
    comment "en" "S- prefix = serum  IgM mass/volume in Serum or Plasma."
}
concept "S-IMATINIB" {
    comment "en" "S-Imatinib = imatinib (tyrosine kinase inhibitor) TDM in serum."
}
concept "S-IMIPRAMIN" {
    comment "en" "S- = serum. imipramin = imipramine (TCA antidepressant TDM)."
}
concept "S-INHIBIN-B" {
    comment "en" "S- = serum; inhibin-B = inhibin B (reproductive hormone)."
}
concept "S-INSULIN" {
    comment "en" "S-Insulin = insulin in serum  Direct match."
}
concept "S-IOHEXOL-JOD" {
    comment "en" """
        S-Iohexol-Jod = serum iohexol iodine (GFR marker). Iohexol in serum/plasma is the direct
        measurement. renal clearance is derived  Neither.
        """
}
concept "S-ISOPROPANOL" {
    comment "en" "Toxicology screening. S-prefix = serum  moles/vol match."
}
concept "S-ISOVALERYLKARNITIN" {
    comment "en" "S- = serum. Acylcarnitine, metabolic screening."
}
concept "S-JÄRN" {
    name "sv" "S-Järn"
    comment "en" "S- = serum. Iron studies - Iron in Serum. Specimen type: serum based on S- prefix."
}
concept "S-JÄRN LAB G" {
    comment "en" "S- = serum. Järn = iron. Lab G = Lab G lab."
}
concept "S-KALCITONIN" {
    comment "en" "S- = serum."
}
concept "S-KALIUM LAB G" {
    name "sv" "S-KALIUM"
    comment "en" "Same analyte as S-KALIUM  Lab G hospital variant."
}
concept "S-KAPPA/LAMBDA-KVOT" {
    comment "en" "S- = serum  kappa/lambda free light chain ratio."
}
concept "S-KARNITIN" {
    comment "en" "S- = serum. Karnitin = carnitine."
}
concept "S-KARNITIN, ACYL" {
    comment "en" """
        S- = serum. karnitin acyl = acylcarnitine. Carnitine esters and acylcarnitine are near-synonyms 
        Carnitine esters is.
        """
}
concept "S-KARNITIN, FRITT" {
    comment "en" "S-Karnitin, fritt = free carnitine (C0) in serum."
}
concept "S-KARNITIN, TOTAL" {
    comment "en" "Total carnitine."
}
concept "S-KLOMIPRAMIN" {
    comment "en" "S-Klomipramin = serum clomipramine level. TCA class-level is closest."
}
concept "S-KLORID" {
    comment "en" "S- = serum. Klorid = chloride."
}
concept "S-KOL. LAB G" {
    name "sv" "S-KOL"
    comment "en" """
        S-Kol = serum chloride (klorid abbreviated as Kol). Lab G = Lab G hospital lab.
        """
}
concept "S-KOLESTEROL" {
    name "sv" "S-Kolesterol"
    comment "en" "S-Kolesterol = total cholesterol in serum. Lipid panel - Cholesterol in Serum."
}
concept "S-KOLESTEROL (WLAB)" {
    comment "en" "S- = serum. Kolesterol = cholesterol  WLAB = internal lab qualifier."
}
concept "S-KOLINESTERAS" {
    comment "en" "Cholinesterase (butyrylcholinesterase/pseudocholinesterase) activity in serum."
}
concept "S-KOLINESTERAS (STUDIE)" {
    comment "en" "Cholinesterase study. S- prefix = serum. (studie) indicates research use."
}
concept "S-KOMPLEMENTFAKTOR 3" {
    comment "en" "S- = serum."
}
concept "S-KOMPLEMENTFAKTOR 4"
concept "S-KOPPAR" {
    comment "en" "S-Koppar = copper in serum (Wilson disease workup)."
}
concept "S-KORTISOL" {
    comment "en" "S- = serum. kortisol = cortisol."
}
concept "S-KORTISOL (RIA)"
concept "S-KORTISOL DEXAMET." {
    name "sv" "S-KORTISOL DEXAMET"
    comment "en" """
        S-Kortisol Dexamet. = cortisol after dexamethasone suppression test. Standard overnight 1 mg
        dexamethasone suppression. Exact timing match for standard protocol.
        """
}
concept "S-KOTININ" {
    comment "en" "S- = serum. kotinin = cotinine (nicotine metabolite)."
}
concept "S-KREA LAB G" {
    name "sv" "S-KREA"
    comment "en" "Creatinine in serum from Lab G lab (Lab C site-specific suffix). standard code."
}
concept "S-KREAT(LAB-INTERN)" {
    name "sv" "S-KREAT"
}
concept "S-KREATININ (ENZYM)" {
    comment "en" "S- = serum, Kreatinin = creatinine, (enzym) = enzymatic method."
}
concept "S-KREATININ, ENZYMATISK"
concept "S-KREATININ, ENZYMATISKT" {
    comment "en" "S-=serum; creatinine measured by enzymatic method."
}
concept "S-KROMOGRANIN A" {
    comment "en" "Neuroendocrine tumör marker  S-prefix = serum."
}
concept "S-KRYOGLOBULIN" {
    comment "en" "Cryoglobulin screening. Generic serum/plasma is best match."
}
