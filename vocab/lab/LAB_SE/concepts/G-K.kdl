// Swedish hospital local laboratory test codes, codes G-K
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "GALAKTOSYLCERAMIDAS" {
    comment "en" """
        Galaktosylceramidas = galactosylceramidase (GALC enzyme). Specimen not specified. leukocytes is
        standard for Krabbe disease screening.
        """
}
concept "GALC GENOTYP"
concept "GCS MOTORISKT" {
    comment "en" "GCS motor subscale."
}
concept "GCS VERBALT" {
    comment "en" "GCS verbal component. Clinical observation."
}
concept "GCS ÖGONÖPPNING" {
    comment "en" "Glasgow Coma Scale eye opening component."
}
concept "GLUKOS" {
    name "sv" "Glukos"
    comment "en" "Common ED test - glucose."
}
concept "GLUKOSYLCERAMIDAS" {
    comment "en" "Specimen not specified; serum/plasma as default clinical specimen."
}
concept "GRAVIDITETSVECKA" {
    comment "en" "Graviditetsvecka = gestational age (pregnancy week). Generic estimated GA."
}
concept "HB LOKALT-KAP" {
    comment "en" "Hb lokalt-kap = hemoglobin measured locally from capillary sample."
}
concept "HB LOKALT-VEN" {
    comment "en" "Hb lokalt-ven = hemoglobin local-venous."
}
concept "HBB GENOTYP"
concept "HEMATST.LAB G"
concept "HEMOGLOBIN" {
    name "sv" "Hemoglobin"
    variant "HB" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab C. Common ED test - hemoglobin (abbreviated form).
        Common ED test - hemoglobin.
        """
}
concept "HEP-P-BIOB SCAPIS" {
    comment "en" """
        Hep-P-BioB SCAPIS = Hepatitis B surface Ag in plasma for SCAPIS biobank. Likely a biobank
        storage order.
        """
}
concept "HEP-TEM" {
    comment "en" "HEPTEM = ROTEM channel with heparinase."
}
concept "HFE GENOTYP" {
    comment "en" """
        HFE genotyp = hereditary hemochromatosis genotype (C282Y, H63D). 'mutations found' preferred.
        """
}
concept "HFE-GENOTYP"
concept "HYPOKROM ERYTROCYT" {
    comment "en" "Hypochrom erytrocyt = hypochromic erythrocytes (%)."
}
concept "IGG PRODUKTIONSTAL" {
    comment "en" "IgG Produktionstal = IgG synthesis rate (CSF/Serum). mass/time rate."
}
concept "IGH-CCND1" {
    comment "en" "IGH-CCND1 = IGH-CCND1 translocation (t(11. 14))  molecular genetics presence test."
}
concept "IHX CLEARANCE OKORR." {
    name "sv" "IHX CLEARANCE OKORR"
    comment "en" "Iohexol (contrast agent) GFR clearance. okorr=corrected."
}
concept "IN-TEM" {
    comment "en" "Intrinsic TEM (ROTEM thromboelastometry)."
}
concept "INTERLEUKIN-6 (STUDIE)" {
    name "sv" "INTERLEUKIN-6"
    comment "en" "IL-6 cytokine  (studie)=research study context."
}
concept "INTERLEUKIN6" {
    comment "en" "No specimen prefix; IL-6 commonly measured in serum/plasma."
}
concept "IOHEXOL FLERPUNKT"
concept "JAK2 EXON12 MUTATION" {
    comment "en" "Molecular genetics test for JAK2 exon 12 mutations (myeloproliferative neoplasm workup)."
}
concept "JAK2 V617F MUTATION" {
    comment "en" "JAK2 V617F = JAK2 gene p.Val617Phe mutation  exact molecular genetics match."
}
concept "JAK2-GENOTYP" {
    comment "en" "JAK2 genotype. Swedish JAK2 testing typically covers V617F and exon 12."
}
concept "JAK2-MUTATIONSANALYS"
concept "KALIUM" {
    name "sv" "Kalium"
    variant "K" kind=abbrev
    comment "en" "Catalogued at: Lab A, Lab C. Common ED test - potassium."
}
concept "KB-AKT.BIKARB.(PNA)" {
    name "sv" "KB-AKT.BIKARB"
    comment "en" """
        kB- = capillary blood; Akt.bikarb; = actual bicarbonate. /PNA = POC  blood specimen covers
        capillary.
        """
}
concept "KB-AKT.BIKARBONAT" {
    comment "en" "kB-Akt.bikarbonat = actual bicarbonate in venous blood gas  General Blood covers venous."
}
concept "KB-BASÖVERSKOTT(PNA)" {
    comment "en" "kB-Basöverskott=base excess in capillary blood (PNA)."
}
concept "KB-BASÖVERSKOTT/ECV" {
    comment "en" "Base excess capillary blood (kB)."
}
concept "KB-COHB (PNA)" {
    name "sv" "KB-COHB"
    comment "en" "COHb/Hb ratio is the standard clinical measure."
}
concept "KB-CRP" {
    comment "en" "kB-CRP = capillary blood CRP."
}
concept "KB-EVF, BERÄKN (PNA)" {
    name "sv" "KB-EVF, BERÄKN"
    comment "en" "kB = capillary blood; EVF = hematocrit. beräkn = calculated. PNA = point-of-care."
}
concept "KB-GLUKOS" {
    comment "en" "kB = kapillar blod."
}
concept "KB-GLUKOS (0 MIN)" {
    comment "en" "kB-Glukos (0 min) = capillary blood glucose at time 0 (baseline OGTT)  kB- = kapillart blod."
}
concept "KB-GLUKOS (120 MIN)" {
    comment "en" """
        kB = kapillart blod (capillary blood); OGTT 120-min glucose. Best match is 2h post-dose S/P
        glucose.
        """
}
concept "KB-GLUKOS (150MIN)" {
    comment "en" "kB- = capillary blood; 150min = OGTT timepoint. generic capillary glucose best match."
}
concept "KB-GLUKOS (15MIN)" {
    comment "en" "kB-Glukos (15min) = capillary blood glucose by test strip (15-min post-meal)."
}
concept "KB-GLUKOS (180MIN)" {
    comment "en" """
        kB-Glukos (180min) = capillary glucose at 180 min (OGTT timepoint). using baseline capillary
        glucose as surrogate.
        """
}
concept "KB-GLUKOS (30MIN)" {
    comment "en" "kB-Glukos (30min) = capillary blood glucose at 30 min OGTT  same analyte/specimen as 0 min."
}
concept "KB-GLUKOS (45MIN)" {
    comment "en" "kB- = kapillärblod = capillary blood. 45min = OGTT timepoint. HemoCue is a glucometer  Both."
}
concept "KB-GLUKOS (60MIN)" {
    comment "en" "kB = kapillärblod = capillary blood."
}
concept "KB-GLUKOS (90MIN)" {
    comment "en" "Capillary blood glucose at 90 minutes (oral glucose tolerance test)."
}
concept "KB-GLUKOS (PNA)" {
    comment "en" """
        kB- = capillary blood (Swedish). /PNA = POC. Capillary blood glucose is the most specific match.
        kB- prefix indicates capillary blood specimen. Same glucose measurement. kB- prefix indicates
        capillary blood specimen.
        """
}
concept "KB-HB" {
    comment "en" "kB- = capillary blood. Hb = hemoglobin."
}
concept "KB-HBA1C" {
    comment "en" "HbA1c capillary blood (kB prefix). HbA1c/Hb.total by HPLC as strict."
}
concept "KB-HBA1C (FILTER)" {
    comment "en" "kB-HbA1c (filter) = capillary HbA1c by filter paper."
}
concept "KB-HEMOGLOBIN" {
    comment "en" "kB = kapillar blod (capillary blood)."
}
concept "KB-HEMOGLOBIN (PNA)" {
    comment "en" """
        kB = kapillärblod = capillary blood. PNA = POC  Hemoglobin in blood. kB- prefix indicates
        capillary blood specimen. Same hemoglobin measurement. kB- prefix indicates capillary blood
        specimen.
        """
}
concept "KB-LAKTAT" {
    comment "en" "Capillary blood lactate (kB- prefix)."
}
concept "KB-LPK" {
    comment "en" "kB-LPK = kapillarblod leukocyter (WBC from capillary blood). Same analyte as venous WBC."
}
concept "KB-METHB (PNA)" {
    name "sv" "KB-METHB"
    comment "en" "kB = capillary blood gas POC  MetHb fraction."
}
concept "KB-PCO2" {
    comment "en" "kB = capillary blood gas. pCO2 measurement. Adjusted-to-actual-temp is and preferred."
}
concept "KB-PCO2(PNA)" {
    comment "en" "kB- = capillary blood. pCO2. POC. Blood match is appropriate for capillary blood gas."
}
concept "KB-PH" {
    comment "en" "kB = kapillart blod (capillary blood)."
}
concept "KB-PK"
concept "KB-PK (INR)" {
    comment "en" "kB- = capillary blood. PK(INR) = INR from capillary blood."
}
concept "KB-PO2 (PNA)" {
    name "sv" "KB-PO2"
    comment "en" """
        kB- = capillary blood. pO2 = oxygen partial pressure. Temp-adjusted is unadjusted is not. Both
        valid.
        """
}
concept "KB-PYRUVAT" {
    comment "en" "kB-Pyruvat = capillary blood pyruvate."
}
concept "KB-SR, MIKRO" {
    comment "en" """
        kB- = capillary blood; SR = ESR. mikro = microsed  Westergren is most common method in Sweden.
        """
}
concept "KB-ST.BIKARBONAT"
concept "KB-SYRGASMÄTTN.(PNA)" {
    name "sv" "KB-SYRGASMÄTTN"
    comment "en" "kB- = capillary blood. Syrgasmättn = O2 sat."
}
concept "KB-SYRGASMÄTTNAD" {
    comment "en" """
        kB- = capillary blood; syrgasmattning = oxygen saturation. calculated from pO2 rather than pulse
        oximetry.
        """
}
concept "KB-THB"
concept "KB-THB (PNA)" {
    comment "en" "kB-=capillary blood."
}
concept "KIT MUTATION" {
    comment "en" "KIT gene mutation analysis (GIST/mastocytosis)."
}
concept "KLOMIPRAMIN+DESMETYL"
concept "KOPPAR, FRITT" {
    comment "en" "Koppar, fritt = free copper in serum. Dual-mapped."
}
concept "KP-GLUKOS (0 MIN)" {
    comment "en" "kP=capillary plasma. (0 min)=fasting/glucose tolerance baseline  Glucometer method."
}
concept "KP-GLUKOS (120 MIN)" {
    comment "en" "kP-Glukos 120 min = capillary plasma glucose at 120 min OGTT."
}
concept "KP-GLUKOS (15MIN)" {
    comment "en" "kP- = capillary plasma. 15min = time point."
}
concept "KP-GLUKOS (30MIN)" {
    comment "en" "kP = kapillart plasma (capillary plasma); 30min time point."
}
concept "KP-GLUKOS (45MIN)" {
    comment "en" """
        kP-Glukos (45min) = capillary POC glucose at 45min during OGTT. General Blood Glucose covers
        capillary.
        """
}
concept "KP-GLUKOS (60MIN)" {
    comment "en" "Capillary plasma glucose 60min post challenge  generic 1h code."
}
concept "KP-GLUKOS (HEMOCUE)" {
    name "sv" "KP-GLUKOS"
    comment "en" "kP-Glukos (HemoCue) = capillary point-of-care glucose by HemoCue photometer."
}
concept "KREATININ" {
    name "sv" "Kreatinin"
    variant "KREA" kind=abbrev
    comment "en" """
        Catalogued at: Lab A, Lab C. Common ED test - creatinine (abbreviated). Common
        ED test - creatinine.
        """
}
concept "KREATININCLEARENCE" {
    comment "en" """
        Kreatininclearence = creatinine clearance (Swedish spelling). Standard 24h urine + serum/plasma
        clearance match.
        """
}
concept "KROPPSTEMP" {
    comment "en" "Kroppstemp = body temperature."
}
concept "KROPPSTEMP (PNA)" {
    comment "en" "PNA suffix = POC device  body temperature."
}
concept "KROPPSTEMPERATUR" {
    name "sv" "Kroppstemperatur"
    variant "TEMPERATUR" kind=raw
    comment "en" "Catalogued at: Lab A, Lab F. Vital sign. Temperatur = body temperature."
}
