// Swedish hospital local laboratory test codes, codes U
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "U 6-MAM" {
    comment "en" """
        6-MAM = heroin metabolite. is Presence. quantitative is Toxicology screening often reports
        presence.
        """
}
concept "U OXIKODON" {
    comment "en" "Oxycodone urine drug test. Presence vs screen method uncertain  Both."
}
