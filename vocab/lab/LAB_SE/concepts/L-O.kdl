// Swedish hospital local laboratory test codes, codes L-O
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "LAKTAS GENOTYP" {
    comment "en" """
        Laktas genotyp = lactase genotype (LCT gene C-13910T). 'Mutations found' vs 'mutations tested
        for' dual-mapped.
        """
}
concept "LAKTAS-GENOTYP" {
    comment "en" "Lactase persistence genotype (LCT -13910C>T). not specific to -13910 SNP  No hit."
}
concept "LCHAD GENOTYP" {
    comment "en" """
        LCHAD = long-chain 3-hydroxyacyl-CoA dehydrogenase. HADHA gene. The c.1528G>C is the common
        pathogenic variant.
        """
}
concept "LDL/HDL"
concept "LED-LPK, MONO" {
    comment "en" "Led- = joint (synovial), LPK = leukocytes, mono = mononuclear cells."
}
concept "LED-LPK, POLY"
concept "LEDV-ERYTROCYTER" {
    comment "en" "Ledv = Ledvatska (synovial fluid). Erythrocytes in synovial fluid."
}
concept "LEDV-GLUKOS" {
    comment "en" "Ledv = ledvatska = synovial/joint fluid."
}
concept "LEDV-LAKTAT" {
    comment "en" "Ledv = ledvätska = synovial/joint fluid."
}
concept "LEDV-LEUKOCYTER" {
    comment "en" "Ledv- = ledvätska = synovial fluid. Total leukocyte count in synovial fluid."
}
concept "LEDV-NEUTROFILA" {
    comment "en" "Ledv- = body fluid (ledningsvatska). neutrophila = neutrophil differential  ratio preferred."
}
concept "LEDV-PROTEIN" {
    comment "en" "Ledv-Protein = protein in synovial fluid (Ledvatten = joint fluid)."
}
concept "LEDV-PYROFOSFATKRIST" {
    comment "en" "Ledv = ledvätska = synovial fluid  pyrophosphate crystals for CPPD/pseudogout."
}
concept "LEDV-URATKRISTALLER"
concept "LEDVÄTSKA-PROTEIN" {
    comment "en" "Ledvätska=synovial/joint fluid  total protein."
}
concept "LEUKAFERES CD34" {
    comment "en" "Leukapheresis CD34 stem cell count  specimen is blood during apheresis."
}
concept "LEUKOCYTER" {
    name "sv" "Leukocyter"
    variant "LPK" kind=raw
    comment "en" """
        Catalogued at: Lab A, Lab C. Common ED test - leukocyte particle count
        (Swedish abbreviation). Common ED test - leukocytes.
        """
}
concept "LKC-ALP" {
    comment "en" """
        LKC = cytology cell count in body fluid; ALP = alkaline phosphatase staining. Best available
        match is serum/plasma ALP.
        """
}
concept "LKC-KOMBESTERASER (D" {
    comment "en" "Lkc = erythrocyte. kombesteraser = combined esterases (cholinesterases) in red blood cells."
}
concept "LÄNGD" {
    comment "en" "Swedish Längd = body height."
}
concept "LÖSLIGT FIBRIN" {
    comment "en" "Losligt fibrin = soluble fibrin; no soluble fibrin exists."
}
concept "M-KARNITIN/TORRVIKT" {
    comment "en" "M- = muscle tissue."
}
concept "MDM2 (12Q15) FISH" {
    comment "en" """
        MDM2 amplification at 12q15 by fluorescence in situ hybridization. Cytogenetic test, not a
        standard lab analyte.
        """
}
concept "MEDVETANDEGRAD ENL RETTS" {
    name "sv" "Medvetandegrad enl Retts"
    comment "en" """
        RETTS medvetandegrad is a consciousness level scale. RETTS consciousness level assessment. This
        is intentional: consciousness grading is clinician assessment, not laboratory instrument
        measurement. RETTS uses simplified consciousness scale (Alert/Confused/Somnolent/Unconscious),
        distinct from GCS. Domain exception documented in SOURCE_TO_CONCEPT_MAP_SWEDISH_EXT.csv
        review_notes. Specimen type: N/A (clinical observation).
        """
}
concept "MEDVETANDEGRAD, NEWS" {
    comment "en" "Medvetandegrad = consciousness level."
}
concept "MONOAMINOXIDAS B"
concept "MPL MUTATIONSANALYS" {
    comment "en" "MPL mutation analysis for myeloproliferative neoplasms  sequencing-based."
}
concept "MPL W515 MUTATION" {
    comment "en" "MPL W515 mutation for myeloproliferative neoplasms. combined W515 variant preferred."
}
concept "MPS-MÖNSTER" {
    comment "en" "MPS-mönster = mucopolysaccharidosis pattern screening. GAG pattern interpretation in urine."
}
concept "MPV" {
    comment "en" "MPV = mean platelet volume."
}
concept "MT-Q10" {
    comment "en" "Mt-Q10 = muscle coenzyme Q10 (mitochondrial function). but specimen mismatch."
}
concept "MT-Q10/PROTEIN" {
    comment "en" """
        Mt-=muscle tissue; Q10/protein=CoQ10/protein ratio in muscle; serum/plasma CoQ10 as proxy.
        specimen mismatch  but wrong specimen.
        """
}
concept "MULTIPLATE"
concept "MUSKEL-CPT II"
concept "MVB-GLUKOS (PNA)" {
    name "sv" "MVB-GLUKOS"
    comment "en" """
        mvB-Glukos = mixed venous blood glucose from POC. mvB- prefix indicates mixed venous blood
        specimen. mvB- prefix indicates mixed venous blood specimen. Same glucose measurement.
        """
}
concept "NATRIUM" {
    name "sv" "Natrium"
    variant "NA" kind=abbrev
    comment "en" "Catalogued at: Lab A, Lab C. Common ED test - sodium."
}
concept "NONHDLAPOB"
concept "NPM1 MUTATION" {
    comment "en" "NPM1 mutation = NPM1 gene mutation analysis for AML."
}
concept "NPM1/ABL1"
concept "OSMOTISK RESISTENS" {
    comment "en" "Osmotisk resistens = osmotic resistance/fragility of RBCs."
}
concept "OXYGENTILLFORSEL PNA" {
    comment "en" """
        Inhaled oxygen concentration (FiO2). Inhaled oxygen concentration (FiO2). Specimen type: N/A
        (inspired gas).
        """
}
concept "OXYGENTILLFÖRSEL PNA" {
    comment "en" "Oxygentillförsel = oxygen delivery/supply at PNA (POC blood gas)."
}
