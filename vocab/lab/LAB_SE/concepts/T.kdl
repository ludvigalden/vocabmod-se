// Swedish hospital local laboratory test codes, codes T
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "TAU GENOTYP"
concept "TBC-AGGREGATION"
concept "TILLVÄXTHORMON (GH)" {
    comment "en" "Tillväxthormon (GH) = growth hormone/somatotropin."
}
concept "TNT" {
    name "sv" "TnT"
    comment "en" "Common ED test - troponin T."
}
concept "TOT. ANTAL KOLONIER" {
    comment "en" """
        Total colony count. Specimen not specified. urine is most common. Could be any specimen. for
        urine variant.
        """
}
concept "TP53 (17P13.1)" {
    comment "en" "TP53 tumör suppressor gene mutation testing. 17p13.1 = chromosomal locus."
}
concept "TP53 MUTATION" {
    comment "en" "TP53 mutation analysis. Mutations found (nominal) vs full analysis (broader)  Neither."
}
concept "TPMT GENOTYP"
concept "TPO-ANTIKROPPAR" {
    comment "en" """
        TPO-antikroppar = TPO antibodies. same analyte as S-anti-Tyroperoxidas  no S- prefix but implied
        serum from lab context.
        """
}
concept "TRC-ADP(MULTIPLATE)" {
    name "sv" "TRC-ADP"
}
concept "TRC-ASPI(MULTIPLATE)" {
    name "sv" "TRC-ASPI"
    comment "en" """
        Multiplate ASPI = arachidonic acid-induced impedance aggregometry. Different method (impedance
        vs LTA).
        """
}
concept "TRC-COL(MULTIPLATE)" {
    name "sv" "TRC-COL"
    comment "en" "Platelet aggregation collagen by Multiplate impedance aggregometry."
}
concept "TRC-RIST(MULTIPLATE)" {
    name "sv" "TRC-RIST"
    comment "en" """
        Trc-RIST(Multiplate) = platelet aggregation with ristocetin on Multiplate impedance
        aggregometer.
        """
}
concept "TRC-TRAP(MULTIPLATE)" {
    name "sv" "TRC-TRAP"
    comment "en" """
        TRAP-6 induced platelet aggregation via Multiplate impedance aggregometry. Trc- prefix =
        trombocyter (platelets).
        """
}
concept "TROPONIN I" {
    name "sv" "Troponin I"
    comment "en" "Common ED test - cardiac troponin I (Lab C uses TnI)."
}
concept "TROPONIN I (PNA)"
concept "TROPONIN I (STRATUS)" {
    comment "en" "Stratus CS is method  analyte+specimen unchanged."
}
concept "TROPONIN T(P)" {
    name "sv" "Troponin T(P)"
    comment "en" "Common ED test - troponin T in plasma."
}
concept "TU-5-HIAA" {
    comment "en" "5-HIAA in 24h urine."
}
concept "TU-ADRENALIN" {
    comment "en" "tU-Adrenalin = timed urine epinephrine."
}
concept "TU-ALBUMIN" {
    comment "en" "tU-Albumin = spot urine albumin. Albumin/creatinine ratio is standard spot test."
}
concept "TU-ALDOSTERON" {
    comment "en" "Urine aldosterone."
}
concept "TU-AMYLAS" {
    comment "en" "tU- = timed urine."
}
concept "TU-CALCIUM" {
    comment "en" "tU- = timed urine collection."
}
concept "TU-CL" {
    comment "en" "tU-Cl = timed urine chloride."
}
concept "TU-CU" {
    comment "en" "tU- = timed urine (likely 24h). Copper in urine. 24h is the standard collection  Both."
}
concept "TU-FOSFAT" {
    comment "en" """
        tU-=timed urine; fosfat=phosphate. 24h urine phosphate is standard for timed collections  exact
        collection duration not specified.
        """
}
concept "TU-GLUKOS" {
    comment "en" "tU- prefix = timed urine collection."
}
concept "TU-HYDROXYPROLIN" {
    comment "en" """
        tU = timbestämd urin = timed urine  Urine specimen serum/plasma hydroxyproline is Specimen
        mismatch - urine is correct analyte but.
        """
}
concept "TU-KALIUM" {
    comment "en" "tU-Kalium = timed urine potassium. Could be spot or 24h. spot version preferred."
}
concept "TU-KAPPA" {
    comment "en" "tU- = timed urine. Kappa light chains mass/volume in urine."
}
concept "TU-KORTISOL" {
    comment "en" """
        tU- = timed urine cortisol, typically 24h collection. Could also be free cortisol. mass/time is
        the common clinical measurement  Both.
        """
}
concept "TU-LAMBDA" {
    comment "en" "tU- = timed/random urine. lambda free light chains."
}
concept "TU-MAGNESIUM" {
    comment "en" "tU- = timed urine collection."
}
concept "TU-METOXIKATEKOLAMIN" {
    comment "en" """
        tU=total urine; metoxikatekolamin=metoxycatecholamines (metanephrines+catecholamine
        metabolites).
        """
}
concept "TU-NATRIUM" {
    comment "en" "Swedish: sodium concentration in urine (tU = timed urine)."
}
concept "TU-NORADRENALIN" {
    comment "en" "tU = timed urine collection. Noradrenalin = norepinephrine (Swedish term)."
}
concept "TU-OXALAT" {
    comment "en" """
        tU-Oxalat = oxalate in timed urine collection. 24h collection as strict. The tU prefix suggests
        timed but duration unspecified.
        """
}
concept "TU-PORFYRINER" {
    comment "en" "tU-Porfyriner = urine porphyrins. 24h mass/time standard."
}
concept "TU-PORFYRINER, KVAL" {
    comment "en" """
        tU- = total/untimed urine. kval = qualitative. Interpretation best for qualitative screening.
        """
}
concept "TU-PREGNANTRIOL" {
    comment "en" """
        tU-Pregnantriol = timed urine pregnanetriol; 11-Oxo variant is related metabolite but not
        identical.
        """
}
concept "TU-PROTEIN" {
    comment "en" "tU = tillfällig urine = spot/random urine  unspecified duration is closest."
}
concept "TU-URAT" {
    comment "en" """
        tU- = timed urine; exact collection interval unknown; 24h urine is most common. units differ
        (mass vs moles)  24h match.
        """
}
concept "TU-UREA" {
    comment "en" "tU-Urea = urea in urine (timed)  t- prefix indicates timed collection."
}
concept "TU-VMA" {
    comment "en" "tU- = timed urine; VMA = vanillylmandelic acid."
}
concept "TVÄTTADE TPMT PROVER" {
    comment "en" """
        Tvattade = washed (pre-analytical); TPMT = thiopurine methyltransferase gene analysis. The test
        itself is TPMT mutation analysis. washing is sample prep.
        """
}
