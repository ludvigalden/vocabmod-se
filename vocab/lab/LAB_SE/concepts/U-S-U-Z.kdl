// Swedish hospital local laboratory test codes, codes U-S-U-Z
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "U-SALICYLSYRA" {
    comment "en" "U-=urine."
}
concept "U-SULFATID" {
    comment "en" "U-Sulfatid = sulfatides in urine (metabolic screening for leukodystrophies)."
}
concept "U-SYNTETISKA CANNABINOIDER" {
    comment "en" "U-Syntetiska cannabinoider = synthetic cannabinoids in urine."
}
concept "U-THC-SYRA" {
    comment "en" "Swedish: THC-acid (THC-COOH metabolite) in urine."
}
concept "U-TRAMADOL" {
    comment "en" "U- prefix = urine. Tramadol = opioid analgesic  screen method presence match."
}
concept "U-TRIHEXOSID" {
    comment "en" """
        U- = urine. Trihexosid = ceramide trihexoside (globotriaosylceramide/Gb3) for Fabry disease
        screening.
        """
}
concept "U-URAT"
concept "U-UREA" {
    comment "en" "U-Urea = urine urea. urea nitrogen."
}
concept "U-UROBILINOGEN" {
    comment "en" "U-Urobilinogen = urobilinogen in urine  Test strip method is most common for urinalysis."
}
concept "U-VMA" {
    comment "en" """
        U-VMA = vanillylmandelic acid in urine. Specimen match (urine) is certain. unit uncertainty
        (moles vs mass volume) and whether 24h collection.
        """
}
concept "U-VMA/KREATININ" {
    comment "en" "U-VMA/kreatinin = vanillylmandelic acid/creatinine ratio in urine."
}
concept "U-VOLYM (24H)" {
    comment "en" "U- = urine, 24h collection volume."
}
concept "U-XYLOS (165MMOL)" {
    comment "en" "U- = urine; Xylos = D-xylose absorption test (165mmol dose variant)."
}
concept "U-ZN" {
    comment "en" "U- = urine. Zn = zinc  unspecified duration urine zinc."
}
concept "U-ZOLPIDEM" {
    comment "en" "U-Zolpidem = zolpidem (sedative) in urine, toxicology. Confirmatory method match."
}
concept "U-ZOPIKLON"
