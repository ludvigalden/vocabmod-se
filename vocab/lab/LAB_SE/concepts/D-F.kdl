// Swedish hospital local laboratory test codes, codes D-F
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "DESMETYLV/VENLAFAXIN" {
    comment "en" """
        Desmetylv/Venlafaxin = O-desmethylvenlafaxine/venlafaxine ratio (TDM). Combined moles/volume as
        strict.
        """
}
concept "DIALYSAT-NATRIUM" {
    comment "en" "Sodium in dialysate fluid."
}
concept "DIALYSVÄ.-KREATININ" {
    comment "en" """
        Dialysvä.-Kreatinin = creatinine in dialysis fluid (peritoneal dialysis). Mass/volume as strict.
        """
}
concept "DIALYSVÄTSKA-FOSFAT" {
    comment "en" "Dialysvätska = dialysis fluid. fosfat = phosphate."
}
concept "DIALYSVÄTSKA-GLUKOS" {
    comment "en" "Glucose concentration in dialysis fluid."
}
concept "DIALYSVÄTSKA-UREA" {
    comment "en" "Dialysvätska = dialysis fluid, Urea = urea."
}
concept "DRÄN-BILIRUBIN" {
    comment "en" "Drän = drain/drainage fluid. body fluid is closest specimen  bilirubin total."
}
concept "DRÄNVÄTSKA-AMYLAS" {
    comment "en" """
        Dränvätska=drainage fluid (post-surgical peritoneal drain). amylase for pancreatitis monitoring 
        peritoneal fluid match.
        """
}
concept "DRÄNVÄTSKA-KREATININ"
concept "DV(PERITONEAL) EOS" {
    comment "en" """
        Swedish: eosinophils in peritoneal dialysis fluid (Dv = dialysis fluid). Source may report
        absolute count or %.
        """
}
concept "DV(PERITONEAL) LPK" {
    comment "en" "Dv(peritoneal) = peritoneal dialysis fluid. LPK = leukocyte count."
}
concept "DV(PERITONEAL) LYMF" {
    comment "en" "Dv- = dialysate (peritoneal); Lymf = lymphocytes."
}
concept "DV(PERITONEAL) MONO" {
    comment "en" "Dv=drainage fluid peritoneal  monocyte differential."
}
concept "DV(PERITONEAL) SEGM" {
    comment "en" "Dv- = dialysis fluid (peritoneal); Segmented neutrophils."
}
concept "EGFR CYSTATIN C" {
    comment "en" "eGFR Cystatin C = estimated GFR based on cystatin C formula."
}
concept "EGFR KREATININ" {
    comment "en" "eGFR by CKD-EPI creatinine-based formula  standard Swedish lab formula."
}
concept "EPK-FAKT.6TGN/6MMPN" {
    comment "en" """
        EPK = erythrocyte. FAKT = ratio/factor. 6TGN/6MMPN = thiopurine metabolites (azathioprine/6-MP
        monitoring). Panel concept as strict.
        """
}
concept "ERC-C18:1" {
    comment "en" """
        Erythrocyte membrane fatty acid  specimen and method mismatch (Blood vs Erc, Presence vs
        quantitative).
        """
}
concept "ERC-C20:3(N-6)" {
    comment "en" "Erc-C20:3(n-6) = erythrocyte dihomogamma-linolenic acid (fatty acid profiling)."
}
concept "ERC-C22:5 (N-3)" {
    comment "en" "Erc- = erythrocyte; C22:5 (n-3) = docosapentaenoic acid. specimen mismatch."
}
concept "ERC-C22:6(N-3)" {
    comment "en" """
        Erc-C22:6(n-3) = DHA (docosahexaenoic acid) in erythrocytes. Erc = erythrocyte membrane fatty
        acid analysis.
        """
}
concept "ERC-G-6-PD" {
    comment "en" "Erc- = erythrocytes. G-6-PD = glucose-6-phosphate dehydrogenase  Both."
}
concept "ERC-HB FETALT" {
    comment "en" """
        Erc-Hb fetalt = fetal hemoglobin. Kleihauer-Betke electrophoresis also Source unspecified
        method.
        """
}
concept "ERC-MCH" {
    comment "en" "ERC-MCH = MCH in erythrocytes. automated count variant chosen as strict."
}
concept "ERC-MCH LAB G" {
    comment "en" "MCH from erythrocytes at Lab G."
}
concept "ERC-MCHC" {
    comment "en" "ERC- prefix = erythrocyte parameter. MCHC is derived from Hgb/Hct."
}
concept "ERC-MCHC LAB G" {
    comment "en" "Erc-MCHC = MCHC in erythrocytes. Lab G = Lab G method reference."
}
concept "ERC-MCV" {
    comment "en" "Erc = erythrocytes  MCV in RBC is exact."
}
concept "ERC-MCV LAB G" {
    comment "en" "Erc- = erythrocyte. MCV = mean corpuscular volume. Lab G = site."
}
concept "ERC-PORFYRINER" {
    comment "en" "Erc- = erythrocyte, Porfyriner = porphyrins. Exact RBC porphyrin match."
}
concept "ERC-PYRUVATKINAS" {
    comment "en" "Erc-Pyruvatkinas = erythrocyte pyruvate kinase activity."
}
concept "ERC-RET. LAB G" {
    name "sv" "ERC-RET"
    comment "en" "Erc-Ret. Lab G = erythrocyte reticulocyte count by Lab G (manual) method."
}
concept "ERC-TPMT" {
    comment "en" "TPMT genotype for thiopurine dosing  ERC=erythrocyte specimen."
}
concept "ERC-TRANSKETOLAS" {
    comment "en" "Erc = erythrocyte prefix."
}
concept "ERY-RET. MIKROSKOPI" {
    comment "en" "Ery-Ret. mikroskopi = reticulocyte count on blood smear by microscopy."
}
concept "EWSR1 (22Q12)" {
    comment "en" """
        EWSR1 (22q12) = EWSR1 gene rearrangement FISH probe at chromosome 22q12  tissue FISH concept.
        """
}
concept "EX-TEM" {
    comment "en" "ex-TEM = extrinsic thromboelastometry (tissue factor activated ROTEM)."
}
concept "F-HB" {
    comment "en" "F-=feces/stool."
}
concept "F-HB LAB G" {
    comment "en" "F- = fetal; Hb = hemoglobin; F-Hb = fetal hemoglobin (HbF)."
}
concept "F-HB(ACTIM)"
concept "F-KALIUM" {
    comment "en" "F- = feces."
}
concept "F-KOPROPORFYRINER" {
    comment "en" "F- = feces; Koproporfyriner = coproporphyrins."
}
concept "F-MASKÄGG, OXYURIS" {
    comment "en" "Pinworm (Oxyuris/Enterobius vermicularis) egg in stool. F- prefix = feces/stool."
}
concept "F-NATRIUM" {
    comment "en" "F- = feces."
}
concept "F-PORFYRINER FRAKT." {
    name "sv" "F-PORFYRINER FRAKT"
    comment "en" "F-Porfyriner frakt; = fecal porphyrin fractionation."
}
concept "F-PROTOPORFYRINER" {
    comment "en" "F-=feces. Protoporphyrin in Stool  used for lead exposure and porphyria evaluation."
}
concept "FFPE DNA-PLOIDI FLÖDESCYTOMETRI" {
    comment "en" "DNA ploidy on FFPE tissue by flow cytometry."
}
concept "FIB-TEM" {
    comment "en" "fib-TEM = fibrinogen ROTEM test. TEG 'maximum clot firmness' is closest surrogate."
}
concept "FKP-GLUKOS (HEMOCUE)" {
    name "sv" "FKP-GLUKOS"
    comment "en" "fkP- = point-of-care capillary plasma. HemoCue is a well-known glucometer."
}
concept "FLT3-ITD MUTATION" {
    comment "en" "FLT3-ITD mutation = internal tandem duplication. ITD-specific variant not separately coded."
}
concept "FLT3-TKD MUTATION"
concept "FLUOXETIN+DESMETYLF" {
    comment "en" "Desmetylf = desmethylfluoxetine = norfluoxetine. Combined parent+metabolite measurement."
}
concept "FOSFATSTEN" {
    comment "en" "Fosfatsten = phosphate stone. Presence of phosphate in stone calculus."
}
concept "FP-HDL-KOLESTEROL" {
    comment "en" "fP = fasting plasma. HDL-kolesterol = HDL cholesterol."
}
concept "FP-KOLESTEROL" {
    comment "en" "fP- = fasting plasma. Kolesterol = total cholesterol."
}
concept "FP-LDL-KOLESTEROL" {
    name "sv" "fP-LDL-kolesterol"
    variant "S-LDL-KOLESTEROL" kind=raw
    comment "en" """
        Catalogued at: Lab B, Lab C. fP- = fasting plasma; fP-LDL-kolesterol =
        direct-measured LDL cholesterol. 2026-04-23. Swedish fP-prefix = fasting plasma. Lab B uses
        fP- prefix (fasting plasma). fP-/S- prefix difference reflects specimen convention, not clinical
        distinction. Lipid panel - LDL cholesterol in Serum. S- = serum; LDL cholesterol.
        """
}
concept "FP-TRIGLYCERID" {
    comment "en" """
        fP-=fasting plasma; Triglyceride in Serum or Plasma. exact clinical match  extern lab note in
        desc.
        """
}
concept "FRAKT. HEMOGLOBINER" {
    comment "en" "Frakt. Hemoglobiner = hemoglobin fractions (electrophoresis pattern)."
}
concept "FRI BETA HCG" {
    comment "en" """
        Fri=fri beta HCG (free beta subunit of human chorionic gonadotropin)  specimen not specified,
        serum/plasma is standard.
        """
}
