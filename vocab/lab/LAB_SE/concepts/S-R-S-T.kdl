// Swedish hospital local laboratory test codes, codes S-R-S-T
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S-RESISTIN" {
    comment "en" "S-Resistin = resistin in serum  inflammatory marker."
}
concept "S-REUMATOID FAKTOR" {
    comment "en" "S- = serum. reumatoid faktor = rheumatoid factor  units/volume preferred over titer (not."
}
concept "S-S-100" {
    comment "en" "S-100 = S100 protein (brain injury marker). S-100B is the clinically relevant isoform."
}
concept "S-SALICYLATER"
concept "S-SELEN" {
    comment "en" "Selenium in serum."
}
concept "S-SEROTONIN(STUDIER)" {
    name "sv" "S-SEROTONIN"
    comment "en" """
        S-Serotonin(studier) = serotonin in serum for studies  both Moles/volume and Mass/volume
        Moles/volume preferred as SI unit.
        """
}
concept "S-SERTRALIN" {
    comment "en" "S- = serum  Sertralin = sertraline (SSRI TDM)."
}
concept "S-SHBG" {
    comment "en" "S-SHBG = serum sex hormone binding globulin  Mass/volume variant."
}
concept "S-SIDOKEDJESULFON" {
    comment "en" """
        S-Sidokedjesulfon = porphobilinogen (PBG) in serum. Old Swedish abbreviation (porphobilin = side
        chain). Acute porphyria diagnosis.
        """
}
concept "S-T3" {
    comment "en" "S- = serum  total T3."
}
concept "S-T3 FRITT" {
    comment "en" "S- prefix = serum."
}
concept "S-T3, FRITT" {
    comment "en" "Free T3 (triiodothyronine) in serum."
}
concept "S-T4" {
    comment "en" "S-T4 = serum thyroxine. standard total T4."
}
concept "S-T4 FRITT" {
    name "sv" "S-T4 fritt"
    comment "en" "S-Fritt T4 = free thyroxine in serum. Thyroid function test - Free thyroxine in Serum."
}
concept "S-TBG" {
    comment "en" "S-TBG = thyroxine binding globulin in serum."
}
concept "S-TEICOPLANIN" {
    comment "en" "S- = serum; teicoplanin TDM (therapeutic drug monitoring)."
}
concept "S-TEOFYLLIN" {
    comment "en" "S-Teofyllin = serum theophylline. drug monitoring."
}
concept "S-TESTO LAB G" {
    name "sv" "S-TESTO"
    comment "en" """
        Testosterone from Lab G hospital lab. Clinic-specific label. analyte is standard
        testosterone.
        """
}
concept "S-TESTOSTERON" {
    comment "en" "S- = serum."
}
concept "S-TESTOSTERON, BIOTILLGÄNGLIGT"
concept "S-TESTOSTERON, FRITT" {
    comment "en" "S- = serum."
}
concept "S-TIBC" {
    name "sv" "S-TIBC"
    comment "en" """
        TIBC = Total Iron Binding Capacity in serum. Iron studies - Iron binding capacity total in
        Serum. Specimen type: serum based on S- prefix.
        """
}
concept "S-TIOCYANAT" {
    comment "en" "S-Tiocyanat = serum thiocyanate (cyanide/smoke exposure marker)."
}
concept "S-TIORIDAZIN"
concept "S-TNF-ALFA (STUDIER)" {
    name "sv" "S-TNF-ALFA"
    comment "en" "S-TNF-alfa = serum TNF-alpha, research/studies context. Cytokine marker."
}
concept "S-TNT (LAB-INTERN)" {
    name "sv" "S-TNT"
    comment "en" "S-TnT = troponin T in serum."
}
concept "S-TOBRAMYCIN" {
    comment "en" "S-Tobramycin = tobramycin TDM in serum. No peak/trough qualifier."
}
concept "S-TOPIRAMAT" {
    comment "en" "S-Topiramat = topiramate (anticonvulsant) TDM in serum."
}
concept "S-TRANSF. RECEPTOR" {
    comment "en" "S- = serum. soluble transferrin receptor for iron status."
}
concept "S-TRANSFERR CARLANDE" {
    comment "en" "S-Transferrin = serum transferrin."
}
concept "S-TRANSFERRIN" {
    comment "en" "S-Transferrin = serum transferrin."
}
concept "S-TRANSFERRINMÄTTNAD" {
    name "sv" "S-Transferrinmättnad"
    comment "en" """
        Transferrinmättnad = transferrin saturation, measured in serum. Iron studies - Transferrin
        saturation in Serum. Specimen type: serum based on S- prefix.
        """
}
concept "S-TRANSKORTIN(CBG)" {
    comment "en" "CBG=corticosteroid binding globulin."
}
concept "S-TRIGLYC (WLAB)" {
    name "sv" "S-TRIGLYC"
    comment "en" "S-Triglyc = triglycerides in serum. Wlab is lab identifier  TG mass/volume in S/P."
}
concept "S-TRIGLYC. LAB G" {
    comment "en" "S- = serum; Triglyc. = triglycerides. Lab G = lab/method qualifier."
}
concept "S-TRIGLYCERIDER" {
    name "sv" "S-Triglycerider"
    comment "en" "S-=serum; triglycerides mass/volume. Lipid panel - Triglycerides in Serum."
}
concept "S-TRIGLYCERIDER (GB)" {
    comment "en" """
        S- = serum. Triglycerider = triglycerides. (gb) suffix is site-internal qualifier. Standard
        triglyceride in Serum or Plasma.
        """
}
concept "S-TRIJODTYRONIN" {
    comment "en" "S- prefix = serum."
}
concept "S-TROPONIN T" {
    comment "en" "Troponin T cardiac in serum/plasma. generic."
}
concept "S-TSH" {
    name "sv" "S-TSH"
    comment "en" "S-TSH = thyroid-stimulating hormone in serum."
}
concept "S-TSH (ICMA)" {
    comment "en" """
        S- = serum. TSH = thyroid-stimulating hormone/thyrotropin. The detection limit variants are
        available. is most common generation.
        """
}
concept "S-TSH RECEPTORAK." {
    name "sv" "S-TSH RECEPTORAK"
    comment "en" """
        S-TSH receptorak. = thyrotropin receptor antibody (TRAb) in serum. Graves disease evaluation.
        """
}
concept "S-TYREOGLOBULIN" {
    comment "en" "Thyroglobulin in serum."
}
concept "S-TYROTROPIN, TSH"
concept "S-TYROXIN" {
    comment "en" "S-Tyroxin = total thyroxine (T4) in serum."
}
