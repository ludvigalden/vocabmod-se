// Swedish hospital local laboratory test codes, codes P-PY
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "P.O.GLUKOSBELASTNING" {
    comment "en" """
        P.o.Glukosbelastning = oral glucose tolerance test in plasma. 2h panel is standard OGTT
        timepoint.
        """
}
concept "P/S-CRP (NÄRLAB)" {
    name "sv" "P/S-CRP"
}
concept "P/S-TROPONIN I (CTN)" {
    comment "en" """
        P/S- prefix indicates serum or plasma. (CTN) = cardiac troponin. Standard cardiac Troponin I in
        Serum or Plasma.
        """
}
concept "PAPP-A" {
    comment "en" """
        PAPP-A is first-trimester screening marker. MoM is the standard reporting unit. Neither variant
        is Swedish term has no specimen prefix, serum/plasma assumed.
        """
}
concept "PEEP (PNA)" {
    name "sv" "PEEP"
}
concept "PERICARD-LPK"
concept "PERICARD-NEUTROFILA" {
    comment "en" "Neutrophils in pericardial fluid."
}
concept "PERICARD-PROTEIN"
concept "PLEU-BASOFILA" {
    comment "en" "Pleu-Basofila = basophils in pleural (pleura) fluid."
}
concept "PLEU-EOSINOFILA" {
    comment "en" "Pleu-Eosinofila = eosinophils in pleural fluid."
}
concept "PLEU-HB" {
    comment "en" "Hemoglobin in pleural fluid."
}
concept "PLEU-LIPOPROTEIN FR" {
    comment "en" """
        Pleu- = pleural fluid; lipoprotein fr = lipoprotein (fr may = fraction/free). Beta lipoprotein
        as best guess. specific fraction unknown.
        """
}
concept "PLEU-LPK" {
    comment "en" "Pleu-LPK = leukocytes in pleural fluid  exact specimen match."
}
concept "PLEU-LYMFOCYTER" {
    comment "en" "Pleu- prefix = pleural fluid."
}
concept "PLEU-MONOCYTER" {
    comment "en" "Pleu- = pleural fluid."
}
concept "PLEU-ODIFF.CELLER" {
    comment "en" "Pleu = pleural fluid. Odiff = differential count  cell count panel captures differential."
}
concept "PLEU-PLASMACELLER" {
    comment "en" "Pleu-=pleural fluid."
}
concept "PLEU-SEGMENTERADE" {
    comment "en" "Pleu- = pleural fluid. Segmenterade = segmented neutrophils."
}
concept "PLEU-STAVKÄRNIGA" {
    comment "en" "Pleu- = pleural fluid; stavkärniga = band neutrophils."
}
concept "PLEURA-ADA" {
    comment "en" "Pleura-ADA = adenosine deaminase in pleural fluid (tuberculosis marker)."
}
concept "PLEURA-ERYTROCYTER" {
    comment "en" "Pleura=pleural fluid  erythrocyte count for hemorrhagic vs transudative effusion."
}
concept "PLEURA-GLUKOS" {
    comment "en" "Glucose in pleural fluid. body fluid used."
}
concept "PLEURA-KOLESTEROL" {
    comment "en" "Pleural fluid cholesterol."
}
concept "PLEURA-LEUKOCYTER" {
    comment "en" "Leukocyte count in pleural fluid  no method specified."
}
concept "PLEURA-PROTEIN"
concept "PLEURA-TRIGLYCERIDER" {
    comment "en" "Triglycerides in pleural fluid. Body fluid used as specimen."
}
concept "PLEURAVÄTSKA-PH (PNA)" {
    name "sv" "PLEURAVÄTSKA-PH"
    comment "en" "50895-2 most specimen-specific (by Test strip)  2748-2 (Body fluid) is."
}
concept "PML-RARA/GUSB" {
    comment "en" "APL diagnostic. PML-RARA by PCR  GUSB = beta-glucuronidase reference gene."
}
concept "PORFOBILINOGENSYNTAS" {
    comment "en" """
        Porfobilinogensyntas = porphobilinogen synthase (ALA dehydratase) in erythrocytes. Porphyria
        workup.
        """
}
concept "POSTFILTER-CA PNA" {
    comment "en" "Postfilter-CA = ionized calcium post hemofiltration."
}
concept "PROLAKTIN LÅGMOLEKYL" {
    comment "en" "Low-molecular-weight prolactin = monomeric fraction."
}
concept "PT-BLÖDNINGSTID" {
    comment "en" """
        Pt- = patient. Bleeding time, no method specified. General term is Ivy method variant exists.
        Swedish labs typically use Ivy.
        """
}
concept "PT-GLUKOSBELASTNING" {
    comment "en" "Pt- = point-of-care/bedside. Glukosbelastning = glucose tolerance test."
}
concept "PT-KREATININCLEARANCE" {
    comment "en" "Patient creatinine clearance. 24h collection assumed."
}
concept "PT-LÄNGD" {
    comment "en" "Pt-längd = patient length/body height."
}
concept "PT-SVETTMÄNGD" {
    comment "en" "Sweat quantity."
}
concept "PT-SVETTSEKRETION" {
    comment "en" "Pt- = patient test. sweat secretion volume (quantitative pilocarpine iontophoresis for CF)."
}
concept "PT-VIKT" {
    comment "en" "Pt-Vikt = patient body weight."
}
concept "PULSFREKVENS" {
    name "sv" "Pulsfrekvens"
    variant "PULS" kind=abbrev
    comment "en" "Catalogued at: Lab A, Lab F. Puls = heart rate/pulse from Lab F bedside vitals."
}
concept "PULSFREKVENS OREGELBUNDEN" {
    comment "en" "Irregular pulse."
}
concept "PYRUVATKINAS SCREEN" {
    comment "en" "Pyruvatkinas Screen = pyruvate kinase screening in RBC."
}
