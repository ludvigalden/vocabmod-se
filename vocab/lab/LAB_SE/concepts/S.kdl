// Swedish hospital local laboratory test codes, codes S
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S ALP, BENSPECIFIKT" {
    comment "en" "Bone-specific alkaline phosphatase."
}
concept "S BIL. LAB G" {
    name "sv" "S BIL"
    comment "en" """
        S- = serum. bil = bilirubin. Lab G = Lab G method (Swedish). Total bilirubin is the
        routine clinical test.
        """
}
concept "S FT4 LAB G" {
    name "sv" "S FT4"
}
concept "S TROPONIN I HÖGKÄNSLIG (STUDIER)" {
    name "sv" "S TROPONIN I HÖGKÄNSLIG"
    comment "en" """
        S Troponin I Hogkanslig (Studier) = high-sensitivity cardiac Troponin I in serum, labeled as
        research. HS method as strict.
        """
}
concept "S TSH LAB G" {
    name "sv" "S TSH"
    comment "en" """
        TSH from Lab G satellite lab. only detection-limit variants are Two possible
        detection-limit variants.
        """
}
