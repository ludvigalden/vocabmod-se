// Swedish hospital local laboratory test codes, codes S-L-S-P
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "S-LAUROYLKARNITIN" {
    comment "en" """
        Lauroylcarnitine = dodecanoylcarnitine C12. newborn screening acylcarnitine panel  S-prefix =
        serum.
        """
}
concept "S-LD, TOTAL" {
    comment "en" "S- = serum  LD total = unspecified method LD."
}
concept "S-LD-ISOENZYMER" {
    comment "en" "S-=serum."
}
concept "S-LD-ISOENZYMER 1" {
    comment "en" "LDH isoenzyme 1."
}
concept "S-LD-ISOENZYMER 2" {
    comment "en" "S- = serum. LD-isoenzymer 2 = LDH isoenzyme 2."
}
concept "S-LD-ISOENZYMER 3" {
    comment "en" "S- = serum  LD isoenzyme 3 = LDH-3."
}
concept "S-LD-ISOENZYMER 4" {
    comment "en" "LD isoenzyme interpretation rather than quantitative."
}
concept "S-LD-ISOENZYMER 5" {
    comment "en" "S- = serum; LD-isoenzymer 5 = lactate dehydrogenase isoenzyme 5."
}
concept "S-LD1" {
    comment "en" "S- = serum. LD1 = lactate dehydrogenase isoenzyme 1 (heart)."
}
concept "S-LDL-KOL (WLAB)" {
    name "sv" "S-LDL-KOL"
}
concept "S-LDL-KOL LAB G" {
    comment "en" """
        S- = serum. LDL-kol = LDL cholesterol. Lab G = Lab G formula (Swedish LDL calc
        method).
        """
}
concept "S-LEPTIN" {
    comment "en" "Leptin hormone."
}
concept "S-LEPTIN (STUDIER)" {
    comment "en" "S- = serum; leptin."
}
concept "S-LH (LUTROPIN)" {
    comment "en" "LH = luteinizing hormone = lutropin."
}
concept "S-LIPOPROTEIN FRAKT." {
    name "sv" "S-LIPOPROTEIN FRAKT"
    comment "en" "S-Lipoprotein frakt. = lipoprotein fractionation in serum."
}
concept "S-LITIUM" {
    comment "en" "S-Litium = serum lithium  standard therapeutic drug monitoring."
}
concept "S-LPA(LIPOPROTEIN A)" {
    comment "en" "S-Lpa = serum lipoprotein(a)."
}
concept "S-LYSOZYM" {
    comment "en" "S-Lysozym = serum lysozyme."
}
concept "S-M-KOMPONENT"
concept "S-M-KOMPONENT IGA" {
    comment "en" "S-M-komponent IgA = monoclonal IgA (M-protein) in serum."
}
concept "S-M-KOMPONENT IGG" {
    comment "en" """
        M-komponent IgG = monoclonal IgG detected by protein electrophoresis  M protein isotype panel
        captures this.
        """
}
concept "S-M-KOMPONENTTYPNING" {
    comment "en" "S-M-komponenttypning = monoclonal protein typing by serum protein electrophoresis."
}
concept "S-MAGNESIUM" {
    comment "en" "S-Magnesium = serum magnesium."
}
concept "S-MAKROPROLAKTIN"
concept "S-METADON" {
    comment "en" "S-Metadon = serum methadone TDM. Standard therapeutic drug monitoring concept."
}
concept "S-METANOL" {
    comment "en" "S- = serum. Methanol quantification. Moles/volume appropriate for toxicology."
}
concept "S-METOTREXAT" {
    comment "en" "Methotrexate therapeutic drug monitoring."
}
concept "S-METYLMALONAT" {
    comment "en" "S- = serum, Metylmalonat = methylmalonate."
}
concept "S-MG LAB G" {
    name "sv" "S-MG"
    comment "en" """
        S-Mg = magnesium in serum. Lab G = Lab G hospital (site qualifier, no analytical
        relevance).
        """
}
concept "S-MIANSERIN"
concept "S-MIRTAZAPIN"
concept "S-MONONUKLEOS" {
    comment "en" "S-Mononukleos = mononucleosis screen in serum."
}
concept "S-MYOGLOBIN" {
    comment "en" "S- = serum."
}
concept "S-MYRISTOYLKARNITIN" {
    comment "en" "Myristoylcarnitine = tetradecanoylcarnitine (C14:0). Moles/volume in serum or plasma."
}
concept "S-NA LAB G" {
    name "sv" "S-NA"
    comment "en" "S-Na at Lab G hospital lab."
}
concept "S-NORKLOZAPIN" {
    comment "en" "S-Norklozapin = norclozapine (clozapine metabolite) in serum."
}
concept "S-NORMIANSERIN" {
    comment "en" "S- = serum. Normianserin = mianserin metabolite (TDM)."
}
concept "S-NORTRIPTYLIN" {
    comment "en" "S- = serum. nortriptyline TCA drug level."
}
concept "S-NSE" {
    comment "en" "S- = serum. NSE = neuron-specific enolase."
}
concept "S-NSE, IFMA" {
    comment "en" "S-NSE = neuron-specific enolase in serum  IFMA is method."
}
concept "S-NT-PROBNP" {
    comment "en" "NT-proBNP in serum."
}
concept "S-O,P´-DDD" {
    comment "en" """
        S-o,p'-DDD = mitotane (Lysodren, o,p'-DDD) drug level in serum. Used for adrenocortical
        carcinoma TDM.
        """
}
concept "S-OKTANOYLKARNITIN" {
    comment "en" "S- = serum. octanoylcarnitine C8 acylcarnitine. Newborn screening/metabolic panel."
}
concept "S-OLANZAPIN" {
    comment "en" "S-Olanzapin = olanzapine TDM in serum."
}
concept "S-OROSOMUCOID" {
    comment "en" "Orosomucoid = alpha-1-acid glycoprotein  S-prefix = serum."
}
concept "S-OSMOLALITET"
concept "S-OSTEOCALCIN"
concept "S-OSTEOCALCIN, TOTAL" {
    comment "en" "Total osteocalcin in serum."
}
concept "S-PALMITOYLKARNITIN" {
    comment "en" "S- = serum."
}
concept "S-PARACETAMOL"
concept "S-PARATHORMON" {
    comment "en" "S-Parathormon = intact parathyroid hormone in serum."
}
concept "S-PARATHORMON (7-84)" {
    comment "en" "S-Parathormon (7-84) = biointact/whole PTH (1-84 only)."
}
concept "S-PEPSINOGEN I"
concept "S-PERFENAZIN" {
    comment "en" "Perphenazine therapeutic drug monitoring in serum."
}
concept "S-PINP (STUDIER)" {
    name "sv" "S-PINP"
    comment "en" """
        S- = serum. PINP = procollagen I N-terminal propeptide (bone turnover marker)  Studier =
        research studies qualifier.
        """
}
concept "S-PLAP" {
    comment "en" """
        S-PLAP = placental alkaline phosphatase (Regan isoenzyme), measured as heat-stable ALP fraction.
        """
}
concept "S-PREALBUMIN" {
    comment "en" "Nutritional marker  S-prefix = serum."
}
concept "S-PRIMIDON" {
    comment "en" "S- = serum. primidone antiepileptic drug level."
}
concept "S-PROCALCITONIN" {
    comment "en" "S-Procalcitonin = serum procalcitonin."
}
concept "S-PROGESTERON" {
    comment "en" "S- prefix = serum."
}
concept "S-PROKOLLAGEN-I-CP" {
    comment "en" "PINP = N-terminal propeptide of type I procollagen  bone turnover marker."
}
concept "S-PROKOLLAGEN-III-P" {
    comment "en" """
        S-Prokollagen-III-P = procollagen type III N-terminal propeptide (PIIINP) in serum. No
        equivalent.
        """
}
concept "S-PROLAKTIN" {
    comment "en" "Swedish: serum prolactin. Baseline variant is the closest to routine measurement."
}
concept "S-PROLAKTIN FÄLLD" {
    comment "en" "S-Prolaktin fälld = serum prolactin precipitated (macroprolactin screening)."
}
concept "S-PROPIONYLKARNITIN"
concept "S-PROTEIN"
concept "S-PROTEIN LAB G"
concept "S-PSA %" {
    comment "en" "S-PSA % = PSA percentage (free/total ratio). Using total PSA as surrogate."
}
concept "S-PSA LAB G" {
    comment "en" "S- = serum. PSA total  Lab G = internal qualifier."
}
concept "S-PSA LAB G F" {
    comment "en" "S-PSA Lab G F = free prostate specific antigen from Lab G  F=fri (free)."
}
concept "S-PSA FRITT" {
    comment "en" "PSA fritt=free PSA  S-prefix = serum."
}
concept "S-PSA KVOT" {
    comment "en" "PSA kvot = free PSA / total PSA ratio."
}
concept "S-PSA TOTAL"
concept "S-PSAF% LAB G" {
    name "sv" "S-PSAF"
    comment "en" "S- = serum; PSAf% = PSA free percentage (free/total ratio)."
}
concept "S-PTH" {
    comment "en" "S-PTH likely = intact PTH in Swedish clinical practice. Neither PTHrP is but unlikely match."
}
concept "S-PTH BIO-INTAKT" {
    comment "en" """
        S-PTH bio-intakt = bioactive intact PTH. OMOP uses intact PTH as standard. no separate
        bio-intact concept.
        """
}
concept "S-PTH INTAKT"
