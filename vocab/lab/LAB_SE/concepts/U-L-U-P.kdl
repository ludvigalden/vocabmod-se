// Swedish hospital local laboratory test codes, codes U-L-U-P
context {
    system "LAB_SE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "U-LAKTAT" {
    comment "en" "Swedish: lactate concentration in urine."
}
concept "U-LAMBDA" {
    comment "en" """
        U-Lambda = lambda light chains in urine; Term does not specify free vs total. Total lambda
        chains as strict.
        """
}
concept "U-LEUKOCYTER" {
    comment "en" "U-Leukocyter = leukocytes in urine."
}
concept "U-LEUKOCYTER (PNA)" {
    comment "en" "U-Leukocyter = urine leukocytes."
}
concept "U-M-KOMPONENTTYPNING" {
    comment "en" "M-komponent = monoclonal protein. typning = typing. Immunofixation is the standard method."
}
concept "U-MAGNESIUM"
concept "U-MDA" {
    comment "en" "U- = urine; MDA = methylenedioxyamphetamine. confirmatory screen  neither."
}
concept "U-MDMA" {
    comment "en" "U-MDMA = MDMA drug screen in urine."
}
concept "U-MEFEDRON" {
    comment "en" "U- = urine. Mefedron = mephedrone  confirmatory quant."
}
concept "U-MEPROBAMAT" {
    comment "en" "U- = urine."
}
concept "U-METADON"
concept "U-METADON SCREEN" {
    comment "en" "U- = urine."
}
concept "U-METAKVALON" {
    comment "en" "Metakvalon = methaqualone (sedative drug)."
}
concept "U-METAMFETAMIN"
concept "U-METANOL" {
    comment "en" "U- = urine. metanol = methanol (toxic alcohol)."
}
concept "U-METEDRON" {
    comment "en" "U-prefix = urine. methedrone = mephedrone/bath salt  confirmatory toxicology."
}
concept "U-METOXIADREN/KREAT" {
    comment "en" """
        Metoxiadren = metoxyadrenaline = metanephrine (Swedish synonym). match for
        metanephrine/creatinine ratio.
        """
}
concept "U-METOXIADRENALIN" {
    comment "en" "U-Metoxiadrenalin = metanephrines (metoxiadrenalin is Swedish for metanephrine/MN) in urine."
}
concept "U-METOXIKAT/KREAT." {
    name "sv" "U-METOXIKAT/KREAT"
    comment "en" "Swedish metoxikat = methadone + EDDP metabolites normalized to creatinine."
}
concept "U-METOXIKATEKOLAMIN." {
    name "sv" "U-METOXIKATEKOLAMIN"
    comment "en" """
        Fractionated metanephrines (metoxikatekolaminer) in urine. Panel code best match  neither panel
        nor individual codes.
        """
}
concept "U-METOXINORADR/KREAT"
concept "U-METOXINORADRENALIN" {
    comment "en" """
        Metoxinoradrenalin = Normetanephrine (Swedish synonym). U- = urine. specimen type unclear (24h
        vs random).
        """
}
concept "U-METYLFENIDAT" {
    comment "en" "U-Metylfenidat = urine methylphenidate (Ritalin)."
}
concept "U-METYLMALONAT" {
    comment "en" "U- = urine."
}
concept "U-MORFIN" {
    comment "en" "U-Morfin = morphine in urine."
}
concept "U-MUKOPOLYSACKARIDER" {
    comment "en" "U- = urine."
}
concept "U-MYOGLOBIN"
concept "U-NAG (STUDIE)" {
    name "sv" "U-NAG"
}
concept "U-NATRIUM" {
    comment "en" "U- prefix = urine  sodium moles/volume in urine."
}
concept "U-NIKOTINMETABOL/KRE" {
    comment "en" """
        Nikotinmetabol/kreat = nicotine metabolites/creatinine ratio. Nicotine+Cotinine Presence is
        loose placeholder.
        """
}
concept "U-NIKOTINMETABOLITER" {
    comment "en" """
        U-Nikotinmetaboliter = nicotine metabolites in urine. but source is broader (includes other
        metabolites).
        """
}
concept "U-NITRIT" {
    comment "en" "Urine nitrite by dipstick."
}
concept "U-NITRIT (PNA)" {
    comment "en" "U- = urine. PNA = point-of-care."
}
concept "U-NORADRENALIN" {
    comment "en" "U-Noradrenalin = noradrenaline/norepinephrine in urine. mass/volume."
}
concept "U-NORADRENALIN/KREA" {
    comment "en" """
        U- = urine. noradrenalin/krea = norepinephrine/creatinine ratio. Mass ratio match is the direct
        equivalent. Alt: Norepinephrine absolute but not the requested ratio.
        """
}
concept "U-NORDIAZEPAM" {
    comment "en" "Nordiazepam (active metabolite of diazepam) quantitative confirmation in urine."
}
concept "U-OLIGOSACKARIDER, NEUTRALA" {
    comment "en" """
        U-Oligosackarider, neutrala = neutral oligosaccharides in urine. general oligosaccharides
        presence as best match.
        """
}
concept "U-OLIGOSACKARIDER, SURA" {
    comment "en" "Acidic oligosaccharides in urine."
}
concept "U-OPIATER" {
    comment "en" "U- = urine; Opiater = opioids."
}
concept "U-OPIATER SCREEN" {
    comment "en" "Opiate screening test in urine."
}
concept "U-OPIATER V" {
    comment "en" "U- = urine. V = verification. General presence vs confirmatory method  Both."
}
concept "U-ORGANISKA SYROR" {
    comment "en" "Organic acids panel in urine."
}
concept "U-OSMOLALITET"
concept "U-OXALAT" {
    comment "en" "U- = urine, Oxalat = oxalate. Specimen timing uncertain."
}
concept "U-OXAZEPAM" {
    comment "en" "U-Oxazepam = oxazepam in urine (toxicology). confirmatory method."
}
concept "U-OXIKODON, VERIF" {
    comment "en" "U-Oxikodon, verif = oxycodone verified/confirmed in urine."
}
concept "U-PBG" {
    comment "en" "U-PBG = urine porphobilinogen."
}
concept "U-PBG KVAL" {
    comment "en" "U-PBG kval = porphobilinogen qualitative in urine. presence test."
}
concept "U-PENTAZOCIN" {
    comment "en" "U- = urine. Pentazocin = pentazocine (opioid analgesic)  presence match."
}
concept "U-PETIDIN" {
    comment "en" "Petidin = meperidine (pethidine) in Swedish."
}
concept "U-PH" {
    comment "en" "U-pH = urine pH."
}
concept "U-PH (PNA)" {
    comment "en" "U- = urine; PNA = point-of-care. POC method not distinguished."
}
concept "U-PH (STICKA)" {
    comment "en" "U-pH (sticka) = urine pH by test strip."
}
concept "U-PORFYRINER" {
    comment "en" "U-Porfyriner = urine porphyrins. Moles/volume match."
}
concept "U-PORFYRINER FRAKT." {
    name "sv" "U-PORFYRINER FRAKT"
    comment "en" """
        Porfyriner frakt; = porphyrin fractionation. panel-level code  exact collection interval
        unknown.
        """
}
concept "U-PORFYRINER/KREAT." {
    name "sv" "U-PORFYRINER/KREAT"
    comment "en" "Porphyrins/creatinine ratio in urine  creatinine-normalized porphyrin excretion."
}
concept "U-PREGABALIN" {
    comment "en" "U-prefix = urine  therapeutic drug monitoring."
}
concept "U-PREGNANTRIOL" {
    comment "en" "U- = urine  Pregnantriol = pregnanetriol (steroid metabolite, CAH workup)."
}
concept "U-PREGNANTRIOL/KREAT"
concept "U-PROTEIN" {
    comment "en" "U- = urine. total protein concentration. Standard quantitative protein in urine."
}
concept "U-PROTEIN/KREATININ" {
    comment "en" "Standard protein/creatinine ratio in urine (not 24h)."
}
