    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "Blood LOINC is appropriate."
}
mapping "P(AB)-KALIUM.1" source="P(AB)-KALIUM" target="75940-7" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        P(aB)-Kalium = potassium in plasma from arterial blood gas  blood specimen covers point-of-care
