mapping "P(AB)-GLUKOS (PNA).1" source="P(AB)-GLUKOS (PNA)" target="2339-0" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        P(aB)-Glukos (PNA) = point-of-care blood-gas analyzer glucose from arterial blood. POC-specific
