// Swedish hospital local laboratory test codes to LOINC mappings, codes P
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "P(AB)-BILIRUBIN(PNA).1" source="P(AB)-BILIRUBIN(PNA)" target="42719-5" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "Total bilirubin from arterial blood gas analyzer (PNA)  Blood specimen closest."
}
mapping "P(AB)-CA JON PH 7,4.1" source="P(AB)-CA JON PH 7,4" target="1994-3" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "pH-adjusted as target unadjusted blood calcium as weak alt."
}
mapping "P(AB)-CA JON PH 7,4.2" source="P(AB)-CA JON PH 7,4" target="53138-4" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "P(AB)-CAJON OKOR/PNA.1" source="P(AB)-CAJON OKOR/PNA" target="12180-6" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "P(AB)-CAJON OKORR..1" source="P(AB)-CAJON OKORR." target="59470-5" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "mass/vol as strict  pH-adjusted mol/vol as weak."
}
mapping "P(AB)-CAJON OKORR..2" source="P(AB)-CAJON OKORR." target="53138-4" relationship=equivalent preference=alternative {
