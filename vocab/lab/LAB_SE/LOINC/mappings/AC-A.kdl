// Swedish hospital local laboratory test codes to LOINC mappings, codes AC-A
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "ACTH.1" source="ACTH" target="2141-0" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "Measured in plasma (not serum)  Exact LOINC match."
}
mapping "ADH.1" source="ADH" target="14949-2" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
