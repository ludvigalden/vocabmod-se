// Swedish hospital local laboratory test codes to LOINC mappings, codes T
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "TAU GENOTYP.1" source="TAU GENOTYP" target="40478-0" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "MAPT gene genotype for frontotemporal dementia/tauopathy risk  Exact LOINC match but."
}
mapping "TBC-AGGREGATION.1" source="TBC-AGGREGATION" target="4680-5" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        TBC-Aggregation = thrombocyte (platelet) aggregation test  best LOINC match is vWF ristocetin
        cofactor as related platelet function assay.
        """
}
