// Swedish hospital local laboratory test codes to LOINC mappings, codes BC-BM
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "BCR-ABL1 MUTATION.1" source="BCR-ABL1 MUTATION" target="55135-8" relationship=partial_overlap effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "BCR-ABL1 mutation analysis  kinase domain mutation panel is closest match."
}
mapping "BCR-ABL1 T(9;22).1" source="BCR-ABL1 T(9;22)" target="46434-7" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        22) Philadelphia chromosome  cells/total as primary, fusion transcript ratio as weak
        alternative.
        """
}
mapping "BCR-ABL1 T(9;22).2" source="BCR-ABL1 T(9;22)" target="21795-0" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "BCR/ABL MRNA P190.1" source="BCR/ABL MRNA P190" target="49496-3" relationship=partial_overlap effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "LOINC e1a1 is closest available."
}
mapping "BCRABL1 RNA.1" source="BCRABL1 RNA" target="46434-7" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        BCR-ABL1 RNA quantification  ratio concept selected as it represents the quantitative RNA assay.
