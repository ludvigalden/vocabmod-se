}
mapping "AB-SYRGASMÄTTNAD/PNA.1" source="AB-SYRGASMÄTTNAD/PNA" target="51733-4" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "weak target is direct measurement."
}
mapping "AB-SYRGASMÄTTNAD/PNA.2" source="AB-SYRGASMÄTTNAD/PNA" target="2708-6" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "AB-THB.1" source="AB-THB" target="30313-1" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        aB-tHb = total hemoglobin in arterial blood gas analysis  medium confidence since gas-analysis
        Hb vs routine Hb may differ slightly.
        """
