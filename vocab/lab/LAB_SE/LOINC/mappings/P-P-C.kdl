// Swedish hospital local laboratory test codes to LOINC mappings, codes P-P-C
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "P- APCR B.1" source="P- APCR B" target="13590-5" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        P- = plasma, APCR = activated protein C resistance, B = coagulation assay variant. Primary match
        is time ratio (quantitative). presence result is alternative.
        """
}
mapping "P- APCR B.2" source="P- APCR B" target="48596-1" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
