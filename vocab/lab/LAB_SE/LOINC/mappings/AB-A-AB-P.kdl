// Swedish hospital local laboratory test codes to LOINC mappings, codes AB-A-AB-P
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
    }
}
mapping "AB-AKT.BIKARB.(PNA).1" source="AB-AKT.BIKARB.(PNA)" target="1959-6" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "AB-AKT.BIKARBONAT.1" source="AB-AKT.BIKARBONAT" target="1959-6" relationship=equivalent {
