// NPU retrieval adjudication mappings to LOINC, codes SWE15164-SWE15256
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
context {
    collection "npu-loinc-retrieval" version="2026.1"
    source system="NPU" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "SWE15164.retr.1" source="SWE15164" target="8048-1" relationship=source_is_broader_than_target preference=primary {
