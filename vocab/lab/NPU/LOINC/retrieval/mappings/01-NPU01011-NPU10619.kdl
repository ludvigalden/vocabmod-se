// targets referenced by code only.
context {
    collection "npu-loinc-retrieval" version="2026.1"
    source system="NPU" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
