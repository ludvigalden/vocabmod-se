// NPU: Nomenclature for Properties and Units (IFCC/IUPAC), the full registry the source
// dataset's npu export carries: the international NPU codes and the SWE national extensions, one
// designation (the IFCC/IUPAC full definition) and one synonym (the report name) per code. The
// source header names no edition, so the release is the source registry's version
// (label-source=registry).
system "NPU" kind=classification distribution=published publisher="se.equalis" default-locale="sv" {
    name "en" "Nomenclature for Properties and Units"
}
release "2025" system="NPU" label-source=registry
context {
    system "NPU" release="2025"
}
category "lab-test" {
    name "en" "Laboratory test"
}
import "concepts/**/*.kdl" kind=fragment
