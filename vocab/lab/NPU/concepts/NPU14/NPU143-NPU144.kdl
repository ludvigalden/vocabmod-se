// NPU laboratory tests, prefix NPU14, codes NPU143-NPU144
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU14322" {
    name "sv" "Plasma—Protein C(aktiverat) resistens;relativ tid(med/utan exogent aktiverat protein C;procedur)"
    synonym "sv" "P—APC-resistenskvot"
}
measurement-definition "NPU14322" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Protein C(aktiverat) resistens" property-kind="relativ tid" specification="med/utan exogent aktiverat protein C;procedur"
