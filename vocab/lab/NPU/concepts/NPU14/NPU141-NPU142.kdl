// NPU laboratory tests, prefix NPU14, codes NPU141-NPU142
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU14104" {
    name "sv" "Plasma(arteriellt Blod)—Oxygen(O2);gastension(patient kroppstemperatur)"
    synonym "sv" "P(aB)—pO2 (Pt temp)"
}
measurement-definition "NPU14104" result-type=quantity specimen="Plasma(arteriellt Blod)" component="Oxygen(O2)" property-kind="gastension" specification="patient kroppstemperatur" {
    unit "kPa" namespace="npu"
}
