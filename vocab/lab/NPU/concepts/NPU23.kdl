// NPU laboratory tests, prefix NPU23, codes NPU23111-NPU23881
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU23111" {
    name "sv" "Urin—Amfetamin;masskoncentration"
    synonym "sv" "U—Amfetamin"
}
measurement-definition "NPU23111" result-type=quantity specimen="Urin" component="Amfetamin" property-kind="masskoncentration" {
    unit "µg/L" namespace="npu"
}
