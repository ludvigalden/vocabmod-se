// NPU laboratory tests, prefix NPU28, codes NPU288
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU28800" {
    name "sv" "Patient—Glukos(administrerat);massa(oralt administrerat)"
