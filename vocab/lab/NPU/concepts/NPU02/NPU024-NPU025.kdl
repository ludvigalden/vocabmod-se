// NPU laboratory tests, prefix NPU02, codes NPU024-NPU025
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU02401" {
    name "sv" "Cerebrospinalvätska—Homovanillat;substanskoncentration"
    synonym "sv" "Csv—HVA"
}
measurement-definition "NPU02401" result-type=quantity specimen="Cerebrospinalvätska" component="Homovanillat" property-kind="substanskoncentration" {
    unit "µmol/L" namespace="npu"
}
concept "NPU02402" {
    name "sv" "Urin—Homovanillat;substanskoncentration"
    synonym "sv" "U—HVA"
}
measurement-definition "NPU02402" result-type=quantity specimen="Urin" component="Homovanillat" property-kind="substanskoncentration" {
    unit "µmol/L" namespace="npu"
}
concept "NPU02409" {
    name "sv" "Plasma(arteriellt Blod)—Vätekarbonat;substanskoncentration(aktuell;37°C)"
