// NPU laboratory tests, prefix NPU07, codes NPU07296-NPU07437
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU07296" {
    name "sv" "Urin(mittstråle)—Bakterie(specifikation);känslighet(lista;ratioskala;procedur)"
    synonym "sv" "U(mittstr)—Bakt (k,list)"
    status "inactive"
}
measurement-definition "NPU07296" result-type=quantity procedure-defined-unit=#true specimen="Urin(mittstråle)" component="Bakterie(specifikation)" property-kind="känslighet" specification="lista;ratioskala;procedur"
concept "NPU07420" {
    name "sv" "Urin(specifikation)—Bakterie;antalskoncentration(procedur)"
