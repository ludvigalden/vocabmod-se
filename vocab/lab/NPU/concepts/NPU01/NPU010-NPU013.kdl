// NPU laboratory tests, prefix NPU01, codes NPU010-NPU013
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU01011" {
    name "sv" "Plasma—Acetoacetat;substanskoncentration"
    synonym "sv" "P—Acetoacetat"
}
