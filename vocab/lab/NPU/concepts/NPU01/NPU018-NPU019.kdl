// NPU laboratory tests, prefix NPU01, codes NPU018-NPU019
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU01805" {
    name "sv" "Kreatinkinas(Plasma)—Kreatinkinastyp;katalytisk fraktion(lista;37°C;procedur)"
    synonym "sv" "CK(P)—CK isoenzym"
}
measurement-definition "NPU01805" result-type=quantity procedure-defined-unit=#true specimen="Kreatinkinas(Plasma)" component="Kreatinkinastyp" property-kind="katalytisk fraktion" specification="lista;37°C;procedur"
concept "NPU01807" {
    name "sv" "Plasma—Kreatinin;substanskoncentration(Jaffe)"
    synonym "sv" "P—Kreatinin (Jaffe)"
}
measurement-definition "NPU01807" result-type=quantity specimen="Plasma" component="Kreatinin" property-kind="substanskoncentration" specification="Jaffe" {
    unit "µmol/L" namespace="npu"
}
