// NPU laboratory tests, prefix NPU63, codes NPU632-NPU633
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU63232" {
    name "sv" "Blod—Granulocyter(omogen);antalskoncentration"
    synonym "sv" "B—Omogna granulocyter"
}
measurement-definition "NPU63232" result-type=quantity specimen="Blod" component="Granulocyter(omogen)" property-kind="antalskoncentration" {
    unit "x10^9/L" namespace="npu"
}
concept "NPU63244" {
    name "sv" "Sekret(Konjunktiva;specifikation)—Neisseria gonorrhoeae;taxon(procedur)"
    synonym "sv" "Konj—Neisseria gonorrhoeae (gonokock), odling"
}
measurement-definition "NPU63244" result-type=quantity procedure-defined-unit=#true specimen="Sekret(Konjunktiva;specifikation)" component="Neisseria gonorrhoeae" property-kind="taxon" specification="procedur"
concept "NPU63263" {
    name "sv" "DNA(specifikation)—DPYD-gen(NG_008807.2:g.346167C>G);entitiskt antal(0 1 2)"
