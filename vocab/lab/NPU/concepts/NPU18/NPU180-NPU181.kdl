// NPU laboratory tests, prefix NPU18, codes NPU180-NPU181
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU18000" {
    name "sv" "Ledvätska(specifikation)—Leukocyter(mononukleära);antalskoncentration"
    synonym "sv" "Ledv—Leukocyter, mono"
}
