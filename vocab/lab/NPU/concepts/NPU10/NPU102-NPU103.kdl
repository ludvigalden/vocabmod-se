// NPU laboratory tests, prefix NPU10, codes NPU102-NPU103
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU10202" {
    name "sv" "Erytrocyter(Blod)—Porfobilinogendeaminas;katalytisk koncentration(37°C;procedur)"
    synonym "sv" "Erc(B)—PBGD"
}
measurement-definition "NPU10202" result-type=quantity procedure-defined-unit=#true specimen="Erytrocyter(Blod)" component="Porfobilinogendeaminas" property-kind="katalytisk koncentration" specification="37°C;procedur" {
    unit "nkat/L" namespace="npu"
}
