// NPU laboratory tests, prefix NPU10, codes NPU106-NPU107
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU10600" {
    name "sv" "Plasma—Alkaliskt fosfatas, lever endotelialtyp;katalytisk koncentration(37°C;procedur)"
    synonym "sv" "P—ALP, lever endotel typ"
}
measurement-definition "NPU10600" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Alkaliskt fosfatas, lever endotelialtyp" property-kind="katalytisk koncentration" specification="37°C;procedur" {
    unit "µkat/L" namespace="npu"
}
