// NPU laboratory tests, prefix NPU10, codes NPU100-NPU101
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU10000" {
    name "sv" "Transferrin(Plasma)—Kolhydratfattigt transferrin;substansfraktion"
    synonym "sv" "Transf(P)—CDT, fraktion"
    status "inactive"
}
measurement-definition "NPU10000" result-type=quantity specimen="Transferrin(Plasma)" component="Kolhydratfattigt transferrin" property-kind="substansfraktion"
concept "NPU10001" {
    name "sv" "Patient(Urin)—Vanillinmandelat/Kreatinin;substansflödeskvot(procedur)"
    synonym "sv" "tU—VMA/Krea"
}
measurement-definition "NPU10001" result-type=quantity procedure-defined-unit=#true specimen="Patient(Urin)" component="Vanillinmandelat/Kreatinin" property-kind="substansflödeskvot" specification="procedur" {
    unit "x10^-3" namespace="npu"
}
