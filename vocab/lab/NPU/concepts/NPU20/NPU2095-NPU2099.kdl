// NPU laboratory tests, prefix NPU20, codes NPU2095-NPU2099
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU20950" {
    name "sv" "Plasma—Erytrocyt Dantu-antikropp;arbiträr substanskoncentration(37°C;procedur)"
