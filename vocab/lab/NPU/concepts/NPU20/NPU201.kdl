// NPU laboratory tests, prefix NPU20, codes NPU201
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU20100" {
    name "sv" "Plasma—Rött vinbär-antikropp(Immunglobulin E);arbiträr substanskoncentration(f322;procedur)"
    synonym "sv" "P—Rött vinbär-ak"
}
measurement-definition "NPU20100" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Rött vinbär-antikropp(Immunglobulin E)" property-kind="arbiträr substanskoncentration" specification="f322;procedur" {
    unit "(pde)" namespace="npu"
}
