// NPU laboratory tests, prefix NPU03, codes NPU039
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU03902" {
    name "sv" "Plasma—Oxkarbazepin;substanskoncentration"
    synonym "sv" "P—Oxkarbazepin"
}
