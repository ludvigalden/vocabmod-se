// NPU laboratory tests, prefix NPU03, codes NPU030-NPU033
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU03010" {
    name "sv" "Hemoglobin(Blod)—Oxygen(O2);gastension(vid halvmättnad)"
    synonym "sv" "Hb(B)—Oxygen p50"
}
measurement-definition "NPU03010" result-type=quantity specimen="Hemoglobin(Blod)" component="Oxygen(O2)" property-kind="gastension" specification="vid halvmättnad" {
    unit "kPa" namespace="npu"
}
