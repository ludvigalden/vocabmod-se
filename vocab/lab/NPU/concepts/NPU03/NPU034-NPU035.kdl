// NPU laboratory tests, prefix NPU03, codes NPU034-NPU035
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU03404" {
    name "sv" "Blod—Sänkningsreaktion;längd(Westergren,1h)"
    synonym "sv" "B—SR"
}
measurement-definition "NPU03404" result-type=quantity specimen="Blod" component="Sänkningsreaktion" property-kind="längd" specification="Westergren,1h" {
    unit "mm" namespace="npu"
}
