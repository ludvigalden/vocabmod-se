    synonym "sv" "tU—Protein HC"
}
measurement-definition "NPU57104" result-type=quantity specimen="Patient(Urin)" component="alfa-1-Mikroglobulin" property-kind="massflöde" {
    unit "mg/d" namespace="npu"
}
concept "NPU57111" {
    name "sv" "DNA(Plasma)—LCT-gen(LRG_338:g.9094C>T);arbiträrt innehåll(procedur)"
    synonym "sv" "DNA(P)—LCT-gen 13910 C>T"
