// NPU laboratory tests, prefix NPU57, codes NPU571
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU57100" {
    name "sv" "Urin—3,4-Metylendioxipyrovaleron;masskoncentration"
    synonym "sv" "U—3,4-MDPV"
}
measurement-definition "NPU57100" result-type=quantity specimen="Urin" component="3,4-Metylendioxipyrovaleron" property-kind="masskoncentration" {
    unit "µg/L" namespace="npu"
}
concept "NPU57101" {
    name "sv" "Urin—Mefedron;masskoncentration"
    synonym "sv" "U—Mefedron"
}
measurement-definition "NPU57101" result-type=quantity specimen="Urin" component="Mefedron" property-kind="masskoncentration" {
    unit "µg/L" namespace="npu"
}
