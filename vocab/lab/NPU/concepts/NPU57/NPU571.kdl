}
measurement-definition "NPU57111" result-type=quantity procedure-defined-unit=#true specimen="DNA(Plasma)" component="LCT-gen(LRG_338:g.9094C>T)" property-kind="arbiträrt innehåll" specification="procedur"
concept "NPU57130" {
    name "sv" "Plasma—Hemoglobin;masskoncentration"
