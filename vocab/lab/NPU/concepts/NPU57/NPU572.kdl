// NPU laboratory tests, prefix NPU57, codes NPU572
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU57202" {
    name "sv" "System(specifikation)—Bakterie(specifikation);känslighet(Gentamicin;tröskelmasskoncentration;procedur)"
