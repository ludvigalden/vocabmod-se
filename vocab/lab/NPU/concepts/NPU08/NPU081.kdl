// NPU laboratory tests, prefix NPU08, codes NPU081
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU08100" {
    name "sv" "Plasma—Salmonella-antikropp;arbiträr substanskoncentration(procedur)"
    synonym "sv" "P—Salmonella-ak"
}
measurement-definition "NPU08100" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Salmonella-antikropp" property-kind="arbiträr substanskoncentration" specification="procedur" {
    unit "(pde)" namespace="npu"
}
