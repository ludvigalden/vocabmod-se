// NPU laboratory tests, prefix NPU26, codes NPU261-NPU264
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU26171" {
    name "sv" "Plasma—Prolaktin;masskoncentration(0 minuter efter stimulering)"
    synonym "sv" "P—Prolaktin (0 min)"
}
measurement-definition "NPU26171" result-type=quantity specimen="Plasma" component="Prolaktin" property-kind="masskoncentration" specification="0 minuter efter stimulering" {
    unit "µg/L" namespace="npu"
}
