// NPU laboratory tests, prefix NPU26, codes NPU269
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU26900" {
    name "sv" "Cerebrospinalvätska—Metylmalonat;substanskoncentration"
    synonym "sv" "Csv—Metylmalonat"
}
measurement-definition "NPU26900" result-type=quantity specimen="Cerebrospinalvätska" component="Metylmalonat" property-kind="substanskoncentration" {
    unit "µmol/L" namespace="npu"
}
