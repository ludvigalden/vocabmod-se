// NPU laboratory tests, prefix SWE05, codes SWE0555-SWE0559
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "SWE05550" {
    name "sv" "Leukocyter(Blod)—Granulocyter;antalsfraktion"
    synonym "sv" "Lkc(B)—Granulocyter"
}
