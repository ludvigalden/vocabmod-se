// NPU laboratory tests, prefix SWE05, codes SWE0506-SWE0509
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "SWE05060" {
    name "sv" "Amfetamin(Urin)—Levamfetamin;substansfraktion"
    synonym "sv" "U—Levamfetamin-fraktion"
}
measurement-definition "SWE05060" result-type=quantity specimen="Amfetamin(Urin)" component="Levamfetamin" property-kind="substansfraktion" {
    unit "%" namespace="npu"
}
