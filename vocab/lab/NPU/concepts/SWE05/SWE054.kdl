// NPU laboratory tests, prefix SWE05, codes SWE054
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "SWE05400" {
    name "sv" "Hemoglobin(Fe;O2-bindande;venöst Blod)—Oxygen(O2);mättnad"
    synonym "sv" "Hb(vB)—Oxygenmättnad"
}
measurement-definition "SWE05400" result-type=quantity specimen="Hemoglobin(Fe;O2-bindande;venöst Blod)" component="Oxygen(O2)" property-kind="mättnad" {
    unit "%" namespace="npu"
}
