// NPU laboratory tests, prefix NPU60, codes NPU602
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU60200" {
    name "sv" "Plasma—Erytrocyt Tm-antikropp;arbiträr substanskoncentration(20°C;procedur)"
    synonym "sv" "P—anti-Tm 20°C"
}
measurement-definition "NPU60200" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Erytrocyt Tm-antikropp" property-kind="arbiträr substanskoncentration" specification="20°C;procedur" {
    unit "(pde)" namespace="npu"
}
