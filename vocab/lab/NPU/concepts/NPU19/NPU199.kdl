// NPU laboratory tests, prefix NPU19, codes NPU199
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU19903" {
    name "sv" "Plasma—Renin;masskoncentration"
    synonym "sv" "P—Renin"
}
measurement-definition "NPU19903" result-type=quantity specimen="Plasma" component="Renin" property-kind="masskoncentration" {
    unit "ng/L" namespace="npu"
}
