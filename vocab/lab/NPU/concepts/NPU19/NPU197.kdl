// NPU laboratory tests, prefix NPU19, codes NPU197
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU19700" {
    name "sv" "Plasma—Apolipoprotein(a);masskoncentration"
    synonym "sv" "P—Apolipoprotein(a)"
    status "inactive"
}
measurement-definition "NPU19700" result-type=quantity specimen="Plasma" component="Apolipoprotein(a)" property-kind="masskoncentration" {
    unit "mg/L" namespace="npu"
}
