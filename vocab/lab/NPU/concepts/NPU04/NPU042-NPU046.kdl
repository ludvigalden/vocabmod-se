// NPU laboratory tests, prefix NPU04, codes NPU042-NPU046
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU04200" {
    name "sv" "Plasma—Tyrotropin;arbiträr substanskoncentration(IRP 80/558;20 minuter efter stimulering;procedur)"
    synonym "sv" "P—TSH (20 min)"
}
measurement-definition "NPU04200" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Tyrotropin" property-kind="arbiträr substanskoncentration" specification="IRP 80/558;20 minuter efter stimulering;procedur" {
    unit "mIE/L" namespace="npu"
}
