// NPU laboratory tests, prefix NPU04, codes NPU049
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU04912" {
    name "sv" "Urin—Oxikodon;substanskoncentration"
    synonym "sv" "U—Oxikodon"
}
measurement-definition "NPU04912" result-type=quantity specimen="Urin" component="Oxikodon" property-kind="substanskoncentration" {
    unit "µmol/L" namespace="npu"
}
