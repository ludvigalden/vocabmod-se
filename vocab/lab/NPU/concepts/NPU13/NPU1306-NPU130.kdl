// NPU laboratory tests, prefix NPU13, codes NPU1306-NPU130
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU13060" {
    name "sv" "Plasma—Ambrosia artemisifolia-antikropp(Immunglobulin E);arbiträr substanskoncentration(w1;procedur)"
    synonym "sv" "P—A.artemisifolia-ak"
}
measurement-definition "NPU13060" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Ambrosia artemisifolia-antikropp(Immunglobulin E)" property-kind="arbiträr substanskoncentration" specification="w1;procedur" {
    unit "(pde)" namespace="npu"
}
