// NPU laboratory tests, prefix NPU13, codes NPU1337-NPU1339
context {
    system "NPU" release="2025"
}
defaults {
    concepts {
        status "active"
        class "lab-test"
    }
}
concept "NPU13370" {
    name "sv" "Plasma—Rödspotta-antikropp(Immunglobulin E);arbiträr substanskoncentration(f254;procedur)"
    synonym "sv" "P—Rödspotta-ak"
}
measurement-definition "NPU13370" result-type=quantity procedure-defined-unit=#true specimen="Plasma" component="Rödspotta-antikropp(Immunglobulin E)" property-kind="arbiträr substanskoncentration" specification="f254;procedur" {
    unit "(pde)" namespace="npu"
}
