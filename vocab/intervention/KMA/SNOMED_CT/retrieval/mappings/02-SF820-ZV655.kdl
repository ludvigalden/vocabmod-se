// KVÅ medical procedure retrieval adjudication mappings to SNOMED CT, codes SF820-ZV655
// Each mapping records a third blinded tie-break pass;
// targets referenced by code only.
// Individual Swedish procedure titles quoted in the rationales below are quotations from
// E-hälsomyndigheten, Klassifikation av medicinska åtgärder (KVÅ), release 2026. They serve
// as adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "kma-snomed-ct-retrieval" version="2026.1"
    source system="KMA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "SF820.retr.1" source="SF820" target="241691000" relationship=related_to preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Blinded rubric adjudication, third tie-break pass: the two prior blinded passes each chose a different defensible target; this pass resolved the tie-break. Evidence: designation text. Omissions recorded: captures only the rectal induction component; airway control (rapid sequence induction regardless of intubation route), main maintenance of anesthesia/sedation (intravenous with relaxation), and analgesia maintenance (none) lost."
}
