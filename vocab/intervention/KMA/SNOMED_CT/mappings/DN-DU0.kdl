mapping "DR055.1" source="DR055" target="302497006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source DR055 SNOMED CT 302497006 = hemodialysis using citrate-based regional anticoagulation (a
        technique variant of dialysis, not a distinct disorder/procedure concept). No SNOMED CT concept
        exists in the mirror (only citrate anticoagulation solution 467650001 and citrate intoxication).
        Target, the parent procedure that subsumes the citrate-anticoagulation variant. Broader: every
        citrate dialysis is a hemodialysis, but not vice versa. Low confidence: the
        citrate-anticoagulation aspect is lost and this is the best-available parent, not a verified
        crosswalk.
        """
}
mapping "DR056.1" source="DR056" target="302497006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source DR056 SNOMED CT 302497006 = heparin-free hemodialysis (a dialysis session performed without
        heparin anticoagulation, typically using saline/zero-balance techniques; a technique variant,
        not a distinct procedure concept). No SNOMED CT concept exists. Target, the parent that subsumes
        the heparin-free variant. Broader: every heparin-free dialysis is a hemodialysis. Low
        confidence: the heparin-free aspect is lost; best-available parent, not a verified crosswalk.
        """
}
