// KVÅ medical procedures to SNOMED CT mappings, codes AH-AM
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kma-snomed-ct" version="2026.1"
    source system="KMA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "AH008.1" source="AH008" target="80865008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Mammografisk preparatundersokning = mammographic examination of a specimen; SNOMED CT 2100100425
        80865008 is the exact SNOMED CT equivalent.
        """
}
