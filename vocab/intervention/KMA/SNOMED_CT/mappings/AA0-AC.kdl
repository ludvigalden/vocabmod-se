// KVÅ medical procedures to SNOMED CT mappings, codes AA0-AC
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kma-snomed-ct" version="2026.1"
    source system="KMA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
