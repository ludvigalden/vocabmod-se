// KVÅ medicinska åtgärder: the Swedish medical procedure classification, the inventory the
// source dataset carries.
system "KMA" kind=classification distribution=published publisher="se.ehalsomyndigheten" default-locale="sv" {
    name "sv" "Klassifikation av medicinska åtgärder (KVÅ medicinska)"
}
release "2026" system="KMA" label-source=registry
context {
    system "KMA" release="2026"
}
category "procedure" {
    name "en" "KVÅ medical procedure"
}
collection "kma-omop-custom" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "KVÅ medical procedures (KMÅ) to OMOP custom concepts"
    authors "ludvig-alden"
    source system="KMA" release="2026"
    target system="OMOP_CUSTOM"
    import "OMOP_CUSTOM/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
collection "kma-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "KVÅ medical procedures (KMÅ) to SNOMED CT"
    authors "ludvig-alden"
    source system="KMA" release="2026"
    target system="SNOMED_CT" release="20251130"
    import "SNOMED_CT/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
