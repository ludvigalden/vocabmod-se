// KVÅ kirurgiska åtgärder: the Swedish surgical procedure classification, the inventory the
// source dataset carries.
system "KKA" kind=classification distribution=published publisher="se.ehalsomyndigheten" default-locale="sv" {
    name "sv" "Klassifikation av kirurgiska åtgärder (KVÅ kirurgiska)"
}
release "2026" system="KKA" label-source=registry
context {
    system "KKA" release="2026"
}
category "procedure" {
    name "en" "KVÅ surgical procedure"
}
collection "kka-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "KVÅ surgical procedures (KKÅ) to SNOMED CT"
    authors "ludvig-alden"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
    import "SNOMED_CT/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
