// KVÅ surgical procedures to SNOMED CT mappings, codes NEH-NFF
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kka-snomed-ct" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "NEH99.1" source="NEH99" target="SNOMED_CT:28181007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source NEH99 SNOMED CT 28181007 = KVÅ residual (sacroiliac or symphysis). Target (Athena-local). No
        specific pelvic-joint operation standard exists; hip joint is the nearest anatomical neighbor.
        Broader; confidence low (residual source, indirect match).
        """
}
