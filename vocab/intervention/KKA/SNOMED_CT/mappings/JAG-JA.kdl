// KVÅ surgical procedures to SNOMED CT mappings, codes JAG-JA
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kka-snomed-ct" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "JAG10.1" source="JAG10" target="SNOMED_CT:719726009" relationship=source_is_narrower_than_target preference=alternative effect=omitted quality=60 {
