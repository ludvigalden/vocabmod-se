// KVÅ surgical procedures to SNOMED CT mappings, codes VBJ-VCB
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kka-snomed-ct" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "VBJ00.1" source="VBJ00" target="SNOMED_CT:40298007" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
