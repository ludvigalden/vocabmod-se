// KVÅ surgical procedures to SNOMED CT mappings, codes FKC-FNC
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kka-snomed-ct" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "FKC10.1" source="FKC10" target="SNOMED_CT:310396003" relationship=equivalent quality=100 {
