// KVÅ surgical procedures to SNOMED CT mappings, codes CBC-CEE
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "kka-snomed-ct" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "CBC00.1" source="CBC00" target="SNOMED_CT:12762001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
}
mapping "CBC99.1" source="CBC99" target="SNOMED_CT:172274000" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source CBC99 SNOMED CT 172274000 = Other operation for eyelid injury (KVÅ residual). Target. Source
        is specifically trauma-related; target is the general eyelid operations parent. Broader. Low
        tier: no crosswalk, trauma indication lost.
        """
}
