// KVÅ surgical procedure retrieval adjudication mappings to SNOMED CT, codes NEK19-VGA23
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual Swedish procedure titles quoted in the rationales below are quotations from
// E-hälsomyndigheten, Klassifikation av kirurgiska åtgärder (KVÅ), release 2026. They serve
// as adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "kka-snomed-ct-retrieval" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "NEK19.retr.1" source="NEK19" target="123014005" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Procedure (KVÅ surgical procedures NEK19): partial or total excision of pelvic bone; designation on sheet, disjunctive extent. Omissions recorded: bone-tissue restriction, partial/total extent."
}
