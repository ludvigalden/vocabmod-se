// KVÅ surgical procedure retrieval adjudication mappings to SNOMED CT, codes FHA96-JLB28
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual Swedish procedure titles quoted in the rationales below are quotations from
// E-hälsomyndigheten, Klassifikation av kirurgiska åtgärder (KVÅ), release 2026. They serve
// as adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "kka-snomed-ct-retrieval" version="2026.1"
    source system="KKA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "FHA96.retr.1" source="FHA96" target="52930005" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
     rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Procedure: other closure of acquired ventricular septal defect (residual); candidate FSN — closure of an acquired VSD entails VSD closure. Omissions recorded: förvärvad (acquired) qualifier, residual (annan) restriction."
}
