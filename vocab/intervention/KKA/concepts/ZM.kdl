// KVÅ surgical procedures, group ZM, codes ZMC00-ZMX09
context {
    system "KKA" release="2026"
}
defaults {
    concepts {
        status "active"
        class "procedure"
    }
}
concept "ZMC00" {
    name "en" "Caesarean section performed before onset of labour"
}
concept "ZMC01" {
    name "en" "Caesarean section performed after rupture of membranes without contractions"
}
concept "ZMC02" {
    name "en" "Caesarean section performed in latent phase"
}
concept "ZMX00" {
    name "en" "Procedure performed before onset of labour"
}
concept "ZMX01" {
    name "en" "Procedure performed after rupture of membranes without contractions"
}
concept "ZMX02" {
    name "en" "Procedure performed in latent phase"
}
concept "ZMX06" {
    name "en" "Procedure performed in placental stage (before placental delivery)"
}
concept "ZMX07" {
    name "en" "Procedure performed less than 2 hours postpartum"
}
concept "ZMX08" {
    name "en" "Procedure performed 2-24 hours postpartum"
}
concept "ZMX09" {
    name "en" "Procedure performed more than 24 hours postpartum"
}
