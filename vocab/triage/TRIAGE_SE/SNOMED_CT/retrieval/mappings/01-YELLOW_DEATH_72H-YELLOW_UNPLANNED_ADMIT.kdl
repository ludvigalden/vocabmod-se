// RETTS triage level retrieval adjudication mappings to SNOMED CT, codes YELLOW_DEATH_72H-YELLOW_UNPLANNED_ADMIT
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
context {
    collection "triage-se-snomed-ct-retrieval" version="2026.1"
    source system="TRIAGE_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "YELLOW_DEATH_72H.retr.1" source="YELLOW_DEATH_72H" target="419099009" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
     rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Swedish outcome event (Observation) for RETTS triage levels YELLOW_DEATH_72H (death within 72 hours) entails SNOMED CT Observation 434489 / FSN; candidates with 24-hour (442289) or sudden/unexpected/instantaneo. Omissions recorded: 72-hour time window (relative to the emergency department visit)."
}
mapping "YELLOW_UNPLANNED_ADMIT.retr.1" source="YELLOW_UNPLANNED_ADMIT" target="405614004" relationship=equivalent preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
     rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Swedish admission type (Observation) for RETTS triage levels YELLOW_UNPLANNED_ADMIT (unplanned admission) vs SNOMED CT Observation 4236739 / FSN; 44803024 adds 'l."
}
