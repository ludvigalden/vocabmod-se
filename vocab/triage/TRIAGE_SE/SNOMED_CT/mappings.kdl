// RETTS triage codes to SNOMED CT mappings, codes ESS-01-RLS-85
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "triage-se-snomed-ct" version="2026.1"
    source system="TRIAGE_SE" release="2024"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
