// Agents, licenses, and the predicate every published hierarchy uses.
// Agents are grouped by kind and sorted by id within each group.
agent "inserm.orphanet" kind=organization {
    name "en" "Orphanet (INSERM)"
}
agent "int.who" kind=organization {
    name "en" "World Health Organization"
}
agent "msso" kind=organization {
    name "en" "MedDRA Maintenance and Support Services Organization"
}
agent "nordic.nomesco" kind=organization {
    name "en" "Nordic Medico-Statistical Committee (NOMESCO)"
}
agent "org.regenstrief" kind=organization {
    name "en" "Regenstrief Institute"
}
agent "se.ehalsomyndigheten" kind=organization {
    name "sv" "E-hälsomyndigheten"
    name "en" "Swedish eHealth Agency"
}
agent "se.equalis" kind=organization {
    name "sv" "Equalis"
}
agent "se.scb" kind=organization {
    name "sv" "Statistiska centralbyrån (SCB)"
}
agent "se.socialstyrelsen" kind=organization {
    name "sv" "Socialstyrelsen"
}
agent "se.tlv" kind=organization {
    name "sv" "Tandvårds- och läkemedelsförmånsverket"
}
agent "us.nchs" kind=organization {
    name "en" "United States National Center for Health Statistics"
}
agent "us.nlm" kind=organization {
    name "en" "United States National Library of Medicine"
}
agent "ludvig-alden" kind=person {
    name "en" "Ludvig Aldén"
}
license "cc-by-4.0" uri="https://creativecommons.org/licenses/by/4.0/" redistribution=permitted {
    name "en" "Creative Commons Attribution 4.0 International"
}
license "meddra" redistribution=prohibited {
    name "en" "MedDRA licence (MSSO); codes only in this tree"
}
// UCUM Copyright Notice and License 1.1 (https://ucum.org/license):
// free, revocable redistribution of the unmodified Work, with the four
// notices when the Work is reproduced in its entirety. Codes used as
// mapping endpoints interoperate with the Work and are not derivatives.
license "org.regenstrief.ucum" uri="https://ucum.org/license" redistribution=conditional {
    name "en" "UCUM Copyright Notice and License, version 1.1"
}
license "snomed-ct-affiliate" redistribution=prohibited {
    name "en" "SNOMED CT Affiliate License"
}
predicate "vocabmod:is-a" direction=forward hierarchical=#true defines-ancestry=#true require-acyclic=#true {
    name "en" "is a"
}
