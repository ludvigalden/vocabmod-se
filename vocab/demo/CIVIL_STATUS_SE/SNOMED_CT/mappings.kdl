// Swedish civil status codes to SNOMED CT mappings, codes EP-SP
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "civil-status-se-snomed-ct" version="2026.1"
    source system="CIVIL_STATUS_SE" release="2024"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "EP.1" source="EP" target="286141000000107" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "Exact semantic match for Swedish Efterlevande partner."
}
mapping "G.2" source="G" target="36629006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "OG.2" source="OG" target="125725006" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
}
mapping "RP.1" source="RP" target="286051000000109" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "Swedish SNOMED CT 286051000000109 (registered same-sex partnership"
}
mapping "S.2" source="S" target="286081000000103" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "SP.1" source="SP" target="286081000000103" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        SP = Skild partner (divorced from registered partnership). Exact match to SNOMED CT UK refset
        SNOMED CT 286081000000103 in Observation domain. Verified standard_concept=S, vocabulary_id=SNOMED,
        domain_id=Observation. Swedish registered partnership dissolution is semantically identical to
        UK civil partnership dissolution.
        """
}
