// Swedish civil status codes, misc: codes with no filename-safe letter range; -N names number the parts in file order
context {
    system "CIVIL_STATUS_SE" release="2024"
}
defaults {
    concepts {
        status "active"
        class "status"
    }
}
concept "EP" {
    name "sv" "Efterlevande partner"
    name "en" "Surviving partner"
}
concept "G" {
    name "sv" "Gift"
    name "en" "Married"
}
concept "OG" {
    name "sv" "Ogift"
    name "en" "Unmarried"
}
concept "RP" {
    name "sv" "Registrerad partner"
    name "en" "Registered partner"
}
concept "S" {
    name "sv" "Skild"
    name "en" "Divorced"
}
concept "SP" {
    name "sv" "Skild partner"
    name "en" "Divorced partner"
}
concept "Ä" {
    name "sv" "Änka/änkling"
    name "en" "Widow/widower"
}
