// LISA education levels, codes 1-9
context {
    system "LISA_EDUCATION" release="2024"
}
defaults {
    concepts {
        status "active"
        class "level"
    }
}
concept "1" {
    name "sv" "Förskoleutbildning"
    name "en" "Pre-primary education"
}
concept "2" {
    name "sv" "Folkskoleutbildning eller ospecificerad förgymnasial utbildning kortare än 9 år"
    name "en" "Primary education"
}
concept "3" {
    name "sv" "Grundskoleutbildning (9-10 år) och/eller 1-årig gymnasial utbildning"
    name "en" "Lower secondary education"
}
concept "4" {
    name "sv" "Gymnasial utbildning 2-3 år"
    name "en" "Upper secondary education"
}
concept "5" {
    name "sv" "Eftergymnasial utbildning 1 år"
    name "en" "Post-secondary non-tertiary education"
}
concept "6" {
    name "sv" "Eftergymnasial utbildning 2-3 år"
    name "en" "Short-cycle tertiary education"
}
concept "7" {
    name "sv" "Eftergymnasial utbildning 3 år"
    name "en" "Bachelor's or equivalent level"
}
concept "8" {
    name "sv" "Eftergymnasial utbildning 4-5 år"
    name "en" "Master's or equivalent level"
}
concept "9" {
    name "sv" "Forskarutbildning"
    name "en" "Doctoral or equivalent level"
}
