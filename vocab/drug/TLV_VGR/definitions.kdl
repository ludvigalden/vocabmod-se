// TLV varugrupperingskoder: the grouping codes for reimbursed
// consumable articles (stomi Y90, diabetes Y92, läkemedelsnära
// Y93). Code + group name only, verbatim from the TLV
// varugrupperingskoder document (2025-10-02); the hierarchy is
// the codes' own prefix structure, mirrored as parent links.
system "TLV_VGR" kind=classification distribution=published publisher="se.tlv" default-locale="sv" {
    name "sv" "Varugrupperingskoder"
}
release "2025-10-02" system="TLV_VGR" label-source=header
context {
    system "TLV_VGR" release="2025-10-02"
}
category "code" {
    name "en" "Varugrupp code"
}
collection "tlv-vgr-snomed-ct-retrieval" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "TLV product groups to SNOMED CT (retrieval)"
    authors "ludvig-alden"
    source system="TLV_VGR" release="2025-10-02"
    target system="SNOMED_CT" release="20251130"
    import "SNOMED_CT/retrieval/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
collection "tlv-vgr-rxnorm-retrieval" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "TLV product groups to RxNorm (retrieval)"
    authors "ludvig-alden"
    source system="TLV_VGR" release="2025-10-02"
    target system="RXNORM"
    import "RXNORM/retrieval/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
