// TLV product group retrieval adjudication mappings to SNOMED CT, codes Y90-Y93HA02
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual varugrupp names quoted in the rationales below are quotations from TLV,
// Varugrupperingskoder (release 2025-10-02), data that TLV offers for reuse. They serve as
// adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "tlv-vgr-snomed-ct-retrieval" version="2026.1"
    source system="TLV_VGR" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y90.retr.1" source="Y90" target="35398009" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Device: TLV Y90 'Förbrukningsartiklar - Stomi' general ostomy consumable category; SNOMED CT 4148230 / covers ostomy articles generally. Omissions recorded: restriction to consumable articles (appliance class also covers non-consumable devices)."
}
