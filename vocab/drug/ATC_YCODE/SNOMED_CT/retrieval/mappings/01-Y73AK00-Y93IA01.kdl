// ATC Y-code retrieval adjudication mappings to SNOMED CT, codes Y73AK00-Y93IA01
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual Swedish product-group names quoted in the rationales below are quotations
// from TLV, ATC Y-koder (produktgrupper för förbrukningsartiklar), release 2026 — data
// that TLV offers for reuse in its price-and-decision database. They serve as
// adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "atc-ycode-snomed-ct-retrieval" version="2026.1"
    source system="ATC_YCODE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y73AK00.retr.1" source="Y73AK00" target="337588003" relationship=equivalent preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
     rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Device source ATC Y-codes Y73AK00 'Incontinence product' -> SNOMED CT Device 4224994 deprecated suffix is status not meaning."
}
