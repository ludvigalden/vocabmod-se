// ATC Y-code retrieval adjudication mappings to SNOMED CT, codes Y85CA00-Y93JA01
// Each mapping records a third blinded tie-break pass;
// targets referenced by code only.
// Individual Swedish product-group names quoted in the rationales below are quotations
// from TLV, ATC Y-koder (produktgrupper för förbrukningsartiklar), release 2026 — data
// that TLV offers for reuse in its price-and-decision database. They serve as
// adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "atc-ycode-snomed-ct-retrieval" version="2026.1"
    source system="ATC_YCODE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y85CA00.retr.1" source="Y85CA00" target="32711007" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Blinded rubric adjudication, third tie-break pass: the two prior blinded passes each chose a different defensible target; this pass resolved the tie-break. Evidence: designation text (English designation 'Ostomy - drainable bag'). Omissions recorded: drainable (emptyable) bag property; candidate covers both drainable and closed ostomy collection bags."
}
mapping "Y90KC02.retr.1" source="Y90KC02" target="705679009" relationship=source_is_broader_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Blinded rubric adjudication, third tie-break pass: the two prior blinded passes each chose a different defensible target; this pass resolved the tie-break. Evidence: designation text ('Absorberande förband'). Omissions recorded: general absorbent-dressing scope of the source; candidate is restricted to exudate (wound exudate) absorption, which the source designation does not state."
}
mapping "Y90KC05.retr.1" source="Y90KC05" target="705679009" relationship=source_is_narrower_than_target preference=primary {
