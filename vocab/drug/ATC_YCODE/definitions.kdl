// ATC Y-codes: the Swedish national product-group extension for reimbursed consumables. No WHO ATC
// file exists in the source dataset; ATC itself is an external system.
system "ATC_YCODE" kind=classification distribution=published publisher="se.tlv" default-locale="sv" {
    name "sv" "ATC Y-koder (produktgrupper för förbrukningsartiklar)"
}
release "2026" system="ATC_YCODE" label-source=registry
context {
    system "ATC_YCODE" release="2026"
}
category "y-code" {
    name "en" "ATC Y-code"
}
collection "atc-ycode-snomed-ct-retrieval" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ATC Y-codes to SNOMED CT (retrieval)"
    authors "ludvig-alden"
    source system="ATC_YCODE" release="2026"
    target system="SNOMED_CT" release="20251130"
    import "SNOMED_CT/retrieval/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
collection "atc-ycode-rxnorm-retrieval" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ATC Y-codes to RxNorm (retrieval)"
    authors "ludvig-alden"
    source system="ATC_YCODE" release="2026"
    target system="RXNORM"
    import "RXNORM/retrieval/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
