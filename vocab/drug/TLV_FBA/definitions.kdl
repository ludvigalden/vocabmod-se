// TLV förbrukningsartiklar: reimbursed medical consumables (förbrukningsartiklar), one code per
// article. The source header names the release.
system "TLV_FBA" kind=classification distribution=published publisher="se.tlv" default-locale="sv" {
    name "sv" "TLV förbrukningsartiklar"
}
release "2026" system="TLV_FBA" label-source=header
context {
    system "TLV_FBA" release="2026"
}
category "article" {
    name "en" "Reimbursed consumable article"
}
// The source's article_type column, as a category of package.
category "egenkontroll-av-medicinering" {
    name "sv" "Egenkontroll av medicinering"
}
category "stomi" {
    name "sv" "Stomi"
}
category "tillfora-kroppen-lakemedel" {
    name "sv" "Tillföra kroppen läkemedel"
}
import "concepts/**/*.kdl" kind=fragment
