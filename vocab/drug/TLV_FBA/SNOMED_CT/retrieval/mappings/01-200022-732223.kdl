// TLV consumables retrieval adjudication mappings to SNOMED CT, codes 200022-732223
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual article and product names quoted in the rationales below are quotations from
// TLV, TLV förbrukningsartiklar (release 2026), data that TLV offers for reuse in its
// price-and-decision database. They serve as adjudication evidence for the individual
// mappings; the full dataset is not redistributed.
context {
    collection "tlv-fba-snomed-ct-retrieval" version="2026.1"
    source system="TLV_FBA" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "200022.retr.1" source="200022" target="342973009" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Device; Swedish designation names a skin protection ring (hudskyddsring); candidate Skin protector is the entailed generic device with ring form and brand unstated. Omissions recorded: ring form, brand (TRE)."
}
