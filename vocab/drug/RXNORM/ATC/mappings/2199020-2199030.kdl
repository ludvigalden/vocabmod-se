// RxNorm product codes to ATC mappings, ATC codes N04CX-N04CX, RxNorm ids 2199020-2199030
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "rxnorm-atc" version="2026.1"
    source system="RXNORM"
    target system="ATC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "importer-assigned-granularity"
    }
}
mapping "2199020.1" source="2199020" target="N04CX" {
    confidence 5 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "istradefylline 20 MG Oral Tablet"
}
mapping "2199026.1" source="2199026" target="N04CX" {
    confidence 5 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "istradefylline 20 MG Oral Tablet [Nourianz]"
}
mapping "2199028.1" source="2199028" target="N04CX" {
    confidence 5 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "istradefylline 40 MG Oral Tablet"
}
mapping "2199030.1" source="2199030" target="N04CX" {
    confidence 5 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "istradefylline 40 MG Oral Tablet [Nourianz]"
}
