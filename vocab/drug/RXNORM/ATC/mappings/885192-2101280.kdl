// RxNorm product codes to ATC mappings, ATC codes J06AA-J06AA, RxNorm ids 885192-2101280
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "rxnorm-atc" version="2026.1"
    source system="RXNORM"
    target system="ATC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "importer-assigned-granularity"
    }
}
mapping "885192.1" source="885192" target="J06AA" {
    confidence 5 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "Agkistrodon piscivorus antivenin 780 UNT / Crotalus adamanteus antivenin 420 UNT / Crotalus atrox antivenin 1270 UNT / Crotalus scutulatus antivenin 5570 UNT Injection"
}
