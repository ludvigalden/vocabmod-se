// RxNorm: the US National Library of Medicine's normalized naming resource for
// clinical drugs. Declared code-only: its ids are mapping endpoints, never
// concept definitions, and the tree carries no RxNorm concepts. The
// rxnorm-atc collection states, for each drug product or ingredient, the
// ATC class it belongs to; the rows compile NLM's RxNorm codes and names
// with attribution to the National Library of Medicine.
system "RXNORM" kind=vocabulary distribution=external publisher="us.nlm" {
    name "en" "RxNorm"
}
