// TLV product number retrieval adjudication mappings to RxNorm, codes 115424-764
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual product names quoted in the rationales below are quotations from TLV,
// varunummer for reimbursed medicinal products (TLV läkemedel, release 2026), data that
// TLV offers for reuse in its price-and-decision database. They serve as adjudication
// evidence for the individual mappings; the full dataset is not redistributed.
context {
    collection "tlv-vnr-rxnorm-retrieval" version="2026.1"
    source system="TLV_VNR" release="2026"
    target system="RXNORM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "115424.retr.1" source="115424" target="377743" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this RxNorm concept. Evidence: Drug product: TLV product numbers 115424 = Lidokain/Prilokain Ebb 25 mg/g + 25 mg/g kräm (Kronans Apotek product listing kronansapotek.se/p/115424; extract designation ). Omissions recorded: strength 25 mg/g each, manufacturer Ebb."
}
