// TLV product number retrieval adjudication mappings to SNOMED CT, codes 160730-5494
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual product names quoted in the rationales below are quotations from TLV,
// varunummer for reimbursed medicinal products (TLV läkemedel, release 2026), data that
// TLV offers for reuse in its price-and-decision database. They serve as adjudication
// evidence for the individual mappings; the full dataset is not redistributed.
context {
    collection "tlv-vnr-snomed-ct-retrieval" version="2026.1"
    source system="TLV_VNR" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "160730.retr.1" source="160730" target="346535003" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Drug product: TLV product numbers 160730 = Nutriflex Lipid 38/120/40, lipid-containing intravenous nutrition (extract designation ). Omissions recorded: specific lipid composition, amino-acid/glucose components, strengths, brand Nutriflex."
}
mapping "22845.retr.1" source="22845" target="470091001" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Drug product: TLV product numbers 22845 = Oftagel, carbomer eye gel, tear substitute (extract designation ). Omissions recorded: active substance carbomer 2.5 mg/g, gel formulation, brand Oftagel."
}
