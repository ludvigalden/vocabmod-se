// Varunummer dose-form codes to EDQM Standard Terms mappings, codes RAPHPR-WOUSTI; ÖGDRO sorts last, having no filename-safe letter range
// Mapping targets reference the EDQM Standard Terms database (standardterms.edqm.eu) by code only;
// the tree carries no EDQM Standard Terms term names or descriptions. Each comment states this project's basis.
context {
    collection "tlv-vnr-dose-form-edqm" version="2026.1"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="EDQM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "RAPHPR.edqm.1" source="RAPHPR" target="12105000" {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "A radioactive substance used to label another substance before administration."
}
