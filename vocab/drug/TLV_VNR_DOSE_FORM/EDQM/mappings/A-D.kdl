// Varunummer dose-form codes to EDQM Standard Terms mappings, codes BATADD-DNSTI
// Mapping targets reference the EDQM Standard Terms database (standardterms.edqm.eu) by code only;
// the tree carries no EDQM Standard Terms term names or descriptions. Each comment states this project's basis.
context {
    collection "tlv-vnr-dose-form-edqm" version="2026.1"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="EDQM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "BATADD.edqm.1" source="BATADD" target="10501000" {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "A preparation dispersed in bathwater for a medicated bath."
}
mapping "BEHIST.edqm.1" source="BEHIST" target="12001000" {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
