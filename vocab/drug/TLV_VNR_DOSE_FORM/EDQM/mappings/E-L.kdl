// Varunummer dose-form codes to EDQM Standard Terms mappings, codes EADREM-LYSOSU
// Mapping targets reference the EDQM Standard Terms database (standardterms.edqm.eu) by code only;
// the tree carries no EDQM Standard Terms term names or descriptions. Each comment states this project's basis.
context {
    collection "tlv-vnr-dose-form-edqm" version="2026.1"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="EDQM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
