}
mapping "BSRLM.1" source="BSRLM" target="385256005" {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "INUTEM.1" source="INUTEM" target="442015005" {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "RAPHPR.1" source="RAPHPR" target="385254008" {
