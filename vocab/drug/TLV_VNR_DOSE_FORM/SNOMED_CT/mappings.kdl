// Varunummer dose-form codes to SNOMED CT mappings, codes BSRLM-RNGEN
context {
    collection "tlv-vnr-dose-form-snomed-ct" version="2026.1"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
