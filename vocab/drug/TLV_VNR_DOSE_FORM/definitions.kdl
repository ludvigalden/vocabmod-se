// VNR dose-form abbreviations as the source dataset carries them; the SNOMED CT-keyed rows are
// dose-form code lists and are imported as cross-system claims only.
system "TLV_VNR_DOSE_FORM" kind=classification distribution=published publisher="se.tlv" default-locale="sv" {
    name "en" "Varunummer dose form codes"
}
release "2026" system="TLV_VNR_DOSE_FORM" label-source=registry
context {
    system "TLV_VNR_DOSE_FORM" release="2026"
}
category "dose-form" {
    name "en" "Dose form"
}
collection "tlv-vnr-dose-form-rxnorm" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "TLV dose forms to RxNorm"
    authors "ludvig-alden"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="RXNORM"
    defaults {
        mappings {
            relationship "equivalent"
        }
    }
    import "RXNORM/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
collection "tlv-vnr-dose-form-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "TLV dose forms to SNOMED CT"
    authors "ludvig-alden"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="SNOMED_CT" release="20251130"
    defaults {
        mappings {
            relationship "equivalent"
        }
    }
    import "SNOMED_CT/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts.kdl" kind=fragment
