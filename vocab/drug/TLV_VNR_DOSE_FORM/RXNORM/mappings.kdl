// Varunummer dose-form codes to RxNorm mappings, misc: codes with no filename-safe letter range, -N parts numbered in file order
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "tlv-vnr-dose-form-rxnorm" version="2026.1"
    source system="TLV_VNR_DOSE_FORM" release="2026"
    target system="RXNORM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
