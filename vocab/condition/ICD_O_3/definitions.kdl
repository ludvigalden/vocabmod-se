// ICD-O-3 morphology codes as the source dataset carries them (a placeholder inventory).
// Concept names restate the code and are not repeated.
system "ICD_O_3" kind=classification distribution=published publisher="int.who" default-locale="sv" {
    name "en" "ICD for Oncology, 3rd edition"
}
release "2026" system="ICD_O_3" label-source=registry
context {
    system "ICD_O_3" release="2026"
}
category "code" {
    name "en" "Oncology code"
}
collection "icd-o-3-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-O-3 to SNOMED CT"
    authors "ludvig-alden"
    source system="ICD_O_3" release="2026"
    target system="SNOMED_CT" release="20251130"
    defaults {
        mappings {
            claim-scope "icd-o-3-snomed-ct@2026.1"
        }
    }
    import "SNOMED_CT/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts.kdl" kind=fragment
