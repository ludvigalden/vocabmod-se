// ICD-10-SE extension codes to OMOP ICD-10-CM concept mappings, codes I8-Y5
// Fallback tier: the source grades every row icd10cm_base_fallback
// (non-standard ICD-10-CM billing concepts), so the collection is
// preference=alternative throughout.
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-icd-10-cm" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_ICD_10_CM"
}
defaults {
    mappings {
        preference "alternative"
        assessment-method "source-default-granularity"
    }
}
mapping "I803P.1" source="I803P" target="35207884" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "\"Phlebitis and thrombophlebitis of lower extremities, unspecified\""
}
mapping "I809P.1" source="I809P" target="35207886" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "Phlebitis and thrombophlebitis of unspecified site"
}
mapping "I839P.1" source="I839P" target="1569399" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "Asymptomatic varicose veins of lower extremities"
}
mapping "I872P.1" source="I872P" target="35207904" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Swedish extension I87.2 (venous insufficiency) + P (primary diagnosis marker); (20696009)
        preserved
        """
}
