mapping "I489A.1" source="I489A" target="1569174" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Swedish 5th-char extension A=first episode of I48.9 (unspecified AF); no standard SNOMED CT for
        unspecified atrial fibrillation exists; weak to Chronic atrial fibrillation 426749004 as
        broadest AF subtype
        """
}
mapping "I489B.1" source="I489B" target="1569174" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Swedish fifth-char extension for recurrent episode of I48.9; base I48.9 = atrial fibrillation
        and flutter unspecified; deprecated prior 4108832 combined fibrillation+flutter; best standard
        is SNOMED CT 49436004 313217
        """
}
mapping "I489C.1" source="I489C" target="1569174" relationship=equivalent {
