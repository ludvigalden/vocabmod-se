// ICD-10-SE extension codes to OMOP ICD-10-CM concept mappings, codes I4-I7
// Fallback tier: the source grades every row icd10cm_base_fallback
// (non-standard ICD-10-CM billing concepts), so the collection is
// preference=alternative throughout.
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-icd-10-cm" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_ICD_10_CM"
}
defaults {
    mappings {
        preference "alternative"
        assessment-method "source-default-granularity"
    }
}
mapping "I441A.1" source="I441A" target="35207767" relationship=equivalent {
