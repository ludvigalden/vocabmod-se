// ICD-10-SE extension codes to SNOMED CT mappings, codes W066-W06
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W066.1" source="W066" target="20902002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W066 SNOMED CT 20902002 = Fall from bed in industrial/construction area. Swedish extension
        specifies place=industrial. Target SNOMED CT 436882 (20902002, S) = Fall from bed; verified
        W06→436882 crosswalk. Place-specific SNOMED CT 40419708/44794275 are non-standard. 436882 closest
        standard ancestor; captures the fall event, drops place. Broader with verified crosswalk; high
        tier.
        """
}
mapping "W0660.1" source="W0660" target="20902002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0660 SNOMED CT 20902002 = Fall from bed in industrial area during sports. Adds place +
        activity to base W06. Target SNOMED CT 436882 (20902002, S); verified crosswalk. 436882 closest
        standard ancestor; broader; high tier.
        """
}
