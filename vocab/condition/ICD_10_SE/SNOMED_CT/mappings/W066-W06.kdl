mapping "W0679.1" source="W0679" target="20902002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0679 is the Swedish ICD-10-SE extension of W06 SNOMED CT 20902002 qualified by agricultural
        setting + unspecified activity. Parent W06 crosswalks to SNOMED CT 436882 (Fall from bed,
        concept_code 20902002) via Athena relationship 45575895->436882. The Swedish extension adds
        place/activity detail but the entire meaning is subsumed by — the activity qualifier is metadata
        about the fall event, not a different clinical concept. broader: target is the legitimate
        ancestor fully containing the source; one-level climb, confidence.
        """
}
mapping "W068.1" source="W068" target="20902002" relationship=source_is_narrower_than_target {
