// ICD-10-SE extension codes to SNOMED CT mappings, codes V447-V44
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4470.1" source="V4470" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4470 = Swedish 7-char extension of ICD-10 V44.7: person on outside of car injured in
        collision with heavy transport vehicle or bus in traffic accident, during idrott/sport/motion.
        Activity digit dropped. Primary SNOMED CT 274913009 (Athena 433930, Maps-to for V44.7); broader
        (generalizes collision partner, drops role/activity). Secondary SNOMED CT 36198007 (444074).
        primary, secondary.
        """
}
