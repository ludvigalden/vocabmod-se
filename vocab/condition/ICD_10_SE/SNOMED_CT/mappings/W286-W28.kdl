// ICD-10-SE extension codes to SNOMED CT mappings, codes W286-W28
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W286.1" source="W286" target="218017003" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W286 SNOMED CT 218017003 = Swedish extension of W28 specifying place=industrial/construction
        area. Target SNOMED CT 435145 = (standard_concept=S). Base W28 has verified crosswalk.
        Place-specific SNOMED CT 220651000 (industrial/construction) is retired/non-standard. 435145
        subsumes all place variants. Broader: one level of specificity loss. High tier.
        """
}
mapping "W2860.1" source="W2860" target="218017003" relationship=source_is_narrower_than_target effect=omitted quality=40 {
