// ICD-10-SE extension codes to SNOMED CT mappings, codes W446-W44
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W446.1" source="W446" target="125670008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W446 = Swedish extension of W44 SNOMED CT 125670008, industrial area/construction site.
        Clinical injury identical to parent W44; suffix is place-of-occurrence context only. Target
        SNOMED CT 4053838 (125670008), Athena crosswalk of W44 (row 45756297 -> 4053838). Target fully
        subsumes source. Broader (one level).
        """
}
mapping "W4460.1" source="W4460" target="125670008" relationship=source_is_narrower_than_target {
