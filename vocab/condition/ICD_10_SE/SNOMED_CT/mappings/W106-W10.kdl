// ICD-10-SE extension codes to SNOMED CT mappings, codes W106-W10
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W106.1" source="W106" target="217083007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W106 = SNOMED CT 217083007 (place only). Target SNOMED CT 441749 = (217083007, standard).
        Non-standard SNOMED CT combined concept 40419971 (220457005, U) maps to 441749. One-level broader:
        event kept, place axis dropped.
        """
}
mapping "W1060.1" source="W1060" target="217083007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1060 = SNOMED CT 217083007. Target SNOMED CT 441749 = (217083007, standard). Place and
        activity axes dropped.
        """
}
mapping "W1061.1" source="W1061" target="217083007" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1061 SNOMED CT 217083007 is a Swedish 7th-char extension of ICD-10 W10 specifying place
        (industrial/construction site) and activity (play/leisure). Target SNOMED CT 441749 (217083007) is
        the OMOP standard concept that W10 maps to via Athena crosswalk (ICD10 row 45756250 -> 441749).
        Target fully subsumes the clinical event (fall on stairs); the Swedish place/activity detail is
        contextual attribution with no separate SNOMED CT standard concept. Broader: target is the
        legitimate ancestor; crosswalk-verified at parent W10, one-level breadth mismatch from the
        unspecified W10, plus additional Swedish attribution axes absent from SNOMED CT.
        """
}
mapping "W1062.1" source="W1062" target="217083007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1062 SNOMED CT 217083007 is a Swedish extension of W10 specifying place
        (industrial/construction site) and activity (paid work). Target SNOMED CT 441749 (Fall on or from
        stairs or steps) is the W10 crosswalk target (45756250 -> 441749). Target subsumes the clinical
        fall event; place/activity attribution has no SNOMED CT standard equivalent. Broader with verified
        parent crosswalk; confidence.
        """
}
