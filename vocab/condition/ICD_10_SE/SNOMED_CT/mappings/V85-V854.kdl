// ICD-10-SE extension codes to SNOMED CT mappings, codes V85-V854
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8500.1" source="V8500" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8500 SNOMED CT 36198007 is a Swedish KVÅ activity subdivision (sport) of WHO V85. Activity
        suffix has no SNOMED CT representation. Target SNOMED CT 444074 = (concept_code 36198007), the
        verified Athena crosswalk for the WHO V85 parent (concept 45756155). Parent subsumes all
        activity variants. Broader; : one-level broader with verified crosswalk.
        """
}
