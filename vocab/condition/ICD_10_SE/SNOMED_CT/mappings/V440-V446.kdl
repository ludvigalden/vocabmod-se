mapping "V4403.1" source="V4403" target="214640008" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4403 = Swedish national extension of ICD-10 V44.0 (car occupant driver injured in
        nontraffic collision with heavy transport vehicle/bus) plus an activity qualifier (annan
        sysselsättning). The base V44.0 maps via Athena to SNOMED CT 437738 (Motor vehicle accident off
        public road) and 444074 (Victim of vehicular AND/OR traffic accident). The activity qualifier
        has no SNOMED CT analogue; both targets are partial (cover injury axis only, drop the activity
        axis). per partial boundary rule.
        """
}
mapping "V4403.2" source="V4403" target="36198007" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
