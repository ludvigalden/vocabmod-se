mapping "V4440.1" source="V4440" target="242107006" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4440 = Swedish 7-char extension of ICD-10 V44.4: car occupant (driver/passenger) injured
        in collision with heavy transport vehicle or bus, person injured while boarding/alighting,
        during sport/exercise. The 7th-digit activity context (idrott/sport/motion) is a Swedish
        national extension with no standard equivalent and is dropped. Primary target SNOMED CT 242107006
        (Accident while boarding or alighting from motor vehicle on road) is the Athena Maps-to target
        for V44.4 (concept 4053428); it is broader because it drops the collision partner (heavy
        truck/bus) and the activity context. Secondary target SNOMED CT 36198007 (Victim of vehicular
        AND/OR traffic accident, concept 444074) is the second Athena Maps-to target for V44.4, more
        general. high for primary: crosswalk-verified, one-level broader; moderate for secondary.
        """
}
mapping "V4440.2" source="V4440" target="36198007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
