// ICD-10-SE extension codes to SNOMED CT mappings, codes V440-V446
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4400.1" source="V4400" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4400 is a Swedish national extension of ICD-10 V4x adding activity context
        (sport/leisure/work/unspecified) to a car-occupant injury in collision with heavy transport
        vehicle or bus. Role: driver. Target SNOMED CT 437738 = Motor vehicle accident off public road, the
        standard crosswalk target for the corresponding base ICD-10 V4x category (e.g.
        V43.0/V43.5/V43.4). Activity and role granularity present in the Swedish source has no SNOMED CT
        representation; target captures the accident mechanism. broader: target subsumes the source's
        accident type; activity/role detail is lost. : verified crosswalk from the parent ICD-10 code,
        one level broader.
        """
}
mapping "V4401.1" source="V4401" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
