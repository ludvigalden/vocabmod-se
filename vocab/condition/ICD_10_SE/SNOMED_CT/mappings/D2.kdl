// ICD-10-SE extension codes to SNOMED CT mappings, codes D2
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "D219A.1" source="D219A" target="404035005" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219A SNOMED CT 404035005 = Abrikossoff's tumör (granular cell tumör, historically
        Abrikossoff), unspecified site. Target (Granular cell tumör). Target is the unqualified general
        Granular cell tumör concept; it fully subsumes the source which is a same-named tumör with
        unspecified site. High confidence broader map.
        """
}
mapping "D219B.1" source="D219B" target="86959002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219B SNOMED CT 86959002 = Angiomyoma (angiomyoma = angioleiomyoma, a benign smooth-muscle
        vascular neoplasm), unspecified site. Target (Angiomyoma). Same clinical concept. High rather
        than exact confidence because no independent ICD-10→SNOMED CT crosswalk exists for D21.9 subcodes
        in the athena mirror (the D21.9 base code maps to 442105). The unqualified SNOMED CT is the same
        entity as the source.
        """
}
mapping "D219C.1" source="D219C" target="9671003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219C SNOMED CT 9671003 = Elastofibroma, unspecified site (typically elastofibroma dorsi, a
        rare fibroelastic tumör of subscapular soft tissue). Target (Elastofibroma). Same clinical
        entity. High rather than exact because no ICD-10→SNOMED CT crosswalk exists for D21.9 subcodes in
        the mirror.
        """
}
mapping "D219D.1" source="D219D" target="424568000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219D SNOMED CT 424568000 = Fibroma, unspecified site, a generic residual concept. Target
        (Fibroma). Target legitimately subsumes the source; however the SNOMED CT concept is itself an
        unspecific morphologic descriptor covering heterogeneous entities. Low confidence because the
        ICD-10 D21.9 base crosswalk points elsewhere (442105) and the SNOMED CT bare concept is a
        heterogeneous bucket; recorded to preserve a specific lead for reviewer.
        """
}
mapping "D219E.1" source="D219E" target="44598004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219E SNOMED CT 44598004 = Leiomyoma, unspecified site. Target (Leiomyoma). Same clinical
        concept; high rather than exact because no ICD-10→SNOMED CT crosswalk exists for the D21.9 subcode
        and the SNOMED CT bare concept is broader than site-specific leiomyomas (the source is similarly
        unspecified-site, so the breadth matches).
        """
}
mapping "D219F.1" source="D219F" target="39143003" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219F SNOMED CT 39143003 = Myxoma, unspecified site (a benign gelatinous soft-tissue
        neoplasm). Target (Myxoma). Same clinical concept. High rather than exact because no
        ICD-10→SNOMED CT crosswalk exists for D21.9 subcodes and the bare SNOMED CT Myxoma concept is a broad
        bucket (Myxoma of heart 426191007 is the more commonly used OMOP concept); recorded as the most
