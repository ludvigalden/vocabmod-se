        """
}
mapping "D219X.1" source="D219X" target="92069005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D219X SNOMED CT 92069005 = Unspecified benign tumör of connective and other soft tissue,
        unspecified site. Target SNOMED CT 442105 (Benign neoplasm of soft tissue) is the Athena canonical
        standard concept mapped from ICD-10 D21.9 base code (45552335 Maps to 442105). Target fully
        subsumes the source; one-level broader; high confidence.
        """
