// ICD-10-SE extension codes to SNOMED CT mappings, codes V517-V51
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5170.1" source="V5170" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5170 = Swedish extension of V51.7 (person on outside of vehicle, traffic accident)
        qualified by SNOMED CT 214171003. Target SNOMED CT 4061564 = (concept_code 214171003). V51.7 ->
        4061564 crosswalk verified; 444074 (Victim of vehicular AND/OR traffic accident) is a weaker
        alternate. Activity qualifier dropped; broader.
        """
}
