    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5200.1" source="V5200" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5200 = Swedish extension of ICD-10 V52.0: driver of pick-up truck/van (light truck)
        injured in nontraffic collision with two- or three-wheeled motor vehicle, during sport/activity.
        The activity qualifier is contextual-administrative and does not change the clinical injury
        concept. Parent V52.0 (OMOP 45756601) carries Athena SNOMED 36198007 418399005 edges to SNOMED CT
        418399005 (Motor vehicle accident) and 36198007 (Victim of vehicular AND/OR traffic accident).
        Both targets fully subsume the source; the Swedish activity suffix has no SNOMED CT representation,
        so the relationship is broader. High tier: parent-code crosswalk verified in Athena-local
        mirror.
        """
}
