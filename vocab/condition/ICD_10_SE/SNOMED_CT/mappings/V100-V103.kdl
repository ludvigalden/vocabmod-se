// ICD-10-SE extension codes to SNOMED CT mappings, codes V100-V103
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V1000.1" source="V1000" target="48084008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1000 = Swedish extension of V10.0 (cyclist driver injured in non-traffic collision with
        pedestrian/animal) + SNOMED CT 214640008 47397001 48084008 activity suffix. Activity suffix
        dropped. Targets follow V100 precedent: 432510 (exact for driver role) + 433099 (exact for
        cyclist-victim role) + 437738 (broader, covers non-traffic context). Moderate tier: Swedish
        activity suffix, legacy baseline.
        """
}
