}
mapping "X170.1" source="X170" target="242524006" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X170 SNOMED CT 242524006 = a Swedish ICD-10-SE national extension that subdivides X17
        (Athena ICD10 concept 45756376) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4054162 = (sctid 242524006), the verified Athena crosswalk target for
        X17 (ICD10 relationship 45756376 -> 4054162). Why this target: it is the authoritative standard
        concept the parent X17 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
