// ICD-10-SE extension codes to SNOMED CT mappings, codes T9-UA
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "T918A.1" source="T918A" target="285235009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T918A (Swedish extension of T91.8) = Late effects of whiplash injury. Parent ICD-10 T91.8
        (Sequelae of other specified injuries of neck and trunk) has Athena SNOMED 285235009 crosswalk
        to SNOMED CT 4110914 (Sequelae of injuries of neck and trunk, concept_code 285235009). Swedish
        A-code specifies whiplash as the underlying injury; SNOMED CT target covers sequelae of neck/trunk
        injuries broadly. Target subsumes source. broader.
        """
}
mapping "T918W.1" source="T918W" target="285235009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T918W (Swedish extension of T91.8) = Late effects of other specified injuries of neck and
        trunk. Functionally identical to ICD-10 T91.8 (Sequelae of other specified injuries of neck and
        trunk), which has Athena SNOMED 285235009 crosswalk to SNOMED CT 4110914 (Sequelae of injuries of
        neck and trunk, concept_code 285235009). Same clinical concept = exact_match.
        """
}
mapping "T969.1" source="T969" target="363304009" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T969 = ICD-10 T96 (Sequelae of poisoning by drugs, medicaments and biological
        substances). Athena SNOMED 363304009 crosswalk to SNOMED CT 4180771 (Disorder due to and following
        poisoning, concept_code 363304009). The SNOMED CT target is the canonical equivalent for sequelae
        of poisoning. Crosswalk-verified exact match =.
        """
}
mapping "T979.1" source="T979" target="363304009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T979 = ICD-10 T97 (Sequelae of toxic effects of substances chiefly nonmedicinal as to
        source). Athena SNOMED 363304009 crosswalk to SNOMED CT 4180771 (Disorder due to and following
        poisoning, concept_code 363304009). The same target also maps T96 (sequelae of medicinal
        poisoning), so 4180771 subsumes both medicinal and nonmedicinal poisoning sequelae — broader
        than T97 alone. broader.
        """
}
mapping "U859.1" source="U859" target="720580006" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source U859 = ICD-10 U85 (Resistance to antineoplastic drugs). Athena SNOMED 720580006 crosswalk
        to SNOMED CT 36715097 (Resistance to antineoplastic drug, concept_code 720580006).
        Crosswalk-verified exact semantic equivalence = exact_match.
        """
}
