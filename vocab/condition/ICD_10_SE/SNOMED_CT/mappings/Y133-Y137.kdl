// ICD-10-SE extension codes to SNOMED CT mappings, codes Y133-Y137
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y133.1" source="Y133" target="418098005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y133 = Swedish ICD-10-SE national extension of Y13 SNOMED CT 418098005 (Athena ICD10 concept
        45756478), refined by Swedish external-cause place axis: idrotts- och sportanläggning (sports
        and athletics facility); no specific activity axis (place-only code). The clinical
        event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause metadata
        with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 4167568 = sctid 418098005. Why
        this target: Athena ICD10 crosswalk maps base Y13 (concept_id 45756478) -> 4167568 (relationship
        45756478, 4167568); it is the authoritative standard concept for Y13 and fully subsumes every
        place/activity-specific SE subdivision. mapping_type=broader (target fully contains every
        clinical meaning of the source; the dropped qualifier is breadth-neutral external-cause
        metadata, not a partial slice). Confidence (high): verified Athena crosswalk on the base code
        with a small, well-understood one-level breadth mismatch (the SE place/activity refinement is
        lost). Athena-local research only.
        """
}
mapping "Y1330.1" source="Y1330" target="418098005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y1330 SNOMED CT 418098005 = a Swedish ICD-10-SE national extension that subdivides Y13
        (Athena ICD10 concept 45756478) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4167568 = (sctid 418098005), the verified Athena crosswalk target for
        Y13 (ICD10 relationship 45756478 -> 4167568). Why this target: it is the authoritative standard
        concept the parent Y13 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
