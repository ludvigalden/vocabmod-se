// ICD-10-SE extension codes to SNOMED CT mappings, codes D45-D48
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "D459.1" source="D459" target="109992005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D459 SNOMED CT 109992005 = polycythemia vera, myeloproliferative neoplasm. Target SNOMED CT
        135214 (=109992005) = Polycythemia vera (clinical). Athena crosswalk D45 → 135214; identical
        clinical concept. Exact-equivalent.
        """
}
