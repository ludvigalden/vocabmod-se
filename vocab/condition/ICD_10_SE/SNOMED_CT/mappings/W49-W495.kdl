// ICD-10-SE extension codes to SNOMED CT mappings, codes W49-W495
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W490.1" source="W490" target="242056005" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 242056005 [GPS] [GPFP]"
}
mapping "W4900.1" source="W4900" target="88817006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4900 SNOMED CT 88817006 = Swedish national extension of W49 (Exposure to other and
        unspecified inanimate mechanical forces) adding residential-area + sport detail; no
        international ICD-10 or SNOMED CT analogue for the place/activity subcategorization. Target SNOMED CT
        4230638 (Exposure to inanimate mechanical force, concept_code 88817006) is the verified Athena
        crosswalk target for W49 (concept_id 45756300). Target fully subsumes the source: every case of
        exposure to inanimate mechanical force in a residential/sport setting is such an exposure.
        broader (target subsumes source). High : verified Athena crosswalk at the W49 parent level with
        a one-level well-understood breadth mismatch (Swedish extension is more specific).
        """
}
