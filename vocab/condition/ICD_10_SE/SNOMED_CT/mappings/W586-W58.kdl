// ICD-10-SE extension codes to SNOMED CT mappings, codes W586-W58
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W586.1" source="W586" target="17982002" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W586 = Bitten or attacked by crocodile or alligator - industrial/construction area.
        Target SNOMED CT 17982002. Mechanism captured; place (industrial/construction area) modifier has no
        standard representation. Broader because target subsumes mechanism but omits place specificity.
        Moderate tier: crosswalk-verified base mechanism, expanded code not in standard vocabularies.
        """
}
