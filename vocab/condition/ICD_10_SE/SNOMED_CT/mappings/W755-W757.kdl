// ICD-10-SE extension codes to SNOMED CT mappings, codes W755-W757
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W755.1" source="W755" target="269791004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W755 = Swedish ICD-10-SE national extension of W75 SNOMED CT 269791004 (Athena ICD10 concept
        45756321), refined by Swedish external-cause place axis: butiks-, handels- eller serviceområde
        (shop, trade or service area); no specific activity axis (place-only code). The clinical event
        (accidental suffocation/strangulation in bed) is unchanged; the Swedish place/activity
        qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical analogue.
        Target SNOMED CT 4155227 = sctid 269791004. Why this target: Athena ICD10 crosswalk maps base W75
        (concept_id 45756321) -> 4155227 (relationship 45756321, 4155227); it is the authoritative
        standard concept for W75 and fully subsumes every place/activity-specific SE subdivision (the
        setting is preserved on both sides). mapping_type=broader (target fully contains every clinical
        meaning of the source; the dropped qualifier is breadth-neutral external-cause metadata, not a
        partial slice). Confidence (high): verified Athena crosswalk on the base code with a small,
        well-understood one-level breadth mismatch (the SE place/activity refinement is lost).
        Athena-local research only.
        """
}
