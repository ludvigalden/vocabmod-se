// ICD-10-SE extension codes to SNOMED CT mappings, codes V547-V54
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5470.1" source="V5470" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5470 (Swedish extension) = SNOMED CT 274913009: person on outside of pick-up truck/van
        injured in traffic collision with heavy transport vehicle or bus, while engaged in
        sport/activity. SE extension of WHO V54.7 with activity digit (sport). Target =; Athena Maps to
        for WHO V54.5 (45537237→433930) and subsumes the V54.x traffic-collision event. Broader: target
        fully contains the collision event; the sport-activity context is metadata not represented in
        SNOMED CT. Low tier : defensible best target with semantic loss on the activity axis and no direct
        WHO crosswalk for the SE code.
        """
}
mapping "V5471.1" source="V5471" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5471 (Swedish extension) = SNOMED CT 274913009: person on outside of pick-up truck/van in
        traffic collision with heavy transport vehicle or bus, during play/leisure. SE extension of WHO
        V54.7 with activity digit (leisure). Target =; Athena Maps to for WHO V54.5, subsumes the V54.x
        traffic-collision event. Broader: collision-event portion fully contained; leisure-activity
