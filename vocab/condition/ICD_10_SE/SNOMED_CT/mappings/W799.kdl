// ICD-10-SE extension codes to SNOMED CT mappings, codes W799
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W799.1" source="W799" target="1345125000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W799 SNOMED CT 1345125000 is a Swedish national extension of WHO base Inhalation and
        ingestion of food causing obstruction of respiratory tract (ICD-10 id 45756325); the Swedish
        suffix subdivides the base by a place/activity external-cause axis with no distinct standard
        SNOMED CT clinical analogue. Base event Athena-crosswalks to SNOMED CT 1447566 (concept_code
        1345125000) via ICD10 relationship 45756325 -> 1447566. The Swedish place/activity qualifier is
        external-cause metadata; the injury event is unchanged. Target subsumes the event -> broader.
        Confidence : verified Athena crosswalk on the WHO base, one-level broader (qualifier dropped).
        """
}
mapping "W7990.1" source="W7990" target="217779001" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        5th-char extension of W79 (inhalation/ingestion of food causing obstruction); exact SNOMED CT match
        found
        """
}
