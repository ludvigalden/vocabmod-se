// ICD-10-SE extension codes to SNOMED CT mappings, codes X4-X404
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X400.1" source="X400" target="7895008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X400 = SNOMED CT 7895008 (Swedish national extension). Base X40 Athena-crosswalks to SNOMED CT
        438028 (concept_code 7895008) via ICD10 relationship 45756396 -> 438028. The Swedish extension
        subdivides the base event by a place/activity/qualifier axis with no distinct standard SNOMED CT
        clinical analogue; the underlying clinical event is unchanged. Target subsumes the source event
        -> broader. Confidence : verified Athena crosswalk on base X40, one-level broader (Swedish
        qualifier dropped).
        """
}
