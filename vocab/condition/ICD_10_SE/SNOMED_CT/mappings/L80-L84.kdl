// ICD-10-SE extension codes to SNOMED CT mappings, codes L80-L84
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L809.1" source="L809" target="56727007" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L809 SNOMED CT 56727007 = vitiligo. Target SNOMED CT 138502 (Vitiligo, standard_concept=S) is
        an exact match; Athena ICD10 L80 -> crosswalk confirms.
        """
}
mapping "L814A.1" source="L814A" target="398744007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L814A SNOMED CT 398744007 = lentigo (generic). Target SNOMED CT 4160756 (Lentigo,
        standard_concept=S) is the active standard concept; the older 40397833 (Lentigo) and 40625816
        (Lentigo) are retired (D). Exact name match, high confidence (not) because the source name is
        generic and the SNOMED CT hierarchy contains several more specific active subtypes (solar, simplex)
        the source might have meant.
        """
}
mapping "L814B.1" source="L814B" target="49765009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L814B SNOMED CT 49765009 is a historical/clinical term for patchy brown-grey
        hyperpigmentation of the back (also called /); SNOMED CT has no concept literally named. Best
        defensible target is SNOMED CT 4172432 (Hyperpigmentation of skin, standard_concept=S), which fully
        subsumes the entity. Broader, low confidence: clinical term not represented in SNOMED CT; Athena
        L81.4 (Other melanin hyperpigmentation) maps to 4172432 as the closest neighbor.
        """
}
mapping "L814C.1" source="L814C" target="24285001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L814C SNOMED CT 24285001 = pigmented contact dermatitis from cosmetics (Swedish extension of
        L81.4). Target SNOMED CT 4085267 (concept_code 24285001) is the standard
        pigmented-contact-dermatitis concept in SNOMED CT and is widely used as its clinical equivalent.
        Moderate (not) tier: the Swedish term and Riehl's melanosis are clinically near-synonymous in
        dermato-epidemiology but no Athena crosswalk confirms a 1:1 equivalence at this
        national-extension code, and some authors distinguish Riehl's (lichenoid) from broader pigmented
        cosmetic dermatitis.
        """
}
