// ICD-10-SE extension codes to SNOMED CT mappings, codes X585-X58
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X585.1" source="X585" target="418715001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X585 SNOMED CT 418715001 = a Swedish ICD-10-SE national extension that subdivides X58
        (Athena ICD10 concept 45756411) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4305831 = (sctid 418715001), the verified Athena crosswalk target for
        X58 (ICD10 relationship 45756411 -> 4305831). Why this target: it is the authoritative standard
        concept the parent X58 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
