// ICD-10-SE extension codes to SNOMED CT mappings, codes W566-W56
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W566.1" source="W566" target="80580005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W566 SNOMED CT 80580005 = Swedish extension of WHO ICD-10 W56 adding epidemiological
        place/activity context (place=industrial area/construction site). Target (Athena 4213723) =,
        standard (S). Base ICD-10 W56 -> 4213723 verified via Athena crosswalk; the Swedish subcode
        inherits that target. Broader: target subsumes the marine-animal exposure/injury event in full;
        the place/activity axis is administrative/epidemiological context, not a separate clinical
        dimension, so the medical meaning is fully covered. high: verified crosswalk, one-level broader;
        place/activity specificity lost.
        """
}
mapping "W5660.1" source="W5660" target="80580005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5660 SNOMED CT 80580005 = Swedish extension of WHO ICD-10 W56 adding epidemiological
        place/activity context (place=industrial area/construction site, activity=sport/athletics).
        Target (Athena 4213723) =, standard (S). Base ICD-10 W56 -> 4213723 verified via Athena
        crosswalk; the Swedish subcode inherits that target. Broader: target subsumes the marine-animal
        exposure/injury event in full; the place/activity axis is administrative/epidemiological
        context, not a separate clinical dimension, so the medical meaning is fully covered. high:
        verified crosswalk, one-level broader; place/activity specificity lost.
        """
}
