// ICD-10-SE extension codes to SNOMED CT mappings, codes Z09
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Z094A.1" source="Z094A" target="113009005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Z094A = Swedish ICD-10-SE national extension of Z09 SNOMED CT 113009005 (Athena ICD10
        concept 45581005), refined by Swedish external-cause metadata: place=gata och väg (street and
        highway); activity=activity code A. The clinical event/exposure is unchanged; the Swedish
        place/activity qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical
        analogue. Target SNOMED CT 4013510 = sctid 113009005. Why this target: Athena ICD10 crosswalk maps
        base Z09 (concept_id 45581005) -> 4013510 (relationship 45581005, 4013510); it is the
        authoritative standard concept for Z09 and fully subsumes every place/activity-specific SE
        subdivision. mapping_type=broader (target fully contains every clinical meaning of the source;
        the dropped qualifier is breadth-neutral external-cause metadata, not a partial slice).
        Confidence (high): verified Athena crosswalk on the base code with a small, well-understood
        one-level breadth mismatch (the SE place/activity refinement is lost). Athena-local research
        only.
        """
}
