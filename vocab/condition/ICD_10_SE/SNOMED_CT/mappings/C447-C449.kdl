// ICD-10-SE extension codes to SNOMED CT mappings, codes C447-C449
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C447B.1" source="C447B" target="403914000" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C447B SNOMED CT 403914000 = superficial basal cell carcinoma of skin of lower limb including
        hip. A site-specific BCC of lower-extremity concept (SNOMED CT 4299418, 402522006) exists, but no
        site-specific superficial-BCC concept. Target SNOMED CT 4300564 (403914000) = Superficial basal
        cell carcinoma matches histology exactly, drops site. Per the C446B rationale, the
        superficial-growth-pattern is a clinically distinct BCC subtype worth preserving. Partial:
        histology covered, topology not. Moderate tier per §1.
        """
}
mapping "C447C.1" source="C447C" target="403913006" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C447C SNOMED CT 403913006 = morphea-like (morphoeic/sclerosing) basal cell carcinoma of skin
        of lower limb including hip. Target SNOMED CT 4297183 (403913006) = Sclerosing morpheic basal cell
        carcinoma matches morphoeic-BCC histology exactly but drops the lower-limb site (no
        site-specific morphoeic BCC concept exists). Partial: histology covered, topology not. Moderate
        tier per §1.
        """
}
mapping "C447D.1" source="C447D" target="402522006" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C447D SNOMED CT 402522006 = other basal cell carcinoma of skin of lower limb including hip.
        Target SNOMED CT 4299418 (402522006) = Basal cell carcinoma of lower extremity. Site+histology
        match; just distinguishes from superficial/morpheaform subtypes, which SNOMED CT does not separate
        at this site. Standard_concept=S, Athena mirror.
        """
}
mapping "C447E.1" source="C447E" target="402522006" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C447E SNOMED CT 402522006 = unspecified basal cell carcinoma of skin of lower limb including
        hip. Target SNOMED CT 4299418 (402522006) = Basal cell carcinoma of lower extremity. Site+histology
        match; has no separate standard concept, so the site-specific BCC is the correct standard
        target. Standard_concept=S, Athena mirror.
        """
}
mapping "C447S.1" source="C447S" target="402815007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "C447W.1" source="C447W" target="372124007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C447W SNOMED CT 372124007 = other specified malignant neoplasm of skin of lower limb
        including hip (ICD-10 C44.7 subextension). Target SNOMED CT 4162993 (Malignant neoplasm of skin of
        lower limb, concept_code 372124007) covers the body site but not the histology residual bucket.
        Broader: site subsumed, residual histology undifferentiated. Low tier per §1: residual source
        bucket, no specific histology crosswalk.
        """
}
mapping "C447X.1" source="C447X" target="372124007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
