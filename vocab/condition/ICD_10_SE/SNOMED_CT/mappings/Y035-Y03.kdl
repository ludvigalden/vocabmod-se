    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y035.1" source="Y035" target="242923007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y035 SNOMED CT 242923007 = a Swedish ICD-10-SE national extension that subdivides Y03
        (Athena ICD10 concept 45756470) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 438952 = (sctid 242923007), the verified Athena crosswalk target for Y03
        (ICD10 relationship 45756470 -> 438952). Why this target: it is the authoritative standard
        concept the parent Y03 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
