// ICD-10-SE extension codes to SNOMED CT mappings, codes W925-W92
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W925.1" source="W925" target="217594000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W925 = SNOMED CT 217594000 (Swedish national extension). Base W92 Athena-crosswalks to
        SNOMED CT 435430 (concept_code 217594000) via ICD10 relationship 45756336 -> 435430. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W92, one-level broader (Swedish
        qualifier dropped).
        """
}
