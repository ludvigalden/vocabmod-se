// ICD-10-SE extension codes to SNOMED CT mappings, codes W336-W33
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W336.1" source="W336" target="220708006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W336 = Skott från gevär/hagelbössa/tyngre skjutvapen - industriområde, byggarbetsplats
        (rifle/shotgun discharge, industrial area/construction site). Target SNOMED CT 40421185 = [X]
        (220708006). Same clinical concept; exact term-equivalent. high (no Swedish-specific crosswalk,
        term match not independently re-verified).
        """
}
