// ICD-10-SE extension codes to SNOMED CT mappings, codes X845-X84
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X845.1" source="X845" target="248062006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X845 SNOMED CT 248062006 = a Swedish ICD-10-SE national extension that subdivides X84
        (Athena ICD10 concept 45585673) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4092411 = (sctid 248062006), the verified Athena crosswalk target for
        X84 (ICD10 relationship 45585673 -> 4092411). Why this target: it is the authoritative standard
        concept the parent X84 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
mapping "X8450.1" source="X8450" target="248062006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (broader): Source = SNOMED CT 248062006. Target 4092411 =. Target reframes as
        a behavioral finding rather than the injury event, and the source is deliberately
        method-unspecified; looser equivalence than the X8313/X8278 suicide-attempt mapping.
        """
}
