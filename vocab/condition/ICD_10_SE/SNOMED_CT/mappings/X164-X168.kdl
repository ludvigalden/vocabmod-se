// ICD-10-SE extension codes to SNOMED CT mappings, codes X164-X168
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X164.1" source="X164" target="242518000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X164 SNOMED CT 242518000 is a Swedish national extension of WHO base Contact with hot
        heating appliances, radiators and pipes (ICD-10 id 45756375); the Swedish suffix subdivides the
        base by a place/activity external-cause axis with no distinct standard SNOMED CT clinical analogue.
        Base event Athena-crosswalks to SNOMED CT 4073070 (concept_code 242518000) via ICD10 relationship
        45756375 -> 4073070. The Swedish place/activity qualifier is external-cause metadata; the injury
        event is unchanged. Target subsumes the event -> broader. Confidence : verified Athena crosswalk
        on the WHO base, one-level broader (qualifier dropped).
        """
}
