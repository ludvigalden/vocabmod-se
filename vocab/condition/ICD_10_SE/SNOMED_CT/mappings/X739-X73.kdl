// ICD-10-SE extension codes to SNOMED CT mappings, codes X739-X73
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X739.1" source="X739" target="248062006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 248062006 [GPS] [IPS] [ICNP]"
}
mapping "X7390.1" source="X7390" target="82313006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X7390 SNOMED CT 82313006 = a Swedish ICD-10-SE national extension that subdivides X73
        (Athena ICD10 concept 45756448) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4219484 = (sctid 82313006), the verified Athena crosswalk target for X73
        (ICD10 relationship 45756448 -> 4219484). Why this target: it is the authoritative standard
        concept the parent X73 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
