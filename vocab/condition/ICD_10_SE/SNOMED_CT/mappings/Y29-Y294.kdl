}
mapping "Y290.1" source="Y290" target="269735005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y290 SNOMED CT 269735005 = a Swedish ICD-10-SE national extension that subdivides Y29
        (Athena ICD10 concept 45756512) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 443272 = (sctid 269735005), the verified Athena crosswalk target for Y29
