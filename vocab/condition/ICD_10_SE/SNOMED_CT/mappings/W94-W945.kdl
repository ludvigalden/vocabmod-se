// ICD-10-SE extension codes to SNOMED CT mappings, codes W94-W945
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W940.1" source="W940" target="406445001" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "W9400.1" source="W9400" target="406445001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W9400 = Swedish ICD-10-SE national extension of W94 SNOMED CT 406445001 (Athena ICD10
        concept 45756338), refined by Swedish external-cause metadata: place=bostad och bostadsområde /
        hemmet (home and residential area); activity=idrott, sport, motion (sport, exercise). The
        clinical event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause
        metadata with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 443532 = sctid
        406445001. Why this target: Athena ICD10 crosswalk maps base W94 (concept_id 45756338) -> 443532
        (relationship 45756338, 443532); it is the authoritative standard concept for W94 and fully
        subsumes every place/activity-specific SE subdivision. mapping_type=broader (target fully
        contains every clinical meaning of the source; the dropped qualifier is breadth-neutral
        external-cause metadata, not a partial slice). Confidence (high): verified Athena crosswalk on
        the base code with a small, well-understood one-level breadth mismatch (the SE place/activity
        refinement is lost). Athena-local research only.
        """
}
