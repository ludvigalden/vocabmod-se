// ICD-10-SE extension codes to SNOMED CT mappings, codes V417-V41
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4170.1" source="V4170" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4170 = Swedish extension of V41.7 (person on outside of vehicle injured in traffic
        collision with pedal cycle, SNOMED CT 214171003/sport). Target SNOMED CT 4061564 = (concept_code
        214171003). Base V41.7 has a verified Athena crosswalk to 4061564; Swedish 5th-character adds an
        activity dimension absent from WHO ICD-10 and SNOMED CT. Target fully subsumes source (every V4170
        case is a road collision between motor vehicle and pedal cycle); activity and exact
        role-on-outside detail dropped. Broader; moderate.
        """
}
mapping "V4171.1" source="V4171" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4171 = Swedish extension of V41.7 (person on outside of vehicle traffic collision with
        pedal cycle, SNOMED CT 214171003/play and leisure). Target SNOMED CT 4061564. Base V41.7 verified
        crosswalk; activity dropped. Broader; moderate.
        """
}
