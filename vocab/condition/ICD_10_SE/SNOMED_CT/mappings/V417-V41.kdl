mapping "V4190.1" source="V4190" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4190 = Swedish ICD-10-SE national extension of WHO V41.9 SNOMED CT 214171003, with activity
        suffix (sport/exercise). Target SNOMED CT 4061564 = (214171003). Inherited via Athena from WHO
        V41.9 (concept_id 45604682). Target captures the collision mechanism fully but drops the
        unspecified-occupant role and the Swedish activity-context suffix; no SNOMED CT concept encodes
        activity-at-time-of-accident. Broader: target fully subsumes the accident scenario, source is a
        child by activity suffix. moderate: mechanical crosswalk not independently re-verified, and the
        activity suffix is a Swedish national extension with no standard analogue.
        """
}
mapping "V4191.1" source="V4191" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4191 = Swedish ICD-10-SE national extension of WHO V41.9 SNOMED CT 214171003, with activity
        suffix (play and other leisure). Target SNOMED CT 4061564 = (214171003). Inherited via Athena from
        WHO V41.9 (concept_id 45604682). Target captures the collision mechanism but drops the
        unspecified-occupant role and Swedish activity suffix; no SNOMED CT concept encodes
        activity-at-time-of-accident. Broader: target fully subsumes the accident scenario. moderate:
        mechanical crosswalk, unspecified/extended source.
        """
}
