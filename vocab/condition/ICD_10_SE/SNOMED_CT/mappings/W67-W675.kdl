// ICD-10-SE extension codes to SNOMED CT mappings, codes W67-W675
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W670.1" source="W670" target="217776008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is a Swedish ICD-10 SE extension sub-code of W67 (Drowning/submersion while in
        swimming-pool), qualified by place and activity. SNOMED CT 4318639 = SNOMED CT 217776008 (concept_code
        217776008). Athena crosswalk maps base W67 to 4318639. The Swedish sub-code denotes the same
        clinical event (drowning in a swimming pool) with added context (specific place category,
        specific activity). The target subsumes the source fully — every such case is an accidental
        drowning in a swimming pool. Broader mapping: the target drops the place/activity qualifiers.
        High confidence because the crosswalk is verified at the parent level and the breadth mismatch
        is small and well-understood.
        """
}
