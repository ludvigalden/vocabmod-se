// ICD-10-SE extension codes to SNOMED CT mappings, codes X683-X687
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X683.1" source="X683" target="271982007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X683 = Swedish ICD-10-SE national extension of X68 SNOMED CT 271982007 (Athena ICD10 concept
        45756446), refined by Swedish external-cause place axis: idrotts- och sportanläggning (sports
        and athletics facility); no specific activity axis (place-only code). The clinical
        event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause metadata
        with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 4152376 = sctid 271982007. Why
        this target: Athena ICD10 crosswalk maps base X68 (concept_id 45756446) -> 4152376 (relationship
        45756446, 4152376); it is the authoritative standard concept for X68 and fully subsumes every
        place/activity-specific SE subdivision. mapping_type=broader (target fully contains every
        clinical meaning of the source; the dropped qualifier is breadth-neutral external-cause
        metadata, not a partial slice). Confidence (high): verified Athena crosswalk on the base code
        with a small, well-understood one-level breadth mismatch (the SE place/activity refinement is
        lost). Athena-local research only.
        """
}
mapping "X6830.1" source="X6830" target="271982007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X6830 SNOMED CT 271982007 = a Swedish ICD-10-SE national extension that subdivides X68
        (Athena ICD10 concept 45756446) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4152376 = (sctid 271982007), the verified Athena crosswalk target for
        X68 (ICD10 relationship 45756446 -> 4152376). Why this target: it is the authoritative standard
        concept the parent X68 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
