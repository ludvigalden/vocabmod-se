// ICD-10-SE extension codes to SNOMED CT mappings, codes W36-W365
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W360.1" source="W360" target="218071008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W360 SNOMED CT 218071008 is the Swedish ICD-10-SE extension of W36 (Explosion and rupture of
        gas cylinder) adding place=home and residential area. Target SNOMED CT 436890 (Accident caused by
        explosion of gas cylinder, code 218071008) is the verified Athena crosswalk target for W36.
        Target fully subsumes source: every gas-cylinder explosion at home IS a gas-cylinder explosion.
        broader, confidence (verified crosswalk, one-level breadth).
        """
}
