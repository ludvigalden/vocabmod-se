// ICD-10-SE extension codes to SNOMED CT mappings, codes W08-W085
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W080.1" source="W080" target="242413007" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W080 SNOMED CT 242413007 = Fall from other furniture, home/residential area. Parent W08
        (Fall involving other furniture) SNOMED CT 433657 (Fall from furniture, concept_code 242413007).
        The place qualifier is administrative; the clinical concept is identical to W08/Fall from
        furniture. Exact-equivalent: crosswalk-verified, same concept.
        """
}
mapping "W0800.1" source="W0800" target="242413007" relationship=source_is_narrower_than_target {
