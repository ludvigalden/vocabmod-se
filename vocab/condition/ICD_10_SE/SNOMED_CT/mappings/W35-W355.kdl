// ICD-10-SE extension codes to SNOMED CT mappings, codes W35-W355
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W350.1" source="W350" target="218070009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W350 SNOMED CT 218070009 = Swedish 5-char extension of base ICD-10 W35 (Explosion and
        rupture of boiler) specialising the place to. Target SNOMED CT 433117 (concept_code 218070009) is
        the OMOP standard concept that the base W35 maps to via Athena crosswalk. SNOMED CT has no concept
        that distinguishes place/activity for boiler explosions, so 433117 is the leaf standard concept
        and fully subsumes every W350xxx child. broader because target covers the event without the
        place axis; moderate tier per rubric — best available standard concept, mechanical crosswalk
        from W35 not independently re-verified for the Swedish extension, and
        unspecified-with-respect-to-place source framing.
        """
}
mapping "W3500.1" source="W3500" target="218070009" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3500 SNOMED CT 218070009 = Swedish extension of W35 boiler explosion,
        place=home/residential area, activity=sport/exercise. SNOMED CT 433117 is the leaf standard
        concept; no SNOMED CT concept distinguishes the activity or place. broader (target fully subsumes
        source event); moderate — best available, crosswalk-verified at base level only.
        """
}
