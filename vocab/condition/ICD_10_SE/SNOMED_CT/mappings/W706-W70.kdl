// ICD-10-SE extension codes to SNOMED CT mappings, codes W706-W70
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W706.1" source="W706" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W706 = drowning and submersion following fall into natural water in
        industrial/construction area (no activity specified). Parent W70 crosswalks to SNOMED CT 436593
        (Accidental drowning and submersion). Target broader: covers all accidental drowning, not
        limited to natural-water falls or industrial locations. Moderate tier: Athena crosswalk at
        parent level; 4-digit subcode is a Swedish place modifier with no individual SNOMED CT equivalent.
        """
}
