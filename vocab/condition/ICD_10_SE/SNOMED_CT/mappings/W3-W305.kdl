}
mapping "W3000.1" source="W3000" target="220668001" relationship=partial_overlap {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W3000 = Swedish ICD-10-SE SNOMED CT 220668001. Target SNOMED CT 40420911 (220668001) =
        [X]Contact with agricultural machinery, occurrence at home. SNOMED CT captures machinery+place axis
        exactly; the Swedish activity suffix (sport) is a separate dimension with no SNOMED CT
        representation and is dropped. Partial single-component match. Moderate tier per §1: best
        available standard concept, SNOMED CT [X] mechanical crosswalk not independently re-verified.
        """
}
