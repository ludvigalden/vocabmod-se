// ICD-10-SE extension codes to SNOMED CT mappings, codes V89-V8
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8900.1" source="V8900" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8900 = Swedish extension of WHO ICD-10 V89.0 SNOMED CT 214031005 36198007 with activity
        suffix (sport/exercise). Targets 437165 SNOMED CT and 444074 are the Athena crosswalk targets of
        V89.0. Broader: targets subsume the victim/accident semantics; activity context lost. Moderate:
        crosswalk via WHO parent, not re-verified at extension level.
        """
}
