// ICD-10-SE extension codes to SNOMED CT mappings, codes X975-X97
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X975.1" source="X975" target="219231000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X975 SNOMED CT 219231000 = a Swedish ICD-10-SE national extension that subdivides X97
        (Athena ICD10 concept 45756465) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 438051 = (sctid 219231000), the verified Athena crosswalk target for X97
        (ICD10 relationship 45756465 -> 438051). Why this target: it is the authoritative standard
        concept the parent X97 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
