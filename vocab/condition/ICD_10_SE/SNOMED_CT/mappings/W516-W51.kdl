// ICD-10-SE extension codes to SNOMED CT mappings, codes W516-W51
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W516.1" source="W516" target="58538004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W516 = Swedish extension of W51 with location SNOMED CT 58538004 (industrial/construction
        area), no activity specified. Target SNOMED CT 4239303 =. Same broader-subsumption reasoning:
        SNOMED CT concept fully contains the event; the location axis has only an invalid [X]-prefixed
        SNOMED CT analogue (40421851/220871007). : verified crosswalk from W51, one-level broader.
        """
}
