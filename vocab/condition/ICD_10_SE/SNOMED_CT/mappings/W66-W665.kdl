// ICD-10-SE extension codes to SNOMED CT mappings, codes W66-W665
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W660.1" source="W660" target="221000003" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W660 (Swedish ICD-10 5-char extension of W66 SNOMED CT 221000003, place = home/residential
        area, no activity axis) encodes the clinical event of bathtub drowning following a fall,
        occurring at home. Target SNOMED CT 40417713 (concept_code 221000003) = [X]Drowning and submersion
        following fall into bath-tub, occurrence at home. The target is the ICD-10-aligned SNOMED CT
        equivalent at the same place axis (home). Broader rather than exact because the Swedish code is
        a national extension with no direct Athena crosswalk, and the SNOMED CT [X] concept is the WHO
        ICD-10 equivalent. High tier: closest standard concept, place axis matches exactly, no extra
        axes dropped.
        """
}
mapping "W6600.1" source="W6600" target="221000003" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W6600 (Swedish ICD-10 5-char extension of W66, place = home, activity = sport/exercise)
        encodes the clinical event of bathtub drowning following a fall at home during sport. Target
        SNOMED CT 40417713 (concept_code 221000003) = [X]Drowning and submersion following fall into
        bath-tub, occurrence at home. Target captures the clinical drowning event and the place axis; it
        drops the activity axis (sport/exercise), which has no SNOMED CT analogue (external-cause modifier,
        not a clinical feature). Broader: target fully contains the clinical event. Moderate tier: place
        axis matches but the activity qualifier is unmapped, so equivalence is looser than for W660.
        """
}
