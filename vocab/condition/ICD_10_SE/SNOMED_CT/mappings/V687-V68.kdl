// ICD-10-SE extension codes to SNOMED CT mappings, codes V687-V68
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6870.1" source="V6870" target="242116005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6870 = Swedish 7-char extension of V68.7 SNOMED CT 242116005, activity context. Target
        SNOMED CT 432509 = (242116005). Parent V68.7 crosswalks to 432509 in Athena; activity-context
        suffix has no SNOMED CT analogue. Target fully subsumes the accident meaning (broader);
        person-on-outside role and activity detail dropped. High tier : verified parent crosswalk,
        one-level breadth loss.
        """
}
mapping "V6871.1" source="V6871" target="242116005" relationship=source_is_narrower_than_target {
