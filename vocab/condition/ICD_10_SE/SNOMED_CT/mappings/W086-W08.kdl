// ICD-10-SE extension codes to SNOMED CT mappings, codes W086-W08
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W086.1" source="W086" target="242413007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W086 = Swedish 4-char extension of W08 SNOMED CT 242413007 in industrial area/construction
        site. Target SNOMED CT 433657 = (242413007), Athena crosswalk target for W08. SNOMED CT has no
        parallel for the place axis; 433657 subsumes the source. High tier : verified crosswalk,
        one-level breadth mismatch.
        """
}
