// ICD-10-SE extension codes to SNOMED CT mappings, codes V77-V774
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7700.1" source="V7700" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V77.00 = Swedish extension of V77.0 SNOMED CT 214640008. Activity suffix is a Swedish
        national extension with no SNOMED CT analogue. Athena maps V77.0 (concept 45756055) to SNOMED CT
        437738 (214640008) — the most specific standard target for a nontraffic bus collision. Broader:
        target captures the off-road MV accident event, drops the fixed-object and activity specifics.
        Confidence moderate: mechanical crosswalk at the 4-char level, Swedish source extension.
        """
}
mapping "V7701.1" source="V7701" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V77.01 = Swedish extension of V77.0 SNOMED CT 214640008. Same V77.0 → SNOMED CT 437738
        (214640008) lineage. Broader; confidence moderate.
        """
}
mapping "V7702.1" source="V7702" target="217897003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is a Swedish ICD-10-SE 5-digit activity extension of V77 (Bus occupant injured in
        collision with fixed or stationary object, nontraffic accident). The 5th digit encodes the
        activity at time of injury (sport/leisure/work/vital/other/unspecified); the 4th digit encodes
        the role (driver/passenger/person on outside/unspecified). The activity dimension has no SNOMED CT
        representation. Following corpus precedent (V770-V779 parents and V79xx siblings), the activity
        codes inherit the parent's three SNOMED CT targets: 436292, 437738, 444074. Each target subsumes
        the source (broader): the SNOMED CT concept captures the collision/accident aspect but drops
        bus-specificity, role, and activity. Legacy confidence rebaselined to moderate (Athena
        crosswalk, unspecified-source breadth mismatch, not independently re-verified).
        """
}
