// ICD-10-SE extension codes to SNOMED CT mappings, codes W650-W655
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W650.1" source="W650" target="217773000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W650 = SNOMED CT 217773000 (Swedish ICD-10 external-cause extension). The base ICD-10 code
        W65 (Accidental drowning and submersion while in bath-tub) has a verified Athena crosswalk to
        (Accidental drowning or immersion in bathtub). The source adds the home-place qualifier; the
        SNOMED CT concept 220988004 (Drowning and submersion while in bath-tub, occurrence at home)
        captures the place axis specifically but is an [X] extension concept. Mapping to 217773000 is
        broader (drops the place qualifier); one-level broader with a verified crosswalk. High tier.
        """
}
mapping "W6500.1" source="W6500" target="217773000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W6500 = SNOMED CT 217773000 (Swedish ICD-10 extension). Maps to (Accidental drowning or
        immersion in bathtub) via the W65 crosswalk. Place (home) + activity (sports) qualifiers have no
        SNOMED CT analogue at this granularity; the place-specific SNOMED CT 220988004 captures only the home
        axis, leaving the activity axis uncovered. One-level broader; moderate tier.
        """
}
mapping "W6501.1" source="W6501" target="217773000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W6501 = SNOMED CT 217773000 (Swedish ICD-10 extension). Maps to (Accidental drowning or
        immersion in bathtub) via the W65 crosswalk. Place (home) + activity (play/leisure) qualifiers
        dropped; no SNOMED CT concept models the activity axis. One-level broader; moderate tier.
        """
}
mapping "W6502.1" source="W6502" target="217773000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source: W6502 SNOMED CT 217773000 = drowning/submersion in bathtub at home during work. Swedish
        ICD-10 external-cause extension encoding place (home) + activity (work) on base code W65.
        Target: SNOMED CT 436592 (217773000). Best available standard concept: captures the mechanism
        (drowning in bathtub) but not the place/activity qualifiers. Parent W65 has Athena crosswalk
        SNOMED CT 217773000 436592. Moderate tier: best available standard target, verified crosswalk from
        parent code, but source is more specific (place+activity) than target.
        """
}
