mapping "V1901.1" source="V1901" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1901 = Swedish 5th-char extension of ICD-10 V19.0 (Driver injured in collision with
        other/unspecified motor vehicles in nontraffic accident), activity=leisure/other free time. Base
        V19.0 Athena-crosswalked to SNOMED CT 432510 (Driver in vehicular AND/OR traffic accident) and
        437738 (Motor vehicle accident off public road). 432510 is the primary cyclist-role target
        (driver of the pedal cycle). Activity suffix is administrative context not in SNOMED CT. broader,
        moderate.
        """
}
