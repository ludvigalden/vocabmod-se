// ICD-10-SE extension codes to SNOMED CT mappings, codes W509-W50
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W509.1" source="W509" target="243671000000109" relationship=source_is_narrower_than_target {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W509 is the Swedish extension for W50 SNOMED CT 219178006 243671000000109, unspecified
        place, unspecified activity. Target SNOMED CT 44790611 is the primary Athena crosswalk target for
        base W50. Since W509 is the unspecified variant (no place/activity suffix), the target subsumes
        the full clinical meaning with no specificity loss beyond the base code. Confidence (moderate):
        inherited crosswalk from parent W50; the prior athena comment suggested 437483 (Homicide or
        assault by unarmed fight or brawl) but 44790611 is the verified primary Maps-to target and is
        preferred.
        """
}
mapping "W509.2" source="W509" target="219178006" relationship=source_is_narrower_than_target preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "W5090.1" source="W5090" target="243671000000109" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is a Swedish national extension of ICD-10 W50 SNOMED CT 243671000000109 with added
        place/activity specificity. Target SNOMED CT 44790611 (concept_code 243671000000109,
        standard_concept=S) is the primary Athena crosswalk target for base W50 (ICD10 concept
        45756301). The target fully subsumes the interpersonal-violence event meaning; the
        place/activity suffix is circumstantial metadata, not a separate clinical axis, so the
        relationship is broader not partial. Confidence (moderate): best available standard concept,
        crosswalk inherited from parent W50 since the Swedish extension subcode has no direct OMOP ICD10
        entry; source specificity (place/activity) not captured by target.
        """
}
