// ICD-10-SE extension codes to SNOMED CT mappings, codes W850-W854
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W850.1" source="W850" target="242789001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W850 = SNOMED CT 242789001 (Swedish national extension). Base W85 Athena-crosswalks to
        SNOMED CT 4055054 (concept_code 242789001) via ICD10 relationship 45756330 -> 4055054. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W85, one-level broader (Swedish
        qualifier dropped).
        """
}
