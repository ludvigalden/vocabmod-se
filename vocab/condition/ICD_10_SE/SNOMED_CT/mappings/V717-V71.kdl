// ICD-10-SE extension codes to SNOMED CT mappings, codes V717-V71
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7170.1" source="V7170" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7170 = Swedish extension of V71.7 (Bus occupant, person on outside of vehicle injured in
        traffic accident, collision with pedal cycle) with activity SNOMED CT 214171003 (sport/exercise).
        Target SNOMED CT 4061564 (214171003, Motor vehicle on road in collision with pedal cycle) is the
        Athena Maps-to target for base V71.7. Target captures the collision event but loses the
        person-on-outside role, the bus-specificity, and the activity dimension. Broader on multiple
        axes. Moderate tier: best available standard target; meaningful specificity loss.
        """
}
mapping "V7171.1" source="V7171" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7171 = Swedish extension of V71.7 (bus occupant, person on outside, traffic accident,
        pedal cycle collision) with activity SNOMED CT 214171003 (play/leisure). Target SNOMED CT 4061564
        (214171003, Motor vehicle on road in collision with pedal cycle) is the Athena Maps-to target
        for base V71.7. Person-on-outside role, bus-specificity, and activity lost. Broader. Moderate
        tier.
        """
}
