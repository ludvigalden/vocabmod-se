mapping "V7179.1" source="V7179" target="214171003" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7179 = Swedish 5-char extension of ICD-10 V71.7 SNOMED CT 214171003 36198007, with 5th
        char. The activity suffix (sport/work/leisure/etc.) is a Swedish context modifier with no SNOMED CT
        analogue; the underlying injury concept is V71.7. Athena ICD10 V71.7 crosswalk (concept
        45756000) Maps to SNOMED CT 4061564 (214171003, std=S) and SNOMED CT 444074 (36198007, std=S). 4061564
        is broader (subsumes the collision type); 444074 is a more general broader traffic-accident
        victim concept. for the specific collision target (one-level broader, crosswalk-verified); for
        the generic victim concept.
        """
}
mapping "V7179.2" source="V7179" target="36198007" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
