// ICD-10-SE extension codes to SNOMED CT mappings, codes M89
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M890B.1" source="M890B" target="712537009" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M890B SNOMED CT 712537009 = algoneurodystrophy (CRPS) of shoulder/upper arm (Swedish B, WHO
        M89.01+M89.02). Target 46273207 (712537009), the Athena Maps-to target for M89.01 and M89.02.
        Broader: subsumes the site-specific source into the upper-limb CRPS concept. One-level broader,
        crosswalk-verified.
        """
}
mapping "M890C.1" source="M890C" target="712537009" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M890C SNOMED CT 712537009 = CRPS of elbow/forearm (Swedish C, WHO M89.03). Target 46273207
        (712537009), the Athena Maps-to target for M89.03. Broader: upper-limb CRPS subsumes the forearm
        site. Crosswalk-verified.
        """
}
