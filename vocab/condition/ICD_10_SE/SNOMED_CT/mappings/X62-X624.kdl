// ICD-10-SE extension codes to SNOMED CT mappings, codes X62-X624
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X620.1" source="X620" target="271982007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X620 SNOMED CT 271982007 = a Swedish ICD-10-SE national extension that subdivides X62
        (Athena ICD10 concept 45756441) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4152376 = (sctid 271982007), the verified Athena crosswalk target for
        X62 (ICD10 relationship 45756441 -> 4152376). Why this target: it is the authoritative standard
        concept the parent X62 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
