}
mapping "X3900.1" source="X3900" target="217591008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X3900 = SNOMED CT 217591008 (Swedish national extension). Base X39 Athena-crosswalks to
        SNOMED CT 437453 (concept_code 217591008) via ICD10 relationship 45756395 -> 437453. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X39, one-level broader (Swedish
        qualifier dropped).
        """
}
