// ICD-10-SE extension codes to SNOMED CT mappings, codes Y05
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y050.1" source="Y050" target="248110007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y050 SNOMED CT 248110007 = a Swedish ICD-10-SE national extension that subdivides Y05
        (Athena ICD10 concept 45756472) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4093699 = (sctid 248110007), the verified Athena crosswalk target for
        Y05 (ICD10 relationship 45756472 -> 4093699). Why this target: it is the authoritative standard
        concept the parent Y05 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
