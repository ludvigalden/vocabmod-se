// ICD-10-SE extension codes to SNOMED CT mappings, codes W546-W549
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W546.1" source="W546" target="37383006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W546 SNOMED CT 37383006 = Swedish ICD-10 SE extension external-cause code: bitten/attacked
        by dog, with place+activity detail (industrial area/construction site (place only)). No standard
        OMOP/SNOMED CT concept exists at this place+activity granularity. Target SNOMED CT 4291007 =
        (fully-specified name), the verified Athena crosswalk target of the parent ICD-10 W54 (Bitten or
        struck by dog). The target fully subsumes the mechanism axis (every dog attack is a mammal
        attack) but drops the place and activity axes entirely. Best available standard concept.
        Moderate confidence : mechanical crosswalk inherited from parent W54, not independently
        re-verified per 5-digit child; source carries detail with no standard representation.
        """
}
