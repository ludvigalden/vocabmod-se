// ICD-10-SE extension codes to SNOMED CT mappings, codes V646-V64
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6460.1" source="V6460" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6460 is a Swedish 7th-character ICD-10 extension of V64.6 (Occupant of heavy transport
        vehicle injured in collision with heavy transport vehicle or bus, passenger injured in traffic
        accident). The 7th character SNOMED CT 274913009 encodes the activity at time of injury: idrott,
        sport, motion (sport/exercise). This contextual axis (what the injured person was doing) has no
        clinical SNOMED CT equivalent. Target SNOMED CT 433930 = is the parent V64.x's verified Athena
        standard concept; it fully captures the injury event (heavy-transport collision, v64.6) but
        drops the activity qualifier. broader: target subsumes the source's injury event without the
        contextual axis. Moderate : parent crosswalk verified in the ICD10/SNOMED CT mirror, but the
        Swedish extension is not independently re-verified.
        """
}
