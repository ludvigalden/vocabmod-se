    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W4000.1" source="W4000" target="218099004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4000 SNOMED CT 218099004 is a Swedish 6-char extension of ICD-10 W40 (Explosion of other
        materials) with place=home/residential area and activity=sport. Target SNOMED CT 440607 =
        (218099004). Base ICD-10 W40 has verified Athena to 440607; place/activity suffix not separately
        encoded in SNOMED CT, target subsumes source (broader). Moderate tier: parent crosswalk applied
        mechanically to children.
        """
}
