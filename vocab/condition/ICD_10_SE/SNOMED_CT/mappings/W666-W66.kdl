// ICD-10-SE extension codes to SNOMED CT mappings, codes W666-W66
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W666.1" source="W666" target="217773000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W666 SNOMED CT 217773000 = drowning/submersion following fall into bathtub,
        industrial/construction area (Swedish 4th-digit place extension of WHO W66). Target SNOMED CT
        436592 (217773000). The SNOMED CT target subsumes all bathtub drowning regardless of place. No
        standard SNOMED CT concept exists for place-specific bathtub drowning (only [X] extended concepts).
        Broader map: target fully contains source. Moderate tier: verified crosswalk from W66 base to
        this SNOMED CT target; SE place extension is a child of W66.
        """
}
mapping "W6660.1" source="W6660" target="217773000" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W6660 SNOMED CT 217773000 = drowning after fall into bathtub at industrial area during
        sport/exercise (Swedish 5th-digit activity extension). Target SNOMED CT 436592. No standard SNOMED CT
        concept captures place+activity granularity; target fully subsumes source. Moderate tier:
        crosswalk-verified from W66 base.
        """
}
