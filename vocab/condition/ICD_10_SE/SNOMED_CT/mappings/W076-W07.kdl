// ICD-10-SE extension codes to SNOMED CT mappings, codes W076-W07
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W076.1" source="W076" target="83468000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W076 SNOMED CT 83468000 = fall from chair in industrial area/construction site. Swedish
        5-char extension of W07. Target SNOMED CT 4308870 = (83468000), standard concept. Base W07
        crosswalk verified. The SNOMED CT concept 40419719 (220425009) is retired (invalid_reason=U).
        Broader: target subsumes source; location specificity lost. High.
        """
}
