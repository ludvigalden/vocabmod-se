    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X4700.1" source="X4700" target="442784009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X4700 SNOMED CT 442784009 = a Swedish ICD-10-SE national extension that subdivides X47
        (Athena ICD10 concept 45756403) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 40484966 = (sctid 442784009), the verified Athena crosswalk target for
        X47 (ICD10 relationship 45756403 -> 40484966). Why this target: it is the authoritative standard
        concept the parent X47 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
