// ICD-10-SE extension codes to SNOMED CT mappings, codes X92-X924
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X920.1" source="X920" target="219197006" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 219197006 [GPS]"
}
mapping "X9200.1" source="X9200" target="219197006" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X9200 SNOMED CT 219197006 = a Swedish ICD-10-SE national extension that subdivides X92
        (Athena ICD10 concept 45756460) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 439448 = (sctid 219197006), the verified Athena crosswalk target for X92
        (ICD10 relationship 45756460 -> 439448). Why this target: it is the authoritative standard
        concept the parent X92 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
