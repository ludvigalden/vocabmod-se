// ICD-10-SE extension codes to SNOMED CT mappings, codes X02-X025
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X020.1" source="X020" target="288297000" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "X0200.1" source="X0200" target="288297000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X0200 = SNOMED CT 288297000 (Swedish national extension). Base X02 Athena-crosswalks to
        SNOMED CT 438938 (concept_code 288297000) via ICD10 relationship 45756362 -> 438938. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X02, one-level broader (Swedish
        qualifier dropped).
        """
}
