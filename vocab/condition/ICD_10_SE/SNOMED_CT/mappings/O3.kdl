        """
}
mapping "O300X.1" source="O300X" target="65147003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O300X SNOMED CT 65147003 = twin pregnancy, unspecified chorionicity (Swedish extension of
        WHO O30.0). SNOMED CT 441919 (Twin pregnancy, concept_code 65147003) is the standard Clinical
        Finding that the WHO O30.0 base crosswalks to via Athena. Source is functionally the
        WHO-equivalent unspecified twin pregnancy; broader label chosen because the Swedish extension
        code is distinct from the WHO base. High : verified crosswalk on the WHO parent, one-level
        broader (chorionicity unspecified).
        """
}
