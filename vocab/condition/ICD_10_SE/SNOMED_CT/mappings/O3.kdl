// ICD-10-SE extension codes to SNOMED CT mappings, codes O3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "O300A.1" source="O300A" target="459166009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O300A SNOMED CT 459166009 = dichorionic/diamniotic twin pregnancy (Swedish extension of WHO
        O30.0). SNOMED CT 43021054 (Dichorionic diamniotic twin pregnancy, concept_code 459166009) is a
        standard Clinical Finding denoting exactly the same chorionicity/amnionicity combination. 1:1
        semantic equivalence; exact_match.
        """
}
mapping "O300B.1" source="O300B" target="459168005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O300B SNOMED CT 459168005 = monochorionic/diamniotic twin pregnancy (Swedish extension of
        WHO O30.0). SNOMED CT 43021951 (Monochorionic diamniotic twin pregnancy, concept_code 459168005) is
        a standard Clinical Finding denoting exactly the same chorionicity/amnionicity. 1:1 equivalence;
        exact_match.
        """
}
mapping "O300C.1" source="O300C" target="459171002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O300C SNOMED CT 459171002 = monochorionic/monoamniotic twin pregnancy (Swedish extension of
        WHO O30.0). SNOMED CT 43021952 (Monochorionic monoamniotic twin pregnancy, concept_code 459171002)
