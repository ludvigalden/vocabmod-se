// ICD-10-SE extension codes to SNOMED CT mappings, codes M2
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M210C.1" source="M210C" target="70123009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
}
mapping "M210F.1" source="M210F" target="33754009" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "M210G.1" source="M210G" target="52012001" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M210G SNOMED CT 52012001 = genu valgum / knock knee (Swedish 6th-char G = knee/lower leg).
        Target SNOMED CT 80504 (52012001) = Acquired genu valgum. Athena crosswalk from base ICD-10 M21.06
        (Valgus deformity, lower leg) maps directly to 80504. The Swedish code specifies genu (knee)
        which is the same clinical concept as. Confidence : crosswalk-verified exact match, Swedish
        extension code corresponds to M21.06.
        """
}
mapping "M211C.1" source="M211C" target="15935181000119105" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "M211F.1" source="M211F" target="12067001" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M211F SNOMED CT 12067001 = coxa vara deformity of hip (Swedish 6th-char F = pelvic
        region/thigh, here specifically hip). Target SNOMED CT 81948 (12067001) = Acquired coxa vara. Base
        ICD-10 M21.15 (Varus deformity, pelvic region and thigh) crosswalks to 37162978 (Deformity of
        bone of pelvis), but 81948 is the more clinically precise SNOMED CT concept that exactly denotes
        coxa vara. Confidence : exact clinical concept match, SNOMED CT browser confirms 12067001 is the
        canonical acquired coxa vara.
        """
}
mapping "M211G.1" source="M211G" target="79168008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
}
mapping "M217F.1" source="M217F" target="203601000" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source M217F SNOMED CT 203601000 = unequal leg length in femur. Target SNOMED CT 40400785 (203601000)
        = Acquired unequal leg length. The source is specifically about femur shortening, but SNOMED CT
        only has side-specific femur-shortening concepts (601060 left femur, 601063 right femur) without
        a side-agnostic femur-specific target. 40400785 is the parent that subsumes all lower-limb
        length inequality including the femur-shortening cases. Confidence : target is broader than
        source (target subsumes both femur and tibia cases, both sides), but is the best side-agnostic
        standard concept.
        """
}
mapping "M217G.1" source="M217G" target="203601000" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source M217G SNOMED CT 203601000 = unequal leg length in lower leg (tibia/fibula). Target SNOMED CT
        40400785 (203601000) = Acquired unequal leg length. SNOMED CT has side-specific tibia-shortening
        concepts (601062 left, 601065 right) but no side-agnostic tibia-specific target. 40400785
        subsumes all lower-limb length inequality. Confidence : target is broader than source, but is
        the best side-agnostic standard concept.
        """
}
mapping "M217X.1" source="M217X" target="203601000" relationship=equivalent quality=100 {
