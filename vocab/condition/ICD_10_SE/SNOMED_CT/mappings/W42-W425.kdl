// ICD-10-SE extension codes to SNOMED CT mappings, codes W42-W425
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W420.1" source="W420" target="218229001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W4200.1" source="W4200" target="6300007" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4200 SNOMED CT 6300007 is the Swedish national extension of ICD-10 W42 (Exposure to noise)
        scoped to residential area + sport/activity. Target =, the Athena crosswalk target for parent
        W42 (OMOP concept 45756295 -> 434238). The target denotes the same clinical event (noise
        exposure) and fully subsumes the source; the residential/activity context is administrative
        detail with no separate SNOMED CT representation, making the target one level broader than the
        source. High : parent crosswalk-verified, well-understood breadth mismatch.
        """
}
mapping "W4201.1" source="W4201" target="6300007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4201 SNOMED CT 6300007 = exposure to noise at home/residential area during leisure
        activity. Target SNOMED CT 434238 is the OMOP standard concept that the parent W42 maps to via
        verified Athena crosswalk. The setting/activity detail has no OMOP standard analogue —
        non-standard [X]Exposure-to-noise-by-place concepts (40421549 at home, etc.) exist but are
        themselves non-standard and map upward to 434238. Target fully subsumes the source (every
        leisure noise exposure at home is an exposure to noise). High tier: one-level broader, verified
        crosswalk, well-understood breadth mismatch.
        """
}
mapping "W4202.1" source="W4202" target="6300007" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4202 SNOMED CT 6300007 = exposure to noise at home/residential area during paid work.
        SNOMED CT 4301229 is the work-specific descendant, but the home/residential-area context is not
        occupational, so the standard general target 434238 is the closest defensible standard concept
        (parent W42 maps to it via verified Athena crosswalk). Target fully subsumes the source. High
        tier: one-level broader, verified crosswalk.
        """
}
