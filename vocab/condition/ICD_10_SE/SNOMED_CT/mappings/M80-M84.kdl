mapping "M800J.1" source="M800J" target="203451004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M800J SNOMED CT 203451004 = postmenopausal osteoporosis with pathological fracture, thoracic
        spine (SE extension of M80.0). Target SNOMED CT 4068133 (203451004) = Osteoporotic fracture of
        thoracic vertebra. Unlike the other M80.0 sites (which map to generic
        pathological-fracture-by-site concepts), the thoracic-spine site has a dedicated
        osteoporotic-fracture SNOMED CT concept that captures both the fracture-site axis and the
        osteoporosis axis of the combined source. High tier: precise semantic match, slightly below
        because the source specifies which the SNOMED CT concept does not encode.
        """
}
mapping "M800K.1" source="M800K" target="1245005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M800K (Swedish ICD-10-SE) = postmenopausal osteoporosis with pathological fracture in
        lumbar spine — a Swedish site-letter extension of ICD-10 M80.0. Target SNOMED CT 1245005 =
        (concept_code 1295483002), the standard concept that the international parent M80.0 (concept
        45572553) and all its site variants crosswalk to via Athena. The lumbar-spine site specificity
        in the Swedish code is not separately represented in SNOMED CT; target fully subsumes the source.
        broader (target subsumes site-specific source); high tier — verified crosswalk to the
        international parent, small breadth mismatch (site detail dropped).
        """
}
