mapping "M800C.1" source="M800C" target="287066008" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M800C SNOMED CT 287066008 = postmenopausal osteoporosis with pathological fracture,
        elbow/forearm (SE extension of M80.0). Target SNOMED CT 440511 (287066008) = Pathological fracture
        - forearm. The Athena target for ICD-10-CM M80.03X (Postmenopausal osteoporosis with
        pathological fracture, forearm). The target captures the fracture-site axis of the combined
        source; the underlying osteoporosis is implicit in the Athena standard mapping. High tier:
        crosswalk-verified site match.
        """
}
mapping "M800E.1" source="M800E" target="287068009" relationship=equivalent {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source M800E SNOMED CT 287068009 = postmenopausal osteoporosis with pathological fracture, pelvic
        region (SE extension of M80.0). Target SNOMED CT 434140 (287068009) = Pathological fracture -
        pelvis and/or thigh. The Athena target for ICD-10-CM M80.05X. Note: SE code is pelvis-only while
        the SNOMED CT target covers pelvis-and-thigh; this is a small breadth mismatch, hence (high) rather
        than. Best available standard concept for the pelvic site.
        """
}
mapping "M800F.1" source="M800F" target="287068009" relationship=equivalent quality=100 {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source M800F SNOMED CT 287068009 = postmenopausal osteoporosis with pathological fracture,
        hip/thigh (SE extension of M80.0). Target SNOMED CT 434140 (287068009) = Pathological fracture -
        pelvis and/or thigh. The Athena target for ICD-10-CM M80.05X (pelvic region and thigh).
        Hip/thigh is covered by the SNOMED CT concept's component. High tier: crosswalk-verified site
        match.
        """
}
