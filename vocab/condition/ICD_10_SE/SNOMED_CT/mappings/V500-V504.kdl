// ICD-10-SE extension codes to SNOMED CT mappings, codes V500-V504
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5000.1" source="V5000" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5000 = Swedish-SE extension of V50.0 (Driver of pick-up truck or van injured in
        collision with pedestrian or animal, driver injured in non-traffic accident) + activity suffix
        SNOMED CT 214640008 36198007 = idrott, sport, motion. V50.0 base has Athena Maps-to to 437738
        (Motor vehicle accident off public road) and 444074 (Victim of vehicular AND/OR traffic
        accident). Activity suffix is SE-administrative with no SNOMED CT analogue. Both targets capture
        part of the clinical content (off-public-road context; victim role) but lose the
        pick-up-truck/collision-with-pedestrian-or-animal detail. Broader (target subsumes victim
        aspect, drops vehicle-type and activity), moderate: verified crosswalk for V50.0 base, applied
        mechanically to SE child.
        """
}
mapping "V5000.2" source="V5000" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V5001.1" source="V5001" target="214640008" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5001 is a Swedish national-extension 7-char ICD-10 code encoding SNOMED CT 214640008 PLUS a
        Swedish-specific activity-dimension suffix (idrott/sport, lek och fritid, förvärvsarbete, annan
        sysselsättning, vitalaktivitet, andra specificerade, ospecificerad). The activity context has no
        SNOMED CT or OMOP standard concept analogue - it is a registry-only dimension. The underlying clinical
        injury event is captured by the parent V50 code crosswalk: V50.0 (driver non-traffic), V50.1
        (passenger non-traffic), V50.2 (person on outside non-traffic), V50.3 (unspecified occupant
        non-traffic) all Athena- (Motor vehicle accident off public road, OMOP concept 437738). Target
        214640008 (SNOMED CT disorder). Best available standard concept; the source's
        vehicle/role/non-traffic semantics are covered but the activity dimension is dropped. Confidence
        (low): partial mapping - one axis of a multi-dimensional Swedish-extension code, crosswalk
        inherited from parent V50 code, not independently re-verified at the 7-char level.
        """
}
