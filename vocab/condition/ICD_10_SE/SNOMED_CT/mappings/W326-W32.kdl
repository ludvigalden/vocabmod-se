// ICD-10-SE extension codes to SNOMED CT mappings, codes W326-W32
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W326.1" source="W326" target="218082000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W326 SNOMED CT 218082000 = Swedish extension of W32 specifying place=industrial/construction
        site. Target SNOMED CT 433948 (verified Maps-to for parent W32). Place axis has no SNOMED CT analogue;
        clinical core fully captured. Broader; high.
        """
}
