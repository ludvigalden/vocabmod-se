// ICD-10-SE extension codes to SNOMED CT mappings, codes W73-W737
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W730.1" source="W730" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W730 = other specified drowning and submersion, residential area (bostad och
        bostadsområde). This is a 4-char place modifier of W73. Target SNOMED CT 436593 (217748000), the
        standard concept that parent W73 crosswalks to. SNOMED CT has non-standard [X] concept 40417991
        (other specified drowning, occurrence at home, 221056004) which matches the place dimension, but
        it is deprecated (invalid_reason=D). No standard concept captures the place dimension for
        W73-type drowning. Weak tier: place specificity lost, but total subsumption and parent
        crosswalk.
        """
}
mapping "W7300.1" source="W7300" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7300 = other specified drowning and submersion, residential area, sports/exercise
        activity. Target SNOMED CT 436593 (217748000). 5-char code adds both place (residential) and
        activity (sports) detail; no standard SNOMED CT concept captures either dimension for W73-type
        drowning. Weak tier: extreme specificity loss, parent crosswalk-confirmed, total subsumption.
        """
}
