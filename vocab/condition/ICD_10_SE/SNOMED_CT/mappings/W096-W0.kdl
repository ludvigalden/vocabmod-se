// ICD-10-SE extension codes to SNOMED CT mappings, codes W096-W0
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W096.1" source="W096" target="41411008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W096 SNOMED CT 41411008 = Swedish 4-character extension of W09 refining place=industrial and
        construction area. UK-extension [X] concept 220446000 (id 40419959) is non-standard
        classification in the mirror. Target SNOMED CT 437477 (41411008), international standard, Athena
        W09 Maps to target. Broader one level.
        """
}
