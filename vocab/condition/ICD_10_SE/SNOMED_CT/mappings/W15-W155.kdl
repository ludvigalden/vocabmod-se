// ICD-10-SE extension codes to SNOMED CT mappings, codes W15-W155
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W150.1" source="W150" target="4521008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W150 Swedish extension of W15 SNOMED CT 4521008 (ICD10 45585578) adding place
        (home/residential area). Target SNOMED CT 432806 (4521008, Fall from cliff) is the Athena-verified
        for base W15. Target fully subsumes the source; place metadata has no SNOMED CT analogue and is
        dropped. One-level broader with verified crosswalk.
        """
}
