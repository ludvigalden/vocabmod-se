// ICD-10-SE extension codes to SNOMED CT mappings, codes V657-V65
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6570.1" source="V6570" target="242090001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6570 = Swedish 5th-character extension of ICD-10 V65.6/.7/.9 (occupant of heavy
        transport vehicle injured in collision with railway train, person på utsidan av fordonet skadad
        i trafikolycka, activity=idrott, sport, motion). The activity-context suffix has no SNOMED CT
        representation; the base ICD-10 V65.6/V65.7/V65.9 maps via Athena crosswalk to SNOMED CT 4054296
        (Motor vehicle on road in collision with vehicle running on rails) and 444074 (Victim of
        vehicular AND/OR traffic accident). 4054296 captures the specific collision mechanism; 444074 is
        the broader traffic-accident victim concept. Targets are broader: SNOMED CT drops the activity
        dimension. Confidence : verified Athena crosswalk on the base code, one-level broader (activity
        context unrepresented).
        """
}
mapping "V6570.2" source="V6570" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
