// ICD-10-SE extension codes to SNOMED CT mappings, codes W57-W575
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W570.1" source="W570" target="220931001" relationship=equivalent effect=omitted quality=60 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W570 = SNOMED CT 220931001 at a specific place of occurrence. Target SNOMED CT 40417357 =. The
        SNOMED CT concept denotes the same external-cause injury at the same place-of-occurrence
        granularity. Crosswalk-verified via Athena-local ICD10→SNOMED CT mirror and the SNOMED CT [X]
        extension concepts.
        """
}
mapping "W5700.1" source="W5700" target="220931001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5700 = nonvenomous insect/arthropod bite at a specific place (occurrence at home)
        combined with a specific activity qualifier
        (sport/leisure/work/other/vital-activity/unspecified). Target SNOMED CT 40417357 = SNOMED CT
        220931001. SNOMED CT captures the place dimension but has no combined place+activity concept; the
        activity axis is dropped. One-level breadth mismatch: target fully subsumes the injury+place
        meaning. Confidence per rubric §1 tier.
        """
}
