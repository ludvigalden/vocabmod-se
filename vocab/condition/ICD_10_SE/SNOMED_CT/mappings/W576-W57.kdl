// ICD-10-SE extension codes to SNOMED CT mappings, codes W576-W57
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W576.1" source="W576" target="217706007" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W576: Bitten/stung by non-venomous insect/arthropod - industrial area/construction site
        (place qualifier only). Target SNOMED CT 437478 (Bite of nonvenomous arthropod). The source adds
        place-of-occurrence (industrial/construction) qualifier not present in SNOMED CT. Parent W57
        crosswalks to this SNOMED CT concept. Broader: target subsumes source; no SNOMED CT concept captures
        the place granularity. Moderate : Athena crosswalk-verified parent, unspecified-place source.
        """
}
mapping "W5760.1" source="W5760" target="217706007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5760: Bitten/stung by non-venomous insect/arthropod - industrial/construction area -
        sports/exercise. Target SNOMED CT 437478 (Bite of nonvenomous arthropod). Same analysis as W576:
        place+activity qualifiers not in SNOMED CT; parent crosswalk verified. Broader, moderate.
        """
}
mapping "W5761.1" source="W5761" target="217706007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5761 = Swedish extension of W57 SNOMED CT 217706007, adding place/activity detail
        (industrial area/construction site - play and other leisure). Target SNOMED CT 437478 (concept_code
        217706007) is the standard concept that W57 maps to via Athena crosswalk. Target subsumes the
        source: the source's clinical content is identical to W57 (the activity/location subdivisions
        carry no separate SNOMED CT representation). Broader because the target is the parent injury
        concept; moderate tier (re-baselined from legacy) reflects unspecified-source crosswalk without
        independent re-verification.
        """
}
