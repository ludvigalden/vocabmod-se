// ICD-10-SE extension codes to SNOMED CT mappings, codes V37-V376
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3700.1" source="V3700" target="217897003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3700 = Swedish extension of WHO V37.0 (driver of three-wheeled motor vehicle injured in
        nontraffic collision with fixed/stationary object), activity SNOMED CT 217897003. Target SNOMED CT
        436292 =. Parent V37.0 crosswalks to 436292 (plus 435134, 444074) in Athena; 436292 most
        specifically captures the fixed-object collision. Activity suffix has no SNOMED CT representation
        and is dropped. Broader; moderate tier.
        """
}
