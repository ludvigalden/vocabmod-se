// ICD-10-SE extension codes to SNOMED CT mappings, codes X78-X783
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X780.1" source="X780" target="248062006" relationship=equivalent effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        ICD leaf code intentional self-harm by sharp glass -> (248062006); crosswalk-verified, loses
        sharp-glass specificity
        """
}
mapping "X7800.1" source="X7800" target="82313006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X7800 SNOMED CT 82313006 = a Swedish ICD-10-SE national extension that subdivides X78
        (Athena ICD10 concept 45756450) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4219484 = (sctid 82313006), the verified Athena crosswalk target for X78
