mapping "W0269.1" source="W0269" target="220372005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0269 = Swedish 5-char ICD-10 extension: SNOMED CT 220372005. Target SNOMED CT 220372009 (OMOP
        concept 40419436) =. SNOMED CT subdivides W02 only by place, not by activity; the activity axis of
        the source is not represented in any standard concept, so the target legitimately subsumes the
        source (every such fall on an industrial site falls under this SNOMED CT concept regardless of
        activity). One-level broader, verified via athena-local SNOMED CT concepts.tdl. high: small,
        well-understood breadth mismatch with no independent crosswalk (Swedish extension not in ICD10
        mirror).
        """
}
mapping "W027.1" source="W027" target="220373000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W027 = SNOMED CT 220373000. Target (OMOP 40419437) =. SNOMED CT place concept fully subsumes
        the source; no activity subdivision exists in SNOMED CT so this is a one-level broader map.
        Verified via athena-local SNOMED CT concepts.tdl. high: clearly correct, small breadth mismatch
        (activity axis absent), no ICD10-side crosswalk for Swedish extension.
        """
}
