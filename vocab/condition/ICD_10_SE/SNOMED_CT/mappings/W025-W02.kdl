// ICD-10-SE extension codes to SNOMED CT mappings, codes W025-W02
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W025.1" source="W025" target="39109007" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W025 = Swedish 4-char extension of W02 in trade/service area. Parent W02
