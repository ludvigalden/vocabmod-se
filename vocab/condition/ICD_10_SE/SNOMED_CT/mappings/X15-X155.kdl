// ICD-10-SE extension codes to SNOMED CT mappings, codes X15-X155
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X150.1" source="X150" target="242520002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X1500.1" source="X1500" target="242509002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X1500 = SNOMED CT 242509002 (Swedish national extension). Base X15 Athena-crosswalks to
        SNOMED CT 4053939 (concept_code 242509002) via ICD10 relationship 45756374 -> 4053939. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X15, one-level broader (Swedish
        qualifier dropped).
        """
}
