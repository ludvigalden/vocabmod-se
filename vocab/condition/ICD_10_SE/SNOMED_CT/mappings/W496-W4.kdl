// ICD-10-SE extension codes to SNOMED CT mappings, codes W496-W4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W496.1" source="W496" target="88817006" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W496: Exposure to other and unspecified non-living mechanical forces,
        industrial/construction area. Target SNOMED CT 88817006: Exposure to inanimate mechanical force.
        Source adds place modifier (industrial/construction). Crosswalk-verified for parent W49; one
        level of specificity lost (place). Moderate tier: best available standard concept.
        """
}
