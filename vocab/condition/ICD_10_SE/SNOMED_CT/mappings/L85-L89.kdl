// ICD-10-SE extension codes to SNOMED CT mappings, codes L85-L89
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L851A.1" source="L851A" target="201054008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L851A SNOMED CT 201054008 = keratoderma climactericum (Haxthausen). Target SNOMED CT 4307930
        (concept_code 201054008) = Keratoderma climactericum. Same clinical concept; exact SNOMED CT match
        in mirror.
        """
}
mapping "L851B.1" source="L851B" target="396227001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L851B SNOMED CT 396227001 = keratoderma associated with esophageal cancer (Howel-Evans
        syndrome / tylosis with esophageal carcinoma). The mirror contains SNOMED CT 4005989 (concept_code
        111030006) but that is a syndrome concept, not the keratoderma finding itself, and the source
        frames the condition as a keratoderma. Best keratoderma-level standard target is SNOMED CT 4213271.
        Low confidence broader: real doubt because the paraneoplastic/syndromic context is not captured
        by the target and a syndrome-target alternative may be preferred by a reviewer.
        """
}
mapping "L851W.1" source="L851W" target="396227001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L851W SNOMED CT 396227001 = other acquired keratosis palmaris et plantaris. Target SNOMED CT
        4213271 (concept_code 396227001) = Acquired palmoplantar keratoderma (synonym: acquired
        keratosis palmaris et plantaris). Same clinical concept; exact SNOMED CT match. The ICD10 L85.1
        crosswalk also lands on this concept (45591648 -> 4213271).
        """
}
mapping "L852A.1" source="L852A" target="400123002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L852A SNOMED CT 400123002 = hereditary diffuse palmoplantar keratoderma of
        Brauer-Brünaer-Fuhs, a rare hereditary variant. No SNOMED CT concept for this specific eponymous
        variant exists in the mirror. Best available standard target is SNOMED CT 4271018. Low confidence
        broader: variant-specific identity is lost at the target.
        """
}
mapping "L852B.1" source="L852B" target="402773000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L852B SNOMED CT 402773000 = keratoderma maculosa disseminata palmaris et plantaris of
        Buschke-Fischer-Brauer, a hereditary punctate/nummular PPK. No SNOMED CT concept for this specific
        eponymous variant exists in the mirror. Best standard target is SNOMED CT 4300110 (concept_code
        402773000), which subsumes the punctate/macular PPK presentation. Low confidence broader: the
        disseminated nummular phenotype is not fully captured by the punctate PPK concept.
        """
}
mapping "L852C.1" source="L852C" target="205575004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L852C SNOMED CT 205575004 = keratosis palmoplantaris areata et striata of Siemens, a
        hereditary striate/areate PPK. Target SNOMED CT 4006456 (concept_code 205575004) = Keratoderma
        areata. Same areata phenotype; the striata component is a recognized presentation within the
        areata spectrum. Low-confidence exact_match: SNOMED CT concept exists but the eponymous/striata
        variant identity is only partially captured, and is a rare SNOMED CT concept warranting reviewer
        confirmation.
        """
}
mapping "L852D.1" source="L852D" target="4515009" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L852D SNOMED CT 4515009 = keratosis punctata of the palmar creases. Target SNOMED CT 4163220
        (concept_code 4515009) = Keratoderma punctata, the standard SNOMED CT punctate keratoderma concept.
        Same clinical concept; high-confidence exact_match (small breadth mismatch on crease
        localization keeps it at).
        """
}
mapping "L852W.1" source="L852W" target="4515009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L852W SNOMED CT 4515009 = other and unspecified keratosis punctata. Target SNOMED CT 4163220.
        Unspecified Swedish residual maps to the standard punctate keratoderma concept; target subsumes
        the unspecified source. Moderate tier: unspecified source mapped to parent without independent
        re-verification.
        """
}
