mapping "L858H.1" source="L858H" target="254670002" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L858H SNOMED CT 254670002 = clear cell acanthoma (Degos eponym variant). Target SNOMED CT
