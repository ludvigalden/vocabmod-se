// ICD-10-SE extension codes to SNOMED CT mappings, codes W235-W23
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W235.1" source="W235" target="35468003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W235 SNOMED CT 35468003: Swedish ICD-10-SE extension of W23 (Caught, crushed, jammed or
        pinched in or between objects) at butiks-, handels- eller serviceområde (trade and service
        area). Target SNOMED CT 4146976 (concept_code 35468003) = (Observation/Event, standard_concept=S),
        the Athena crosswalk target for parent W23. Why this target: every SE child of W23 denotes a
        caught/crushed-in-between-objects event; 4146976 fully subsumes the mechanism axis. The
        place/activity detail has no current standard concept (the [X].occurrence-at-. SNOMED CT concepts
        are all retired invalid_reason=U). Why this tier: high: one-level broader map with a verified
        Athena crosswalk from the parent W23 to 4146976; the place-specific SNOMED CT equivalent
        (40420596/44793994 (220595002)) is retired/invalid, so the parent mechanism concept is the
        closest standard target.
        """
}
mapping "W2350.1" source="W2350" target="35468003" relationship=source_is_narrower_than_target {
