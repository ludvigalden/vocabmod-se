// ICD-10-SE extension codes to SNOMED CT mappings, codes V62-V624
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6200.1" source="V6200" target="214640008" relationship=partial_overlap quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6200 = Swedish extension of V62.0 (driver of heavy transport vehicle, nontraffic,
        collision with two-/three-wheeled motor vehicle) subdivided by sport/exercise. Target SNOMED CT
        437738 = (214640008). The nontraffic off-road dimension is captured; the specific collision
        partner (two-/three-wheeled MV) and the activity dimension are uncovered → partial. Moderate
        tier: crosswalk-verified V62.0 base target; unmatched specificity.
        """
}
