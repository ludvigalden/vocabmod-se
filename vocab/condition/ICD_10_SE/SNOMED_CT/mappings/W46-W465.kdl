// ICD-10-SE extension codes to SNOMED CT mappings, codes W46-W465
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W460.1" source="W460" target="821431000000102" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W4600.1" source="W4600" target="821431000000102" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4600 = Swedish extension of W46 SNOMED CT 821431000000102 at. Parent W46 (Athena 45756299)
        has verified crosswalk to SNOMED CT 44806406 (Hypodermic needle injury, concept_code
        821431000000102). The Swedish 6-char extension adds place+activity metadata, which does not
        change the clinical injury concept. Target broader: subsumes injury meaning while dropping
        place/activity suffix. High tier.
        """
}
