// ICD-10-SE extension codes to SNOMED CT mappings, codes Y27-Y274
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y270.1" source="Y270" target="219356008" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "Y270.2" source="Y270" target="218130004" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "Y2700.1" source="Y2700" target="219356008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y2700 SNOMED CT 219356008 = a Swedish ICD-10-SE national extension that subdivides Y27
        (Athena ICD10 concept 45756510) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 432810 = (sctid 219356008), the verified Athena crosswalk target for Y27
        (ICD10 relationship 45756510 -> 432810). Why this target: it is the authoritative standard
        concept the parent Y27 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
