// ICD-10-SE extension codes to SNOMED CT mappings, codes W126-W12
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W126.1" source="W126" target="2617007" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W126 = SNOMED CT 2617007 (fall on/from scaffolding, industrial area/construction site) — the
        Swedish 4-character W12 subcode that adds only the place (industrial/construction). The Swedish
        W126 is semantically co-extensive with base ICD-10 W12 since the place qualifier is the
        canonical setting for scaffolding falls and SNOMED CT 432804 does not distinguish place. Target
        432804 is the verified Athena of W12. exact_match.
        """
}
mapping "W1260.1" source="W1260" target="2617007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1260 = fall on/from scaffolding at industrial/construction site during sport/exercise.
        Swedish ICD-10-SE extension of W12 (via W126). Target SNOMED CT 432804 SNOMED CT 2617007 fully
        subsumes this variant. broader; high.
        """
}
