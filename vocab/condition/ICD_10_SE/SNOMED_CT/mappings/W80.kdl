// ICD-10-SE extension codes to SNOMED CT mappings, codes W80
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W800.1" source="W800" target="262599003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W800 SNOMED CT 262599003 is a Swedish national extension of WHO base Inhalation and
        ingestion of other objects causing obstruction of respiratory tract (ICD-10 id 45756326); the
        Swedish suffix subdivides the base by a place/activity external-cause axis with no distinct
        standard SNOMED CT clinical analogue. Base event Athena-crosswalks to SNOMED CT 4094822 (concept_code
        262599003) via ICD10 relationship 45756326 -> 4094822. The Swedish place/activity qualifier is
        external-cause metadata; the injury event is unchanged. Target subsumes the event -> broader.
        Confidence : verified Athena crosswalk on the WHO base, one-level broader (qualifier dropped).
        """
}
