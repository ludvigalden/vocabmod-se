// ICD-10-SE extension codes to SNOMED CT mappings, codes W744-W748
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W744.1" source="W744" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W744 = Swedish ICD-10-SE national extension of W74 SNOMED CT 217748000 (Athena ICD10 concept
        45756320), refined by Swedish external-cause place axis: gata och väg (street and highway); no
        specific activity axis (3-char place code). The clinical event (unspecified accidental
        drowning/submersion) is unchanged; the Swedish place/activity qualifiers are external-cause
        metadata with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 436593 = sctid
        217748000. Why this target: Athena ICD10 crosswalk maps base W74 (concept_id 45756320) -> 436593
        (relationship 45756320, 436593); it is the authoritative standard concept for W74 and fully
        subsumes every place/activity-specific SE subdivision. mapping_type=broader (target fully
        contains every clinical meaning of the source; qualifier loss is breadth-neutral external-cause
        metadata, not a partial slice). Confidence (high): verified Athena crosswalk on the base code
        with a small, well-understood one-level breadth mismatch (the SE place/activity refinement is
        dropped). Athena-local research only.
        """
}
