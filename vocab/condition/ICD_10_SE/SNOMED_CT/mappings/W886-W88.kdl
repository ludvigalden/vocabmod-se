// ICD-10-SE extension codes to SNOMED CT mappings, codes W886-W88
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W886.1" source="W886" target="122866006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W886 = SNOMED CT 122866006 (Swedish national extension). Base W88 Athena-crosswalks to
        SNOMED CT 444128 (concept_code 122866006) via ICD10 relationship 45590509 -> 444128. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W88, one-level broader (Swedish
        qualifier dropped).
        """
}
