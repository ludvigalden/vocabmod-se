// ICD-10-SE extension codes to SNOMED CT mappings, codes V737-V73
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7370.1" source="V7370" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7370 = Swedish extension of V73.7 SNOMED CT 274913009 with activity. Target SNOMED CT 433930 =
        (Athena Maps to from V73.7 / 45590307). Target subsumes collision event; activity extension
        dropped. High tier: parent crosswalk.
        """
}
