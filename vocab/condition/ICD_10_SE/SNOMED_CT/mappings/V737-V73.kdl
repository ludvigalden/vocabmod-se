mapping "V7378.1" source="V7378" target="220092008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7378 = Swedish ICD-10-SE 5-char extension of WHO V73.7 SNOMED CT 220092008, plus an
        activity suffix (/ other specified activities). Target = [X]Bus occupant injured in collision
        with car, pick-up truck or van, person on outside of vehicle injured in traffic accident (exact
        WHO V73.7 equivalent in the Athena mirror). The target fully subsumes the
        collision/victim-position semantics of the source but drops the Swedish-extension activity
        dimension; target is therefore broader. High tier : a single, well-understood breadth mismatch —
        the activity suffix is a known Swedish-national sub-classification with no separate SNOMED CT
        representation.
        """
}
mapping "V7379.1" source="V7379" target="220092008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7379 = Swedish extension of WHO V73.7 (bus occupant, collision with car/light truck,
        person on outside, traffic accident) + activity suffix SNOMED CT 220092008 (unspecified activity).
        Target = [X]Bus occupant injured in collision with car, pick-up truck or van, person on outside
        of vehicle injured in traffic accident. Same base V73.7 crosswalk; activity suffix dropped;
        broader. High : single well-understood breadth mismatch.
        """
}
