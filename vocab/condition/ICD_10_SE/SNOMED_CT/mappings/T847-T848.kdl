// ICD-10-SE extension codes to SNOMED CT mappings, codes T847-T848
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "T847A.1" source="T847A" target="473038008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T847A SNOMED CT 473038008 = infection and inflammatory reaction due to other internal
        orthopedic prosthetic devices, implants and grafts, anatomically site-specified (Swedish
        extension of ICD-10 T84.7). Target SNOMED CT 43021250 =. Best available standard concept; Athena
        crosswalk from parent T84.7 -> 43021250. The Swedish site specifier has no standard SNOMED CT
        analogue at this specificity, so the site info is lost. Low tier: parent crosswalk verified, but
        target is meaningfully broader (infection/inflammation -> any complication) AND the anatomical
        site specifier is lost; real specificity loss on two axes.
        """
}
