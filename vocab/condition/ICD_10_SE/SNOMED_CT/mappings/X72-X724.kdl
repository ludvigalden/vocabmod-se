// ICD-10-SE extension codes to SNOMED CT mappings, codes X72-X724
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X720.1" source="X720" target="82313006" relationship=source_is_narrower_than_target {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source X720 SNOMED CT 287184008 82313006 = a Swedish ICD-10-SE national extension that subdivides
        X72 (Athena ICD10 concept 45756447) by Swedish place/activity axes with no separate standard
        SNOMED CT analogue. Target SNOMED CT 4219484 = (sctid 82313006), the verified Athena crosswalk target
        for X72 (ICD10 relationship 45756447 -> 4219484). Why this target: it is the authoritative
        standard concept the parent X72 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
