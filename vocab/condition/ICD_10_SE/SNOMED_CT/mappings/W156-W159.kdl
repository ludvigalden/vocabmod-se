// ICD-10-SE extension codes to SNOMED CT mappings, codes W156-W159
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W156.1" source="W156" target="4521008" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W156 = Swedish extension of W15 SNOMED CT 4521008 in industrial area/construction site.
        Target SNOMED CT 432806 (4521008) =. Parent W15 crosswalk-verified to 432806; place context is
        orthogonal to the clinical injury, target fully subsumes source. High tier: one-level broader
        with verified parent crosswalk.
        """
}
