// ICD-10-SE extension codes to SNOMED CT mappings, codes W136-W13
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W136.1" source="W136" target="14047009" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W136 = Swedish W13 SNOMED CT 14047009 - industrial area/construction site (3-char-equivalent
        place-only code). Athena crosswalk: W13 maps to SNOMED CT 441201 (14047009). The place qualifier
        (industrial/construction) is the only added specificity and has no separate SNOMED CT standard
        concept; target is the canonical standard for this source. Crosswalk-verified; exact_match.
        """
}
mapping "W1360.1" source="W1360" target="14047009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1360 = Swedish extension of W13 SNOMED CT 14047009, qualified. Parent W13 Athena-crosswalks
        to SNOMED CT 441201 (14047009). The place (industrial) and activity (sport) qualifiers are
        contextual metadata with no separate SNOMED CT standard concept; the target fully subsumes the
        clinical event. broader; high.
        """
}
