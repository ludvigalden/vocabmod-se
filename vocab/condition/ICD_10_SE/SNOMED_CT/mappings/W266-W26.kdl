// ICD-10-SE extension codes to SNOMED CT mappings, codes W266-W26
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W266.1" source="W266" target="242772009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W266 = Swedish extension of W26 SNOMED CT 242772009 subdivided by place (industrial
        area/construction site). WHO parent W26 (Athena id 45756279) Maps to SNOMED CT 4055051 (Accident
        caused by sharp pointed object, code 242772009). Swedish code adds place context; parent target
        fully subsumes it. : one-level broader, verified crosswalk.
        """
}
