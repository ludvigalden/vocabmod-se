// ICD-10-SE extension codes to SNOMED CT mappings, codes V617-V61
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6170.1" source="V6170" target="36198007" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6170 = Swedish extension of V61.7 (person on outside of heavy transport vehicle,
        traffic, vs pedal cycle) subdivided by sport/exercise. The V61.7 Athena crosswalk yields 444074
        (SNOMED CT 36198007, 36198007) and 4069060 (a nontraffic concept that contradicts the traffic
        source), so only 444074 is defensible. No SNOMED CT concept for exists in the mirror.
        Activity-context and person-on-outside role both partially uncovered. Weak tier: only a generic
        vehicular-accident victim target remains.
        """
}
