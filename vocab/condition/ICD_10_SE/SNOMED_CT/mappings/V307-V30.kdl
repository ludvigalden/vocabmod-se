mapping "V3094.1" source="V3094" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3094 = Swedish ICD-10-SE 7-char extension of base ICD-10 V30.9 SNOMED CT 214031005
        407153006 + activity-context suffix (vital activity such as rest, sleep, meals, personal
        hygiene). Athena crosswalk V30.9 -> 437165 (Motor vehicle traffic accident, SNOMED CT 214031005)
        and 443539 (Injury due to motor vehicle accident, SNOMED CT 407153006) verified in
        ICD10/relationships.tdl. The activity-context suffix is a Swedish national extension axis with
        no separate SNOMED CT representation; the SNOMED CT targets fully subsume the clinically meaningful
        accident/injury axis. broader: target subsumes source (accident) while the activity dimension
        has no standard representation. tier: one-level broader with verified crosswalk.
        """
}
mapping "V3094.2" source="V3094" target="407153006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V3098.1" source="V3098" target="214031005" relationship=source_is_narrower_than_target {
