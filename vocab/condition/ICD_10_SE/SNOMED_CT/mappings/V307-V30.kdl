// ICD-10-SE extension codes to SNOMED CT mappings, codes V307-V30
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3070.1" source="V3070" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3070 (V30.7 person on outside, traffic, activity=sport). Base V30.7 (Athena 45756349)
        Maps to SNOMED CT 437165 + 443539. Broader; moderate.
        """
}
