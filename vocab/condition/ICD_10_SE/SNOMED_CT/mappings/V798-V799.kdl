// ICD-10-SE extension codes to SNOMED CT mappings, codes V798-V799
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7980.1" source="V7980" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7980 = Swedish extension of ICD-10 V79.8 (Bus occupant injured in other specified
        transport accidents) with activity suffix SNOMED CT 418399005 (sports). Target SNOMED CT 435134
        (concept_code 418399005) =, standard concept. Athena ICD10CM crosswalk for V79.88 maps to 435134
        and 440897; 435134 selected as the more specific accident-event concept. Broader: target
        subsumes the motor-vehicle-accident axis but drops bus-specificity, the detail, and the Swedish
        sports-activity qualifier. Confidence (low): Swedish extension, heterogeneous residual base
        code, activity dimension lost.
        """
}
mapping "V7981.1" source="V7981" target="418399005" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V7981.3" source="V7981" target="127348004" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V7982.1" source="V7982" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7982 = Swedish extension of ICD-10 V79.8 (Bus occupant, other specified transport
        accidents) with activity suffix SNOMED CT 418399005 (work). Same base V79.8; only Swedish activity
        qualifier differs. Target SNOMED CT 435134 (418399005) =, standard. Broader: subsumes accident
        axis, drops bus-specificity and work-activity context. Confidence (low).
        """
}
