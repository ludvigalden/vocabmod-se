// ICD-10-SE extension codes to SNOMED CT mappings, codes W406-W40
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W406.1" source="W406" target="218099004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W406 SNOMED CT 218099004 is the Swedish extension of W40 specifying place=industrial
        area/construction site. Target SNOMED CT 440607 (Accident caused by explosive material) is the W40
        crosswalk target and subsumes all place-specific children. Broader; high tier.
        """
}
