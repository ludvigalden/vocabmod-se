    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7200.1" source="V7200" target="214640008" relationship=source_is_narrower_than_target quality=100 {
