// ICD-10-SE extension codes to SNOMED CT mappings, codes W686-W68
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W686.1" source="W686" target="217776008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W686 = Swedish 4-char extension of W68 (Drowning/submersion following fall into swimming
        pool, at industrial/construction site). Clinical event is subtype of W68. Target SNOMED CT 4318639
        (Accidental drowning and submersion in swimming pool, 217776008, standard_concept=S) is the
        verified SNOMED CT 217776008 target of parent W68. Target is broader: same clinical event, no
        place-of-occurrence encoding. No standard SNOMED CT concept combines the event with the Swedish
        place axis ([X] variant non-standard). High : parent crosswalk verified; broader on
        administrative place axis.
        """
}
