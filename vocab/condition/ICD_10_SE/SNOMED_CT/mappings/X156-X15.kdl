// ICD-10-SE extension codes to SNOMED CT mappings, codes X156-X15
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X156.1" source="X156" target="242509002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X156 SNOMED CT 242509002 is a Swedish national extension of WHO base Contact with hot
        household appliances (ICD-10 id 45756374); the Swedish suffix subdivides the base by a
        place/activity external-cause axis with no distinct standard SNOMED CT clinical analogue. Base
        event Athena-crosswalks to SNOMED CT 4053939 (concept_code 242509002) via ICD10 relationship
        45756374 -> 4053939. The Swedish place/activity qualifier is external-cause metadata; the injury
        event is unchanged. Target subsumes the event -> broader. Confidence : verified Athena crosswalk
        on the WHO base, one-level broader (qualifier dropped).
        """
}
