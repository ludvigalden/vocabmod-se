// ICD-10-SE extension codes to SNOMED CT mappings, codes X359-X35
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X359.1" source="X359" target="217744003" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X359 = SNOMED CT 217744003 (Swedish national extension). Base X35 Athena-crosswalks to
        SNOMED CT 440290 (concept_code 217744003) via ICD10 relationship 45571179 -> 440290. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X35, one-level broader (Swedish
        qualifier dropped).
        """
}
mapping "X3590.1" source="X3590" target="217744003" relationship=source_is_narrower_than_target {
