// ICD-10-SE extension codes to SNOMED CT mappings, codes W000-W005
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W000.1" source="W000" target="33036003" relationship=equivalent effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Leaf code Fall on same level due to ice and snow -> SNOMED CT 33036003; crosswalk-verified;
        ice/snow cause dropped
        """
}
mapping "W0000.1" source="W0000" target="242387001" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0000 SNOMED CT 242387001 = Swedish 5-char extension of ICD-10 W00 (concept 45756242) +
        place=home + activity=sport. Target SNOMED CT 4053863 (242387001). Athena crosswalk W00 → 4053863
        verified. The accident concept itself matches exactly; place/activity suffixes are contextual
        metadata for injury surveillance with no separate SNOMED CT target. High tier (not): verified
        crosswalk but source carries place+activity context not in the target.
        """
}
