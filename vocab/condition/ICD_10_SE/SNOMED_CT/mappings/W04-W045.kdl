// ICD-10-SE extension codes to SNOMED CT mappings, codes W04-W045
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W040.1" source="W040" target="60594001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W040 = SNOMED CT 60594001, place=bostad och bostadsområde (home/residential area). Target
        (4244882) =, the verified Maps-to target of base W04. Target subsumes the injury event; the SE
        code adds place context absent in SNOMED CT. Broader, high tier via parent W04 crosswalk.
        """
}
