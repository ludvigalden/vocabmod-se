// ICD-10-SE extension codes to SNOMED CT mappings, codes P6-Q3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "P609.1" source="P609" target="34417008" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source P609 SNOMED CT 34417008 = DIC in fetus and newborn. Target SNOMED CT 432443 (ICD10 P60 Maps to
        target). Exact equivalence, crosswalk-verified.
        """
}
mapping "P610A.1" source="P610A" target="13292000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source P610A SNOMED CT 13292000 = neonatal alloimmune thrombocytopenia (FNAIT). Target SNOMED CT
        40292199. Exact semantic equivalence; the source explicitly names FNAIT which is the same
        clinical entity. High tier (no independent crosswalk for this Swedish extension code, but the
        term match is unambiguous).
        """
}
mapping "P610B.1" source="P610B" target="7933002" relationship=related_to {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source P610B SNOMED CT 7933002 = autoimmune thrombocytopenia in the newborn. The closest neonatal
        SNOMED CT concept is 4195579 (Neonatal thrombocytopenia associated with maternal idiopathic
        thrombocytopenic purpura), which presumes a maternal ITP origin rather than a primary neonatal
        autoimmune process. There is no SNOMED CT concept for primary neonatal autoimmune thrombocytopenia.
        related because the maternal-ITP association is not equivalent to a neonatal autoimmune process;
        the link is clinically defensible but not identity. Low tier.
        """
}
mapping "P610W.1" source="P610W" target="206514004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source P610W SNOMED CT 206514004 = other specified transient thrombocytopenia of newborn. Target
        SNOMED CT 4071193 (concept_code 206514004) =. Source is the Swedish-extension residual for
        transient neonatal thrombocytopenia; is the matching standard concept for transient neonatal
        thrombocytopenia. High tier: clinical scope matches at the same level of specificity, but no
        independent Athena crosswalk for the Swedish subcode.
        """
}
mapping "P704A.1" source="P704A" target="52767006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source P704A = transient neonatal hypoglycemia (blood glucose <2.2 mmol/l) within first 0-6h of
        life; Swedish time-windowed subcode of ICD-10 P70.4 (Other neonatal hypoglycaemia). Target
        SNOMED CT 23034 (52767006) = Neonatal hypoglycemia, which is the Athena SNOMED 52767006 target for
        P70.4. The source adds time-window specificity that the SNOMED CT concept does not encode; the
        target subsumes the source. Broader: target subsumes source. Tier low : time-window specificity
        is lost, and several Swedish subcodes (P704A/B) both roll up to the same target.
        """
}
mapping "P704B.1" source="P704B" target="52767006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source P704B = transient neonatal hypoglycemia (blood glucose <2.2 mmol/l) >6h after birth;
        Swedish time-windowed subcode of P70.4. Target SNOMED CT 23034 (52767006) Neonatal hypoglycemia is
        the Athena crosswalk target for P70.4 and fully subsumes this source. Broader: target subsumes
        source. : specificity of timing threshold lost; sibling subcode P704A also rolls up here.
        """
}
