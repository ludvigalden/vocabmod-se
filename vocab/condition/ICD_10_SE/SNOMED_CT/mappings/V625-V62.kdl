// ICD-10-SE extension codes to SNOMED CT mappings, codes V625-V62
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6250.1" source="V6250" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6250 (Swedish extension) = driver of heavy transport vehicle injured in collision with
        two-/three-wheeled motor vehicle in traffic accident, during sport/exercise. Base ICD-10 V62.5
        maps via Athena crosswalk to SNOMED CT 433930 (Motor vehicle on road in collision with another
        motor vehicle, 274913009) and 444074 (Victim of vehicular AND/OR traffic accident). Swedish
        extension adds activity context (sport) with no SNOMED CT representation. Broader: target subsumes
        the accident mechanism; activity axis is external-cause metadata. Moderate tier: verified parent
        crosswalk applied to Swedish-extension code.
        """
}
