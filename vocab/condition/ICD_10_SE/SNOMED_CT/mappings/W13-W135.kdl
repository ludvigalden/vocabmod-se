mapping "W1318.1" source="W1318" target="220482005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1318 = Swedish 5-char extension of ICD-10 W13: fall from/out of/through building or
        structure, place=residential institution, activity=other specified. Target SNOMED CT 40419999
        ([X]Fall from, out of or through building or structure, occurrence in residential institution;
        concept_code 220482005) is the OMOP cross-reference concept mirroring the ICD-10 W13.1 place
        subdivision. The target captures the place axis fully but drops the activity axis (the Swedish
        code adds an activity suffix SNOMED CT does not represent), so target is broader. High tier: exact
        term match to the place-level [X] concept without an independent Athena Maps-to crosswalk from
        the Swedish 5-char code (the ICD10 mirror carries only the W13 3-char crosswalk to 441201).
        """
}
mapping "W1319.1" source="W1319" target="220482005" relationship=equivalent {
