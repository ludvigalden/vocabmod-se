// ICD-10-SE extension codes to SNOMED CT mappings, codes W13-W135
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W130.1" source="W130" target="217103006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 217103006 [GPS]"
}
mapping "W1300.1" source="W1300" target="14047009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1300 = SNOMED CT 14047009 (Swedish extension of W13: fall from/through building,
        home/residential area, sport/exercise). Target SNOMED CT 441201 (concept_code 14047009), the
        verified Athena crosswalk target for W13 (ICD10 45756253 → 441201). Target fully subsumes source
        (every building fall is a); the place (home) and activity (sport) detail is
        administrative/epidemiological, not separately modeled in SNOMED CT at this concept level. Broader,
        one-level specificity loss; moderate (mechanical crosswalk on Swedish extension).
        """
}
