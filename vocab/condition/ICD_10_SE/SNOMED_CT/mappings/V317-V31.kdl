// ICD-10-SE extension codes to SNOMED CT mappings, codes V317-V31
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3170.1" source="V3170" target="214171003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V31.7 SNOMED CT 214171003 36198007. Athena ICD10 concept 45756356 (V31.7) Maps to SNOMED CT
        4061564 (214171003) and 444074. Target captures the road-traffic pedal-cycle collision context;
        activity (sport) is administrative metadata not represented in SNOMED CT. Broader at; secondary
        victim concept broader at.
        """
}
