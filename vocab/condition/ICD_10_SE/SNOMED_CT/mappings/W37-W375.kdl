// ICD-10-SE extension codes to SNOMED CT mappings, codes W37-W375
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W370.1" source="W370" target="218069008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W3700.1" source="W3700" target="218069008" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3700 SNOMED CT 218069008 is the Swedish ICD-10-SE extension of W37 (Explosion and rupture
        of pressurized tyre, pipe or hose) qualified by place=home/residential area and
        activity=sport/exercise. Target SNOMED CT 437740 (Accident caused by explosion of pressure vessel,
        concept_code 218069008) is the verified Athena crosswalk target for W37. The activity/place
        qualifier has no separate SNOMED CT representation, so the base W37 target fully subsumes the
        source. Broader (one level), confidence : crosswalk-verified, small breadth mismatch.
        """
}
