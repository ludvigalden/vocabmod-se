        """
}
mapping "V6999.1" source="V6999" target="220052006" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source V6999 = SNOMED CT 220052006 (ICD-10 SE activity extension, fully unspecified activity).
        Target SNOMED CT 40417893 =. With activity unspecified on both sides, the target matches the
        clinical injury axis cleanly; only the administrative fourth-digit granularity keeps this from
        being exact_match (source still separates occupant role where target is [any]). Broader.
        Moderate tier: mirror-verified, closest standard concept, activity axis unrepresentable.
        """
}
