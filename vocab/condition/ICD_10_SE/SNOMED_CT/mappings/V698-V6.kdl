mapping "V6998.1" source="V6998" target="220052006" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source V6998 = SNOMED CT 220052006 (ICD-10 SE activity extension, residual). Target SNOMED CT 40417893
