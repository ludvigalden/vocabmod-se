// ICD-10-SE extension codes to SNOMED CT mappings, codes V698-V6
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6980.1" source="V6980" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6980 = Swedish extension of V69.8 (unspecified occupant of heavy transport vehicle
        injured in other specified transport accidents), activity=idrott/sport/motion (sports/exercise).
        Activity modifier has no SNOMED CT representation. Targets 435134 (Motor vehicle accident, SNOMED CT
        418399005) and 444074 (Victim of vehicular AND/OR traffic accident, SNOMED CT 36198007), Athena
        SNOMED CT 36198007 418399005 targets for parent V69.8 (45561281). Broader: targets subsume source.
        Low tier: Swedish extension, unmatched activity modifier.
        """
}
