// ICD-10-SE extension codes to SNOMED CT mappings, codes W77
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W770.1" source="W770" target="269790003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W770 = SNOMED CT 269790003 with Swedish place/activity qualifiers (Kvävning och
        kvävningstillbud av jord- eller sandmassor - bostad och bostadsområde). Base event W77
        Athena-crosswalks to SNOMED CT 4148585 (269790003) via ICD10 relationship 45756323 -> 4148585.
        Qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical analogue;
        injury event unchanged. Target subsumes the event -> broader. Confidence : verified crosswalk on
        base W77, one-level broader (qualifier dropped).
        """
}
