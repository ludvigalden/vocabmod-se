// ICD-10-SE extension codes to SNOMED CT mappings, codes W606-W609
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W606.1" source="W606" target="419027004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W60x is a Swedish extension of ICD-10 W60 SNOMED CT 419027004 qualified by location
        (gata/vag, butiks/handel, industriområde, lantbruksområde) and activity (idrott, lek,
        forvavsarbete, vitalaktivitet, annan, ospecificerad). These are external-cause activity/location
        modifiers with no independent SNOMED CT target. Target SNOMED CT 4168815 (concept_code 419027004) is
        the parent crosswalk target verified via Athena ICD10->SNOMED CT Maps to edge. Mapping type
        broader: the target fully subsumes the source (same mechanism, lost external-cause context).
        Confidence (moderate): verified parent crosswalk but source is a more specific sub-code with no
        independent crosswalk.
        """
}
