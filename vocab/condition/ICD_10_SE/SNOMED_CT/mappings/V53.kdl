mapping "V5318.1" source="V5318" target="214640008" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5318 = Swedish 5-char extension of ICD-10 V53.1 (passenger of pick-up truck/van injured
        in nontraffic collision with car/pick-up truck/van) + activity suffix SNOMED CT 214640008. Target
        SNOMED CT 437738 (214640008) = Motor vehicle accident off public road. Best standard target: parent
        V53.1 has verified Athena edge to 437738 for nontraffic accidents. Target is broader: it fully
        subsumes the transport-injury meaning; the Swedish activity suffix (contextual metadata, not
        clinical semantics) has no SNOMED CT representation and is lost. High tier : one-level broader,
        crosswalk-verified via parent.
        """
}
