context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5300.1" source="V5300" target="426772002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5300 (Swedish 5-char extension of V53) = driver of pick-up truck/van in non-traffic
        collision with car or pick-up truck/van, activity = sport/exercise. Base V53 (ICD10CM 1575466)
        has Athena SNOMED 426772002 edges to SNOMED CT 4145511 (Car crash, concept_code 426772002, standard
        Observation) and 440897 (Motor vehicle accident victim). Best target 4145511 fits the
        car-collision axis of the source (broader); light-truck counterpart and activity-context axis
        dropped. Low : heterogeneous Swedish-extension source.
        """
}
