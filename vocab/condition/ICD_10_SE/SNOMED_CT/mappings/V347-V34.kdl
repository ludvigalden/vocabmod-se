// ICD-10-SE extension codes to SNOMED CT mappings, codes V347-V34
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3470.1" source="V3470" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3470 = Swedish national extension of ICD-10 V34.7 (person on outside of three-wheeled
        motor vehicle injured in collision with heavy transport vehicle or bus in traffic accident,
        during sport). Target SNOMED CT 433930 (274913009) = SNOMED CT 274913009 — Athena target of parent
        V34.7. Best available standard concept; activity suffix has no SNOMED CT representation. Moderate
        tier: inherited crosswalk, Swedish extension with unrepresented activity granularity.
        """
}
