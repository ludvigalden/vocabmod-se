mapping "V6093.1" source="V6093" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6093 = Swedish extension of V60.9 (Occupant of heavy transport vehicle injured in
        collision with pedestrian or animal, unspecified occupant, traffic accident) with activity
        suffix SNOMED CT 214031005 36198007 (annan sysselsättning / other occupation). The activity suffix
        captures the activity-at-time-of-injury (a Y93-style external-cause axis) and does not change
        the accident type. Parent V60.9 (Athena 45756660) has Athena crosswalks to SNOMED CT 214031005
        (Motor vehicle traffic accident) and 36198007 (Victim of vehicular AND/OR traffic accident).
        Targets are broader: they describe the accident category at a level above the specific Swedish
        activity-extended source. Confidence high : verified Athena crosswalk on the parent, one-level
        broader, the activity suffix has no SNOMED CT representation of its own.
        """
}
mapping "V6093.2" source="V6093" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
