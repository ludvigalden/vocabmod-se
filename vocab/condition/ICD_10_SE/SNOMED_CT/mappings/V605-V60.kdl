// ICD-10-SE extension codes to SNOMED CT mappings, codes V605-V60
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6050.1" source="V6050" target="214031005" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6050 (Swedish) = driver of heavy transport vehicle (truck) injured in collision with
        pedestrian/animal, traffic accident, while engaged in sport/exercise. Decodes to WHO ICD-10
        V60.5 + Swedish activity qualifier SNOMED CT 214031005 36198007. V60.5 crosswalks to SNOMED CT 437165
        (Motor vehicle traffic accident, 214031005) and 444074 (Victim of vehicular AND/OR traffic
        accident). Activity qualifier has no SNOMED CT analogue. Targets cover only the transport-event
        axis (partial).
        """
}
mapping "V6050.2" source="V6050" target="36198007" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
