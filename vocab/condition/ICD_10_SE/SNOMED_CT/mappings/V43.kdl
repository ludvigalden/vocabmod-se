// ICD-10-SE extension codes to SNOMED CT mappings, codes V43
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4300.1" source="V4300" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4300 is a Swedish extension of ICD-10 V43.0 (driver injured in nontraffic collision with
        car/pick-up/van) adding SNOMED CT 214640008 36198007. Parent V43.0 (Athena 45595060) crosswalks to
        SNOMED CT 437738 (Motor vehicle accident off public road, 214640008) and 444074 (Victim of
        vehicular AND/OR traffic accident, 36198007). The Swedish activity suffix has no SNOMED CT
        analogue; injury semantics identical to parent. 437738 is the specific nontraffic-accident
        target (broader: drops car/driver detail + activity); 444074 is the broader fallback.
        """
}
mapping "V4300.2" source="V4300" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
