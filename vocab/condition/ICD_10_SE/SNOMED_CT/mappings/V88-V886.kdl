// ICD-10-SE extension codes to SNOMED CT mappings, codes V88-V886
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8800.1" source="V8800" target="214640008" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8800 is the Swedish national 5th-character extension of ICD-10 V88.0 (45595171 SNOMED CT
        214640008), adding an activity suffix. The underlying base code V88.0 has Athena crosswalks to
        SNOMED CT 437738 (Motor vehicle accident off public road, 214640008) and 444074 (Victim of
        vehicular AND/OR traffic accident). 437738 is the more specific target (off-public-road captures
        the nontraffic aspect). Target subsumes the source; the activity suffix is administrative
        Swedish context. broader/ : crosswalk-verified at base level.
        """
}
