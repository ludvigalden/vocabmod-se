// ICD-10-SE extension codes to SNOMED CT mappings, codes V64-V645
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6400.1" source="V6400" target="219992004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6400 = Swedish 6th-character extension of WHO ICD-10 V64.0: driver of a heavy transport
        vehicle injured in a nontraffic collision with a heavy transport vehicle or bus, with the
        activity axis set to SNOMED CT 219992004. Target =. The target fully subsumes the source
        semantically (same vehicle class, same collision counterpart, same occupant role, same traffic
        status); the only dimension the target does not encode is the Swedish activity axis
        (sport/leisure/work/etc.), which SNOMED CT does not represent. broader (target subsumes source on
        every clinical axis SNOMED CT expresses). Moderate tier: strong semantic match to the WHO base
        code, but no V-code crosswalk in the ICD10 mirror for these Swedish extensions; tier consistent
        with sibling V63/V64 mappings.
        """
}
