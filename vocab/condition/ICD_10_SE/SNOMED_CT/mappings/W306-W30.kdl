// ICD-10-SE extension codes to SNOMED CT mappings, codes W306-W30
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W306.1" source="W306" target="217935007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W306 SNOMED CT 217935007 = agricultural machinery accident in industrial area/construction
        site. Swedish ICD-10-SE place-specific extension of W30. Target SNOMED CT 436874 is the W30
        crosswalk target. Source adds a place modifier with no separate SNOMED CT concept; target subsumes
        accident, drops place. Broader, crosswalk-verified.
        """
}
