// ICD-10-SE extension codes to SNOMED CT mappings, codes W45-W456
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W450.1" source="W450" target="283650009" relationship=equivalent quality=100 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Leaf code Nail entering through skin. Crosswalk-verified to 4151833 (standard, Exact equivalent.
        """
}
mapping "W451.1" source="W451" target="242768005" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W4513.1" source="W4513" target="93458008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4513 SNOMED CT 93458008 = Swedish 5-digit ICD-10-SE external-cause code: foreign body
        entering through skin at an institutional residence during activity. The clinical injury is; the
        place+activity suffix is external-cause metadata with no SNOMED CT representation. Target SNOMED CT
        4246661 (Foreign body in skin, concept_code 93458008) is the standard concept for the base
        injury mechanism and fully subsumes the injury aspect. Broader: target covers the injury but not
        the place/activity context. Moderate tier: best available standard concept, but external-cause
        context is lost; 4-digit parent W451 maps to 4055049 (Accident caused by sharp-edged object)
        which is too specific and clinically inaccurate for generic foreign-body-at-residence. Citation:
        Athena-local mirror.
        """
}
mapping "W4514.1" source="W4514" target="93458008" relationship=source_is_narrower_than_target {
