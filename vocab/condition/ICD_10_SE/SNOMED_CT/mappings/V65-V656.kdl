    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6500.1" source="V6500" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6500 (Swedish) = driver of heavy transport vehicle injured in nontraffic collision with
        railway train, during sport. Parent ICD-10 V65.0 (Athena id 45756699) crosswalks to SNOMED CT
        437738 SNOMED CT 214640008 (214640008, standard, Event). Target is broader: it drops the
        railway-train collision partner, the driver role, and the Swedish activity suffix. Best
        available standard concept (the precise [X] heavy-transport/railway SNOMED CT concepts 40417613
        etc. are inactive, invalid_reason=U). High tier per one-level-broader verified crosswalk.
        """
}
