// ICD-10-SE extension codes to SNOMED CT mappings, codes W440-W445
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W440.1" source="W440" target="125670008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W440 SNOMED CT 125670008 is a Swedish-SE extension subclassifying W44 (Foreign body entering
        into or through eye or natural orifice) by place (residential). Target SNOMED CT 4053838 =
        (concept_code 125670008). Athena ICD10 crosswalk maps parent W44 (concept_id 45756297) to via a
        verified edge. No separate SNOMED CT target for the place qualifier; parent target fully subsumes
        the source. broader: target totally contains the source. Confidence (high).
        """
}
