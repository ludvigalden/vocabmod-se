// ICD-10-SE extension codes to SNOMED CT mappings, codes V790-V796
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7900.1" source="V7900" target="127349007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V7900.2" source="V7900" target="214640008" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V7901.1" source="V7901" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7901 is a Swedish national extension of V79.0 (bus driver injured in collision with
        other/unspecified motor vehicle, nontraffic accident) subdivided by activity (here:
        play/leisure). Activity dimension has no SNOMED CT representation. SNOMED CT 432510 = (48084008) is
        the V79.0 SNOMED CT 214640008 48084008 crosswalk target and subsumes the accident semantics. SNOMED CT
        437738 = (214640008) is the secondary V79.0 crosswalk target, capturing the nontraffic aspect.
        Moderate tier: Athena crosswalk on parent, Swedish activity dimension lost.
        """
}
mapping "V7901.2" source="V7901" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V7902.1" source="V7902" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7902 = Swedish extension of V79.0 (Driver of bus injured in collision with other and
        unspecified motor vehicles in nontraffic accident) with activity suffix SNOMED CT 214640008
        48084008 (förvärvsarbete / paid work). Activity suffix is the Y93-style activity-at-injury axis
        and does not change the accident classification. Parent V79.0 (Athena 45561298) has Athena
        crosswalks to SNOMED CT 432510 (Driver in vehicular AND/OR traffic accident, 48084008) and 437738
        (Motor vehicle accident off public road, 214640008). Targets broader: they describe the
        accident/role category at a level above the Swedish activity-extended source. Confidence high :
        verified Athena crosswalk on parent, one-level broader.
        """
}
