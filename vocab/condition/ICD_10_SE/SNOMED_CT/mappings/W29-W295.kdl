mapping "W2912.1" source="W2912" target="220657001" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W2912 = SNOMED CT 220657001 (Swedish extension of W29 contact with powered hand
        tools/household machinery, in residential institution, during paid work). Target SNOMED CT 40420899
        (code 220657001) = — the ICD-10 Chapter XX external-cause extension that matches the W29 +
        place-of-occurrence (residential institution) axis exactly. The activity dimension
        (förvärvsarbete / paid work) has no SNOMED CT analogue; the target fully subsumes the source
        because every W29-in-residential-institution-during-paid-work event is a
        W29-in-residential-institution event. Moderate : best available standard concept, name-level 1:1
        on the place axis but the activity specificity is lost and no independent crosswalk verifies the
        Swedish 5-char extensions.
        """
}
