// ICD-10-SE extension codes to SNOMED CT mappings, codes W29-W295
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W290.1" source="W290" target="47235009" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 47235009 [GPS]"
}
mapping "W2900.1" source="W2900" target="218016007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2900 SNOMED CT 218016007 is a Swedish-ICD-10-SE extension of base ICD-10 W29 (Contact with
        other powered hand tools and household machinery) subdivided by home + sport. Target SNOMED CT
        432807 (concept_code 218016007) is the standard concept the base W29 maps to via Athena
        crosswalk. The target name is narrower than the full W29 scope (powered hand tools not all
        cutting/piercing), but it is the standard crosswalk target and the closest available; subsumes
        the activity variant. Broader, Athena crosswalk not independently re-verified — moderate tier.
        """
}
