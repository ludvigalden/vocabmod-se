// ICD-10-SE extension codes to SNOMED CT mappings, codes V20
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2000.1" source="V2000" target="10298002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2000 = SNOMED CT 10298002 (motorcycle driver injured in nontraffic collision with
        pedestrian/animal - sport/exercise). Parent V200 and mapped siblings V2001/V2009 all map to
        SNOMED CT 438310 (Victim, motorcycle rider in vehicular AND/OR traffic accident, concept_code
        10298002). Activity suffix (sport) has no SNOMED CT representation; target subsumes the
        rider-victim role. Broader, moderate : family-consistent target, inherited crosswalk, activity
        context lost.
        """
}
mapping "V2001.1" source="V2001" target="10298002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
