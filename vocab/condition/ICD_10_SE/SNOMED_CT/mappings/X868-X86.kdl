// ICD-10-SE extension codes to SNOMED CT mappings, codes X868-X86
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X868.1" source="X868" target="269732008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X868 SNOMED CT 269732008 = a Swedish ICD-10-SE national extension that subdivides X86
        (Athena ICD10 concept 45756454) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4155225 = (sctid 269732008), the verified Athena crosswalk target for
        X86 (ICD10 relationship 45756454 -> 4155225). Why this target: it is the authoritative standard
        concept the parent X86 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
