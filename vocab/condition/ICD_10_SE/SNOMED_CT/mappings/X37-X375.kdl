// ICD-10-SE extension codes to SNOMED CT mappings, codes X37-X375
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X370.1" source="X370" target="35314007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X3700.1" source="X3700" target="420101009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X3700 = SNOMED CT 420101009 (Swedish national extension). Base X37 Athena-crosswalks to
        SNOMED CT 4170415 (concept_code 420101009) via ICD10 relationship 45756394 -> 4170415. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X37, one-level broader (Swedish
        qualifier dropped).
        """
}
