// ICD-10-SE extension codes to SNOMED CT mappings, codes X125-X12
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X125.1" source="X125" target="242494002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X125 = SNOMED CT 242494002 (Swedish national extension). Base X12 Athena-crosswalks to
        SNOMED CT 4054152 (concept_code 242494002) via ICD10 relationship 45756371 -> 4054152. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X12, one-level broader (Swedish
        qualifier dropped).
        """
}
