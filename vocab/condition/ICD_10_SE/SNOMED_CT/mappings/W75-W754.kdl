// ICD-10-SE extension codes to SNOMED CT mappings, codes W75-W754
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W750.1" source="W750" target="269791004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W750 = SNOMED CT 269791004 (suffocation, near-suffocation and strangulation in bed) with
        Swedish place qualifier. Base event W75 Athena-crosswalks to SNOMED CT 4155227 (concept_code
        269791004) via ICD10 relationship 45756321 -> 4155227. The Swedish place qualifier is
        external-cause metadata with no distinct standard SNOMED CT clinical analogue; the asphyxia-in-bed
        event is unchanged. Target subsumes the asphyxia event of every W75 subcategory -> broader.
        Confidence : verified Athena crosswalk on base W75, one-level broader (place qualifier dropped).
        """
}
mapping "W7500.1" source="W7500" target="269791004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7500 = SNOMED CT 269791004 with Swedish qualifiers (place: bostad och bostadsområde;
        activity: idrott, sport, motion). Base event W75 Athena-crosswalks to SNOMED CT 4155227
        (269791004). Qualifiers are external-cause metadata with no distinct standard analogue; injury
        event unchanged. Target subsumes the asphyxia event -> broader. Confidence : verified crosswalk
        on base W75, one-level broader.
        """
}
