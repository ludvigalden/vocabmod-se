// ICD-10-SE extension codes to SNOMED CT mappings, codes V56-V565
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5600.1" source="V5600" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5600 = Swedish activity-context subdivision of ICD-10 V56.0 (Occupant of pick-up
        truck/van, driver, injured in nontraffic collision with other nonmotor vehicle; activity =
        sport/exercise). Activity suffix is Swedish-administrative with no SNOMED CT analogue. Target
        SNOMED CT 437738 — sole base V56.0 crosswalk target; fully covers the nontraffic crash scenario.
        Broader: target subsumes the crash, drops vehicle subtype and Swedish activity dimension.
        Moderate tier: verified base-level Athena crosswalk, mechanical extension to Swedish subcode.
        """
}
mapping "V5601.1" source="V5601" target="214640008" relationship=source_is_narrower_than_target {
