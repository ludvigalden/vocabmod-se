mapping "I101.1" source="I101" target="59621000" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source I101 is a Swedish fifth-character extension of I10 (Essential hypertension); the
        extension encodes an episode-of-care modifier not represented in standard OMOP. The base ICD-10
        I10 crosswalks to SNOMED CT 320128 (Essential hypertension, concept_code 59621000). Target 320128
        (broader); the episode modifier is dropped. High tier : crosswalk-verified at the base level
        with a small, well-understood breadth mismatch from the Swedish extension suffix.
        """
}
mapping "I101.2" source="I101" target="59621000" relationship=source_is_narrower_than_target preference=alternative effect=omitted quality=40 {
