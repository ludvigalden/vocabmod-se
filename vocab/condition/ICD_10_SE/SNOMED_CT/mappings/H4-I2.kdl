// ICD-10-SE extension codes to SNOMED CT mappings, codes H4-I2
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "H400A.1" source="H400A" target="4210003" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400A SNOMED CT 4210003 = Ocular hypertension (Swedish national extension, base H40.0).
        SNOMED CT 381290 (4210003, std=S) is the exact term match and the Athena ICD10CM H40.05 crosswalk
        target. Crosswalk-verified exact equivalence.
        """
}
mapping "H400B.1" source="H400B" target="419422001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400B SNOMED CT 419422001 = Narrow chamber angle (Swedish national extension, base H40.0).
        SNOMED CT 4304101 (419422001, std=S) is the exact term match for the anatomical narrow-angle
        finding. The ICD10CM H40.03 crosswalk resolves to a glaucoma concept, but the Swedish source is
        explicitly, so the finding-level narrow-angle concept is the correct target. (exact term match,
        finding vs disorder nuance).
        """
}
mapping "H400C.1" source="H400C" target="12451000" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400C SNOMED CT 12451000 = Suspected optic disc excavation/cupping (Swedish national
        extension, base H40.0). SNOMED CT 4049851 (12451000, std=S) is the exact term match for the optic
        disc cupping finding. The qualifier marks this as a glaucoma-suspect finding; the cupping
        concept is the underlying finding. (exact term match, suspect qualifier not separately
        represented).
        """
}
mapping "H400D.1" source="H400D" target="44219007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400D SNOMED CT 44219007 = Exfoliation syndrome without confirmed glaucoma diagnosis
        (Swedish national extension, base H40.0). SNOMED CT 433197 (44219007, std=S) is the standard
        concept for pseudoexfoliation/exfoliation syndrome. The (without confirmed glaucoma) (437273);
        the lens-capsule finding is the correct target. Broader (the standard concept covers exfoliation
        with or without glaucoma).
        """
}
mapping "H400E.1" source="H400E" target="392133001" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400E SNOMED CT 392133001 = Pigment dispersion syndrome without confirmed glaucoma diagnosis
        (Swedish national extension, base H40.0). SNOMED CT 4189719 (392133001, std=S) is the exact term
        match. The qualifier confirms this is the syndrome without glaucoma, which is exactly what
        4189719 denotes. (exact term match).
        """
}
mapping "H400W.1" source="H400W" target="833278008" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400W SNOMED CT 833278008 = Other type of suspected glaucoma (Swedish national extension,
        base H40.0). SNOMED CT 3663197 (833278008, std=S) is the Athena ICD10CM H40.0 crosswalk target. The
        Swedish residual for glaucoma suspects maps to the general glaucoma-suspect concept. Broader
        over the specific suspect subtypes.
        """
}
mapping "H400X.1" source="H400X" target="833278008" relationship=equivalent effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H400X SNOMED CT 833278008 = Suspected glaucoma, unspecified (Swedish national extension,
        base H40.0). SNOMED CT 3663197 (833278008, std=S) is the Athena ICD10CM H40.0 crosswalk target.
        Unspecified source maps to the general concept. Moderate tier : Athena crosswalk with an
        unspecified source.
        """
}
mapping "H401A.1" source="H401A" target="77075001" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401A SNOMED CT 77075001 = chronic simple glaucoma with open angle, the historical/clinical
        synonym for primary open-angle glaucoma (ICD-10 WHO H40.1). Target SNOMED CT 435262 (concept_code
        77075001), standard concept. The base ICD-10 H40.1 has an Athena crosswalk to 435262; and denote
        the same clinical concept. Exact equivalence, crosswalk-verified.
        """
}
mapping "H401B.1" source="H401B" target="46168003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401B SNOMED CT 46168003 = pigmentary glaucoma with open angle. Target SNOMED CT 436975
        (concept_code 46168003), standard concept. Exact 1:1 clinical equivalence; the open-angle
        qualifier is intrinsic to pigmentary glaucoma.
        """
}
mapping "H401C.1" source="H401C" target="111514006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401C SNOMED CT 111514006 = capsular glaucoma (glaucoma associated with
        pseudoexfoliation/exfoliation syndrome), open angle. Target SNOMED CT 437273 (concept_code
        111514006), standard concept. Swedish is the established clinical equivalent of
        pseudoexfoliation/exfoliation capsular glaucoma.
        """
}
mapping "H401D.1" source="H401D" target="50485007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401D SNOMED CT 50485007 = low-tension glaucoma with open angle (i.e. normal-tension
        open-angle glaucoma). Target SNOMED CT 441561 (concept_code 50485007), standard concept. Exact
        clinical equivalence.
        """
}
mapping "H401W.1" source="H401W" target="77075001" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401W SNOMED CT 77075001 = other specified primary open-angle glaucoma — a residual bucket.
        Target SNOMED CT 435262 (77075001), the parent concept that subsumes all primary open-angle
        glaucoma subtypes. The base ICD-10 H40.1 crosswalks to 435262; the target fully contains the
        source (broader), but the source is a heterogeneous residual, so confidence is low per the
        rubric for residual/ambiguous sources.
        """
}
mapping "H401X.1" source="H401X" target="77075001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H401X SNOMED CT 77075001 = primary open-angle glaucoma, unspecified. Target SNOMED CT 435262
        (77075001), standard concept, the exact Athena crosswalk target of the base ICD-10 H40.1. The
        Swedish (unspecified) maps to the same concept as the base; high rather than because the source
        adds an unspecified qualifier not encoded in the target.
        """
}
