// ICD-10-SE extension codes to SNOMED CT mappings, codes W86-W865
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W860.1" source="W860" target="419730001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W8600.1" source="W8600" target="418908004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W8600 = SNOMED CT 418908004 (Swedish national extension). Base W86 Athena-crosswalks to
        SNOMED CT 4303528 (concept_code 418908004) via ICD10 relationship 45756331 -> 4303528. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W86, one-level broader (Swedish
        qualifier dropped).
        """
}
