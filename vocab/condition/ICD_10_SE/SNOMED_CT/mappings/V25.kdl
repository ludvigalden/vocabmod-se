// ICD-10-SE extension codes to SNOMED CT mappings, codes V25
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2500.1" source="V2500" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2500 = Swedish extension of WHO V25.0 (motorcycle driver injured in non-traffic
        collision with railway train/vehicle), activity-context suffix SNOMED CT 214640008. Source
        definition: motorcycle driver injured off-road in collision with train while engaged in sport.
        Target 437738 = — the only Athena target for WHO V25.0 in the mirror. Target subsumes source but
        at a high level of generality: it captures but loses both the train-collision mechanism and the
        driver/motorcycle specifics. Low tier : the only available standard target is far broader than
        the source — single-level broader would be, but the climb from to generic is a substantial
        specificity loss. Activity-context suffix also has no representation. No web research;
        Athena-local mirror only.
        """
}
