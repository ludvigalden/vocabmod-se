// ICD-10-SE extension codes to SNOMED CT mappings, codes V57-V575
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5700.1" source="V5700" target="217897003" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5700 = Swedish extension of V57.0 (driver of pick-up truck/van, collision with
        fixed/stationary object, non-traffic accident) with activity SNOMED CT 217897003 57701003 (sport).
        Parent V57.0 crosswalks to SNOMED CT 436292 (Accidental collision with stationary object,
        concept_code 217897003). Primary covers accident axis; secondary 440288 (Accident while engaged
        in sports activity) covers activity axis. Both partial.
        """
}
