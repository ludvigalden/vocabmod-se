// ICD-10-SE extension codes to SNOMED CT mappings, codes A0-A6
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "A083A.1" source="A083A" target="154355005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source A083A SNOMED CT 154355005 = enteritis caused by Coxsackievirus (a Swedish 5th-char subcode
        of A08.3, which itself has no OMOP crosswalk in the mirror). Target SNOMED CT 40319614
        (concept_code 154355005) =, the closest standard concept in the mirror covering Coxsackie gut
        infection. Broader: the target subsumes the source (no enteritis-specific SNOMED CT concept exists
        in the mirror). High tier: exact pathogen match but the target is one level broader (any
        Coxsackie disease vs enteritis specifically).
        """
}
mapping "A083B.1" source="A083B" target="446755003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source A083B SNOMED CT 446755003 = enteritis caused by Echovirus. Target SNOMED CT 40489339
        (concept_code 446755003) =, a precise clinical equivalent in the mirror. High tier: exact term
        and clinical-scope match without an independent crosswalk (no Maps-to edge for this Swedish
        subcode in the mirror).
        """
}
mapping "A083W.1" source="A083W" target="266071000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source A083W SNOMED CT 266071000 = enteritis caused by other specified virus (residual subcode of
        A08.3). No virus-specific SNOMED CT target can be chosen without knowing the organism. Target
        SNOMED CT 198678 =, the Athena crosswalk target for the A08 parent (45755296 Maps to 198678).
        Broader: target subsumes the source. Low tier: residual source; crosswalk climbs two levels
        (A08.3->A08) and loses the viral aetiology.
        """
}
mapping "A1690.1" source="A1690" target="186202007" relationship=source_is_narrower_than_target {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source A1690 is a Swedish 5th-char extension on A16.9 (respiratory TB, not bacteriologically
        confirmed). Name is the bare code (no Swedish label). The legacy comment already proposes SNOMED CT
        154283005 (Pulmonary tuberculosis); mirror has no such concept_id. Best mirror-resolvable
        crosswalk: A16 (45576232) Maps to SNOMED CT 261774 (concept_code 186202007) = SNOMED CT 154283005
        186202007. Broader: the A16 parent subsumes the A16.9 child. Low tier: 5th-char extension
        without a Swedish label leaves the exact scope ambiguous; crosswalk is one level broader than
        the source.
        """
}
