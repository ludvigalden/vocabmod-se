// ICD-10-SE extension codes to SNOMED CT mappings, codes Y5-Y9
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y586B.1" source="Y586B" target="219075006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y586B SNOMED CT 219075006 = a Swedish ICD-10-SE national extension that subdivides Y58
        (Athena ICD10 concept 45756619) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 439558 = (sctid 219075006), the verified Athena crosswalk target for Y58
        (ICD10 relationship 45756619 -> 439558). Why this target: it is the authoritative standard
        concept the parent Y58 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
