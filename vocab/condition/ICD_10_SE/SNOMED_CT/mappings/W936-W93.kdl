// ICD-10-SE extension codes to SNOMED CT mappings, codes W936-W93
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W936.1" source="W936" target="217604004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W936 SNOMED CT 217604004 is a Swedish national extension of WHO base Exposure to excessive
        cold of man-made origin (ICD-10 id 45756337); the Swedish suffix subdivides the base by a
        place/activity external-cause axis with no distinct standard SNOMED CT clinical analogue. Base
        event Athena-crosswalks to SNOMED CT 434257 (concept_code 217604004) via ICD10 relationship
        45756337 -> 434257. The Swedish place/activity qualifier is external-cause metadata; the injury
        event is unchanged. Target subsumes the event -> broader. Confidence : verified Athena crosswalk
        on the WHO base, one-level broader (qualifier dropped).
        """
}
