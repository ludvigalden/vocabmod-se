// ICD-10-SE extension codes to SNOMED CT mappings, codes M06-M09
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M060L.1" source="M060L" target="69896004" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "M060M.1" source="M060M" target="69896004" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "M060N.1" source="M060N" target="69896004" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "M068L.1" source="M068L" target="1162336001" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M068L SNOMED CT 1162336001 = erosive rheumatoid arthritis, RF-negative and ACPA-positive.
        Target SNOMED CT 37160399 = (1162336001). The target captures both the erosive phenotype and the
        ACPA-positive serostatus; the RF-negative aspect is implied (target does not require RF
        positivity). Exact match.
        """
}
mapping "M068M.1" source="M068M" target="1162303002" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M068M SNOMED CT 1162303002 = erosive rheumatoid arthritis, RF-negative and ACPA-negative
        (so-called). Target SNOMED CT 37160376 = (1162303002). The target captures the erosive +
        seronegative (RF-negative) aspects; the additional ACPA-negative qualifier is more specific than
        the target expresses. Broader (target subsumes the ACPA-negative subset); moderate tier
        (ACPA-negativity not separately coded in standard SNOMED CT RA).
        """
}
mapping "M068N.1" source="M068N" target="1162303002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M068N SNOMED CT 1162303002 = erosive RA with RF-negative status and ACPA unspecified. Target
        SNOMED CT 37160376 (1162303002). RF-negative matches the seronegative criterion; erosive matches;
        ACPA-ospecificerad is a minor indeterminacy but the clinical entity is the same. Athena-local
        verified; no separate crosswalk exists for this Swedish-extension code. high: near-equivalent
        but the ACPA-unspecified qualifier and Swedish-extension provenance prevent a call.
        """
}
mapping "M069A.1" source="M069A" target="201764007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M069A SNOMED CT 201764007 = RA unspecified, cervical spine. Target SNOMED CT 4116439
        (201764007). Site-specific SNOMED CT concept exists and matches the source's site exactly. high:
        Athena-local confirmed via the ICD10/SNOMED CT hierarchy; the Swedish (unspecified serostatus)
        aligns with the SNOMED CT concept which also does not specify serostatus. Not because no direct
        crosswalk for this Swedish-extension code.
        """
}
mapping "M069B.1" source="M069B" target="156473007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M069B SNOMED CT 156473007 = RA unspecified, shoulder. Target SNOMED CT 40320304 (156473007).
        Site-specific SNOMED CT concept matches the shoulder site exactly. high: best available standard
        target, site-verified via Athena-local; Swedish-extension code has no direct crosswalk.
        """
}
mapping "M069C.1" source="M069C" target="156474001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M069C SNOMED CT 156474001 = RA unspecified, elbow. Target SNOMED CT 40320305 (156474001).
        Site-specific SNOMED CT concept matches the elbow site exactly. high.
        """
}
mapping "M069D.1" source="M069D" target="156476004" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M069D SNOMED CT 156476004 = RA unspecified, wrist/hand region. Target SNOMED CT 40320307
        (156476004). ICD-10 topography treats wrist/hand as a single region; Athena maps the ICD10
        M06.04 code to the RA-hand-joint SNOMED CT concept (and M06.02 is the only separate upper-limb
        code), so the Swedish combined code is best represented by the hand-joint SNOMED CT concept. The
        wrist is clinically subsumed by the hand region in this coding convention. high: site match is
        defensible but the combined-region Swedish extension prevents.
        """
}
