mapping "M090A.1" source="M090A" target="239803008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M090A SNOMED CT 239803008 = juvenile arthritis in psoriasis, certain diagnosis. Swedish
        letter suffix A marks diagnostic certainty (säker), not a body-site subdivision; clinically this
        is the base M09.0 concept. Target SNOMED CT 4079734 (concept_code 239803008). ICD10 base code M09.0
        maps to 4079734 in the Athena crosswalk; Swedish certainty suffix does not change the clinical
        concept. Exact equivalence.
        """
}
mapping "M090B.1" source="M090B" target="239803008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M090B SNOMED CT 239803008 = juvenile arthritis in psoriasis, probable diagnosis. Swedish
        letter suffix B marks diagnostic certainty (sannolik), not a body-site subdivision; clinically
        equivalent to the base M09.0 concept. Target SNOMED CT 4079734. Athena crosswalk M09.0 -> 4079734;
        certainty marker does not change the clinical referent.
        """
}
