// ICD-10-SE extension codes to SNOMED CT mappings, codes Y04-Y044
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y040.1" source="Y040" target="219178006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "Y0400.1" source="Y0400" target="242889009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y0400 SNOMED CT 242889009 = a Swedish ICD-10-SE national extension that subdivides Y04
        (Athena ICD10 concept 45756471) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4054796 = (sctid 242889009), the verified Athena crosswalk target for
        Y04 (ICD10 relationship 45756471 -> 4054796). Why this target: it is the authoritative standard
        concept the parent Y04 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
