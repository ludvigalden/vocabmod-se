// ICD-10-SE extension codes to SNOMED CT mappings, codes W116-W11
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W116.1" source="W116" target="86591008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W116 is a Swedish extension of W11 SNOMED CT 86591008 encoding
        place=industriområde/byggarbetsplats (industrial/construction area), no activity suffix. Target
        SNOMED CT 432803 (86591008) is the WHO W11 crosswalk target and the only valid standard concept for
        ladder falls. The place-specific SNOMED CT candidate 40419982 is retired (invalid_reason=U).
        Broader mapping: 432803 subsumes the source, but place specificity is lost. Confidence
        (moderate).
        """
}
mapping "W1160.1" source="W1160" target="86591008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1160 is a Swedish 6-char extension of W11 encoding place=industri/byggarbetsplats AND
        activity=idrott/sport/motion. Target SNOMED CT 432803 (86591008) SNOMED CT 86591008 is the W11
        crosswalk target and the only valid standard ladder-fall concept. Both place-specific and
        activity-specific SNOMED CT candidates are retired (40419982 place=industrial U; no active standard
        concept for). Broader: target subsumes source; both axes lost. Confidence (moderate).
        """
}
mapping "W1161.1" source="W1161" target="86591008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1161 is a Swedish 6-char extension of W11 encoding place=industri/byggarbetsplats AND
        activity=lek och annan fritidsverksamhet (play/leisure). Target SNOMED CT 432803 (86591008) SNOMED CT
        86591008 is the W11 crosswalk target and the only valid standard ladder-fall concept; place- and
        activity-specific SNOMED CT candidates are retired or absent. Broader: target subsumes source.
        Confidence (moderate).
        """
}
mapping "W1162.1" source="W1162" target="86591008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1162 is a Swedish 6-char extension of W11 encoding place=industri/byggarbetsplats AND
        activity=förvärvsarbete (paid work). Target SNOMED CT 432803 (86591008) SNOMED CT 86591008 is the W11
        crosswalk target and the only valid standard ladder-fall concept. SNOMED CT 17542004 (S, valid)
        exists as an activity-axis concept but is a different disorder axis (the activity context, not
        the fall itself) and combining it with 432803 would require a multi-target partial decomposition
        without an OMOP convention supporting it for external-cause codes. Broader: target subsumes
        source. Confidence (moderate).
        """
}
mapping "W1163.1" source="W1163" target="86591008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1163 is a Swedish 6-char extension of W11 encoding place=industri/byggarbetsplats AND
        activity=annan sysselsättning. Target SNOMED CT 432803 (86591008) SNOMED CT 86591008 is the W11
        crosswalk target and the only valid standard ladder-fall concept. Broader: target subsumes
        source; both place and activity axes lost. Confidence (moderate).
        """
}
