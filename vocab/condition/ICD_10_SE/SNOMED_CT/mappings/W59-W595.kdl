// ICD-10-SE extension codes to SNOMED CT mappings, codes W59-W595
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W590.1" source="W590" target="418589001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5900.1" source="W5900" target="17982002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5900 = Swedish 5-char extension of ICD-10 W59 SNOMED CT 17982002, place=bostad och
        bostadsområde (home), activity=idrott/sport/motion. Target is the standard concept the parent
        W59 crosswalks to (Athena Maps to: 45756310 -> 4077127, standard_concept=S). Target subsumes the
        source (all source semantics are reptile-attack exposures) but drops both place and activity
        granularity, so it is broader. moderate: best available standard concept, verified crosswalk on
        the parent, but unspecified source vs specific SNOMED CT and two granularity axes lost. The
        [X]-prefixed place-specific SNOMED CT concepts (220954005 etc.) are non-standard (invalid_reason U)
        and were rejected in favor of the standard target.
        """
}
