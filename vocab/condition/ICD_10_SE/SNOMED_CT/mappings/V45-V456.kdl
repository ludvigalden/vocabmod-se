// ICD-10-SE extension codes to SNOMED CT mappings, codes V45-V456
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4500.1" source="V4500" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4500 is the Swedish national extension of ICD-10 V45.0 (Car occupant injured in
        collision with railway train or railway vehicle, driver injured in nontraffic accident) with
        activity qualifier SNOMED CT 214640008 36198007 (sport/athletics/exercise). Targets inherit the
        verified Athena crosswalk of parent V45.0: SNOMED CT 437738 (Motor vehicle accident off public
        road, 214640008) and 444074 (Victim of vehicular AND/OR traffic accident, 36198007). Accident
        mechanism fully captured; activity suffix dropped, so broader. high: crosswalk inherited from
        parent V45.0.
        """
}
