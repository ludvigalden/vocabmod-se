// ICD-10-SE extension codes to SNOMED CT mappings, codes O8-P5
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "O800A.1" source="O800A" target="309469004" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O800A SNOMED CT 309469004 = spontaneous delivery, singleton, occiput anterior. Target SNOMED CT
        4205240 = (concept_code 309469004), the ICD10 O80.0 crosswalk target. Occiput-anterior is the
        typical vertex presentation; the target covers this exactly. exact_match.
        """
}
mapping "O800B.1" source="O800B" target="309469004" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O800B SNOMED CT 309469004 = spontaneous delivery, singleton, occiput posterior. Target
        SNOMED CT 4205240 = (concept_code 309469004), the ICD10 O80.0 crosswalk target. No SNOMED CT concept
        distinguishes occiput-posterior spontaneous delivery; the target subsumes all vertex
        presentations including occiput posterior. high: verified crosswalk, one-level broader (the
        occiput-posterior specificity is lost).
        """
}
mapping "O800W.1" source="O800W" target="309469004" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O800W SNOMED CT 309469004 = spontaneous delivery, singleton, other specified cephalic
        presentation. Target SNOMED CT 4205240 = (concept_code 309469004), the ICD10 O80.0 crosswalk
        target. The target subsumes all specified cephalic variants under the general vertex-delivery
        concept. high: verified crosswalk, one-level broader.
        """
}
mapping "O800X.1" source="O800X" target="309469004" relationship=equivalent effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O800X SNOMED CT 309469004 = spontaneous delivery, singleton, vertex unspecified. Target
        SNOMED CT 4205240 = (concept_code 309469004), the ICD10 O80.0 crosswalk target. Exact equivalence:
