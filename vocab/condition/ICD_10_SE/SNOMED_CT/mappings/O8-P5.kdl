mapping "O911A.1" source="O911A" target="270502007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O911A SNOMED CT 270502007 = purulent mastitis associated with childbirth. Target SNOMED CT
        443263 = (concept_code 270502007), the ICD10 O91.1 crosswalk target. The source denotes purulent
        mastitis (infection with pus) in the puerperium; the target denotes obstetric breast abscess. A
        purulent mastitis is clinically closely related to breast abscess (purulence implies abscess
        formation or progression). The target subsumes the purulent-mastitis/abscess spectrum under the
        obstetric context. high: verified crosswalk, near-equivalent with slight breadth mismatch.
        """
}
mapping "O911B.1" source="O911B" target="270502007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O911B SNOMED CT 270502007 = breast abscess/boil associated with childbirth. Target SNOMED CT
        443263. The Swedish code groups abscess AND other non-purulent breast infections; 443263 is the
        abscess-specific standard target. The ICD10 base O91 Maps to several SNOMED CT targets (72390
        non-purulent mastitis, 443263 abscess, 444244 nipple infection); 443263 is the best single
        target since = abscess. broader because source groups multiple infection types and target covers
        the abscess subcase.
        """
}
mapping "O911X.1" source="O911X" target="270502007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source O911X SNOMED CT 270502007 = unspecified breast abscess associated with childbirth. Target
        SNOMED CT 443263 (Athena Maps to from base ICD10 O91.1). The unspecified subtype inherits the
        parent crosswalk. Moderate tier: unspecified source, parent crosswalk not independently
        re-verified for the Swedish extension.
        """
}
