// ICD-10-SE extension codes to SNOMED CT mappings, codes I7-J2
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "I700A.1" source="I700A" target="81817003" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I700A SNOMED CT 81817003 = atherosclerosis of the thoracic aorta, a Swedish extension
        subcode of ICD-10 I70.0. No SNOMED CT concept for thoracic-aorta atherosclerosis exists in the
        mirror distinct from the general aortic concept; SNOMED CT 312934 (81817003) is the closest
        standard concept and the ICD-10 base I70.0 maps to it via Athena. Thoracic ⊂ aorta, so target
        subsumes source. Confidence : verified crosswalk on the base, one-level breadth mismatch (site
        qualifier dropped).
        """
}
mapping "I700B.1" source="I700B" target="81817003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I700B SNOMED CT 81817003 = atherosclerosis of the abdominal aorta, a Swedish extension
        subcode of ICD-10 I70.0. SNOMED CT 37163036 is not the abdominal aorta specifically (it covers
        visceral branches, not the aorta itself). The best standard concept is SNOMED CT 312934 (81817003),
        the Athena target of base I70.0; abdominal aorta ⊂ aorta, so the target subsumes the source but
        drops the abdominal-site qualifier. Confidence : best available standard concept with verified
        base crosswalk, but a meaningful site qualifier is lost.
        """
}
mapping "I700X.1" source="I700X" target="81817003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I700X SNOMED CT 81817003 = atherosclerosis of aorta, unspecified, the Swedish extension
        residual of ICD-10 I70.0. The base I70.0 maps via Athena to SNOMED CT 312934 (81817003). The
        Swedish = unspecified/residual suffix adds no further clinical specificity, so source and target
        denote the same clinical concept. Confidence : verified crosswalk, exact equivalence on the
        base, the unspecified Swedish extension does not narrow the meaning.
        """
}
mapping "I702D.1" source="I702D" target="51274000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I702D SNOMED CT 51274000 = peripheral atherosclerosis with rest pain, without ulcer, a
        Swedish extension subcode of ICD-10 I70.2. The base I70.2 maps to SNOMED CT 315558 (51274000).
        SNOMED CT 44782441 captures claudication but not rest pain, so the base target is the best standard
        concept. Target subsumes source (drops rest-pain and no-ulcer qualifiers). Confidence : best
        available standard with verified base crosswalk, but the symptom (rest pain) and
        complication-absence qualifiers are lost.
        """
}
mapping "I702E.1" source="I702E" target="51274000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I702E SNOMED CT 51274000 = asymptomatic peripheral atherosclerosis, a Swedish extension
        subcode of ICD-10 I70.2. The base I70.2 maps to SNOMED CT 315558 (51274000). Target subsumes source
        (drops the asymptomatic qualifier, which is a narrowing modifier). Confidence : verified
        crosswalk on the base, one-level breadth mismatch from the symptom qualifier.
        """
}
mapping "I710A.1" source="I710A" target="301899003" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I710A SNOMED CT 301899003 = Stanford type A aortic dissection. SNOMED CT has no concept by
        name; the canonical SNOMED CT equivalent is 4199413 (301899003), since by definition Stanford A
        involves the proximal/ascending aorta. The DeBakey type I/II concepts (4119616, 4124844) overlap
        but are imaging-based, not Stanford-classification based. Target and source denote the same
        clinical concept (proximal/ascending aortic dissection). Confidence : clinically equivalent, but
        no string-level or crosswalk confirmation; the equivalence rests on the definition of Stanford
        A.
        """
}
mapping "I710B.1" source="I710B" target="1344841005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source I710B SNOMED CT 1344841005 = Stanford type B aortic dissection. SNOMED CT 1448923 (1344841005)
        is the explicit SNOMED CT representation of Stanford type B, which by definition is a dissection of
        the descending aorta not involving the ascending aorta. Exact equivalence. Confidence : explicit
        SNOMED CT type-B concept, name-level match.
        """
}
