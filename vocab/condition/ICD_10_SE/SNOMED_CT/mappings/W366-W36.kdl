// ICD-10-SE extension codes to SNOMED CT mappings, codes W366-W36
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W366.1" source="W366" target="218071008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W36.6 SNOMED CT 218071008 (Explosion of gas cylinder - industrial area/construction site) is
        a Swedish 5-char extension of ICD-10 W36 adding place/activity detail. Target SNOMED CT 436890
        (218071008) is the verified Athena target for parent W36. Target fully subsumes the source
        (every industrial-site gas-cylinder explosion is a gas-cylinder explosion) but lacks the
        place/activity granularity, so target is broader. : one-level broader, parent crosswalk verified
        in mirror.
        """
}
