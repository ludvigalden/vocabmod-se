// ICD-10-SE extension codes to SNOMED CT mappings, codes X01-X015
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X010.1" source="X010" target="217485009" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X0100.1" source="X0100" target="217485009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X0100 = SNOMED CT 217485009 (Swedish national extension). Base X01 Athena-crosswalks to
        SNOMED CT 436319 (concept_code 217485009) via ICD10 relationship 45756361 -> 436319. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X01, one-level broader (Swedish
        qualifier dropped).
        """
}
