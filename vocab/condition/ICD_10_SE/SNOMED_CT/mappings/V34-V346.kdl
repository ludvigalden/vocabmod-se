// ICD-10-SE extension codes to SNOMED CT mappings, codes V34-V346
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3400.1" source="V3400" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3400 = Swedish extension of V34.0 (driver of three-wheeled motor vehicle, NON-TRAFFIC
        collision with heavy truck/bus) with activity SNOMED CT 214640008 (sport/exercise). Target (Athena
        437738) =, standard (S). Base V34.0 (45756425) has verified Athena crosswalk to 437738. Broader:
        target subsumes source (every such case is an off-public-road motor-vehicle accident), but
        target drops vehicle-type (3-wheeled vs heavy truck), role (driver), and activity context.
        moderate: verified base crosswalk, multi-dimensional specificity loss.
        """
}
