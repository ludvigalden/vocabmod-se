// ICD-10-SE extension codes to SNOMED CT mappings, codes G5-H1
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "G550A.1" source="G550A" target="193118002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source G550A SNOMED CT 193118002 = compression of nerve roots/plexus in cervical spine in
        neoplastic disease. SNOMED CT 4102360 = (concept_code 193118002), the standard concept that the
        parent ICD-10 G55.0 maps to via Athena edge. The Swedish subcode adds a cervical-spine site
        modifier absent from the SNOMED CT parent; the SNOMED CT target fully subsumes the source (every
        cervical neoplastic compression is a neoplastic nerve root compression), so the relationship is
        broader (target subsumes source). High tier: well-understood one-level breadth mismatch with
        verified crosswalk.
        """
}
mapping "G550J.1" source="G550J" target="193118002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source G550J = compression of nerve roots/plexus in thoracic spine in neoplastic disease. Same
        reasoning as G550A: SNOMED CT 4102360 SNOMED CT 193118002 fully subsumes the source (thoracic site is
        a child of the unspecified parent). Athena crosswalk for G55.0 → 4102360 is verified. High tier,
        broader.
        """
}
