// ICD-10-SE extension codes to SNOMED CT mappings, codes Q4-Q7
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Q431A.1" source="Q431A" target="204741009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Q431A SNOMED CT 204741009 = Hirschsprung disease with short segment (Swedish extension of
        Q43.1). Target SNOMED CT 4002470 (204741009). Exact 1:1 semantic equivalence on segment length.
        """
}
