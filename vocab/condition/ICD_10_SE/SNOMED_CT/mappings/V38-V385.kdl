// ICD-10-SE extension codes to SNOMED CT mappings, codes V38-V385
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3800.1" source="V3800" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V38.00 = V38.0 (driver of three-wheeled motor vehicle injured in noncollision transport
        accident, nontraffic) + Swedish activity SNOMED CT 214640008 36198007. Athena crosswalk from V38.0
        yields SNOMED CT 214640008 (Motor vehicle accident off public road) and 36198007 (Victim of
        vehicular AND/OR traffic accident). Activity dimension unrepresented; broader map. Low
        confidence: residual Swedish extension, aspect-loss on activity.
        """
}
