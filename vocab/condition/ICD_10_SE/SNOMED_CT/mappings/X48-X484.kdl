// ICD-10-SE extension codes to SNOMED CT mappings, codes X48-X484
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X480.1" source="X480" target="291701002" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X480 SNOMED CT 291701002 = a Swedish ICD-10-SE national extension that subdivides X48
        (Athena ICD10 concept 45756404) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4161344 = (sctid 291701002), the verified Athena crosswalk target for
        X48 (ICD10 relationship 45756404 -> 4161344). Why this target: it is the authoritative standard
        concept the parent X48 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
