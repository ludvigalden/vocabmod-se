// ICD-10-SE extension codes to SNOMED CT mappings, codes W206-W20
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W206.1" source="W206" target="71893005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W206 SNOMED CT 71893005 = W20 mechanism at industrial/construction area. W20 base maps to
        SNOMED CT 4216727 (valid S). Place-specific SNOMED CT [X] 220564009 invalid (U). Broader; moderate.
        """
}
mapping "W2060.1" source="W2060" target="71893005" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2060 (Swedish 6-char extension of W20) = SNOMED CT 71893005. Parent W20 (ICD10 id 45756258)
        has Athena crosswalk to SNOMED CT 4216727 (code 71893005). The Swedish extension encodes
        place+activity context for which no SNOMED CT standard concept exists; the target fully subsumes
        the source (every such event is a) so broader. : crosswalk-verified on the W20 parent, but
        place/activity specificity is lost.
        """
}
