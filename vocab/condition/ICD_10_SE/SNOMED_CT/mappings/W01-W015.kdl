// ICD-10-SE extension codes to SNOMED CT mappings, codes W01-W015
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W010.1" source="W010" target="217154006" relationship=equivalent quality=100 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Dotted leaf code for fall from slipping/tripping without striking object; exact SNOMED CT match;
        crosswalk-verified
        """
}
mapping "W0100.1" source="W0100" target="217154006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
