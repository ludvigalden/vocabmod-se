// ICD-10-SE extension codes to SNOMED CT mappings, codes X116-X11
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X116.1" source="X116" target="242503001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X116 = SNOMED CT 242503001 (Swedish national extension). Base X11 Athena-crosswalks to
        SNOMED CT 4054576 (concept_code 242503001) via ICD10 relationship 45756370 -> 4054576. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X11, one-level broader (Swedish
        qualifier dropped).
        """
}
