// ICD-10-SE extension codes to SNOMED CT mappings, codes W93-W935
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W930.1" source="W930" target="217605003" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W9300.1" source="W9300" target="217604004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W9300 = SNOMED CT 217604004 (Swedish national extension). Base W93 Athena-crosswalks to
        SNOMED CT 434257 (concept_code 217604004) via ICD10 relationship 45756337 -> 434257. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W93, one-level broader (Swedish
        qualifier dropped).
        """
}
