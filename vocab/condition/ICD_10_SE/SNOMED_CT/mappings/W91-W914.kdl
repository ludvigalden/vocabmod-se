// ICD-10-SE extension codes to SNOMED CT mappings, codes W91-W914
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W910.1" source="W910" target="218190002" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W910 = SNOMED CT 218190002 (Swedish national extension). Base W91 Athena-crosswalks to
        SNOMED CT 438630 (concept_code 218190002) via ICD10 relationship 45756335 -> 438630. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W91, one-level broader (Swedish
        qualifier dropped).
        """
}
mapping "W9100.1" source="W9100" target="218190002" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (exact_match): SE code = exposure to unspecified radiation (home, sports).
        Target 438630 SNOMED CT 218190002 is base W91 Athena Maps-to crosswalk; same clinical concept,
        place/activity are circumstance. Crosswalk-verified 1:1.
        """
}
