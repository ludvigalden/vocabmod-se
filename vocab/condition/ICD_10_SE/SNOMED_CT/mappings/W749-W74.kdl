// ICD-10-SE extension codes to SNOMED CT mappings, codes W749-W74
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W749.1" source="W749" target="217748000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (exact_match): Source W749 = SE extension of WHO W74 SNOMED CT 217748000 +
        place (unspecified). Verified Maps-to 45756320 (W74) -> 436593 (217748000, standard S). W74 sits
        in the ICD-10 accidental-injury chapter (W00-X59), so W74 is an accidental drowning by chapter;
        is the exact SNOMED CT equivalent.
        """
}
mapping "W7490.1" source="W7490" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7490 = SNOMED CT 217748000 with Swedish qualifiers (place: plats, ospecificerad; activity:
        idrott, sport, motion). Base event W74 Athena-crosswalks to SNOMED CT 436593 (217748000).
        Qualifiers are external-cause metadata with no distinct standard analogue; injury event
        unchanged. Target subsumes the drowning event -> broader. Confidence : verified crosswalk on
        base W74, one-level broader.
        """
}
mapping "W7491.1" source="W7491" target="217748000" relationship=source_is_narrower_than_target {
