mapping "V1992.1" source="V1992" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1992 = SNOMED CT 47397001 (unspecified pedal cyclist injured in unspecified traffic
        accident - during paid work). Parent V199 maps via Athena crosswalk to SNOMED CT 433099 (Victim,
        cyclist in vehicular AND/OR traffic accident, concept_code 47397001). The Swedish 5-char suffix
        encodes only the activity-at-time-of-injury (work), which has no SNOMED CT representation; the
        SNOMED CT target captures the injury-event role (cyclist victim) and fully subsumes the clinical
        meaning, dropping the activity context. Broader: target is the legitimate ancestor. Moderate
        tier : inherited from parent crosswalk, not independently re-verified for this activity-specific
        subcode; activity context lost.
        """
}
mapping "V1993.1" source="V1993" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1993 = SNOMED CT 47397001 (cyclist in unspecified traffic accident - other activity).
        Parent V199 → SNOMED CT 433099 (Victim, cyclist in vehicular/traffic accident) via Athena
        crosswalk. Activity suffix (other activity) has no SNOMED CT representation; target subsumes the
        injury-event semantics. Broader, moderate : parent crosswalk inherited, activity context not
        captured.
        """
}
mapping "V1994.1" source="V1994" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1994 = SNOMED CT 47397001 (cyclist in unspecified traffic accident - vital activity such as
        rest, sleep, meals, personal hygiene). Parent V199 → SNOMED CT 433099 (Victim, cyclist in
        vehicular/traffic accident). Activity suffix has no SNOMED CT representation; target subsumes
        injury-event semantics. Broader, moderate.
        """
}
mapping "V1998.1" source="V1998" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1998 = SNOMED CT 47397001 (cyclist in unspecified traffic accident - other specified
        activities). Parent V199 → SNOMED CT 433099 (Victim, cyclist in vehicular/traffic accident).
        Activity suffix has no SNOMED CT analogue; target subsumes injury-event role. Broader, moderate.
        """
}
mapping "V1999.1" source="V1999" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1999 = SNOMED CT 47397001 (cyclist in unspecified traffic accident - activity unspecified).
        Parent V199 → SNOMED CT 433099 (Victim, cyclist in vehicular/traffic accident). The activity suffix
        is itself unspecified, so the source is effectively equivalent to the parent; target fully
        subsumes it. Broader (conservatively, since the 5-char code is a Swedish extension), moderate.
        """
}
