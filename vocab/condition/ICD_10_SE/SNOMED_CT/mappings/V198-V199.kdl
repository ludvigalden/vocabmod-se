// ICD-10-SE extension codes to SNOMED CT mappings, codes V198-V199
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V1980.1" source="V1980" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1980 = Swedish ICD-10-SE extension of V19.8 (Pedal cyclist [any] injured in other
        specified transport accidents) with activity suffix 0 (sport/exercise). Base V19.8 crosswalks
        via Athena (concept 45604642) to SNOMED CT 47397001 (433099) and SNOMED CT 386662004 (443423). Target
        subsumes the cyclist-accident scenario; activity-context dimension lost. Low tier: Swedish
        extension, crosswalk is for base code.
        """
}
