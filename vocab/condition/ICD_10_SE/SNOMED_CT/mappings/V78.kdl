// ICD-10-SE extension codes to SNOMED CT mappings, codes V78
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7820.1" source="V7820" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7820 (Swedish 5-char extension of ICD-10 V78.2): bus occupant (person on outside of
        vehicle) injured in noncollision nontraffic transport accident, while engaged in sport/exercise.
        Parent V78.2 (Athena concept 45590322) has verified Athena SNOMED 214640008 36198007 edges to
        SNOMED CT 437738 (Motor vehicle accident off public road, concept_code 214640008) and 444074
        (Victim of vehicular AND/OR traffic accident, concept_code 36198007). The Swedish activity
        subcategory (idrott/sport/motion) has no SNOMED CT representation; target 437738 fully subsumes the
        nontraffic-accident axis, and 444074 covers the vehicular-accident-victim axis. Mapping type
        broader: target is the standard parent concept that contains the more specific Swedish code.
        Confidence (high) for 437738: verified crosswalk, one level of specificity added by the Swedish
        activity extension; (moderate) for 444074 as the secondary victim-status target. No web research
        used; Athena-local mirror only.
        """
}
mapping "V7820.2" source="V7820" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
