// ICD-10-SE extension codes to SNOMED CT mappings, codes W19-W195
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W190.1" source="W190" target="1912002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W190 SNOMED CT 1912002 = Swedish 5-char extension of W19 (Unspecified fall) for. Target
        SNOMED CT 436583 = (1912002), verified Athena for W19. Accident concept matches exactly; place
        qualifier is contextual metadata.
        """
}
mapping "W1900.1" source="W1900" target="1912002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1900 is a Swedish national extension of W19 (Unspecified fall) scoped to SNOMED CT 1912002
        (home/residential area, sport/exercise). Target SNOMED CT 436583 = (1912002), verified Athena for
        W19. Subdivision has no individual SNOMED CT target; parent W19 subsumes it. One-level broader.
        """
}
mapping "W1901.1" source="W1901" target="220547006" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1901 = SNOMED CT 220547006. The source is a Swedish national extension that bundles two
        axes: location (home) AND activity (leisure/free-time). SNOMED CT 40420309 (concept_code 220547006)
        covers only the location axis; the activity axis has no SNOMED CT representation. Per the boundary
        rule (combination/with/and source to single target = partial). low tier: real partial semantic
        overlap, target is recorded to preserve the location lead, not asserted as equivalence. Parent
        W19 already maps to SNOMED CT 436583 (Fall).
        """
}
