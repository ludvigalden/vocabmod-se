// ICD-10-SE extension codes to SNOMED CT mappings, codes X399-X3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X399.1" source="X399" target="217591008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X399 = SNOMED CT 217591008 (Swedish national extension). Base X39 Athena-crosswalks to
        SNOMED CT 437453 (concept_code 217591008) via ICD10 relationship 45756395 -> 437453. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X39, one-level broader (Swedish
        qualifier dropped).
        """
}
