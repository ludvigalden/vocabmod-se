// ICD-10-SE extension codes to SNOMED CT mappings, codes T88
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "T887A.1" source="T887A" target="62014003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T887A (Swedish extension of T88.7) = Drug reaction due to allergy/idiosyncrasy. Parent
        ICD-10 T88.7 (Unspecified adverse effect of drug or medicament) has Athena SNOMED 62014003
        crosswalk to SNOMED CT 441207 (Adverse reaction to drug, concept_code 62014003). Swedish A-code
        narrows T88.7 by specifying allergic/idiosyncratic mechanism; SNOMED CT target is broader than
        both. Target subsumes source. broader.
        """
}
mapping "T887X.1" source="T887X" target="62014003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T887X (Swedish extension of T88.7) = Drug reaction UNS. Functionally identical to ICD-10
        T88.7 (Unspecified adverse effect of drug or medicament), which has Athena SNOMED 62014003
        crosswalk to SNOMED CT 441207 (Adverse reaction to drug, concept_code 62014003). Same clinical
        concept at same specificity = exact_match.
        """
}
