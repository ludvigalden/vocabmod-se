// ICD-10-SE extension codes to SNOMED CT mappings, codes W24-W244
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W240.1" source="W240" target="217952006" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "W2400.1" source="W2400" target="269716005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2400 = Swedish ICD-10-SE extension of base W24 SNOMED CT 269716005, qualified by place
        (home and residential area) and activity (sport/exercise). Base W24 (Athena concept_id 45756277)
        has an Athena edge to SNOMED CT 432534 (269716005). No SNOMED CT standard concept captures the
        place+activity qualification; the base-code target fully subsumes the event (every such
        activity-qualified event is a machinery accident). broader because target legitimately subsumes
        the source. (moderate): best available standard target, Athena crosswalk on the base code, but
        the Swedish extension is not independently re-verified and place/activity specificity is lost.
        """
}
mapping "W2401.1" source="W2401" target="269716005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2401 = Swedish extension of base W24, qualified by place SNOMED CT 269716005 and activity
        (play and other leisure). Base W24 maps via Athena to SNOMED CT 432534 (269716005). Target subsumes
        the event; place/activity suffix is administrative. broader.
        """
}
