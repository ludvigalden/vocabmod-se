// ICD-10-SE extension codes to SNOMED CT mappings, codes W146-W14
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W146.1" source="W146" target="82947003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W146 SNOMED CT 82947003 = fall from tree, industrial/construction area (place only). Target
        SNOMED CT 4307686 (concept_code 82947003) =, standard W14 crosswalk target. Place-specific SNOMED CT
        child 40420016 is non-standard, maps to 4307686. Broader: target subsumes source; place
        specificity lost. high: one-level broader with verified W14 crosswalk.
        """
}
mapping "W1460.1" source="W1460" target="82947003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1460 SNOMED CT 82947003 = fall from tree, industrial/construction area, during
        sport/exercise. Target SNOMED CT 4307686 (concept_code 82947003) =, standard W14 crosswalk target.
        Place-specific SNOMED CT child 40420016 is non-standard, maps to 4307686; no standard concept for
        the activity dimension. Broader: target subsumes source. moderate.
        """
}
