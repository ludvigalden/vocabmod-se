// ICD-10-SE extension codes to SNOMED CT mappings, codes V300-V306
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3000.1" source="V3000" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3000 = Swedish extension of V30.0 (Occupant of three-wheeled motor vehicle injured in
        collision with pedestrian or animal, Driver injured in nontraffic accident) with activity SNOMED CT
        48084008. Base V30.0 (Athena 45585387) crosswalks to (Driver in vehicular AND/OR traffic
        accident) and 214640008 (Motor vehicle accident off public road). Best standard target is
        48084008 (driver victim role). Target subsumes the driver-in-vehicular-accident disorder axis;
        both the nontraffic specificity and the activity qualifier are lost. Low tier.
        """
}
