// ICD-10-SE extension codes to SNOMED CT mappings, codes W396-W3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W396.1" source="W396" target="218100007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W396 SNOMED CT 218100007 is a Swedish national extension of ICD-10 W39 subdivided by
        location (industrial area/construction site). Target SNOMED CT 437761 = (218100007), standard
        concept. The base W39 maps to 437761 via Athena crosswalk. Target fully contains the clinical
        fireworks-accident concept; the location modifier lacks SNOMED CT representation, so the target is
        broader. Moderate : parent-level crosswalk, unspecified-source national extension.
        """
}
