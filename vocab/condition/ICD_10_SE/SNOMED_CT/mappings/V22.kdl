// ICD-10-SE extension codes to SNOMED CT mappings, codes V22
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2200.1" source="V2200" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2200 = Swedish 7-char extension of ICD-10 V22.0 SNOMED CT 10298002 214640008 48084008, with
        activity context (sport). Parent V22.0 has Athena edges to SNOMED CT 432510 (Driver in vehicular
        AND/OR traffic accident), 437738 (Motor vehicle accident off public road), 438310 (Victim,
        motorcycle rider in vehicular AND/OR traffic accident). The Swedish extension adds an activity
        axis with no SNOMED CT standard representation; targets are broader (drop activity plus, for
        432510/437738, some vehicle/role specifics). Moderate tier: mechanical crosswalk via parent, SE
        extension not independently re-verified.
        """
}
