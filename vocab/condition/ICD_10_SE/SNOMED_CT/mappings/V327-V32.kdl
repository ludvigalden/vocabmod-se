// ICD-10-SE extension codes to SNOMED CT mappings, codes V327-V32
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3270.1" source="V3270" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3270 = Swedish 5-char expansion of V32.7 SNOMED CT 274913009 36198007 + activity digit
        (idrott, sport, motion). Athena ICD10 mirror: V32.7 (id 45756420) -> SNOMED CT 433930 (Motor
        vehicle on road in collision with another motor vehicle) and 444074 (Victim of vehicular AND/OR
        traffic accident). Activity suffix not in SNOMED CT; source fully subsumed. Broader, high tier.
        """
}
mapping "V3270.2" source="V3270" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
