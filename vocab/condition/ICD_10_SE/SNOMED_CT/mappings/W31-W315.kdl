// ICD-10-SE extension codes to SNOMED CT mappings, codes W31-W315
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W310.1" source="W310" target="217945009" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W3100.1" source="W3100" target="15185003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3100 (Swedish extension of W31) = contact with other/unspecified machinery at
        home/residential area during sport/exercise. Parent W31 (ICD10 45756284) has verified Athena
        SNOMED CT 15185003 edge to SNOMED CT 4035493 (concept_code 15185003). Swedish extension adds
        place/activity detail with no separate SNOMED CT representation; target fully contains the injury
        concept. One-level broader with verified parent crosswalk = high.
        """
}
