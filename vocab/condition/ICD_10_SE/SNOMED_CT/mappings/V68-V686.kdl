// ICD-10-SE extension codes to SNOMED CT mappings, codes V68-V686
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6800.1" source="V6800" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6800 is the Swedish 6th-digit extension of V68.0 (driver of heavy transport vehicle,
        noncollision transport accident, nontraffic), adding activity SNOMED CT 214640008 36198007 (sport,
        exercise). No SNOMED CT standard concept captures the activity dimension; targets inherit from the
        V68.0 Athena crosswalk (45546918 Maps to 437738/444074). Primary 437738 (214640008, standard
        Observation/Event) denotes nontraffic MV accident, broader than source (captures nontraffic MV
        aspect; drops noncollision-mechanism, vehicle type, role, activity). Alt 444074 (36198007)
        broader (victim-status concept, loosest; loses nontraffic specificity). primary: parent V68.0
        crosswalk, activity suffix not independently re-verified.
        """
}
