// ICD-10-SE extension codes to SNOMED CT mappings, codes X244-X247
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X244.1" source="X244" target="269705003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X244 SNOMED CT 269705003 is a Swedish national extension of WHO base Contact with centipedes
        and venomous millipedes (tropical) (ICD-10 id 45756383); the Swedish suffix subdivides the base
        by a place/activity external-cause axis with no distinct standard SNOMED CT clinical analogue. Base
        event Athena-crosswalks to SNOMED CT 4155221 (concept_code 269705003) via ICD10 relationship
        45756383 -> 4155221. The Swedish place/activity qualifier is external-cause metadata; the injury
        event is unchanged. Target subsumes the event -> broader. Confidence : verified Athena crosswalk
        on the WHO base, one-level broader (qualifier dropped).
        """
}
