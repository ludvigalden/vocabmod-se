// ICD-10-SE extension codes to SNOMED CT mappings, codes V48-V486
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4800.1" source="V4800" target="36198007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4800 = Swedish extension of WHO V48.0 (driver injured in noncollision nontraffic
        accident) + activity suffix SNOMED CT 36198007 = idrott/sport/motion. Activity digit has no SNOMED CT
        analogue. Target SNOMED CT 444074 (36198007) =, the Athena crosswalk target for WHO V48.0
        (concept_id 45604712). Broader: target subsumes source; activity and nontraffic/noncollision
        specifics dropped. : crosswalk-verified.
        """
}
