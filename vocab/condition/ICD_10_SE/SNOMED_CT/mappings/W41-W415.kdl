// ICD-10-SE extension codes to SNOMED CT mappings, codes W41-W415
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W410.1" source="W410" target="88817006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is a Swedish ICD-10-SE extension of W41 SNOMED CT 88817006 in the residential setting,
        combined with an activity axis (work, sport, leisure, vital activity). W41 has an Athena
        crosswalk to. No per-place/activity SNOMED CT target exists. Target legitimately subsumes the
        source (high-pressure jet exposure is an inanimate mechanical force exposure); one-level broader
        with verified parent crosswalk.
        """
}
