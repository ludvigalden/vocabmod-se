// ICD-10-SE extension codes to SNOMED CT mappings, codes Y225-Y22
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y225.1" source="Y225" target="219335006" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y225 SNOMED CT 219335006 = a Swedish ICD-10-SE national extension that subdivides Y22
        (Athena ICD10 concept 45756505) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 439236 = (sctid 219335006), the verified Athena crosswalk target for Y22
        (ICD10 relationship 45756505 -> 439236). Why this target: it is the authoritative standard
        concept the parent Y22 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
