// ICD-10-SE extension codes to SNOMED CT mappings, codes V477-V47
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4770.1" source="V4770" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4770 = Swedish 6-char extension of WHO V47.7 (Car occupant — person on outside of
        vehicle injured in traffic accident, collision with fixed/stationary object) + activity suffix
        SNOMED CT 36198007 = idrott/sport/motion. The activity digit is a Swedish national administrative
        extension with no SNOMED CT analogue. Target SNOMED CT 444074 (concept_code 36198007) = — the Athena
        crosswalk target for WHO V47.7 (concept_id 45604711). Target subsumes the source: every
        person-on-outside traffic-accident victim is a victim of a vehicular/traffic accident; the
        activity dimension is dropped as administrative metadata. high: Athena-verified crosswalk,
        well-understood one-level breadth (activity context not represented in SNOMED CT).
        """
}
mapping "V4771.1" source="V4771" target="36198007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4771 = Swedish extension of WHO V47.7 (person on outside of vehicle, traffic accident,
        collision with stationary object) + activity suffix SNOMED CT 36198007 = lek och annan
        fritidsverksamhet (play/leisure). Activity digit has no SNOMED CT analogue. Target SNOMED CT 444074
        (36198007) =, the Athena crosswalk target for WHO V47.7 (45604711). Broader: target subsumes
        source; activity context dropped. : crosswalk-verified, one-level breadth.
        """
}
mapping "V4772.1" source="V4772" target="36198007" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4772 = Swedish extension of WHO V47.7 (person on outside of vehicle, traffic accident,
        collision with stationary object) + activity suffix SNOMED CT 36198007 = förvärvsarbete (paid
        work). Activity digit has no SNOMED CT analogue. Target SNOMED CT 444074 (36198007) =, Athena
        crosswalk for WHO V47.7 (45604711). Broader: target subsumes source; work-context dropped. :
        crosswalk-verified.
        """
}
