// ICD-10-SE extension codes to SNOMED CT mappings, codes W14-W145
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W140.1" source="W140" target="82947003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W140 = Swedish extension SNOMED CT 82947003 (Fall from tree - home and residential area).
        Parent W14 maps to SNOMED CT 4307686 via Athena crosswalk (45571087→4307686). The Swedish suffix
        only adds place context; the clinical external-cause concept is identical. Treated as
        exact_match.
        """
}
mapping "W1400.1" source="W1400" target="82947003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1400 = Swedish national extension of W14 (Fall from tree), home/residential area, during
        sport/exercise. Target SNOMED CT 4307686 = SNOMED CT 82947003, standard OMOP concept parent W14 maps
        to via Athena crosswalk (45571087→4307686). Broader (one level), confidence.
        """
}
