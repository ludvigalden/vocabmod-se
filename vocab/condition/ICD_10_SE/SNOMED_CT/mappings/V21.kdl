// ICD-10-SE extension codes to SNOMED CT mappings, codes V21
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2100.1" source="V2100" target="10298002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2100 (Swedish extension of WHO V21.0) = motorcycle driver injured in non-traffic
        collision with pedal cycle (bicycle) while engaged in sport. WHO V21.0 (concept 45585379) Athena
        crosswalk Maps-to SNOMED CT 438310 (Victim, motorcycle rider in vehicular AND/OR traffic accident,
        10298002). Target name includes AND/OR traffic so it covers non-traffic per the crosswalk.
        Activity digit is administrative; target subsumes source, broader.
        """
}
