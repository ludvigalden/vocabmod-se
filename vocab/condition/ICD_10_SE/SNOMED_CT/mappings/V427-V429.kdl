// ICD-10-SE extension codes to SNOMED CT mappings, codes V427-V429
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4270.1" source="V4270" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4270 is a Swedish extension of ICD-10 V42.7 (person on outside of vehicle injured in
        traffic collision with 2/3-wheeled motor vehicle) adding SNOMED CT 274913009 36198007. Parent V42.7
        (Athena 45580575) crosswalks to SNOMED CT 433930 (Motor vehicle on road in collision with another
        motor vehicle, 274913009) and 444074 (Victim of vehicular AND/OR traffic accident, 36198007).
        The Swedish activity suffix has no SNOMED CT analogue. 433930 is the specific traffic-collision
        target (broader); 444074 is the broader fallback.
        """
}
mapping "V4270.2" source="V4270" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
