// ICD-10-SE extension codes to SNOMED CT mappings, codes V71-V716
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7100.1" source="V7100" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V71.00 = Swedish extension of V71.0 SNOMED CT 214640008 36198007 + activity. Base V71.0
        (Athena 45755991) maps to SNOMED CT 437738 (Motor vehicle accident off public road) + 444074
        (Victim of vehicular AND/OR traffic accident). Targets are broader: they capture the nontraffic
        motor-vehicle accident event but lose bus-vs-pedal-cycle specificity, driver role, and activity
        context. : mechanical crosswalk from base code, Swedish activity dimension not represented.
        """
}
