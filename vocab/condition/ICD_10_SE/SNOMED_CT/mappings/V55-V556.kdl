// ICD-10-SE extension codes to SNOMED CT mappings, codes V55-V556
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5500.1" source="V5500" target="214878007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5500 (Swedish extension) = SNOMED CT 214878007: driver of pick-up truck/van in nontraffic
        collision with railway train, during sport. SE extension of WHO V55.0 with activity digit
        (sport). Target =; this is the Athena Maps to target for WHO V55.2 (45546894→4061041) and V55.3
        (45566039→4061041), and is the closest standard concept for V55.0/V55.1 (which have no direct
        Athena map). Broader: target fully contains the nontraffic train-collision event; sport-activity
        context is dropped metadata. Low tier : best target with verified Athena precedent on sibling
        codes V55.2/V55.3, but no direct WHO crosswalk for the SE code or for V55.0 itself.
        """
}
