// ICD-10-SE extension codes to SNOMED CT mappings, codes X136-X13
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X136.1" source="X136" target="218130004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X136 = SNOMED CT 218130004 (Swedish national extension). Base X13 Athena-crosswalks to
        SNOMED CT 439987 (concept_code 218130004) via ICD10 relationship 45756372 -> 439987. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X13, one-level broader (Swedish
        qualifier dropped).
        """
}
