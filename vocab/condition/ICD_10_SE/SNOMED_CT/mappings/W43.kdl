// ICD-10-SE extension codes to SNOMED CT mappings, codes W43
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W430.1" source="W430" target="45477008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W430 SNOMED CT 45477008 is a Swedish-SE extension subclassifying W43 (Exposure to vibration)
        by place (residential). Target SNOMED CT 443940 = (concept_code 45477008). The Athena ICD10
        crosswalk maps parent W43 (concept_id 45756296) to via a verified edge. The Swedish place
        qualifier has no separate SNOMED CT standard target; the parent target fully subsumes the source.
        broader: target totally contains the source. Confidence (high): verified parent crosswalk,
        one-level-broader on a Swedish extension.
        """
}
