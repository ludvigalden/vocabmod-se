// ICD-10-SE extension codes to SNOMED CT mappings, codes Y145-Y14
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y145.1" source="Y145" target="418098005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y145 SNOMED CT 418098005 = a Swedish ICD-10-SE national extension that subdivides Y14
        (Athena ICD10 concept 45756479) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4167568 = (sctid 418098005), the verified Athena crosswalk target for
        Y14 (ICD10 relationship 45756479 -> 4167568). Why this target: it is the authoritative standard
        concept the parent Y14 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
