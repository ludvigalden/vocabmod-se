        """
}
mapping "C440W.1" source="C440W" target="94032008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440W SNOMED CT 94032008 = other malignant tumors of skin of lip (residual bucket excluding
        BCC/SCC). Target SNOMED CT 136915 (94032008) = Primary malignant neoplasm of skin of lip — the
        Athena target for ICD10 C44.0. Target legitimately subsumes the source because the residual
