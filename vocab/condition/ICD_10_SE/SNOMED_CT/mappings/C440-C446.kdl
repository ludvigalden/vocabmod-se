// ICD-10-SE extension codes to SNOMED CT mappings, codes C440-C446
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C440B.1" source="C440B" target="402819001" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440B SNOMED CT 402819001 = superficial growing basal cell carcinoma of lip skin (Swedish
        subtype of C44.0). Target 4298740 (Basal cell carcinoma of skin of lip) is the most specific
        SNOMED CT concept covering both site (lip skin) and tumör type (BCC); it subsumes the source but
        loses the superficial-growth morphology subtype. High tier: small, well-understood breadth
        mismatch with a defensible standard concept.
        """
}
mapping "C440C.1" source="C440C" target="402819001" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440C SNOMED CT 402819001 = morphoeic (sclerosing/infiltrative) basal cell carcinoma of lip
        skin (Swedish subtype of C44.0). Target 4298740 (Basal cell carcinoma of skin of lip) is the
        most specific SNOMED CT concept covering both site and tumör type; it subsumes the source but loses
        the morphoeic subtype. No morphoeic-BCC SNOMED CT concept exists in the mirror. High tier: small,
        well-understood breadth mismatch.
        """
}
mapping "C440D.1" source="C440D" target="402819001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440D SNOMED CT 402819001 = other basal cell carcinoma of skin of lip. Target SNOMED CT 4298740
        (concept_code 402819001) = Basal cell carcinoma of skin of lip. Site and histology match
        exactly; just distinguishes from superficial/morpheaform subtypes, which the standard SNOMED CT
        concept does not separate. Standard_concept=S, Athena mirror.
        """
}
mapping "C440E.1" source="C440E" target="402819001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440E SNOMED CT 402819001 = unspecified basal cell carcinoma of skin of lip. Target SNOMED CT
        4298740 (402819001) = Basal cell carcinoma of skin of lip. Site+histology match; has no separate
        SNOMED CT concept — the site-specific BCC concept is the correct standard target.
        Standard_concept=S, Athena mirror.
        """
}
mapping "C440S.1" source="C440S" target="255071008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C440S SNOMED CT 255071008 = squamous cell carcinoma of skin of lip. Target SNOMED CT 4113108
