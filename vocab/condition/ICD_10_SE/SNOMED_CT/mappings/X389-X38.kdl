// ICD-10-SE extension codes to SNOMED CT mappings, codes X389-X38
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X389.1" source="X389" target="242555000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X389 = SNOMED CT 242555000 (Swedish national extension). Base X38 Athena-crosswalks to
        SNOMED CT 434828 (concept_code 242555000) via ICD10 relationship 45551940 -> 434828. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X38, one-level broader (Swedish
        qualifier dropped).
        """
}
