// ICD-10-SE extension codes to SNOMED CT mappings, codes V676-V67
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6760.1" source="V6760" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6760 is the Swedish 7-char extension of ICD-10 V67.6 (45570952, SNOMED CT 214031005) with
        5th digit = (sport/exercise). Target SNOMED CT 437165 = (214031005), the most traffic-specific
        SNOMED CT target from the V67.6 Athena crosswalk (436292, 437165, 444074). mapping_type=broader:
        the SNOMED CT target fully captures the traffic accident; the passenger role and activity-context
        dimensions are dropped. Confidence (moderate): verified Athena crosswalk on the base code,
        Swedish extension not independently re-verified.
        """
}
mapping "V6761.1" source="V6761" target="217897003" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6761 is the Swedish 6th-digit extension of V67.6 (occupant of heavy transport vehicle,
        passenger, injured in traffic accident in collision with fixed/stationary object), adding the
        activity dimension SNOMED CT 214031005 217897003 36198007 (play and other leisure). No SNOMED CT
        standard concept captures the activity dimension; targets inherit from the V67.6 Athena
        crosswalk (45570952 Maps to 436292/437165/444074). Primary target 436292 (217897003, standard
        Observation/Event) denotes the collision mechanism, broader than source (subsumes collision
        aspect; drops vehicle type, occupant role, traffic status, activity). Alternate 437165
        (214031005) is broader (captures traffic-accident context; loses collision-with-fixed-object
        specificity). Alternate 444074 (36198007) is broader (victim-status concept, loosest). primary:
        crosswalk-verified at parent V67.6, activity suffix not independently re-verified (mechanical
        inheritance, unspecified source dimension).
        """
}
mapping "V6761.2" source="V6761" target="214031005" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
