// ICD-10-SE extension codes to SNOMED CT mappings, codes V757-V75
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7570.1" source="V7570" target="242090001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7570 = Swedish SE extension subdividing WHO V75.7 (bus occupant/train collision, person
        on outside of vehicle injured in traffic accident) by activity = idrott/sport/motion. Target
        SNOMED CT 4054296 = SNOMED CT 242090001, the verified Athena crosswalk target of parent WHO V75.7
        (ICD10 concept_id 45756034). Target captures the clinical event; broader by omitting the
        activity dimension. High.
        """
}
mapping "V7571.1" source="V7571" target="242090001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7571 = Swedish SE extension subdividing WHO V75.7 (bus/train collision, person on
        outside traffic accident) by activity = lek och annan fritidsverksamhet. Target SNOMED CT 4054296 =
        SNOMED CT 242090001, parent V75.7 crosswalk target. Broader by omission of activity; high.
        """
}
