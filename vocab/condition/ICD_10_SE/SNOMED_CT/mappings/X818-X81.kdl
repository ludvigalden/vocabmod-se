// ICD-10-SE extension codes to SNOMED CT mappings, codes X818-X81
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X818.1" source="X818" target="248062006" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 248062006 [GPS] [IPS] [ICNP]"
}
mapping "X8180.1" source="X8180" target="82313006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X8180 = Swedish ICD-10-SE national extension of X81 SNOMED CT 82313006 (Athena ICD10 concept
        45547154), refined by Swedish external-cause metadata: place=annan specificerad plats / andra
        specificerade platser (other specified place); activity=idrott, sport, motion (sport, exercise).
        The clinical event/exposure is unchanged; the Swedish place/activity qualifiers are
        external-cause metadata with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT
        4219484 = sctid 82313006. Why this target: Athena ICD10 crosswalk maps base X81 (concept_id
        45547154) -> 4219484 (relationship 45547154, 4219484); it is the authoritative standard concept
        for X81 and fully subsumes every place/activity-specific SE subdivision. mapping_type=broader
        (target fully contains every clinical meaning of the source; the dropped qualifier is
        breadth-neutral external-cause metadata, not a partial slice). Confidence (high): verified
        Athena crosswalk on the base code with a small, well-understood one-level breadth mismatch (the
        SE place/activity refinement is lost). Athena-local research only.
        """
}
