// ICD-10-SE extension codes to SNOMED CT mappings, codes V82-V824
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8200.1" source="V8200" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8200 = Swedish extension of V82.0 (streetcar occupant injured in collision with motor
        vehicle in nontraffic accident) with activity SNOMED CT 214640008. WHO V82.0 (45756070) maps to
        SNOMED CT 437738 (Motor vehicle accident off public road, 214640008). Broader: target subsumes
        source but loses streetcar-occupant specificity and the activity facet. Low tier: single
        crosswalk target but the SNOMED CT concept is more generic than the source (drops
        streetcar-vs-motor-vehicle detail).
        """
}
