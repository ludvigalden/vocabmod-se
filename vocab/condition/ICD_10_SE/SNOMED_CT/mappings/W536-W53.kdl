// ICD-10-SE extension codes to SNOMED CT mappings, codes W536-W53
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W536.1" source="W536" target="217698005" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W536 = SNOMED CT 217698005 (Bitten by rat - industrial area/construction site). Swedish
        4th-digit ICD-10 extension adding location to parent W53. Target SNOMED CT 438304 = (217698005).
        The [X] SNOMED CT concept 40417315 maps directly to 438304 via Athena crosswalk. Broader: drops
        location only. Moderate confidence: crosswalk-verified, single level broader.
        """
}
