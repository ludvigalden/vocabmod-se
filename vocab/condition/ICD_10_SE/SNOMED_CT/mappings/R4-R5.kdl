// ICD-10-SE extension codes to SNOMED CT mappings, codes R4-R5
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "R418A.1" source="R418A" target="110352000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source R418A SNOMED CT 110352000 = mild cognitive impairment, subjective (patient-reported). Target
        SNOMED CT 439795 (concept_code 110352000), standard Clinical Finding. The target subsumes the
        source; qualifier is not separately represented in SNOMED CT. High tier: closest standard concept,
        one-level broader.
        """
}
mapping "R418W.1" source="R418W" target="384821006" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source R418W SNOMED CT 384821006 = other and unspecified symptoms and signs involving cognitive
        function and awareness (Swedish extension of ICD-10 R41.8). Target SNOMED CT 4293175 (concept_code
        384821006), standard Observation. This is the Athena crosswalk target for ICD-10 R41.8; the
        target is a broad parent that subsumes the source. Low confidence because the target is very
        broad and the source is a residual category.
        """
}
