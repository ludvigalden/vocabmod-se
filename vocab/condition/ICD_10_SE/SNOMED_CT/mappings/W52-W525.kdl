// ICD-10-SE extension codes to SNOMED CT mappings, codes W52-W525
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W520.1" source="W520" target="220876002" relationship=equivalent {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W520 SNOMED CT 220876002 = Crushed/pushed/stepped on by crowd, home and home area (ICD-10
        W52.0 equivalent). Target SNOMED CT 40421856 (220876002) = [X]Crushed, pushed or stepped on by
        crowd or human stampede, occurrence at home. SNOMED CT [X] concept is the standard representation
        of ICD-10 W52.0; Swedish W520 is its national equivalent. High tier: exact concept match without
        independent crosswalk.
        """
}
mapping "W5200.1" source="W5200" target="220876002" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W5200 SNOMED CT 220876002 = Crushed by crowd, home area, sports. Target SNOMED CT 40421856
        (220876002) = home-occurrence crowd/stampede event. Broader: activity dimension dropped. High
        tier.
        """
}
mapping "W5201.1" source="W5201" target="220876002" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W5201 SNOMED CT 220876002 = Crushed by crowd, home area, leisure. Target SNOMED CT 40421856
        (220876002). Broader: activity dropped. High tier.
        """
}
mapping "W5202.1" source="W5202" target="220876002" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W5202 SNOMED CT 220876002 = Crushed by crowd, home area, paid work. Target SNOMED CT 40421856
        (220876002). Broader: activity dropped. High tier.
        """
}
mapping "W5203.1" source="W5203" target="54719000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5203 SNOMED CT 54719000 = crushed/pushed/stepped on by crowd at home, other activity.
        Parent W52 in ICD-10 mirror (concept_id 45756303) has a verified Athena crosswalk to SNOMED CT
        4184610 (Exposure to human stampede, code 54719000). The 4th-5th char codes are Swedish
        extensions that add place-of-occurrence and activity dimensions; the standard SNOMED CT target
        4184610 fully subsumes them. The place-qualified SNOMED CT children (e.g. 40421856) are
        [X]-prefixed = non-standard and cannot be targets. High tier : crosswalk-verified parent,
        one-level broader, no narrower standard exists.
        """
}
mapping "W5204.1" source="W5204" target="54719000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5204 = crushed/pushed/stepped on by crowd at home, vital activity
        (rest/sleep/meal/personal hygiene). Parent W52 crosswalks via Athena to SNOMED CT 4184610 (Exposure
        to human stampede). Swedish extension adds place+activity; target 4184610 fully subsumes.
        Place-qualified SNOMED CT children are [X] non-standard. High tier : crosswalk-verified parent,
        one-level broader.
        """
}
mapping "W5208.1" source="W5208" target="54719000" relationship=source_is_narrower_than_target {
