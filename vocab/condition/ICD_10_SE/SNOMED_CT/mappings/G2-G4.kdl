// ICD-10-SE extension codes to SNOMED CT mappings, codes G2-G4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "G2000.1" source="G2000" target="49049000" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source G2000 is a Swedish fifth-character extension of ICD-10 G20 (Parkinson's disease); the.00
        suffix is a primary-diagnosis/site marker with no independent clinical meaning. Base G20 maps
        via Athena to SNOMED CT 381270 (49049000). Exact equivalence at the clinical-concept level.
        """
}
mapping "G2000.2" source="G2000" target="49049000" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "G2009.1" source="G2009" target="49049000" relationship=equivalent {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source G2009 is a Swedish fifth-character extension of ICD-10 G20 (Parkinson's disease).09 is a
        site specifier preserved as a custom code with no independent clinical meaning. Base G20 Athena
        crosswalk target SNOMED CT 381270 (49049000). Exact equivalence at the clinical-concept level.
        """
}
mapping "G2009.2" source="G2009" target="49049000" relationship=equivalent preference=alternative {
