// ICD-10-SE extension codes to SNOMED CT mappings, codes M00-M05
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M000B.1" source="M000B" target="428437005" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M000B SNOMED CT 111820003 428437005 = staphylococcal septic arthritis of shoulder (Swedish
        subcode of M00.0). Target 4180873 (428437005) = — the Athena crosswalk target for M00.01 (Staph
        arthritis, shoulder). Target 4009329 (111820003) = — the organism-specific SNOMED CT concept
        (crosswalk target for M00.0 parent); broader because it drops the shoulder site. Multi-target:
        site-specific (exact for location) + organism-specific (broader, loses site).
        """
}
mapping "M000B.2" source="M000B" target="111820003" relationship=equivalent {
