// ICD-10-SE extension codes to SNOMED CT mappings, codes C5-D1
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C529.1" source="C529" target="372025005" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C529 SNOMED CT 372025005 = malignant neoplasm of vagina (Swedish uses C529 for the WHO C52
        code). Target 196048 = Primary malignant neoplasm of vagina, the athena Maps-to target for WHO
        C52. Exact equivalence on the clinical concept, crosswalk-verified. High-tier exact_match per
        athena crosswalk (Swedish C529 encodes WHO C52 with the same scope).
        """
}
