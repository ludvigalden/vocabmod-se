// ICD-10-SE extension codes to SNOMED CT mappings, codes W05-W055
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W050.1" source="W050" target="17886000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 17886000 [GPS]"
}
mapping "W0500.1" source="W0500" target="17886000" relationship=equivalent effect=omitted quality=40 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0500 = Swedish extension of W05 SNOMED CT 17886000 adding home/residential place +
        sport/activity. Target =, Athena crosswalk target for base W05. Administrative place/activity
        detail not in SNOMED CT; clinical event fully captured. high: crosswalk-verified base, dropped
        administrative specificity.
        """
}
