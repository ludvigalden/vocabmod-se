// ICD-10-SE extension codes to SNOMED CT mappings, codes L3-L4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L304A.1" source="L304A" target="58759008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L304A SNOMED CT 58759008 = intertriginous erythema, Swedish subcode of L30.4 Erythema
        intertrigo. Target SNOMED CT 4242574 (concept_code 58759008), standard_concept=S; this is the
        Athena Maps to target for ICD-10 L30.4 (concept_id 45601221). The source is a synonym-level
        description of the same clinical picture; the target is the standard Intertrigo disorder that
        subsumes it. High tier: parent-code crosswalk, one-level broader.
        """
}
