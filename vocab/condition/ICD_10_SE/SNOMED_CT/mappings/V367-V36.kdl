    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3670.1" source="V3670" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3670 = Swedish 5-char extension of ICD-10 V36.7 (person on outside of three-wheeled
        motor vehicle injured in traffic collision with nonmotor vehicle) with activity suffix SNOMED CT
        271579008 36198007. Targets 444074 and 4152175 are the Athena Maps to for V36.7 base. Activity
        suffix has no SNOMED CT representation; targets subsume the source (broader). Moderate tier.
        """
}
