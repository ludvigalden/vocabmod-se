// ICD-10-SE extension codes to SNOMED CT mappings, codes V76-V766
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7600.1" source="V7600" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7600 is a Swedish ICD-10 SE extension of parent V76.0 (bus occupant injured in collision
        with other nonmotor vehicle, driver, nontraffic accident) that adds an activity qualifier
        (SNOMED CT 214640008). Target SNOMED CT 437738 =. The activity qualifier has no SNOMED CT representation;
        the target captures the off-public-road accident event via the parent V76.0 Athena crosswalk.
        broader: target subsumes the source (source is a more specific instance with activity context
        the target lacks). Moderate tier : mechanical crosswalk via parent V76.0 code, SE extension not
        independently re-verified in SNOMED CT browser.
        """
}
