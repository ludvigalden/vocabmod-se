// ICD-10-SE extension codes to SNOMED CT mappings, codes V825-V829
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8250.1" source="V8250" target="213770003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Swedish source = SNOMED CT 213770003 36198007 = streetcar occupant injured by fall in streetcar
        (base ICD-10 V82.5, Athena concept 45756140). 5th-char Swedish activity-context extension has no
        OMOP/SNOMED CT representation. Primary SNOMED CT 440896 =; secondary 444074 =. Mapping rationale: the
        Swedish 5th-character activity suffix (idrott/lek/arbete/etc.) is a national-extension dimension
        with no SNOMED CT or OMOP analogue; the clinical accident content is fully captured by the base V82.X
        SNOMED CT target(s), so each SNOMED CT target subsumes the clinical meaning of the source (broader).
        Confidence (high): one-level breadth mismatch with a verified Athena crosswalk on the base
        ICD-10 V82.X parent.
        """
}
mapping "V8250.2" source="V8250" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
