// ICD-10-SE extension codes to SNOMED CT mappings, codes W056-W05
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W056.1" source="W056" target="17886000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W056 SNOMED CT 17886000 is the Swedish extension adding place (industrial/construction site)
        to W05. Target (Fall from wheelchair) is the standard concept for the parent W05. The target
        subsumes the source (place is not a SNOMED CT axis here). Broader, exact crosswalk on parent,
        near-exact semantic match; tier held to (exact-equivalent of the parent) since the place
        modifier does not change the clinical concept.
        """
}
mapping "W0560.1" source="W0560" target="17886000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0560 SNOMED CT 17886000 is a Swedish subdivision of W05 by place (industrial site) and
        activity (sport). Target (Fall from wheelchair) subsumes W05 and all subdivisions. Broader, high
        confidence via parent crosswalk.
        """
}
mapping "W0561.1" source="W0561" target="17886000" relationship=source_is_narrower_than_target {
