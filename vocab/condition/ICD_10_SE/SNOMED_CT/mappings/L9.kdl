// ICD-10-SE extension codes to SNOMED CT mappings, codes L9
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L908A.1" source="L908A" target="201080009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908A SNOMED CT 201080009 = senile atrophy of the skin. Target SNOMED CT 40396866 (201080009) =
        Atrophia cutis senilis. Exact 1:1 clinical and lexical equivalence; identical Latin name.
        """
}
mapping "L908B.1" source="L908B" target="238828009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908B SNOMED CT 238828009 = atrophia maculosa varioliformis cutis, historically a synonym
        for anetoderma (macular atrophy of the skin). Target SNOMED CT 4032902 (238828009) = Anetoderma,
        the modern clinical concept. The source is the older Latin descriptor for what SNOMED CT calls
        anetoderma; the equivalence is close but the source terminology is historical, so
        broader/moderate is safer than asserting full 1:1 identity (the source may also refer to the
        perifollicular variant).
        """
}
mapping "L908C.1" source="L908C" target="201081008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908C SNOMED CT 201081008 (Atrophoderma neuriticum) = atrophoderma neuriticum. Target SNOMED CT
        40396868 (201081008) = Atrophoderma neuriticum. Exact 1:1 clinical and lexical equivalence;
        identical fully-specified name.
        """
}
mapping "L908D.1" source="L908D" target="238844000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908D SNOMED CT 238844000 = Gowers panatrophy (an eponymous localized panatrophy of the
        skin). Target SNOMED CT 4033366 (238844000) = Gower's panatrophy. Exact 1:1 clinical equivalence
        via eponymous match.
        """
}
mapping "L908E.1" source="L908E" target="32274008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908E SNOMED CT 32274008 = stellate and discoid pseudoscars of Colomb, a combined source
        bundling both stellate pseudoscar and discoid pseudoscar (an eponymous variant). No single
        SNOMED CT concept covers both. Best single target is SNOMED CT 4138260 (32274008) Stellate spontaneous
        pseudoscars, which captures the stellate axis; the discoid axis has no SNOMED CT equivalent.
        Broader with low confidence because the source bundles two clinical patterns and the target
        subsumes only one.
        """
}
mapping "L908W.1" source="L908W" target="400190005" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L908W SNOMED CT 400190005 = ICD-10 L90.8, a residual bucket of specified atrophic skin
        disorders. Target SNOMED CT 134118 = (concept_code 400190005). Athena crosswalk maps L90.8
        (45538603) to 134118. The target is the general parent atrophic condition; the source is a
        heterogeneous residual, so target legitimately subsumes source. High tier: crosswalk-verified
        one-level broader.
        """
}
