// ICD-10-SE extension codes to SNOMED CT mappings, codes C43
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C430B.1" source="C430B" target="403924008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "C430C.1" source="C430C" target="402556000" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "C430D.1" source="C430D" target="93640008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C430D SNOMED CT 93640008 = nodular malignant melanoma of lip (Swedish 5-char extension
        combining site=C43.0 lip + histology=nodular). No single SNOMED CT concept combines lip site with
        nodular histology. Two equally defensible broader parents exist: SNOMED CT 140048 (Malignant
        melanoma of skin of lip, 93640008, S) covers the site axis, and SNOMED CT 4112760 (Nodular
        malignant melanoma of skin, 254731001, S) covers the histology axis. Site-axis target chosen as
        primary broader map (Athena crosswalk resolves WHO C43.0 → 4089860; 140048 is the
        closely-equivalent site concept). Moderate tier: best-available standard concept for an
        unspecified-source extension code, two-level semantic loss.
        """
}
mapping "C430F.1" source="C430F" target="93640008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C430F SNOMED CT 93640008 = superficial spreading malignant melanoma of lip (Swedish
        extension combining lip site + superficial-spreading histology). No single SNOMED CT concept
        combines lip site with superficial-spreading histology. Broader parent SNOMED CT 140048 (93640008,
        standard_concept=S) covers the site axis fully; the histology axis is lost. The WHO C43.0 Athena
        crosswalk target is 4089860 (Malignant melanoma of lip, 188030005); 140048 is the
        site-equivalent standard concept. Moderate tier: best-available standard for an extension code
        with semantic loss.
        """
}
