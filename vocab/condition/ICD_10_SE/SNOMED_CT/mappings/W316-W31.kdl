// ICD-10-SE extension codes to SNOMED CT mappings, codes W316-W31
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W316.1" source="W316" target="15185003" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W316 = Swedish 4-char extension of W31 specifying place=SNOMED CT 15185003 (industrial area,
        construction site). Base ICD-10 W31 (45756284) Athena-maps to SNOMED CT 4035493 (15185003). No
        SNOMED CT standard concept distinguishes machinery contact on industrial/construction sites from
        generic contact. Target fully subsumes source (broader); the place axis is dropped. Confidence
        (moderate): crosswalk-verified, one specificity level dropped (place only, no activity subcode).
        """
}
mapping "W3160.1" source="W3160" target="15185003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3160 = Swedish extension of W31 with place=SNOMED CT 15185003 and activity=
        (sport/athletics/exercise). No SNOMED CT standard captures machinery-contact in
        industrial/construction setting during sport. Base W31 Athena-maps to SNOMED CT 4035493. Broader;
        due to dropped place+activity axes.
        """
}
