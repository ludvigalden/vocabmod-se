mapping "M119B.1" source="M119B" target="34427002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M119B SNOMED CT 34427002 = crystal arthropathy, unspecified, shoulder region. Swedish B =
        axelled (shoulder). Target SNOMED CT 74445 (34427002). Site and disorder match exactly; Athena
        M11.91 crosswalk also maps to 74445. High tier (not) because source is UNS/unspecified and the
        Swedish body-site suffix is a national extension not independently re-verified against the
        SNOMED CT hierarchy.
        """
}
mapping "M119C.1" source="M119C" target="428768008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M119C SNOMED CT 428768008 = crystal arthropathy, unspecified, of elbow. Swedish C =
        armbågsled (elbow). Target SNOMED CT 73550 (428768008). Disorder and site match exactly. ICD-10-CM
        has no M11.9-elbow code, so no Athena crosswalk for this site; SNOMED CT browser confirms 428768008
        active under 18834007 (Crystal arthropathy). High tier (not) because source is UNS and mapping
        relies on direct SNOMED CT lookup, not an Athena crosswalk.
        """
}
mapping "M119D.1" source="M119D" target="26241001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M119D SNOMED CT 26241001 = crystal arthropathy, unspecified, of wrist/hand. Swedish D
        combines wrist and hand. Target SNOMED CT 76500 (26241001); Athena M11.94 (hand) crosswalk maps to
        76500. The source also includes wrist, which has a separate SNOMED CT concept (435038); 76500
        covers the hand component but not the wrist, so this is broader rather than exact. Moderate-high
        tier: UNS source plus combined wrist/hand site not perfectly resolved by a single SNOMED CT target.
        """
}
mapping "M119F.1" source="M119F" target="428027008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M119F SNOMED CT 428027008 = crystal arthropathy, unspecified, of hip. Swedish F = höftled
        (hip). Target SNOMED CT 77953 (428027008). Disorder and site match exactly. No ICD-10-CM M11.9-hip
        code in Athena (the x5 is broader); SNOMED CT browser confirms 428027008 active. High tier (not)
        because source is UNS and no Athena crosswalk for this exact site.
        """
}
