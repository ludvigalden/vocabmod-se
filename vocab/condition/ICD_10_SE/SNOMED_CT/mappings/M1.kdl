mapping "M192D.1" source="M192D" target="201852006" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M192D SNOMED CT 201852006 = other secondary osteoarthritis of wrist/hand (Swedish 6th-char D
        = hand/wrist). Target SNOMED CT 79904 (201852006) = Localized, secondary osteoarthritis of the
        hand. Athena crosswalk from base ICD-10 M19.24 (Other secondary arthrosis, hand) maps to this
        exact concept. Swedish code is the side-agnostic equivalent of M19.24. Confidence :
        crosswalk-verified exact clinical match, but Swedish extension code not independently
        re-verified against M19.24's full scope.
        """
}
mapping "M192H.1" source="M192H" target="201855008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M192H SNOMED CT 201855008 = other secondary osteoarthritis of ankle/foot (Swedish 6th-char H
        = ankle/foot). Target SNOMED CT 80183 (201855008) = Localized, secondary osteoarthritis of the
        ankle and/or foot. Athena crosswalk from base ICD-10 M19.27 (Other secondary arthrosis, ankle
        and foot) does not directly map to 80183 but to 80494 (Arthropathy associated with another
        disorder) and 40482662 (Disorder of joint of ankle and/or foot). 80183 is the more clinically
        precise standard concept matching the source semantics. Confidence : exact clinical match,
        Athena hierarchy confirms the concept exists and is the right specificity.
        """
}
