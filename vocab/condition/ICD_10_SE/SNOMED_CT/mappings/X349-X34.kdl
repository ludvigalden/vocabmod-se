// ICD-10-SE extension codes to SNOMED CT mappings, codes X349-X34
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X3490.1" source="X3490" target="698720003" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X3490 = Swedish ICD-10-SE national extension of X34 SNOMED CT 698720003 (Athena ICD10
        concept 45575988), refined by Swedish external-cause metadata: place=plats, ospecificerad
        (unspecified place); activity=idrott, sport, motion (sport, exercise). The clinical
        event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause metadata
        with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 44784554 = sctid 698720003.
        Why this target: Athena ICD10 crosswalk maps base X34 (concept_id 45575988) -> 44784554
        (relationship 45575988, 44784554); it is the authoritative standard concept for X34 and fully
        subsumes every place/activity-specific SE subdivision. mapping_type=broader (target fully
        contains every clinical meaning of the source; the dropped qualifier is breadth-neutral
        external-cause metadata, not a partial slice). Confidence (high): verified Athena crosswalk on
        the base code with a small, well-understood one-level breadth mismatch (the SE place/activity
        refinement is lost). Athena-local research only.
        """
}
