// ICD-10-SE extension codes to SNOMED CT mappings, codes V855-V859
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8550.1" source="V8550" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8550 SNOMED CT 302977008 36198007 = Swedish ICD-10 SE extension of V85.5 (Förare av
        specialfordon skadad i transportolycka, ej trafik) adding an activity dimension
        (sport/leisure/work/vital activities/other/unspecified). No direct Athena crosswalk for the
        Swedish 6-character extension; inherits the crosswalk from the parent ICD-10 base code V85.5.
        Targets: SNOMED CT 444074; SNOMED CT 4119154. Both targets fully subsume the source (every case is a
        vehicular/traffic accident victim and a vehicle accident event); the activity context, vehicle
        position, and vehicle type are lost. broader mapping. Confidence (primary target) / (secondary):
        mechanical crosswalk from parent base code applied to Swedish extension, not independently
        re-verified; significant specificity loss (activity/position/vehicle-type dimensions dropped).
        """
}
mapping "V8550.2" source="V8550" target="302977008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
