// ICD-10-SE extension codes to SNOMED CT mappings, codes W07-W075
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W070.1" source="W070" target="83468000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        W070 = Swedish extension of W07 SNOMED CT 83468000. Parent W07 crosswalks to SNOMED CT 4308870 (Fall
        from chair, concept_code 83468000) via Athena relationship 45547041->4308870. Place qualifier is
        subsumed by parent. broader, one level.
        """
}
