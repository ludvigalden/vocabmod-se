// ICD-10-SE extension codes to SNOMED CT mappings, codes V467-V46
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4670.1" source="V4670" target="271579008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4670 = Swedish extension of ICD-10 V46.7: person on outside of car injured in collision
        with other nonmotor vehicle, traffic accident, during idrott/sport/motion. Activity digit
        dropped. Primary SNOMED CT 271579008 (4152175) = Motor vehicle on road in collision with nonmotor
        vehicle; Athena Maps-to for V46.7. Broader: drops outside-of-vehicle role and activity.
        Secondary SNOMED CT 36198007 (444074). primary, secondary.
        """
}
mapping "V4670.2" source="V4670" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
