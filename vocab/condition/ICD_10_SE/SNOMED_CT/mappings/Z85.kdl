// ICD-10-SE extension codes to SNOMED CT mappings, codes Z85
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Z850A.1" source="Z850A" target="315733009" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source Z850A = Swedish ICD-10-SE personal-history code: SNOMED CT 315733009. This is a /status code
        (i den egna sjukhistorien), not an active case. Target SNOMED CT 40523857 = sctid 315733009. Why
        this target: it is the body-system-level (or analogous history-of) SNOMED CT concept that the SE
        code's parenthesized ICD-10 chapter (e.g. C15-C26 digestive) maps to; it records the same
        history-of-cancer-by-system semantics. Why broader/ : the SE code is a more specific
        (single-organ) personal-history record subsumed by the system-level history-of concept — a
        verified SNOMED CT concept but a small breadth mismatch (organ specificity lost), so broader at.
        Athena-local research only.
        """
}
mapping "Z850B.1" source="Z850B" target="473061005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (exact_match): Source = personal history of malignant neoplasm of stomach
        (C16). Current 40523857 SNOMED CT 473061005 is broader (GI vs stomach) AND non-standard/deprecated.
        Better target 43021268 matches source exactly by name; demoted to as non-standard
        Context-dependent concept. Replaces broader current target.
        """
}
