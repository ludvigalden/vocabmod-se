// ICD-10-SE extension codes to SNOMED CT mappings, codes W03-W033
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W030.1" source="W030" target="242402009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W030 SNOMED CT 242402009 is a Swedish ICD-10-SE national extension that subdivides parent
        W03 (Other fall on same level due to collision with, or pushing by, another person) by location
        (bostad och bostadsområde (home/residential area)) and activity. Target = (OMOP concept id
        4053867), the Athena-verified target of parent W03. The SE code has no separate SNOMED CT
        crosswalk; the target fully subsumes the source's clinical meaning (fall on same level due to
        collision/pushing by another person) — the location/activity context added by the SE extension
        is administrative and absent from the target, so the target is broader. Confidence (high):
        one-level broader, parent W03 crosswalk verified in Athena local mirror (ICD10/relationships.tdl
        row 45756245 -> 4053867 Maps to).
        """
}
