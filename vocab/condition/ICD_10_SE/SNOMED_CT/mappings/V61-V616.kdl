// ICD-10-SE extension codes to SNOMED CT mappings, codes V61-V616
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6100.1" source="V6100" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6100 = Swedish extension of V61.0 (Occupant of heavy transport vehicle injured in
        collision with pedal cycle, driver injured in nontraffic accident) with activity suffix SNOMED CT
        214640008 (idrott, sport, motion / sport, exercise). Activity suffix is the Y93-style
        activity-at-injury axis and does not change the accident classification. Parent V61.0 (Athena
        45756662) has Athena crosswalk to (Motor vehicle accident off public road). Target broader (one
        level above the activity-extended source). Confidence high : verified Athena crosswalk on
        parent, one-level broader.
        """
}
