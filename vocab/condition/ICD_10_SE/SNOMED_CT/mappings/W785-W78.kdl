// ICD-10-SE extension codes to SNOMED CT mappings, codes W785-W78
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W785.1" source="W785" target="30227006" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (exact_match): SE code = inhalation of gastric contents (commerce). Target
        254163 SNOMED CT 30227006 is base W78 Athena Maps-to crosswalk; same clinical concept, place is
        circumstance. Crosswalk-verified 1:1.
        """
}
mapping "W7850.1" source="W7850" target="30227006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7850 = SNOMED CT 30227006 with Swedish place/activity qualifiers (Inhalation av maginnehåll
        - butiks-, handels- eller serviceområde - idrott, sport, motion). Base event W78
        Athena-crosswalks to SNOMED CT 254163 (30227006) via ICD10 relationship 45756324 -> 254163.
        Qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical analogue;
        injury event unchanged. Target subsumes the event -> broader. Confidence : verified crosswalk on
        base W78, one-level broader (qualifier dropped).
        """
}
