// ICD-10-SE extension codes to SNOMED CT mappings, codes W69-W695
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W690.1" source="W690" target="217748000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W690 = Swedish extension of W69 (drowning and submersion while in natural water):
        drowning in sea/lake/watercourse at home/residential area. Target SNOMED CT 436593 (217748000), the
        Athena Maps-to crosswalk target for parent W69. No standard SNOMED CT concept exists for
        natural-water drowning with place qualifiers (the [X]Drowning.while in natural water, occurrence
        at home = SNOMED CT 221034002 is a UK extension, non-standard). Target subsumes source: every W690
        case is an accidental drowning. Broader one level, high tier per rubric: crosswalk-verified
        parent, small breadth mismatch.
        """
}
mapping "W6900.1" source="W6900" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W6900 = Swedish W69 extension: drowning in sea/lake/watercourse at home/residential area,
        sport/exercise. Target SNOMED CT 436593. Target subsumes source; drops place+activity. No standard
        SNOMED CT combines natural water + place + activity. Broader one level, high tier.
        """
}
