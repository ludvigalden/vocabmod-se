// ICD-10-SE extension codes to SNOMED CT mappings, codes W506-W508
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W506.1" source="W506" target="243671000000109" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W506 SNOMED CT 220861005 242693000 243671000000109 = Swedish ICD-10-SE extension of W50
        (hit/struck/kicked/bitten/scratched by another person) crossed with location [industriområde,
        byggarbetsplats (industrial/construction)] and activity [activity axis]. Target SNOMED CT 44790611
        (243671000000109) = -- Athena Maps-to crosswalk from W50 base (ICD10 concept_id 45756301);
        captures the interpersonal-violence nature; broader because the Swedish code adds
        location+activity detail absent from the target. Target SNOMED CT 4055396 (242693000) = -- second
        Athena Maps-to target; broader still (any mechanical violence). Target SNOMED CT 40421840
        (220861005) = -- WHO ICD-10 location-axis cross-map mirrored in SNOMED CT; partial because it
        captures only the location axis and drops the activity axis. Confidence: 44790611 at (high) --
        crosswalk-verified and the only target that specifically captures interpersonal violence; one
        level broader. 4055396 at (moderate) -- crosswalk-verified but more general. 40421840 at (low)
        -- partial overlap (drops activity); ICD-10-derived [X] cross-map concept, not a native SNOMED CT
        clinical concept.
        """
}
mapping "W506.2" source="W506" target="242693000" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
