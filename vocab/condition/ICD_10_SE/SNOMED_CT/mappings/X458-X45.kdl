// ICD-10-SE extension codes to SNOMED CT mappings, codes X458-X45
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X458.1" source="X458" target="216633005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X458 = Swedish ICD-10-SE national extension of X45 SNOMED CT 216633005 (Athena ICD10 concept
        45756401), refined by Swedish external-cause place axis: annan specificerad plats / andra
        specificerade platser (other specified place); no specific activity axis (place-only code). The
        clinical event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause
        metadata with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 441465 = sctid
        216633005. Why this target: Athena ICD10 crosswalk maps base X45 (concept_id 45756401) -> 441465
        (relationship 45756401, 441465); it is the authoritative standard concept for X45 and fully
        subsumes every place/activity-specific SE subdivision. mapping_type=broader (target fully
        contains every clinical meaning of the source; the dropped qualifier is breadth-neutral
        external-cause metadata, not a partial slice). Confidence (high): verified Athena crosswalk on
        the base code with a small, well-understood one-level breadth mismatch (the SE place/activity
        refinement is lost). Athena-local research only.
        """
}
