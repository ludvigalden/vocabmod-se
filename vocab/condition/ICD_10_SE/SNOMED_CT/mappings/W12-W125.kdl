// ICD-10-SE extension codes to SNOMED CT mappings, codes W12-W125
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W120.1" source="W120" target="2617007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W120 SNOMED CT 2617007 = Swedish extension of ICD-10 W12 (Fall on and from scaffolding) with
        place = home/residential area. Target SNOMED CT 432804 (2617007), the standard concept that mirror
        ICD10 W12 maps to via crosswalk. Place specifier has no SNOMED CT event-level equivalent; target
        subsumes the injury-mechanism axis. One-level broader, verified crosswalk.
        """
}
