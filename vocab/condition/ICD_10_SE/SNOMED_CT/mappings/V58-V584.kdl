// ICD-10-SE extension codes to SNOMED CT mappings, codes V58-V584
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5800.1" source="V5800" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5800 = ICD-10-SE V58.0 (Occupant of pick-up truck or van injured in noncollision
        transport accident, driver injured in nontraffic accident) with Swedish 5th-char activity code
        SNOMED CT 214640008 36198007 = idrott, sport, motion (sports). Targets are the standard OMOP
        crosswalk for base V58.0 (Athena Maps to: 437738 214640008; 444074 36198007). The activity-code
        dimension and the pick-up/van + driver granularity have no SNOMED CT representation and are lost.
        Targets legitimately subsume the source (every V5800 case is a motor-vehicle accident off a
        public road). : verified crosswalk for the base code with a small breadth mismatch from the
        activity suffix.
        """
}
mapping "V5800.2" source="V5800" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
