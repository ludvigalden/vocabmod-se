// ICD-10-SE extension codes to SNOMED CT mappings, codes X6-X604
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X600.1" source="X600" target="271982007" relationship=source_is_narrower_than_target {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source X600 SNOMED CT 271982007 439011002 = a Swedish ICD-10-SE national extension that subdivides
        X60 (Athena ICD10 concept 45756440) by Swedish place/activity axes with no separate standard
        SNOMED CT analogue. Target SNOMED CT 4152376 = (sctid 271982007), the verified Athena crosswalk target
        for X60 (ICD10 relationship 45756440 -> 4152376). Why this target: it is the authoritative
        standard concept the parent X60 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
mapping "X600.2" source="X600" target="439011002" relationship=source_is_narrower_than_target preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
