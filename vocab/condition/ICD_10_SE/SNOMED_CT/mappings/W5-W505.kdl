// ICD-10-SE extension codes to SNOMED CT mappings, codes W5-W505
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W500.1" source="W500" target="242693000" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5000.1" source="W5000" target="243671000000109" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5000 = Swedish 5-char extension of ICD-10 W50 SNOMED CT 242693000 243671000000109, suffix
        (home/residential area, sport) adds place/activity context only. Primary target SNOMED CT 44790611
        = (243671000000109), an Athena target for base W50 — closest standard concept, fully subsumes
        source. Secondary target SNOMED CT 4055396 = (242693000), the other Athena for W50 — broader
        ancestor, still covers source. Both targets broader (Swedish suffix is environmental metadata).
        Primary high tier (one-level broader, verified crosswalk); secondary moderate (looser ancestor).
        """
}
