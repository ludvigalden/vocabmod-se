// ICD-10-SE extension codes to SNOMED CT mappings, codes V540-V546
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5400.1" source="V5400" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5400 = SE extension: driver of pick-up/van, nontraffic collision with heavy
        transport/bus, during sport. WHO V54.0 (driver nontraffic) Athena-crosswalks to SNOMED CT 437738
        (Motor vehicle accident off public road, 214640008, standard Event) and 444074 (Victim). 437738
        captures the off-public-road accident axis but loses vehicle-type (light+heavy truck) and the SE
        sport-activity dimension (no SNOMED CT standard). Broader; low confidence per §1.
        """
}
