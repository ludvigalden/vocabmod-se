// ICD-10-SE extension codes to SNOMED CT mappings, codes H3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "H312A.1" source="H312A" target="74469006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H312A SNOMED CT 74469006 = regional choroidal dystrophy (Swedish extension under H31.2
        Hereditary choroidal dystrophy). SNOMED CT has specific partial/regional concepts (435261
        193468002; 4108965 193470006) but no exact standard concept in the crosswalk. Target SNOMED CT
        441852 (74469006), the standard concept that H31.2 maps to via Athena crosswalk. broader (target
        subsumes the regional-specific source); low confidence — verified crosswalk to the parent, but
        the regional subclass specificity is lost and a more specific partial-dystrophy target may be a
        better fit.
        """
}
mapping "H312B.1" source="H312B" target="193472003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H312B SNOMED CT 193472003 = diffuse choroidal dystrophy (Swedish extension under H31.2).
        Target SNOMED CT 4102055 (193472003). The SNOMED CT concept denotes a total/diffuse choroidal
        dystrophy, fully subsuming the source's diffuse scope. broader (target is the standard bucket
        that subsumes the source); high confidence — well-understood subsumption, one level broader.
        """
}
mapping "H312C.1" source="H312C" target="74469006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H312C SNOMED CT 74469006 = general vascular dystrophy of choroid (Swedish extension under
        H31.2). This is a vascular-aetiology choroidal dystrophy concept with no obvious SNOMED CT
        equivalent in the crosswalk; the SNOMED CT choroidal-dystrophy concepts are
        anatomical/pattern-based, not vascular. Target SNOMED CT 441852 (74469006), the standard concept
        that H31.2 maps to via Athena crosswalk. broader (target subsumes the source); low confidence —
        verified crosswalk to the parent, but the vascular aetiology specificity is lost and the
        semantic overlap is partial.
        """
}
mapping "H312X.1" source="H312X" target="74469006" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H312X SNOMED CT 74469006 = unspecified choroidal dystrophy (Swedish extension under H31.2).
        Target SNOMED CT 441852 (74469006), the standard concept that H31.2 maps to via Athena crosswalk.
        The source denotes an unspecified hereditary choroidal dystrophy, which is exactly the meaning
        of the parent Hereditary choroidal dystrophy concept. exact_match; high confidence — verified
        crosswalk and exact scope match.
        """
}
mapping "H330A.1" source="H330A" target="3598000" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330A SNOMED CT 3598000 = partial retinal detachment with a round or oval hole (Swedish
        extension under H33.0 Retinal detachment with retinal break). Target SNOMED CT 376102 (3598000). A
        round/oval retinal hole is a single retinal defect/break; the SNOMED CT concept denotes partial RD
        with a single defect, matching the source's description. exact_match; high confidence — close
        semantic match on partial RD with single break.
        """
}
mapping "H330B.1" source="H330B" target="4178006" relationship=source_is_broader_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330B = partial retinal detachment with multiple round/oval holes. Target SNOMED CT 378413
        (concept_code 4178006) = Partial recent retinal detachment with multiple defects. The source
        specifies break morphology (round/oval holes) which the target does not capture, and the target
        adds SNOMED CT 4178006 which the source does not assert. Best available standard concept that
        captures; narrower because target adds recency. Low confidence per rubric §1: partial semantic
        overlap.
        """
}
mapping "H330C.1" source="H330C" target="3598000" relationship=source_is_broader_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330C = partial retinal detachment with a single horseshoe hole. Target SNOMED CT 376102
        (concept_code 3598000) = Partial recent retinal detachment with single defect. Source specifies
        horseshoe morphology; target only says SNOMED CT 3598000 and adds. Best available standard for
        single-defect partial RD; narrower due to recency and lost morphology.
        """
}
mapping "H330D.1" source="H330D" target="4178006" relationship=source_is_broader_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330D = partial retinal detachment with multiple horseshoe holes. Target SNOMED CT 378413
        (concept_code 4178006) = Partial recent retinal detachment with multiple defects. Target
        captures multi-defect partial RD but not horseshoe morphology, and adds SNOMED CT 4178006.
        Narrower; low confidence.
        """
}
mapping "H330E.1" source="H330E" target="712508005" relationship=source_is_broader_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330E = partial retinal detachment with oral dialysis (oradialys). Target SNOMED CT 46273181
        (concept_code 712508005) = Rhegmatogenous retinal detachment due to retinal dialysis. Target
        captures dialysis-specific RD precisely but asserts SNOMED CT 712508005 (which an oral dialysis is,
        by definition) and does not specify; it is more specific on mechanism and less specific on
        extent. Best dialysis-specific RD concept available; moderate confidence, narrower.
        """
}
mapping "H330F.1" source="H330F" target="19620000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330F = partial retinal detachment with equatorial break. No SNOMED CT concept for RD with
        equatorial break specifically. Target SNOMED CT 4055484 (concept_code 19620000) = Rhegmatogenous
        retinal detachment, the ICD-10 H33.0 crosswalk target (verified via ICD10 relationships.tdl).
        Broader parent fully subsumes the source; low confidence because specificity on extent (partial)
        and break location (equatorial) is lost.
        """
}
mapping "H330G.1" source="H330G" target="4178006" relationship=source_is_broader_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330G = partial retinal detachment with multiple holes of different types. Target SNOMED CT
        378413 (concept_code 4178006) = Partial recent retinal detachment with multiple defects.
        Captures the SNOMED CT 4178006 axis but not mixed morphology, and adds. Narrower; low confidence.
        """
}
mapping "H330H.1" source="H330H" target="19620000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source H330H = subtotal or total retinal detachment with hole. No single SNOMED CT concept for
        SNOMED CT 19620000 as a disjunctive group. Target SNOMED CT 4055484 (concept_code 19620000) =
        Rhegmatogenous retinal detachment (the H33.0 crosswalk target) fully subsumes both subtotal and
        total rhegmatogenous RD. Broader; low confidence due to lost extent specificity.
        """
}
mapping "H330X.1" source="H330X" target="19620000" relationship=source_is_narrower_than_target {
