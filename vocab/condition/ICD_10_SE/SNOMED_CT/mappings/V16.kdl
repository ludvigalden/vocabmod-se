// ICD-10-SE extension codes to SNOMED CT mappings, codes V16
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V1600.1" source="V1600" target="219525004" relationship=source_is_narrower_than_target quality=100 {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source V1600 = Swedish extension of V16.0 SNOMED CT 219525004, activity= (sport). Target (Athena
        40418753) =, standard concept. Target captures the full injury event (cyclist+other nonmotor
        vehicle+driver+nontraffic); the Swedish activity=sport modifier has no SNOMED CT representation and
        is auxiliary metadata. Broader: target subsumes the source. high: one-level broader, exact match
        on the V16.0 injury axis (Athena ICD10 45537153 -> 45756220 -> 442376 crosswalk points to the
        same V16 family).
        """
}
