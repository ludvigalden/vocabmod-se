mapping "W5268.1" source="W5268" target="220882004" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W5268 = Swedish 5-digit extension of ICD-10 W52 SNOMED CT 220882004 at
        industrial/construction area, activity. SNOMED CT target 40417302 ([X]Crushed, pushed or stepped on
        by crowd or human stampede, occurrence at industrial and construction area; concept_code
        220882004) is the place-level equivalent in the SNOMED CT [X] ICD-10 external-cause extension,
        which drops the activity dimension. Target subsumes the source (one-level broader). High tier:
        place name matches literally (industriområde/byggarbetsplats = industrial and construction
        area); activity is the only lost specificity.
        """
}
mapping "W5269.1" source="W5269" target="220882004" relationship=source_is_narrower_than_target {
