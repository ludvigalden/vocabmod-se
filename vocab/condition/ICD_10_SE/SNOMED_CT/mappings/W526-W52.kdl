// ICD-10-SE extension codes to SNOMED CT mappings, codes W526-W52
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W526.1" source="W526" target="54719000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W526 SNOMED CT 54719000 is a Swedish SE extension of ICD-10 W52 (industrial area,
        construction site). Target SNOMED CT 4184610 = Exposure to human stampede, crosswalk-verified for
        ICD-10 W52 (45756303 Maps to 4184610). Target fully subsumes the source; the location qualifier
        is administrative context, not a distinct clinical disorder. Broader; confidence (parent
        crosswalk, one-level broader).
        """
}
mapping "W5260.1" source="W5260" target="54719000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
