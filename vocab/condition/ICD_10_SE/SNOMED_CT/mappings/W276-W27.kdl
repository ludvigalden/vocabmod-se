// ICD-10-SE extension codes to SNOMED CT mappings, codes W276-W27
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W276.1" source="W276" target="302981008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W276 SNOMED CT 302981008 is a Swedish ICD-10 extension of W27 (Contact with nonpowered hand
        tool) that adds a place/activity suffix. ICD-10 W27 has an Athena crosswalk to SNOMED CT 441193
        (Accident caused by nonpowered hand tools and implements). The Swedish place/activity suffix has
        no separate SNOMED CT standard concept, so the parent accident concept is the best defensible
        target. Target subsumes the source (broader). Confidence : one-level broader with verified
        crosswalk.
        """
}
