// ICD-10-SE extension codes to SNOMED CT mappings, codes W016-W01
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W016.1" source="W016" target="220360004" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W016 = SNOMED CT 220360004 (4-char ICD-10 SE). Target =. Same clinical concept, same place
        axis. High confidence: exact term match, no independent crosswalk re-verified.
        """
}
mapping "W0160.1" source="W0160" target="220360004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0160 = SNOMED CT 220360004 (Swedish activity subdivision). Target = place concept; activity
        axis lost; broader. Moderate confidence.
        """
}
