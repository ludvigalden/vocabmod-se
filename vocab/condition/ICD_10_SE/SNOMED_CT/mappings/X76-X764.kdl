}
mapping "X760.1" source="X760" target="82313006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X760 SNOMED CT 82313006 = a Swedish ICD-10-SE national extension that subdivides X76 (Athena
        ICD10 concept 45551953) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4219484 = (sctid 82313006), the verified Athena crosswalk target for X76
