mapping "V9584.1" source="V9584" target="216267008" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V9584 = Swedish 7-char extension of ICD-10 V95.8 SNOMED CT 216267008 + activity suffix.
        Athena crosswalk V95.8 (concept_id 45580756) -> (concept 435135). Source bundles accident-type
        with activity-at-time; target captures only the accident aspect, not the activity context, so
        partial. Confidence : real partial overlap with semantic loss on the activity dimension. Note
        the V95.8 -> spacecraft crosswalk is the OMOP-standard mapping despite apparent breadth
        mismatch.
        """
}
