// ICD-10-SE extension codes to SNOMED CT mappings, codes W1-W105
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W100.1" source="W100" target="217084001" relationship=equivalent quality=100 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        3-char W10 fall on escalator -> observation SNOMED CT; crosswalk-verified; external cause in
        observation domain; [GPS]
        """
}
mapping "W100.2" source="W100" target="217084001" relationship=equivalent preference=alternative quality=100 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "W1000.1" source="W1000" target="217083007" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1000 is a Swedish national extension of W10 (Fall on and from stairs and steps)
        qualified with place SNOMED CT 217083007 and activity. Target SNOMED CT 441749 (code 217083007),
        crosswalk-verified for base W10 (ICD10 concept 45756250 Maps to 441749). Target fully subsumes
        the core fall-mechanism axis; Swedish extension adds place+activity context not encoded in any
        single standard SNOMED CT concept. Confidence : verified crosswalk, well-understood breadth
        mismatch.
        """
}
