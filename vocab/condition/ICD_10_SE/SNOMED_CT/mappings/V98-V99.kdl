// ICD-10-SE extension codes to SNOMED CT mappings, codes V98-V99
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V989.1" source="V989" target="274215009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V989 SNOMED CT 274215009 = Swedish form of ICD-10 V98 (concept 45566176). Target SNOMED CT
        435713 (274215009). Athena crosswalk V98 → 435713. Target legitimately subsumes source (any is a
        transport accident). Moderate tier: verified crosswalk but unspecified/residual source category.
        """
}
