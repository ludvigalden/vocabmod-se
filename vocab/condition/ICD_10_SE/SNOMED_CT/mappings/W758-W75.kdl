// ICD-10-SE extension codes to SNOMED CT mappings, codes W758-W75
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W758.1" source="W758" target="269791004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W758 = SNOMED CT 269791004 with Swedish place/activity qualifiers (Kvävning,
        kvävningstillbud och strypning i sängen - andra specificerade platser). Base event W75
        Athena-crosswalks to SNOMED CT 4155227 (269791004) via ICD10 relationship 45756321 -> 4155227.
        Qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical analogue;
        injury event unchanged. Target subsumes the event -> broader. Confidence : verified crosswalk on
        base W75, one-level broader (qualifier dropped).
        """
}
