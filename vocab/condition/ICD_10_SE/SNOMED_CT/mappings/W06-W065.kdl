// ICD-10-SE extension codes to SNOMED CT mappings, codes W06-W065
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W060.1" source="W060" target="20902002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W060 SNOMED CT 20902002 is the Swedish rendering of W06 (Fall involving bed) at the home
        setting. The WHO base code W06 has a verified Athena crosswalk to SNOMED CT 436882 = (concept_code
        20902002). The Swedish 4-char W060 adds the home place but is co-extensive at the
        clinical-concept level with; the place axis has no separate SNOMED CT representation. Treated as
        the standard equivalent.
        """
}
mapping "W0600.1" source="W0600" target="20902002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0600 SNOMED CT 20902002 is a Swedish extension of W06 (Fall involving bed) subdividing by
        place (home) and activity (sport/exercise). Target SNOMED CT 436882 = (concept_code 20902002).
        Verified crosswalk on parent W06 → 436882; place/activity detail has no SNOMED CT analogue. Target
        fully subsumes the source, one-level broader.
        """
}
