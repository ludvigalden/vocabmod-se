// ICD-10-SE extension codes to SNOMED CT mappings, codes X465-X46
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X465.1" source="X465" target="72431002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X465 SNOMED CT 72431002 is a Swedish national extension of WHO base Accidental poisoning by
        and exposure to organic solvents and halogenated hydrocarbons and their vapours (ICD-10 id
        45756402); the Swedish suffix subdivides the base by a place/activity external-cause axis with
        no distinct standard SNOMED CT clinical analogue. Base event Athena-crosswalks to SNOMED CT 436581
        (concept_code 72431002) via ICD10 relationship 45756402 -> 436581. The Swedish place/activity
        qualifier is external-cause metadata; the injury event is unchanged. Target subsumes the event
        -> broader. Confidence : verified Athena crosswalk on the WHO base, one-level broader (qualifier
        dropped).
        """
}
