// ICD-10-SE extension codes to SNOMED CT mappings, codes J3-J4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "J303A.1" source="J303A" target="429195002" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source J303A SNOMED CT 429195002 = perennial (non-seasonal) allergic rhinitis caused by animal
        dander/fur (Swedish extension of J30.3). Target (Athena 443558) =. 1:1 semantic equivalence:
        same cause (animal dander), same phenotype (allergic rhinitis); the qualifier is intrinsic to
        animal-dander allergy. exact-equivalent.
        """
}
mapping "J303B.1" source="J303B" target="449729000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source J303B SNOMED CT 449729000 = perennial (non-seasonal) allergic rhinitis caused by house dust
        mites (Swedish extension of J30.3). Target (Athena 42709857) =. 1:1 semantic equivalence: same
        cause (dust mite), same phenotype; dust-mite allergy is by definition perennial.
        exact-equivalent.
        """
}
mapping "J303W.1" source="J303W" target="446096008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source J303W SNOMED CT 446096008 = perennial allergic rhinitis caused by other agents (Swedish
        residual of J30.3). Target (Athena 40486433) =. Target subsumes the residual source (perennial
        AR due to any unspecified agent). No specific-causative-agent target fits the heterogeneous
        residual. high: one-level broader, phenotype preserved.
        """
}
