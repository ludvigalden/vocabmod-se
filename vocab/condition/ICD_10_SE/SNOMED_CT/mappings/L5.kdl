// ICD-10-SE extension codes to SNOMED CT mappings, codes L5
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L506A.1" source="L506A" target="402304007" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L506A SNOMED CT 402304007 = allergic contact urticaria. Target SNOMED CT 4292220 / 402304007 =
        (Athena mirror). Same clinical concept. Exact equivalent.
        """
}
