// ICD-10-SE extension codes to SNOMED CT mappings, codes V104-V109
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V1040.1" source="V1040" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V1040 is the Swedish ICD-10-SE extension of parent V104 (förare av cykel skadad i
        trafikolycka) with an activity suffix (idrott/lek/förvärvsarbete/etc.). The activity suffix is
        Swedish national context metadata with no SNOMED CT analogue; clinically the source denotes the
        same pedal-cycle collision as its parent. Primary target SNOMED CT 432510 (Driver in vehicular
        AND/OR traffic accident) is the parent's verified SNOMED CT 386662004 47397001 48084008 crosswalk
        target in the athena ICD10 mirror; it legitimately subsumes the child (broader) because the
        activity suffix adds no clinical specificity. Weak targets SNOMED CT 433099 (Victim, cyclist in
        vehicular AND/OR traffic accident), SNOMED CT 443423 (Pedal cycle accident) are the parent's
        alternate crosswalk edges, recorded as related leads. Confidence high tier: parent crosswalk is
        verified and the child adds only non-clinical context.
        """
}
mapping "V1040.2" source="V1040" target="47397001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V1040.3" source="V1040" target="386662004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
