// ICD-10-SE extension codes to SNOMED CT mappings, codes W416-W41
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W416.1" source="W416" target="88817006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W416 SNOMED CT 88817006 is the Swedish place subdivision of W41 for industrial
        area/construction site. Target SNOMED CT 4230638 = Exposure to inanimate mechanical force, parent
        W41's canonical OMOP target. Broader.
        """
}
