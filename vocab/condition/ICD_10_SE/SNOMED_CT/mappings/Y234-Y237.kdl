// ICD-10-SE extension codes to SNOMED CT mappings, codes Y234-Y237
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y234.1" source="Y234" target="219334005" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y234 = Swedish ICD-10-SE national extension of Y23 SNOMED CT 219334005 (Athena ICD10 concept
        45756506), refined by Swedish external-cause place axis: gata och väg (street and highway); no
        specific activity axis (place-only code). The clinical event/exposure is unchanged; the Swedish
        place/activity qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical
        analogue. Target SNOMED CT 435155 = sctid 219334005. Why this target: Athena ICD10 crosswalk maps
        base Y23 (concept_id 45756506) -> 435155 (relationship 45756506, 435155); it is the
        authoritative standard concept for Y23 and fully subsumes every place/activity-specific SE
        subdivision. mapping_type=broader (target fully contains every clinical meaning of the source;
        the dropped qualifier is breadth-neutral external-cause metadata, not a partial slice).
        Confidence (high): verified Athena crosswalk on the base code with a small, well-understood
        one-level breadth mismatch (the SE place/activity refinement is lost). Athena-local research
        only.
        """
}
