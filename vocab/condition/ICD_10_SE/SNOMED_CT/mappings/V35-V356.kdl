// ICD-10-SE extension codes to SNOMED CT mappings, codes V35-V356
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3500.1" source="V3500" target="214878007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3500 = Swedish extension of V35.0 (driver of three-wheeled MV injured in nontraffic
        collision with railway train) + SNOMED CT 214878007 (sport/exercise). Target SNOMED CT 4061041 =
        (214878007). The Athena crosswalk maps the V35.0 base to 437738 (MV accident off public road);
        4061041 is the more specific standard concept that the crosswalk assigns to V35.2/V35.3, and it
        precisely captures the nontraffic MV-train collision semantics. Target subsumes the source: it
        fully covers the accident type (nontraffic, three-wheeled MV, train collision); the Swedish
        extension only adds activity context (sport) which has no SNOMED CT representation. (moderate): the
        accident type is precisely captured; only the activity context is lost.
        """
}
