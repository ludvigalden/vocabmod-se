// ICD-10-SE extension codes to SNOMED CT mappings, codes V26
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2600.1" source="V2600" target="214640008" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2600 = Swedish extension of V26.0 (motorcycle driver injured in non-traffic collision
        with other nonmotor vehicle), activity=sport. Parent V26.0 has Athena SNOMED 214640008 crosswalk
        to SNOMED CT 437738 (Motor vehicle accident off public road, 214640008) only. Target is broad: it
        captures the off-public-road event but drops the rider role, the nonmotor-vehicle collision
        counterpart, and the activity dimension. Low tier : single broad target with multiple
        specificity dimensions lost; no closer standard concept exists in the mirror.
        """
}
