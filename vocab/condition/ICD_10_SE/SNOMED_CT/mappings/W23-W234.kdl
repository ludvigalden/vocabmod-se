// ICD-10-SE extension codes to SNOMED CT mappings, codes W23-W234
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W230.1" source="W230" target="35468003" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 35468003 [GPS] [IPS]"
}
mapping "W2300.1" source="W2300" target="35468003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2300 SNOMED CT 35468003 is a Swedish 5-char extension of ICD-10 W23 (concept 45756261),
        with place= and activity=. Target SNOMED CT 4146976 (35468003) is the Athena crosswalk target of
        parent W23. SNOMED CT does not model the activity/place subdivisions of Swedish external-cause
        codes; the parent mechanism fully subsumes the source's clinical injury meaning, with
        activity/place dropped. One-level broader with verified crosswalk = high.
        """
}
