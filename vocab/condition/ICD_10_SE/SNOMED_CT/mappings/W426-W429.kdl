// ICD-10-SE extension codes to SNOMED CT mappings, codes W426-W429
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W426.1" source="W426" target="220807007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W426 SNOMED CT 220807007 = noise exposure - industrial area/construction site. Target SNOMED CT
        40421555 ([X]Exposure to noise, occurrence at industrial and construction area, concept_code
        220807007) is the same clinical concept at the same specificity. Location-only, no activity
        split on either side.
        """
}
mapping "W4260.1" source="W4260" target="220807007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4260 SNOMED CT 220807007 = noise exposure at industrial/construction area during
        sport/exercise. Target SNOMED CT 40421555 ([X]Exposure to noise, occurrence at industrial and
        construction area) covers location only. Target subsumes the source. One-level broader; high
