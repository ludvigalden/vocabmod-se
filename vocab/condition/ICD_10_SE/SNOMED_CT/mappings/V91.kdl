mapping "V9128.1" source="V9128" target="215414001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V9128 (Swedish extension of ICD-10 V91.2) = SNOMED CT 215414001. WHO 4-char V91.2 has Athena
        crosswalk to SNOMED CT 438301 (concept_code 215414001). Target is the parent concept fully
        containing the injury event; the Swedish extension only adds activity context not represented in
        any standard concept. Broader, high tier: verified Athena crosswalk at the 4-char level.
        """
}
