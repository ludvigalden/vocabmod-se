mapping "W0931.1" source="W0931" target="41411008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0931 SNOMED CT 41411008 = Swedish national 5-character extension of ICD-10 W09 (Fall
        involving playground equipment) refining place=sports/athletics area and activity=play/leisure.
        No international SNOMED CT standard concept encodes place+activity for playground-equipment falls;
        the UK-extension [X] concepts (220443008 sports area, 386581000000104 etc.) are non-standard
        classification rows in the mirror and add only the place axis anyway. Target SNOMED CT 437477
        (concept_code 41411008) is the international standard concept that the WHO/Athena W09 (45756249)
        crosswalks to via. It fully subsumes the core event but drops the place+activity granularity the
        Swedish extension carries, so it is a one-level broader ancestor. high: verified Athena
        crosswalk from the parent W09, target is clearly correct but breadth is lost.
        """
}
mapping "W0932.1" source="W0932" target="41411008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0932 SNOMED CT 41411008 = Swedish extension of W09 refining place=sports/athletics area,
        activity=paid work. No international SNOMED CT standard encodes place+activity for
        playground-equipment falls; the UK-extension [X] concepts (220443008 etc.) are non-standard
        classification rows and add only the place axis. Target SNOMED CT 437477 (41411008) is the
        international standard concept crosswalked from W09 in Athena (45756249 Maps to 437477). Fully
        subsumes the core event, drops place+activity. One-level broader; verified crosswalk.
        """
}
