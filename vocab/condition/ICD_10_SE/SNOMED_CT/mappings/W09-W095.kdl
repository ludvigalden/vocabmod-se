mapping "W093.1" source="W093" target="41411008" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W093 = SNOMED CT 41411008 (Fall from playground equipment at sports/athletics facility).
        This is the W09 base code with a single place dimension (sports facility), no extra activity
        axis. SNOMED CT 437477 (Fall from playground equipment) via Athena crosswalk is the direct 1:1
        equivalent — the place attribute is classification context for the same injury mechanism.
        Exact_match, (Athena crosswalk-verified at the W09 level, no additional specificity beyond the
        parent concept).
        """
}
mapping "W0930.1" source="W0930" target="41411008" relationship=source_is_narrower_than_target {
