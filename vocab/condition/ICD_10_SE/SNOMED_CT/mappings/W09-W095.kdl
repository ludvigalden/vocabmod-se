// ICD-10-SE extension codes to SNOMED CT mappings, codes W09-W095
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W090.1" source="W090" target="13711007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 13711007 [GPS]"
}
mapping "W0900.1" source="W0900" target="41411008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W0900 = Swedish extension of W09 SNOMED CT 41411008 (Fall from playground equipment) with
        place=bostad och bostadsområde and activity=idrott, sport, motion. Athena crosswalk: ICD10 W09
        (concept_id 45756249) Maps to SNOMED CT 437477 (Fall from playground equipment, concept_code
        41411008). Target fully captures the injury mechanism; place/activity are ICD-10 classification
        axes. Broader.
        """
}
