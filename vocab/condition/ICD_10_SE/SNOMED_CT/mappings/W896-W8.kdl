// ICD-10-SE extension codes to SNOMED CT mappings, codes W896-W8
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W896.1" source="W896" target="418921006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W896 = SNOMED CT 418921006 (Swedish national extension). Base W89 Athena-crosswalks to
        SNOMED CT 4305999 (concept_code 418921006) via ICD10 relationship 45756333 -> 4305999. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W89, one-level broader (Swedish
        qualifier dropped).
        """
}
