// ICD-10-SE extension codes to SNOMED CT mappings, codes K2-K4
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "K209.1" source="K209" target="16761005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 16761005 [GPS] [IPS] [GPFP]"
}
mapping "K209A.1" source="K209A" target="235599003" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source K209A SNOMED CT 235599003 = eosinophilic esophagitis (Swedish extension providing a specific
        code for EoE). Target (standard Disorder). Same clinical concept, exact correspondence.
        """
}
mapping "K209W.1" source="K209W" target="16761005" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source K209W SNOMED CT 16761005 = other esophagitis (Swedish residual subdivision of WHO K20
        Oesophagitis). Target = Esophagitis, the K20 Athena target. Target subsumes the source (which is
        a child of K20).
        """
}
mapping "K309.1" source="K309" target="3696007" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source K309 SNOMED CT 3696007 = functional dyspepsia (Swedish extension of WHO K30). Target =
        Nonulcer dyspepsia, the K30 Athena target. Functional dyspepsia is the clinical synonym for
        non-ulcer dyspepsia; same concept.
        """
}
mapping "K3190.1" source="K3190" target="3411000119107" relationship=source_is_narrower_than_target {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source K3190 is a 5th-char Swedish extension of K31.9 (Disease of stomach and duodenum,
        unspecified). Best standard target is the K31.9 Athena SNOMED 119291004 3411000119107 target
        SNOMED CT 3411000119107 (standard Disorder). Target legitimately subsumes the unspecified source;
        moderate tier because the source is an unspecified truncation-level Swedish code and the
        crosswalk was reached via the WHO parent rather than the Swedish extension itself.
        """
}
