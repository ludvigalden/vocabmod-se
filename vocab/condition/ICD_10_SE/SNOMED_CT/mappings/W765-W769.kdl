// ICD-10-SE extension codes to SNOMED CT mappings, codes W765-W769
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W765.1" source="W765" target="219328003" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W765 = SNOMED CT 219328003 with Swedish place/activity qualifiers (Annan strypning och
        hängning genom olyckshändelse - butiks-, handels- eller serviceområde). Base event W76
        Athena-crosswalks to SNOMED CT 435154 (219328003) via ICD10 relationship 45756322 -> 435154.
        Qualifiers are external-cause metadata with no distinct standard SNOMED CT clinical analogue;
        injury event unchanged. Target subsumes the event -> broader. Athena crosswalk target carries an
        intent-class mismatch (source is accidental); recorded as the standard crosswalk target with
        that caveat. Confidence : verified crosswalk on base W76, one-level broader (qualifier dropped).
        """
}
