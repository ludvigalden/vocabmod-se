// ICD-10-SE extension codes to SNOMED CT mappings, codes W738-W73
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W738.1" source="W738" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W738 SNOMED CT 217748000 = a Swedish ICD-10-SE national extension that subdivides W73
        (Athena ICD10 concept 45756319) by place (industrial/construction site, agricultural area,
        other/unspecified place) and activity (sport, leisure, gainful work, vital activities, etc.).
        The place/activity axes have no separate standard SNOMED CT disorder concept. Target SNOMED CT 436593
        = (sctid 217748000), the verified Athena crosswalk target for W73 (ICD10 relationship 45756319
        -> 436593); it also subsumes the W65-W74 group. Why this target: it is the authoritative
        standard concept the parent W73 maps to, and every place/activity-specific SE subdivision is
        still an accidental drowning/submersion event fully contained by it. mapping_type=broader
        (target subsumes the source). Confidence (high): verified crosswalk with a small,
        well-understood one-level breadth mismatch (the SE code is a child of W73; 436593 is the
        standard concept for W73). Athena-local research only.
        """
}
