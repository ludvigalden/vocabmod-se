// ICD-10-SE extension codes to SNOMED CT mappings, codes W26-W265
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W2600.1" source="W2600" target="242772009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2600 SNOMED CT 242772009 = Swedish extension of ICD-10 W26 (Contact with other sharp
        objects) subdivided by place (home/residential) and activity (sport). Target SNOMED CT 4055051
        (242772009), the standard crosswalk target for base W26. Target fully subsumes source; drops
        place+activity axes — one-level broader. High tier: verified Athena Maps-to crosswalk on parent.
        SNOMED CT has no place-specific W26 concepts, so 4055051 is the best standard target.
        """
}
