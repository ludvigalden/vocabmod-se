    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W320.1" source="W320" target="218082000" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W3200.1" source="W3200" target="218082000" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3200 SNOMED CT 218082000 = Swedish extension of ICD-10 W32 (Handgun discharge) annotated
        with place (home/residential area) and activity (sport/exercise). Target SNOMED CT 433948
        (concept_code 218082000) is the verified Athena crosswalk target for base W32. The Swedish
        subcode adds only administrative place/activity metadata; clinically it is the same event as
        W32. Target subsumes the source (broader), one-level breadth mismatch, crosswalk-verified.
        """
}
