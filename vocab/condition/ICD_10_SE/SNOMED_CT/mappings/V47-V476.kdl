// ICD-10-SE extension codes to SNOMED CT mappings, codes V47-V476
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4700.1" source="V4700" target="127349007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4700 is a Swedish national 6-character extension of base ICD-10 code V470 = Car occupant
        injured in collision with fixed or stationary object, driver injured in nontraffic accident
        (V47.0); the 6th character encodes the activity at time of accident (idrott, sport, motion
        (sport/exercise)). Source definition: same motor-vehicle accident event as the base code, with
        additional activity-context granularity that has no SNOMED CT representation. Target(s): SNOMED CT
        435988 (127349007). Why this target: the SNOMED CT concept(s) are the standard crosswalk targets
        for the base ICD-10 code (Athena SNOMED 127349007); they fully subsume the accident event; the
        activity-context dimension is lost but the injury event semantics are fully covered, so the
        relationship is broader. Confidence (moderate): best available standard concept, defensible
        subsumption, but the source is a Swedish extension with an unspecified-activity axis that the
        standard vocabulary cannot represent.
        """
}
