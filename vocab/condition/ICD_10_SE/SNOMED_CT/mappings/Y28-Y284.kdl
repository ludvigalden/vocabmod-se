// ICD-10-SE extension codes to SNOMED CT mappings, codes Y28-Y284
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y280.1" source="Y280" target="219342006" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
}
mapping "Y280.2" source="Y280" target="218058005" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "Y2800.1" source="Y2800" target="219342006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y2800 SNOMED CT 219342006 = a Swedish ICD-10-SE national extension that subdivides Y28
        (Athena ICD10 concept 45756511) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4072226 = (sctid 219342006), the verified Athena crosswalk target for
        Y28 (ICD10 relationship 45756511 -> 4072226). Why this target: it is the authoritative standard
        concept the parent Y28 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
