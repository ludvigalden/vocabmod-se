// ICD-10-SE extension codes to SNOMED CT mappings, codes X216-X218
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X216.1" source="X216" target="269705003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X216 = Swedish ICD-10-SE national extension of X21 SNOMED CT 269705003 (Athena ICD10 concept
        45756380), refined by Swedish external-cause place axis: industriområde, byggarbetsplats
        (industrial area, construction site); no specific activity axis (place-only code). The clinical
        event/exposure is unchanged; the Swedish place/activity qualifiers are external-cause metadata
        with no distinct standard SNOMED CT clinical analogue. Target SNOMED CT 4155221 = sctid 269705003. Why
        this target: Athena ICD10 crosswalk maps base X21 (concept_id 45756380) -> 4155221 (relationship
        45756380, 4155221); it is the authoritative standard concept for X21 and fully subsumes every
        place/activity-specific SE subdivision. mapping_type=broader (target fully contains every
        clinical meaning of the source; the dropped qualifier is breadth-neutral external-cause
        metadata, not a partial slice). Confidence (high): verified Athena crosswalk on the base code
        with a small, well-understood one-level breadth mismatch (the SE place/activity refinement is
        lost). Athena-local research only.
        """
}
