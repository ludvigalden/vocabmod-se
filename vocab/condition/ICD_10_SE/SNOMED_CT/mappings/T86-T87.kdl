// ICD-10-SE extension codes to SNOMED CT mappings, codes T86-T87
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "T860A.1" source="T860A" target="234519006" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T860A = Swedish subcode of T86.0 SNOMED CT 234519006. T86.0 Athena-maps to SNOMED CT 4125659
        (Bone marrow transplant rejection, concept_code 234519006). The Swedish A-suffix carries no
        extra clinical detail beyond the parent. Exact 1:1 equivalence.
        """
}
mapping "T860B.1" source="T860B" target="75744002" relationship=equivalent {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source T860B = Swedish subcode of T86.0 denoting graft-versus-host disease (GVHD) arising post
        bone-marrow transplant. SNOMED CT 40626511 (Graft versus host disease, concept_code 75744002) is
        the canonical standard concept for GVHD. The source is the explicit GVHD manifestation; this is
        an exact clinical equivalence. Verified via the SNOMED CT concept registry.
        """
}
mapping "T861A.1" source="T861A" target="236574008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T861A = SNOMED CT 236574008. SNOMED CT 4128371 (Acute rejection of renal transplant,
        concept_code 236574008) is the kidney-specific acute rejection concept; the source's
        cell-mediated qualifier is not separately representable in a single standard concept (the
        generic 4230765). Target subsumes the source as an acute rejection of renal transplant; broader,
        one level of specificity lost. High-.
        """
}
mapping "T861B.1" source="T861B" target="705154007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T861B = SNOMED CT 705154007. SNOMED CT 45771487 (Acute vascular graft rejection, concept_code
        705154007) captures the vascular-rejection aspect but is not kidney-specific; no kidney-specific
        acute vascular rejection concept exists. Target is broader (loses renal-transplant context).
        Moderate because the crosswalk is aspect-matched but not organ-specific. Alternate 4128371
        (Acute rejection of renal transplant) would preserve organ context but lose the vascular
        subtype; 45771487 chosen as the more clinically specific match to the rejection pattern.
        """
}
mapping "T861C.1" source="T861C" target="236574008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T861C = SNOMED CT 236574008. SNOMED CT 4128371 (Acute rejection of renal transplant) is the
        best standard target; the biopsy-verification status is a methodology attribute, not a separate
        clinical concept. Target subsumes the source; broader, one attribute lost. High.
        """
}
mapping "T861D.1" source="T861D" target="236578006" relationship=source_is_narrower_than_target {
