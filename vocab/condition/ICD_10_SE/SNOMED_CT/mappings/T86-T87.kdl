        """
}
mapping "T861F.1" source="T861F" target="35006009" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T861F = SNOMED CT 35006009. SNOMED CT 4148383 (Graft failure due to recurrent recipient
        disease, concept_code 35006009) denotes exactly graft failure caused by recurrence of the
        original recipient disease. Exact semantic equivalence despite the source being kidney-specific
        and the SNOMED CT concept being graft-generic; the kidney context is implicit but the concept is
        the canonical match.
        """
}
