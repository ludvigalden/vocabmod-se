// ICD-10-SE extension codes to SNOMED CT mappings, codes V386-V389
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3860.1" source="V3860" target="242116005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3860 is a Swedish 6-character extension of ICD-10 V38.6 (passenger in traffic,
        noncollision 3-wheel) + idrott/sport/motion. The Swedish 6th character encodes the activity
        context of the injured party (sport/leisure/work/vital activity/etc.) — a contextual dimension
        with no SNOMED CT analogue. The base ICD-10 code (V38.4/5/6/7) has a verified Athena SNOMED
        242116005 36198007 crosswalk to SNOMED CT 432509 (Accident to motor vehicle on road, not involving
        collision) and 444074 (Victim of vehicular AND/OR traffic accident). The Swedish extension
        inherits that crosswalk; the activity-context dimension is dropped. Both targets are broader
        than the source (the source is a more specific, activity-tagged variant). : verified Athena
        crosswalk on the parent, one dropped dimension (activity context).
        """
}
mapping "V3860.2" source="V3860" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
