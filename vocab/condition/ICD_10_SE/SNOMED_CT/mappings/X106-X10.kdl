// ICD-10-SE extension codes to SNOMED CT mappings, codes X106-X10
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X106.1" source="X106" target="242495001" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X106 = SNOMED CT 242495001 (Swedish national extension). Base X10 Athena-crosswalks to
        SNOMED CT 4054574 (concept_code 242495001) via ICD10 relationship 45756369 -> 4054574. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X10, one-level broader (Swedish
        qualifier dropped).
        """
}
