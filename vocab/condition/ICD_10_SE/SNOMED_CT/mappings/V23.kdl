// ICD-10-SE extension codes to SNOMED CT mappings, codes V23
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2300.1" source="V2300" target="10298002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2300 = Swedish 5-char extension of V23.0 (motorcycle rider [driver] injured in collision
        with car/pickup/van, nontraffic accident), 5th char SNOMED CT 10298002 = idrott/sport/motion.
        Athena ICD10 mirror crosswalk for base V23.0 (concept 45595025) maps to SNOMED CT 432510 (Driver in
        vehicular accident), 435134 (Motor vehicle accident), and 438310 (Victim motorcycle rider).
        438310 chosen as strongest single target capturing motorcyclist-injury semantic. Broader because
        Swedish activity-context axis (sport) has no SNOMED CT representation and target loses the
        driver/nontraffic specifics. Moderate : mechanical crosswalk from base V23.0.
        """
}
mapping "V2301.1" source="V2301" target="10298002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
