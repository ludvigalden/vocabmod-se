// ICD-10-SE extension codes to SNOMED CT mappings, codes M85-M87
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M850B.1" source="M850B" target="89859004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M850B SNOMED CT 89859004 = fibrous dysplasia in shoulder joint/upper arm. Swedish national
        extension of ICD-10 M85.0 (Fibrous dysplasia, monostotic). Target SNOMED CT 4233830 (concept_code
        89859004) = Monostotic fibrous dysplasia, standard concept. Athena crosswalk for M85.01/M85.02
        maps to 4233830. Source spans shoulder + upper arm; no single SNOMED CT monostotic-FD concept
        covers both. Target subsumes source; one level broader. high.
        """
}
