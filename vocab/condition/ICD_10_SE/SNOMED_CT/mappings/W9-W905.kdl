// ICD-10-SE extension codes to SNOMED CT mappings, codes W9-W905
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W900.1" source="W900" target="218191003" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 218191003 [GPS]"
}
mapping "W9000.1" source="W9000" target="218190002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W9000 = SNOMED CT 218190002 (Swedish national extension). Base W90 Athena-crosswalks to
        SNOMED CT 438630 (concept_code 218190002) via ICD10 relationship 45756334 -> 438630. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W90, one-level broader (Swedish
        qualifier dropped).
        """
}
