// ICD-10-SE extension codes to SNOMED CT mappings, codes X71-X714
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X710.1" source="X710" target="418420002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X7100.1" source="X7100" target="418420002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X7100 SNOMED CT 418420002 = a Swedish ICD-10-SE national extension that subdivides X71
        (Athena ICD10 concept 45566260) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4303690 = (sctid 418420002), the verified Athena crosswalk target for
        X71 (ICD10 relationship 45566260 -> 4303690). Why this target: it is the authoritative standard
        concept the parent X71 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
