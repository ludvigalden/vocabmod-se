// ICD-10-SE extension codes to SNOMED CT mappings, codes X93-X934
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X930.1" source="X930" target="219199009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X930 SNOMED CT 219199009 = a Swedish ICD-10-SE national extension that subdivides X93
        (Athena ICD10 concept 45756461) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 432537 = (sctid 219199009), the verified Athena crosswalk target for X93
        (ICD10 relationship 45756461 -> 432537). Why this target: it is the authoritative standard
        concept the parent X93 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
