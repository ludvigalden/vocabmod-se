// ICD-10-SE extension codes to SNOMED CT mappings, codes F1
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "F102A.1" source="F102A" target="66590003" relationship=equivalent effect=omitted quality=40 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source F102A SNOMED CT 66590003 = alcohol dependence with physiological signs of dependence
        (Swedish extension specifying the qualifier of ICD-10 F10.2). Target SNOMED CT 435243 (concept_code
        66590003) = Alcohol dependence. Source ICD-10 parent F10.2 has Athena crosswalk to 435243.
        SNOMED CT standard does not separate the physiological-signs qualifier at the standard-concept
        level, so 435243 is the closest standard target. High tier: crosswalk-verified at parent,
        qualifier detail not separately standardised.
        """
}
