// ICD-10-SE extension codes to SNOMED CT mappings, codes V817-V81
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8170.1" source="V8170" target="213859004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8170 = SNOMED CT 213859004. Parent V81.7 (concept 45756067) has Athena crosswalk to SNOMED CT
        435703 (Railway accident involving derailment without antecedent collision, code 213859004).
        Activity suffix dropped as non-clinical metadata. high: verified crosswalk, small breadth
        mismatch from activity suffix. mapping_type broader: target covers the derailment-accident axis,
        source adds activity context.
        """
}
mapping "V8171.1" source="V8171" target="213859004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
