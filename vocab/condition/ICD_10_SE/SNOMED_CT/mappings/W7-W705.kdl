// ICD-10-SE extension codes to SNOMED CT mappings, codes W7-W705
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W700.1" source="W700" target="221045004" relationship=equivalent {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W700 = Drowning/submersion after fall into natural water, home/home area (4-char, no
        activity axis). Target SNOMED CT 221045004 = [X]Drowning and submersion following fall into natural
        water, occurrence at home. Both represent drowning after fall into natural water at home, no
        further activity axis. Athena crosswalk verified. High tier: verified crosswalk, match at place
        level.
        """
}
mapping "W7000.1" source="W7000" target="221045004" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W7000 = Drowning/submersion after fall into natural water, home area, sport/exercise.
        Target SNOMED CT 221045004. Swedish code adds activity (sport) axis not in SNOMED CT. Place-level
        crosswalk verified. High tier: one-axis mismatch (activity).
        """
}
mapping "W7001.1" source="W7001" target="221045004" relationship=source_is_narrower_than_target {
    confidence 1 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Source W7001 = Drowning/submersion after fall into natural water, home area, leisure/recreation.
        Target SNOMED CT 221045004. Swedish code adds activity (leisure) axis not in SNOMED CT. Place-level
        crosswalk verified. High tier: one-axis mismatch (activity).
        """
}
mapping "W7002.1" source="W7002" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7002 SNOMED CT 217748000 = Swedish national extension of ICD-10 W70 (Drowning and
        submersion following fall into natural water) further subdivided by location (home/residential
        area) and activity (paid work). Target SNOMED CT 436593 (217748000), the standard crosswalk target
        for the base W70. The target subsumes the clinical event (drowning after fall into natural
        water); the location/activity context the Swedish extension encodes has no SNOMED CT
        representation. Low confidence: 6th-digit Swedish extension with no crosswalk, target fully
        covers the clinical event but loses the location/activity metadata.
        """
}
mapping "W7003.1" source="W7003" target="217748000" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W7003 = Swedish extension of W70 (drowning/submersion following fall into natural water)
        at home/residential area during other occupation. Target SNOMED CT 436593 = Accidental drowning and
        submersion, the standard crosswalk target for base W70. Target subsumes the clinical event;
        location/activity context not represented in SNOMED CT. Low confidence: 6th-digit Swedish
        extension, no crosswalk, target covers clinical core only.
        """
}
