// ICD-10-SE extension codes to SNOMED CT mappings, codes W875-W87
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W875.1" source="W875" target="418908004" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W875 = SNOMED CT 418908004 (Swedish national extension). Base W87 Athena-crosswalks to
        SNOMED CT 4303528 (concept_code 418908004) via ICD10 relationship 45756332 -> 4303528. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W87, one-level broader (Swedish
        qualifier dropped).
        """
}
