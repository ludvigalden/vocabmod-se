// ICD-10-SE extension codes to SNOMED CT mappings, codes C-C3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C019.1" source="C019" target="93687001" relationship=equivalent quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C019 SNOMED CT 93687001 = malignant neoplasm of base of tongue; Swedish spelling of WHO
        ICD-10 C01.9. Crosswalk-verified: ICD10 mirror concept_id 45571487 (C01) SNOMED CT 256633
        (concept_code 93687001). Same clinical concept, same level of specificity.
        """
}
