mapping "C160A.1" source="C160A" target="93738008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C160A SNOMED CT 93738008 = malignant neoplasm of gastroesophageal junction, Siewert type I
        (Swedish national extension of C16.0 cardia). Target SNOMED CT 432838 (concept_code 93738008), via
        the ICD10 C16.0 (45556964) crosswalk. SNOMED CT has no Siewert-typed subconcept, so the target
        fully subsumes the source but drops the Siewert I (distal esophageal adenocarcinoma)
        specificity. Moderate : a verified crosswalk but the Siewert typology is lost.
        """
}
mapping "C160B.1" source="C160B" target="93738008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C160B SNOMED CT 93738008 = malignant neoplasm of gastroesophageal junction, Siewert type II
        (Swedish national extension of C16.0 cardia). Target SNOMED CT 432838 (concept_code 93738008), via
        ICD10 C16.0 crosswalk. SNOMED CT has no Siewert II (true cardia) subconcept; the target fully
        contains the source but loses the Siewert typology. Moderate : verified crosswalk, specificity
        loss.
        """
}
mapping "C160C.1" source="C160C" target="93738008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C160C SNOMED CT 93738008 = malignant neoplasm of gastroesophageal junction, Siewert type III
        (Swedish national extension of C16.0 cardia). Target SNOMED CT 432838 (concept_code 93738008), via
        ICD10 C16.0 crosswalk. SNOMED CT has no Siewert III (subcardial gastric) subconcept; target fully
        contains source, Siewert typology lost. Moderate : verified crosswalk, specificity loss.
        """
}
mapping "C160X.1" source="C160X" target="93738008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C160X SNOMED CT 93738008 = malignant neoplasm of cardia, unspecified Siewert type (Swedish
        national extension of C16.0). Target SNOMED CT 432838 (concept_code 93738008), via ICD10 C16.0
