// ICD-10-SE extension codes to SNOMED CT mappings, codes W58-W585
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W580.1" source="W580" target="418589001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5800.1" source="W5800" target="17982002" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5800 = Swedish 5-char extension of W58 SNOMED CT 17982002 with home/residential setting +
        sports/exercise activity. Target SNOMED CT 4077127 (concept_code 17982002). Athena crosswalk
        verifies W58 -> 4077127. Crocodilians are a subset of reptiles, so the target is broader than
        the source animal; the 5-char SE extension additionally adds place/activity sub-classification
        with no SNOMED CT equivalent. Broader: target subsumes the source's injury mechanism. Moderate :
        Athena crosswalk, two levels of breadth (reptile scope vs crocodilian + lost place/activity
        context).
        """
}
