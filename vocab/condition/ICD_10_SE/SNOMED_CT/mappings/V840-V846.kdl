// ICD-10-SE extension codes to SNOMED CT mappings, codes V840-V846
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8400.1" source="V8400" target="217935007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8400 = SNOMED CT 217935007 (Driver of special agricultural vehicle injured in traffic
        accident - sport/exercise). Swedish extension of base ICD-10 V84.0. Target SNOMED CT 436874 =
        (217935007), the Athena target of base V84.0 (concept 45756150). Target is the closest
        agricultural-vehicle-related standard concept; subsumes the agricultural-context axis but drops
        the traffic-vs-nontraffic distinction, the driver role, and the Swedish sport-activity
        qualifier. Broader with significant specificity loss; tier.
        """
}
