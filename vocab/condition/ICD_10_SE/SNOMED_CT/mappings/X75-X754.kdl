// ICD-10-SE extension codes to SNOMED CT mappings, codes X75-X754
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X750.1" source="X750" target="82313006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X750 SNOMED CT 82313006 = a Swedish ICD-10-SE national extension that subdivides X75 (Athena
        ICD10 concept 45561468) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4219484 = (sctid 82313006), the verified Athena crosswalk target for X75
        (ICD10 relationship 45561468 -> 4219484). Why this target: it is the authoritative standard
        concept the parent X75 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
