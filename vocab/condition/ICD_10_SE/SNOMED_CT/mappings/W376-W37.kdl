// ICD-10-SE extension codes to SNOMED CT mappings, codes W376-W37
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W376.1" source="W376" target="218069008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W376 = Swedish extension of W37 (industrial area/construction site). SNOMED CT 437740 fully
        subsumes the explosion event; the place axis has no SNOMED CT representation. Broader, (parent
        crosswalk verified).
