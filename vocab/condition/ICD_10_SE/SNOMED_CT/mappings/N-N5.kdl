// ICD-10-SE extension codes to SNOMED CT mappings, codes N-N5
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "N109.1" source="N109" target="28637003" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source N109 SNOMED CT 28637003 = Swedish short code for ICD-10 N10 Acute tubulo-interstitial
        nephritis. Athena crosswalk N10 → SNOMED CT 4102631 (28637003). Same clinical concept,
        crosswalk-verified. exact_match.
        """
}
