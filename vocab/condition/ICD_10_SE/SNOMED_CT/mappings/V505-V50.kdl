// ICD-10-SE extension codes to SNOMED CT mappings, codes V505-V50
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5050.1" source="V5050" target="214219000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5050 = Swedish extension of WHO V50.5 (Driver of pick-up truck/van injured in traffic
        collision with pedestrian/animal) with activity suffix SNOMED CT 214219000. WHO V50.5 (Athena
        45575747) has Athena crosswalk to SNOMED CT 442449 (Motor vehicle traffic accident involving
        pedestrian hit by motor vehicle, driver of motor vehicle injured, concept_code 214219000) and
        444074. Most specific target 442449 captures driver/traffic/pedestrian-hit semantics. Target
        broader: loses light-truck specificity and activity dimension. high per verified parent
        crosswalk.
        """
}
mapping "V5051.1" source="V5051" target="214219000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5051 = Swedish extension of WHO V50.5 (driver, traffic) with activity suffix SNOMED CT
        214219000. Same mapping basis as V5050: WHO V50.5 crosswalk to SNOMED CT 442449. high, broader
        (activity dimension lost).
        """
}
