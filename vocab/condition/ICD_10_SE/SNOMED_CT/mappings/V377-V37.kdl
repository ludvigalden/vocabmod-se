// ICD-10-SE extension codes to SNOMED CT mappings, codes V377-V37
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3770.1" source="V3770" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V37.70 = V37.7 (person on outside of three-wheeled motor vehicle injured in traffic
        collision with fixed/stationary object) + Swedish activity SNOMED CT 217897003 36198007 418399005
        (sport/exercise). Athena crosswalk from V37.7 yields SNOMED CT 418399005/217897003/36198007.
        Activity dimension unrepresented; broader map. Low confidence.
        """
}
