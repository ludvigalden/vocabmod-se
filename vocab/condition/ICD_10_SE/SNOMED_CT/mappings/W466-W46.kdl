// ICD-10-SE extension codes to SNOMED CT mappings, codes W466-W46
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W466.1" source="W466" target="821431000000102" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W466 SNOMED CT 821431000000102 = Swedish ICD-10-SE extension of base ICD-10 W46, adding
        location and activity context (e.g. gata/vag, butik/handel/service,
        industriområde/byggarbetsplats, lantbruksområde, and the activity subclass idrott/sport/motion,
        lek/fritid, förvärvsarbete, vitalaktivitet, etc.). Target SNOMED CT 44806406 = (standard concept,
        disorder). Best available standard concept: the base ICD-10 W46 has an Athena crosswalk to
        44806406, and the Swedish location/activity modifiers are record-context detail, not a distinct
        clinical concept — every W46xx variant IS a hypodermic needle injury. mapping_type=broader
        because the target fully subsumes the source (location/activity context does not change the
        injury concept). Confidence (high): a small, well-understood breadth mismatch — the target is
        the parent injury class without the Swedish context detail — with a crosswalk-verified
        equivalence to the base W46.
        """
}
