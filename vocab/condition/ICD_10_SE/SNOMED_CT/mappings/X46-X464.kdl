// ICD-10-SE extension codes to SNOMED CT mappings, codes X46-X464
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X460.1" source="X460" target="72431002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X460 = SNOMED CT 72431002 (Swedish national extension). Base X46 Athena-crosswalks to SNOMED CT
        436581 (concept_code 72431002) via ICD10 relationship 45756402 -> 436581. The Swedish extension
        subdivides the base event by a place/activity/qualifier axis with no distinct standard SNOMED CT
        clinical analogue; the underlying clinical event is unchanged. Target subsumes the source event
        -> broader. Confidence : verified Athena crosswalk on base X46, one-level broader (Swedish
        qualifier dropped).
        """
}
