// ICD-10-SE extension codes to SNOMED CT mappings, codes W034-W03
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W034.1" source="W034" target="242402009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W034 = Swedish extension of W03 + place=street/highway. Target SNOMED CT 4053867 (242402009)
        is the Athena crosswalk target for parent W03 (ICD10 45756245). Injury mechanism identical;
        target subsumes the clinical injury. Place metadata has no single SNOMED CT equivalent and is
        represented via OMOP context tables. Broader (target drops place specificity); high (verified
        parent crosswalk, one-level metadata expansion).
        """
}
