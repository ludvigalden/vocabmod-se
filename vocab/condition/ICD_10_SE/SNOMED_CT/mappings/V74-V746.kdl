mapping "V7400.1" source="V7400" target="220095005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7400 = Swedish extension of WHO V74.0 SNOMED CT 220095005 + activity suffix. Target =
        [X]Bus occupant injured in collision with heavy transport vehicle or bus, driver injured in
        nontraffic accident (exact WHO V74.0 equivalent). Target subsumes the
        collision/occupant/nontraffic semantics, drops the activity dimension; broader. High.
        """
}
