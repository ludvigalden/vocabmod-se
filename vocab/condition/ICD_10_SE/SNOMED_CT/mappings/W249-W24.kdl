// ICD-10-SE extension codes to SNOMED CT mappings, codes W249-W24
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W249.1" source="W249" target="269716005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W249 SNOMED CT 269716005 = contact with lifting/transmission device, unspecified place
        (Swedish extension of W24). Target SNOMED CT 432534 (concept_code 269716005, standard_concept=S,
        Observation/Event). ICD10 relationships.tdl has verified edge W24→432534. The SE suffix only
        adds activity/place context; the parent fully subsumes it. Broader with one level of lost
        activity specificity.
        """
}
mapping "W2490.1" source="W2490" target="269716005" relationship=source_is_narrower_than_target effect=omitted quality=40 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2490 = contact with lifting/transmission device, unspecified place, during
        sport/exercise (SE extension of W24). Target SNOMED CT 432534 (269716005, standard_concept=S).
        Verified SNOMED CT 269716005 W24→432534. Sport context is subsumed by the parent event concept.
        Broader; (crosswalk-verified, one level specificity loss).
        """
}
mapping "W2491.1" source="W2491" target="269716005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2491 = contact with lifting/transmission device, unspecified place, during leisure/play
        (SE extension of W24). Target SNOMED CT 432534 (269716005, S). W24→432534 crosswalk verified.
        Leisure context fully contained in parent. Broader.
        """
}
