mapping "W3469.1" source="W3469" target="218081007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3469 SNOMED CT 218081007 = discharge from other/unspecified firearms,
        industrial/construction place, unspecified activity. ICD-10-SE extension of W34 (place+activity
        axis). Target SNOMED CT 437167 (concept_code 218081007, standard_concept=S, domain Observation).
        437167 is the Athena crosswalk target for the W34 parent. Every W34xx event is an accident
        caused by firearm missile, so the target fully subsumes the source; the Swedish place/activity
        detail has no separate standard SNOMED CT concept (the [X]-prefixed ICD-10-XX mirror codes like
        220719009 are non-standard). High tier : verified crosswalk, one-level broader subsumption with
        well-understood loss of place/activity context.
        """
}
mapping "W347.1" source="W347" target="218081007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W347 SNOMED CT 218081007 = discharge from other/unspecified firearms, agricultural area.
        ICD-10-SE 4-char extension of W34 (place axis only). Target SNOMED CT 437167 (218081007, standard).
        Crosswalk target for W34 parent; fully subsumes every W34xx child. Place detail (agricultural
        area) has no standard SNOMED CT target ([X]-prefixed mirror codes are non-standard). High tier :
        verified crosswalk, one-level broader.
        """
}
