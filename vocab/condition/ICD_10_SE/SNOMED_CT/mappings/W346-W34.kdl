// ICD-10-SE extension codes to SNOMED CT mappings, codes W346-W34
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W346.1" source="W346" target="218081007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W346 = firearm discharge in industrial area/construction site. Clinical injury concept
        subsumed by SNOMED CT 437167 via verified W34 Athena crosswalk. Place is Swedish epidemiological
        metadata without SNOMED CT clinical analogue. Broader, high tier.
        """
}
mapping "W3460.1" source="W3460" target="218081007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
