// ICD-10-SE extension codes to SNOMED CT mappings, codes W386-W38
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W386.1" source="W386" target="419026008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W386 = Swedish extension of ICD-10 W38 SNOMED CT 419026008, place qualifier =
        industriområde, byggarbetsplats. Clinical injury identical to base W38 (one-level place
        subdivision, no further activity subdivision). Target SNOMED CT 4167864 (419026008) is the Athena
        crosswalk target for base W38 and fully subsumes this source. One-level broader; confidence
        (verified crosswalk on the base, single level of breadth mismatch, well-understood place
        qualifier).
        """
}
mapping "W3860.1" source="W3860" target="419026008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3860 = Swedish extension of ICD-10 W38 SNOMED CT 419026008, place = industriområde,
        byggarbetsplats, activity = idrott, sport, motion. Clinical injury identical to base W38. Target
        SNOMED CT 4167864 (419026008) is the Athena crosswalk target for W38 and subsumes this source.
