// ICD-10-SE extension codes to SNOMED CT mappings, codes W810-W814
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W810.1" source="W810" target="12994004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W810 SNOMED CT 12994004 is a Swedish national extension of WHO base Confined to or trapped
        in a low-oxygen environment (ICD-10 id 45756327); the Swedish suffix subdivides the base by a
        place/activity external-cause axis with no distinct standard SNOMED CT clinical analogue. Base
        event Athena-crosswalks to SNOMED CT 4045434 (concept_code 12994004) via ICD10 relationship
        45756327 -> 4045434. The Swedish place/activity qualifier is external-cause metadata; the injury
        event is unchanged. Target subsumes the event -> broader. Confidence : verified Athena crosswalk
        on the WHO base, one-level broader (qualifier dropped).
        """
}
mapping "W8100.1" source="W8100" target="12994004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W8100 = SNOMED CT 12994004 (Swedish national extension). Base W81 Athena-crosswalks to
        SNOMED CT 4045434 (concept_code 12994004) via ICD10 relationship 45756327 -> 4045434. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W81, one-level broader (Swedish
        qualifier dropped).
        """
}
