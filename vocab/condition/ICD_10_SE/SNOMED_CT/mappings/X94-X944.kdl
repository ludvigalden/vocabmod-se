// ICD-10-SE extension codes to SNOMED CT mappings, codes X94-X944
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X940.1" source="X940" target="219203009" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 219203009 [GPS]"
}
mapping "X9400.1" source="X9400" target="242869008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X9400 SNOMED CT 242869008 = a Swedish ICD-10-SE national extension that subdivides X94
        (Athena ICD10 concept 45756462) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 435166 = (sctid 242869008), the verified Athena crosswalk target for X94
        (ICD10 relationship 45756462 -> 435166). Why this target: it is the authoritative standard
        concept the parent X94 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
