// ICD-10-SE extension codes to SNOMED CT mappings, codes W2-W205
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W200.1" source="W200" target="59510000" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 59510000 [GPS]"
}
mapping "W2000.1" source="W2000" target="71893005" relationship=partial_overlap quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2000 SNOMED CT 71893005 is a Swedish 5-char extension of base ICD-10 W20 (Struck by thrown,
        projected or falling object), adding place (home/residential area) and activity (sport) detail.
        Target SNOMED CT 4216727 is the crosswalk-verified standard concept for W20. Coverage gap: ICD-10
        W20 scope includes thrown/projected objects, but SNOMED CT target covers only falling objects (the
        throw/projected subset is outside the target). Mapping is partial — target covers only the
        falling-object aspect of the source. Confidence (low): real semantic overlap but documented
        coverage gap inherited from base W20; Swedish place/activity axes additionally unrepresented.
        """
}
