// ICD-10-SE extension codes to SNOMED CT mappings, codes X06-X065
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X060.1" source="X060" target="418611001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 217537005 418611001 [GPS]"
}
mapping "X060.2" source="X060" target="217537005" relationship=equivalent preference=alternative {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X0600.1" source="X0600" target="217534003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X0600 = SNOMED CT 217534003 (Swedish national extension). Base X06 Athena-crosswalks to
        SNOMED CT 439605 (concept_code 217534003) via ICD10 relationship 45756366 -> 439605. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X06, one-level broader (Swedish
        qualifier dropped).
        """
}
