// ICD-10-SE extension codes to SNOMED CT mappings, codes Z9
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Z910A.1" source="Z910A" target="782555009" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Z910A = Swedish ICD-10-SE personal-history code: SNOMED CT 782555009. This is a /status code
        (i den egna sjukhistorien), not an active case. Target SNOMED CT 36674595 = sctid 782555009. Why
        this target: it is the body-system-level (or analogous history-of) SNOMED CT concept that the SE
        code's parenthesized ICD-10 chapter (e.g. C15-C26 digestive) maps to; it records the same
        history-of-cancer-by-system semantics. Why exact_match/ : the SE code is a more specific
        (single-organ) personal-history record subsumed by the system-level history-of concept — a
        verified SNOMED CT concept but a small breadth mismatch (organ specificity lost), so exact_match
        at. Athena-local research only.
        """
}
