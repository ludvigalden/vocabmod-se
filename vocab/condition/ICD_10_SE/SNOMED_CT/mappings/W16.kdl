    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W1600.1" source="W1600" target="217115005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W1600 = Swedish extension of W16 SNOMED CT 217115005 with place (bostad och
        bostadsområde/home) and activity (idrott/sport/motion). Target SNOMED CT 436589 (concept_code
        217115005) =. Athena crosswalk W16→436589 verified; target subsumes every Swedish
        activity/place-specific child. Activity/place dimensions have no SNOMED CT analogue. High tier :
        one-level broader, verified base crosswalk.
        """
}
