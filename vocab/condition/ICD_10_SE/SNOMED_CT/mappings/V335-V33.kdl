mapping "V3364.1" source="V3364" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3364 = Swedish extension of ICD-10 V33.6 (passenger of three-wheeled motor vehicle
        injured in traffic collision with car/light truck) with an added activity context (SNOMED CT
        274913009 = vital activities such as rest, sleep, meals, personal hygiene). Target (Athena
        433930) =, standard (S). Base ICD-10 V33.6 (Athena 45565980) has verified Athena crosswalk to
        433930; the Swedish extension inherits that target. Broader: target subsumes the source (every
        such case is a motor-vehicle-on-road collision), but target drops vehicle-type specificity
        (3-wheeled), role (passenger), and the activity context. moderate: best available standard
        concept, verified crosswalk on the base code, but loose equivalence due to multiple dropped
        source dimensions (role, vehicle type, activity).
        """
}
mapping "V3368.1" source="V3368" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3368 = Swedish extension of V33.6 (passenger, traffic collision with car/light truck)
        with activity SNOMED CT 274913009 (other specified activities). Target (Athena 433930) =, standard
        (S). Base V33.6 (45565980) has verified Athena crosswalk to 433930. Broader: target subsumes
        source but drops vehicle-type, role, and activity context. moderate: verified base crosswalk,
        multi-dimensional specificity loss.
        """
}
