// ICD-10-SE extension codes to SNOMED CT mappings, codes V335-V33
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3350.1" source="V3350" target="418399005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3350 = V33 driver of three-wheeled motor vehicle / car collision, traffic accident,
        sport/exercise. Same analysis as V3330; the traffic-accident driver variant is slightly closer
        to 444074 (which names traffic accidents) but still drops vehicle type and activity. Best
        standard targets: 435134 and 444074, both broader. Low tier.
        """
}
