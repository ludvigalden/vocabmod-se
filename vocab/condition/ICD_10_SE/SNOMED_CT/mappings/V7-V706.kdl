// ICD-10-SE extension codes to SNOMED CT mappings, codes V7-V706
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7000.1" source="V7000" target="220055008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7000 = SNOMED CT 220055008 (ICD-10 SE V70.0 fourth/fifth-digit extension: bus driver,
        pedestrian/animal collision, nontraffic, with activity qualifier sport). Target SNOMED CT 40417896
        (220055008) =. The clinical injury axis (bus driver, pedestrian/animal, nontraffic) is
        identical; SNOMED CT does not encode the activity qualifier. Exact_match on the injury concept;
        (not) because activity axis is dropped. Mirror-verified.
        """
}
