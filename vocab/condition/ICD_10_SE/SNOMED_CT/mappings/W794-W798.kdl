// ICD-10-SE extension codes to SNOMED CT mappings, codes W794-W798
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W794.1" source="W794" target="1345125000" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W794 SNOMED CT 1345125000 = a Swedish ICD-10-SE national extension that subdivides W79
        (Athena ICD10 concept 45756325) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 1447566 = (sctid 1345125000), the verified Athena crosswalk target for
        W79 (ICD10 relationship 45756325 -> 1447566). Why this target: it is the authoritative standard
        concept the parent W79 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch (the SE code is a child of W79). Athena-local research
        only.
        """
}
