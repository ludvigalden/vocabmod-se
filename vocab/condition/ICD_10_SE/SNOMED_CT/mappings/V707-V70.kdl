// ICD-10-SE extension codes to SNOMED CT mappings, codes V707-V70
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7070.1" source="V7070" target="214031005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V70.70 = Swedish extension of V70.7 (bus occupant, person on outside of vehicle, injured
        in traffic collision with pedestrian/animal) + activity SNOMED CT 214031005 36198007. Base V70.7
        (Athena 45609565) maps to SNOMED CT 437165 + 444074. Broader — outside-of-vehicle role and activity
        context lost.
        """
}
