// ICD-10-SE extension codes to SNOMED CT mappings, codes W84
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W840.1" source="W840" target="365024004" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W840 = SNOMED CT 365024004 (Swedish national extension). Base W84 Athena-crosswalks to
        SNOMED CT 4267973 (concept_code 365024004) via ICD10 relationship 45756329 -> 4267973. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base W84, one-level broader (Swedish
        qualifier dropped).
        """
}
