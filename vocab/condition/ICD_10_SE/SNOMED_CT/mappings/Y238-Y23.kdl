// ICD-10-SE extension codes to SNOMED CT mappings, codes Y238-Y23
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y238.1" source="Y238" target="219334005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
}
mapping "Y2380.1" source="Y2380" target="219334005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y2380 SNOMED CT 219334005 = a Swedish ICD-10-SE national extension that subdivides Y23
        (Athena ICD10 concept 45756506) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 435155 = (sctid 219334005), the verified Athena crosswalk target for Y23
        (ICD10 relationship 45756506 -> 435155). Why this target: it is the authoritative standard
        concept the parent Y23 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
