// ICD-10-SE extension codes to SNOMED CT mappings, codes T840-T846
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "T840B.1" source="T840B" target="213104001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T840B = Swedish national extension: mechanical complication of internal joint prosthesis
        in shoulder (parent T84.0 = Mechanical complication of internal joint prosthesis, OMOP
        45570736). Target SNOMED CT 213104001 (OMOP 80269). Source definition: mechanical complication of
        shoulder joint prosthesis specifically. Target definition: mechanical complication of any
        internal joint prosthesis. Why this target: the parent T84.0 crosswalk resolves here; the SNOMED CT
        target is the closest standard concept and the source's shoulder-specific qualifier has no
        separate SNOMED CT concept. moderate: clinically defensible, loses the joint-site specificity.
        """
}
mapping "T840C.1" source="T840C" target="213104001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source T840C = Swedish national extension: mechanical complication of internal joint prosthesis
        in elbow (parent T84.0). Target SNOMED CT 213104001 (OMOP 80269). Same reasoning as T840B; no
        elbow-specific SNOMED CT concept exists. moderate.
        """
}
