// ICD-10-SE extension codes to SNOMED CT mappings, codes V566-V56
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5660.1" source="V5660" target="271579008" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5660 = Swedish subdivision of V56.6 (Passenger of pick-up truck/van injured in traffic
        collision with nonmotor vehicle; activity = sport/exercise). Activity suffix is
        Swedish-administrative, no SNOMED CT analogue. Target SNOMED CT 4152175 — base V56.6 crosswalk target;
        fully covers the traffic crash scenario. 444074 = Victim of vehicular/traffic accident — broader
        context. Both broader: target subsumes crash, drops Swedish activity dimension. Moderate tier:
        verified base-level Athena crosswalk, mechanical extension to Swedish subcode.
        """
}
mapping "V5660.2" source="V5660" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
