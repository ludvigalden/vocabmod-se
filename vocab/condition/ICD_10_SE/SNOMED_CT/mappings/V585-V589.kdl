    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5850.1" source="V5850" target="242116005" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5850 (Swedish ICD-10-SE) = occupant of light truck/van injured in noncollision transport
        accident, driver injured in traffic accident, during sport/activity. Swedish national extension
        of WHO V58.5 (Athena 45604734); activity dimension unrepresented in SNOMED CT. Targets inherited
        from V58.5 Athena SNOMED 242116005 36198007: 432509 (noncollision-on-road mechanism facet),
        444074 (victim-status facet). Each target covers one aspect of the multi-faceted
        transport-injury source (partial); no single SNOMED CT concept captures the full combination. low:
        inherited parent crosswalk applied to a Swedish activity-extension code, not independently
        re-verified, activity specificity lost.
        """
}
