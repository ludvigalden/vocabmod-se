}
mapping "V2901.1" source="V2901" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2901 = Swedish 7-char extension of ICD-10 V29.0 SNOMED CT 214640008 48084008,
        activity-context (play and other leisure). Base V29.0 Athena SNOMED 432510 (Driver in vehicular
        AND/OR traffic accident, 48084008) and 437738 (Motor vehicle accident off public road,
        214640008). No single SNOMED CT concept fully captures V29.0 (driver + nontraffic +
        motorcycle-vehicle collision); 432510 captures the driver role (broader, drops nontraffic and
        motorcycle specificity), 437738 captures the nontraffic/off-public-road aspect (partial, drops
        driver role and motorcycle). Activity-context extension has no SNOMED CT representation. moderate
        for the primary role target; low for the partial aspect target. Granularity 5:
        V2901/V2902/V2903/V2904/V2908 collapse onto these targets.
        """
}
mapping "V2901.2" source="V2901" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "V2902.1" source="V2902" target="48084008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2902 = Swedish 7-char extension of ICD-10 V29.0 (driver, nontraffic collision with motor
        vehicle), activity-context SNOMED CT 214640008 48084008. Base V29.0 Athena SNOMED 432510 (Driver in
        vehicular AND/OR traffic accident, 48084008) and 437738 (Motor vehicle accident off public road,
        214640008). 432510 captures driver role (broader); 437738 captures nontraffic aspect (partial).
        Activity-context administrative, no SNOMED CT representation.
        """
}
