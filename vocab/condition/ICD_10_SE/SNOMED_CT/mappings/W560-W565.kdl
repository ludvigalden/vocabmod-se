// ICD-10-SE extension codes to SNOMED CT mappings, codes W560-W565
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W560.1" source="W560" target="418589001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5600.1" source="W5600" target="80580005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5600 = Swedish national 4-digit extension of W56 SNOMED CT 80580005, qualified by place
        (residential/home area) and activity (sports/exercise). International ICD-10 only has
        3-character W56, which Athena crosswalks to SNOMED CT 4213723 (concept_code 80580005). No SNOMED CT
        concept models place- or activity-qualified exposure events as a single concept. Target fully
        subsumes source; broader mapping at moderate confidence.
        """
}
mapping "W5601.1" source="W5601" target="242620008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5602.1" source="W5602" target="242651001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "W5603.1" source="W5603" target="80580005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5603 = Swedish national 4-digit extension of W56 SNOMED CT 80580005, qualified by place
        (residential/home area) and activity (other occupation). International ICD-10 only has
        3-character W56, which Athena crosswalks to SNOMED CT 4213723 (80580005). No SNOMED CT concept models
        place- or activity-qualified exposure events. Target fully subsumes source; broader mapping at
        moderate confidence.
        """
}
mapping "W5604.1" source="W5604" target="80580005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5604 SNOMED CT 80580005 = Swedish extension of WHO ICD-10 W56 adding epidemiological
        place/activity context (place=home/residential area, activity=vital activity
        (rest/sleep/meals/hygiene)). Target (Athena 4213723) =, standard (S). Base ICD-10 W56 -> 4213723
        verified via Athena crosswalk; the Swedish subcode inherits that target. Broader: target
        subsumes the marine-animal exposure/injury event in full; the place/activity axis is
        administrative/epidemiological context, not a separate clinical dimension, so the medical
        meaning is fully covered. high: verified crosswalk, one-level broader; place/activity
        specificity lost.
        """
}
