// ICD-10-SE extension codes to SNOMED CT mappings, codes W38-W385
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W380.1" source="W380" target="218069008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W380 SNOMED CT 218069008 = ICD-10 W38 (Explosion and rupture of other specified pressurized
        devices), occurrence at home. Target (Athena 437740) =, standard (S). Base ICD-10 W38
        Athena-crosswalks to 437740 (4167864) but 437740 is the closer pressure-vessel-explosion
        standard concept. The deprecated [X] SNOMED CT 220757009 (other specified pressurized devices,
        occurrence at home) is the literal ICD-10 crosswalk but is non-standard (invalid_reason=D).
        Broader: target subsumes as a subtype of pressure-vessel explosion; place detail (home) is
        dropped. high: verified crosswalk family, one-level broader on device specificity.
        """
}
mapping "W3800.1" source="W3800" target="218069008" relationship=source_is_narrower_than_target {
