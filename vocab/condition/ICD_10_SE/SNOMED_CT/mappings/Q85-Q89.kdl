// ICD-10-SE extension codes to SNOMED CT mappings, codes Q85-Q89
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Q858A.1" source="Q858A" target="54411001" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Q858A Swedish extension for Peutz-Jeghers syndrome. Target SNOMED CT 4182399 (concept_code
        54411001) SNOMED CT 54411001, standard_concept=S, identical clinical entity. Exact 1:1 match.
        """
}
