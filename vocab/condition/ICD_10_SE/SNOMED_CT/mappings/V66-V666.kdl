// ICD-10-SE extension codes to SNOMED CT mappings, codes V66-V666
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6600.1" source="V6600" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6600 = Swedish 5th-character extension of ICD-10 V66.0 (driver of heavy transport
        vehicle injured in collision with other nonmotor vehicle, nontraffic accident, activity=idrott,
        sport, motion). The activity-context suffix has no SNOMED CT representation; the base ICD-10 V66.0
        maps via Athena crosswalk to SNOMED CT 437738 (Motor vehicle accident off public road). Target is
        broader: SNOMED CT drops the activity dimension and the specific collision-counterparty detail.
        Confidence : verified Athena crosswalk on the base code, one-level broader.
        """
}
