// ICD-10-SE extension codes to SNOMED CT mappings, codes V27
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V2700.1" source="V2700" target="10298002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V2700 is a Swedish national extension of ICD-10 V27.0 (motorcycle rider in collision with
        fixed/stationary object, driver injured in nontraffic accident), subsplit by activity context =
        idrott, sport, motion (sport/exercise). The activity suffix has no SNOMED CT standard
        representation. Targets follow the parent V27.0 Athena SNOMED 10298002 214640008 48084008
        crosswalk (SNOMED CT id 438310 = motorcycle-rider victim is common to all V27 subcodes). Mapping
        type broader: each target fully subsumes the accident scenario but drops the activity dimension.
        Confidence (moderate): mechanical crosswalk from the parent ICD-10 code, not independently
        re-verified for the Swedish extension.
        """
}
