// ICD-10-SE extension codes to SNOMED CT mappings, codes M3-M6
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "M328A.1" source="M328A" target="55464009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M328A SNOMED CT 55464009 = SLE without detectable antinuclear antibodies. SNOMED CT has no
        concept for ANA-negative SLE specifically (search of SNOMED CT concepts returns only ANA-negative
        juvenile arthritis variants). Best defensible target is SNOMED CT 257628 (55464009, Systemic lupus
        erythematosus), which fully subsumes the source as the parent SLE concept. Broader map: target
        subsumes the source. Moderate tier: best available standard target but loses the ANA-negative
        qualifier; the M32.8 parent crosswalk maps to 257628 (Athena M32.8 -> 257628).
        """
}
mapping "M328B.1" source="M328B" target="238926009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M328B SNOMED CT 238926009 = Rowell's syndrome (LE + EM-like eruption + characteristic
        serology). SNOMED CT 4033928 (238926009) denotes the identical clinical entity; the SNOMED CT FSN
        matches the source verbatim. Standard concept with a self-map in SNOMED/relationships.tdl.
        Exact-equivalent tier.
        """
}
mapping "M328C.1" source="M328C" target="239891002" relationship=partial_overlap {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M328C SNOMED CT 239891002 = subacute cutaneous lupus erythematosus (SCLE). SNOMED CT 4343923
        (239891002, Subacute cutaneous lupus erythematosus) denotes the same disorder. Athena
        SNOMED/relationships.tdl maps 40396334 (the older SCLE concept) -> 4343923, confirming the
        standard target. Source is a Swedish extension under M32.8; the closest standard concept matches
        the source's clinical scope. High tier (not): source term is just which is conventionally
        subacute *cutaneous* LE in Swedish coding, and the target is the standard SCLE concept, but the
        absence of in the source leaves a small breadth mismatch.
        """
}
mapping "M328D.1" source="M328D" target="239889005" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M328D SNOMED CT 239889005 = bullous SLE. SNOMED CT 4346976 (239889005, Bullous systemic lupus
        erythematosus) is the identical clinical entity; FSN matches verbatim. Standard concept with a
        self-map in SNOMED/relationships.tdl. Exact-equivalent tier.
        """
}
mapping "M328W.1" source="M328W" target="55464009" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source M328W SNOMED CT 55464009 = Swedish extension equivalent to ICD-10 M32.8. The Athena
        crosswalk for M32.8 (concept 45572445) -> 257628 (Systemic lupus erythematosus). The target
        fully subsumes the residual source bucket. Broader map: the parent SLE concept subsumes every.
