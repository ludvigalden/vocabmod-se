// ICD-10-SE extension codes to SNOMED CT mappings, codes W457-W45
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W457.1" source="W457" target="93458008" relationship=partial_overlap {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W457 SNOMED CT 93458008 = Swedish ICD-10-SE extension of W45 (Foreign body or object
        entering through skin) adding place-of-occurrence and activity context (Chapter XX
        external-cause codes). Target (Athena 4246661) =, standard Concept (S, valid, Clinical Finding).
        Why this target: the parent ICD-10 W45 (Athena 45756298) has a verified crosswalk to 4246661;
        these Swedish subcodes inherit that target since no standard SNOMED CT concept exists for the
        place/activity combinations (the [X] Event variants 40421808-19 are non-standard,
        invalid_reason=U). Why partial: the source bundles the injury mechanism + place + activity; the
        target captures only the clinical finding (the mechanism). Place and activity are external-cause
        modifiers with no SNOMED CT standard equivalent. low: parent crosswalk is verified but the source
        carries extra dimensions the target does not cover.
        """
}
