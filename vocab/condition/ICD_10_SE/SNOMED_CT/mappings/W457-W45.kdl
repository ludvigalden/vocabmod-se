mapping "W458.1" source="W458" target="93458008" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 93458008 [GPS] [IPS] [GPFP]"
}
mapping "W4580.1" source="W4580" target="93458008" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W4580 = Swedish extension of W45 SNOMED CT 93458008 at. Parent W45 (Athena concept 45756298)
        has verified crosswalk to SNOMED CT 4246661 (Foreign body in skin, concept_code 93458008). The
        Swedish 6-char extension only adds activity-context metadata (sport/leisure/work/etc.), which
        does not change the clinical injury concept. Target is broader: it fully subsumes the injury
        meaning while dropping the activity-place suffix. High tier : parent crosswalk verified,
        activity suffix orthogonal to injury semantics.
        """
}
