// ICD-10-SE extension codes to SNOMED CT mappings, codes V810-V816
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8100.1" source="V8100" target="214878007" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8100 (ICD-10-SE) = SNOMED CT 214878007 36198007 = train operator/passenger injured in
        collision with motor vehicle in nontraffic accident while doing sport/exercise. Swedish
        extension of ICD-10 V81.0 (Athena 45756063). Base V81.0 has Athena crosswalk to SNOMED CT 4061041
        (Motor vehicle nontraffic accident involving collision between motor vehicle and railway train,
        SCTID 214878007) and 444074 (Victim of vehicular AND/OR traffic accident, SCTID 36198007).
        4061041 is the primary target: specific to the V81.0 nontraffic train/motor-vehicle collision
        type, one-level broader (drops Swedish activity context). 444074 is a broader secondary (general
        vehicular accident victim). High/moderate tiers: 4061041 verified crosswalk with minimal breadth
        loss; 444074 additionally loses the nontraffic-train-collision specificity.
        """
}
