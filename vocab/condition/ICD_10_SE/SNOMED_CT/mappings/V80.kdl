// ICD-10-SE extension codes to SNOMED CT mappings, codes V80
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V8000.1" source="V8000" target="215189007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V8000 = Swedish extension of ICD-10 V80.0 (Animal-rider injured by fall from or being
        thrown from animal in noncollision accident) with activity suffix SNOMED CT 215189007 (sports).
        Target SNOMED CT 442212 (concept_code 215189007) =, standard concept. Athena ICD10CM crosswalk for
        V80.010 maps to 440921 (Traumatic injury, overly broad) and 442212; 442212 is the more specific
        relevant accident-event concept. The directly-corresponding SNOMED CT [X] concept 220159004 is
        deprecated (invalid_reason=D) and is therefore not used. Broader: target subsumes the
        animal-vehicle-accident axis but drops the rider-fall specificity and the Swedish
        sports-activity qualifier. Confidence (low): deprecated direct equivalent forces a broader
        fallback; activity dimension lost.
        """
}
