// ICD-10-SE extension codes to SNOMED CT mappings, codes L2
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "L208A.1" source="L208A" target="24079001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L208A SNOMED CT 24079001 = atopic dermatitis in children without food allergy. Target SNOMED CT
        133834 (concept_code 24079001) = Atopic dermatitis, the Athena crosswalk target for L20 and
        L20.8. SNOMED CT has no concept for specifically. The target subsumes the source; broader, moderate
        confidence because the food-allergy exclusion qualifier is lost.
        """
}
mapping "L208B.1" source="L208B" target="24079001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source L208B SNOMED CT 24079001 = atopic dermatitis in children with food allergy. Target SNOMED CT
        133834 (concept_code 24079001) = Atopic dermatitis, the crosswalk target for L20. SNOMED CT has no
        combined concept. The target covers only the dermatitis axis; the food allergy component is
        uncovered. Broader for the dermatitis axis (a partial-decomposition alternative was considered
        but a single broader target is cleaner here); low confidence because the with-food-allergy
        qualifier is clinically significant and lost in mapping.
        """
}
mapping "L208C.1" source="L208C" target="43116000" relationship=equivalent {
