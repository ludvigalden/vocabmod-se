// ICD-10-SE extension codes to SNOMED CT mappings, codes V357-V35
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3570.1" source="V3570" target="242090001" relationship=partial_overlap {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3570 = Swedish 6-char extension of V35.7 SNOMED CT 242090001. Bundles mechanism + occupant
        position + sport-activity context. Target SNOMED CT 4054296 (242090001) covers only the mechanism
        axis (MV vs rail on road). Partial, weak.
        """
}
