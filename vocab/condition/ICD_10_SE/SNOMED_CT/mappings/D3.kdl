mapping "D392A.1" source="D392A" target="95005005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D392A SNOMED CT 95005005 = Invasive mole (a specific gestational trophoblastic neoplasm of
        uncertain behavior). Target SNOMED CT 194598 = (95005005); WHO ICD-10 D39.2 (45600596) Maps to
        194598. Invasive mole is a subtype of placental trophoblastic neoplasia — the SNOMED CT target is
        slightly broader (any placental uncertain-behavior neoplasm) but the crosswalk is verified. High
        tier, exact-match-with-slight-breadth, score.
        """
}
mapping "D392B.1" source="D392B" target="95005005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D392B SNOMED CT 95005005 = Suspected choriocarcinoma (Swedish national subcode of D39.2).
        Choriocarcinoma is a specific malignant trophoblastic tumör, but the ICD-10 D39.2 parent sits
        under and maps to SNOMED CT 194598. The target (uncertain-behavior placental neoplasm) does not
        assert malignancy, while the source specifically suspects choriocarcinoma — the target is
        broader on the uncertainty axis but the source's framing adds clinical specificity. Best
        available standard concept via the D39.2 crosswalk; narrower (target less specific than the
        suspected-malignancy source framing). Confidence : verified crosswalk with a small breadth
        mismatch.
        """
}
