// ICD-10-SE extension codes to SNOMED CT mappings, codes D3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "D349.1" source="D349" target="92439006" relationship=equivalent quality=100 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D349 SNOMED CT 92439006 = benign neoplasm of thyroid gland. Target (Athena-local row
        141249). Athena crosswalk (ICD10 45542696 → SNOMED CT 141249, sct 92439006). Crosswalk-verified
        exact equivalence.
        """
}
mapping "D370A.1" source="D370A" target="271326004" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D370A SNOMED CT 271326004 is the Swedish extension subcode (A = pathologically uncertain
        behavior) of WHO ICD-10 D37.0. Target SNOMED CT 436080 = (concept_code 271326004). Athena crosswalk
        maps WHO D37.0 (45595754) ->; the SNOMED CT concept subsumes both A (pathologically uncertain) and
        B (clinically unknown) Swedish variants because SNOMED CT does not distinguish the basis of
        uncertainty. High tier: verified crosswalk, only the A/B distinction is lost, target fully
        contains source.
        """
}
mapping "D370B.1" source="D370B" target="271326004" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D370B SNOMED CT 271326004 is the Swedish extension subcode (B = clinically unknown behavior)
        of WHO ICD-10 D37.0. Target SNOMED CT 436080 =. Same rationale as D370A: Athena crosswalk for D37.0
        (45595754) -> 436080; SNOMED CT covers both uncertain/unknown behavior variants. High tier:
        verified crosswalk, A/B distinction not represented in SNOMED CT.
        """
}
