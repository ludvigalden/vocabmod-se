// ICD-10-SE extension codes to SNOMED CT mappings, codes V4-V40
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4000.1" source="V4000" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4000 = Swedish extension of ICD-10 V40.0 SNOMED CT 214640008 36198007 with activity suffix.
        Base V40.0 (OMOP 45570882) has Athena crosswalk to SNOMED CT 214640008 (Motor vehicle accident off
        public road, OMOP 437738) and 36198007 (Victim of vehicular AND/OR traffic accident, OMOP
        444074). Activity suffix is Swedish administrative context with no SNOMED CT analogue. Broader
        mapping: target subsumes the accident content. Confidence : verified crosswalk on base code.
        """
}
