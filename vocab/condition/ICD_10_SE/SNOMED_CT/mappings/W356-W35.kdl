// ICD-10-SE extension codes to SNOMED CT mappings, codes W356-W35
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W356.1" source="W356" target="218070009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W356 = Swedish 4-char extension of W35 specifying place=SNOMED CT 218070009 (industrial
        area/construction site). Base W35 → SNOMED CT 433117 (Athena crosswalk). Place suffix is Swedish
        national context subdivision; no separate SNOMED CT target exists. Mapped to verified parent
        target.
        """
}
mapping "W3560.1" source="W3560" target="218070009" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W3560 = Swedish extension of W35, place=industrial area/construction site,
        activity=sport. Base W35 → SNOMED CT 433117 (Athena crosswalk). Target fully contains clinical
        concept; suffix is administrative context. One-level broader, crosswalk-verified.
        """
}
mapping "W3561.1" source="W3561" target="218070009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is the Swedish ICD-10-SE national extension of W35 (Explosion and rupture of boiler /
        SNOMED CT 218070009), encoding place (industrial/construction site, agricultural area, other
        specified, unspecified) and activity (sports, leisure, paid work, other, vital activities, other
        specified, unspecified) subdivisions. Target SNOMED CT 433117 = (concept_code 218070009), the
        Athena crosswalk target for the base ICD-10 W35. Every place/activity subdivision is a more
        specific instance of a boiler-explosion accident, so the target fully subsumes the source
        (broader, one level). No SNOMED CT concept exists for the Swedish place/activity axes. High :
        verified crosswalk to the closest standard concept, one-level broader.
        """
}
