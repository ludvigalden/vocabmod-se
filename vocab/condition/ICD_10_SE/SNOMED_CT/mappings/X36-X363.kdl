// ICD-10-SE extension codes to SNOMED CT mappings, codes X36-X363
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X360.1" source="X360" target="217738002" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "X3600.1" source="X3600" target="217736003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X3600 = SNOMED CT 217736003 (Swedish national extension). Base X36 Athena-crosswalks to
        SNOMED CT 439480 (concept_code 217736003) via ICD10 relationship 45756393 -> 439480. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X36, one-level broader (Swedish
        qualifier dropped).
        """
}
