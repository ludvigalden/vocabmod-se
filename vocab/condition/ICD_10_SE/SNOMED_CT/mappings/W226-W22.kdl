// ICD-10-SE extension codes to SNOMED CT mappings, codes W226-W22
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W226.1" source="W226" target="217848007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W226 (ICD-10-SE) = struck by/against other object(s) in an industrial area/construction
        site (place only). Swedish extension of WHO W22; WHO W22 (Athena 45756260) Maps-to SNOMED CT 441192
        (217848007 SNOMED CT 217848007, standard). Source adds a place qualifier; target subsumes it.
        One-level broader, verified crosswalk; confidence.
        """
}
mapping "W2260.1" source="W2260" target="217848007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2260 (ICD-10-SE) = struck by/against other object(s) in an industrial area/construction
        site, while doing sport/exercise. Swedish 7-char extension of WHO W22; see W226 for reasoning.
        WHO W22 Maps-to SNOMED CT 441192 (217848007). One-level broader, verified crosswalk; confidence.
        """
}
mapping "W2261.1" source="W2261" target="217848007" relationship=source_is_narrower_than_target quality=100 {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W2261 = Swedish national extension of W22 SNOMED CT 217848007 at an industrial/construction
        area during leisure/play. Swedish codes add a place+activity axis (7th-char extension) with no
        standard OMOP/SNOMED CT equivalent combining both. Parent W22 crosswalks via Athena to SNOMED CT
        441192 (Accidentally struck by or against objects or persons, concept_code 217848007), which
        legitimately subsumes every W22XX child regardless of place/activity. One-level broader,
        crosswalk-verified via parent W22.
        """
}
