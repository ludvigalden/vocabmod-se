// ICD-10-SE extension codes to SNOMED CT mappings, codes W006-W00
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W006.1" source="W006" target="242387001" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W006 = Swedish 4th-character subdivision of W00 by place: SNOMED CT 242387001. Base ICD-10
        W00 maps to SNOMED CT 4053863 (242387001). Place subdivision is administrative context; the
        clinical injury is W00. Exact_match at.
        """
}
mapping "W0060.1" source="W0060" target="242387001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
