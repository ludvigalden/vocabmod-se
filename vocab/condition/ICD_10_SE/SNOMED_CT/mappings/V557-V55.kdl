// ICD-10-SE extension codes to SNOMED CT mappings, codes V557-V55
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V5570.1" source="V5570" target="242090001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V5570 = Swedish 5th-character extension of V55.7 SNOMED CT 242090001, activity. Base V55.7
        (Athena 45756634) maps to SNOMED CT 4054296 (Motor vehicle on road in collision with vehicle
        running on rails). Target subsumes source; vehicle subtype, position (outside), activity context
        lost. Moderate tier.
        """
}
