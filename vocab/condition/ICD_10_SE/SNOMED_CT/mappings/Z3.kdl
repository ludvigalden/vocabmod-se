// ICD-10-SE extension codes to SNOMED CT mappings, codes Z3
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Z311A.1" source="Z311A" target="408960001" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Z311A = Swedish ICD-10-SE national extension of Z31 SNOMED CT 408960001 (Athena ICD10
        concept 45756074), refined by Swedish external-cause metadata: place=institutionellt boende
        (institutional residential setting); activity=activity code A. The clinical event/exposure is
        unchanged; the Swedish place/activity qualifiers are external-cause metadata with no distinct
        standard SNOMED CT clinical analogue. Target SNOMED CT 4258374 = sctid 408960001. Why this target:
        Athena ICD10 crosswalk maps base Z31 (concept_id 45756074) -> 4258374 (relationship 45756074,
        4258374); it is the authoritative standard concept for Z31 and fully subsumes every
        place/activity-specific SE subdivision. mapping_type=broader (target fully contains every
        clinical meaning of the source; the dropped qualifier is breadth-neutral external-cause
        metadata, not a partial slice). Confidence (high): verified Athena crosswalk on the base code
        with a small, well-understood one-level breadth mismatch (the SE place/activity refinement is
        lost). Athena-local research only.
        """
}
