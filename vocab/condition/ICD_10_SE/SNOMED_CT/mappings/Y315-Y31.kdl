// ICD-10-SE extension codes to SNOMED CT mappings, codes Y315-Y31
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y315.1" source="Y315" target="242984003" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y315 SNOMED CT 242984003 = a Swedish ICD-10-SE national extension that subdivides Y31
        (Athena ICD10 concept 45756514) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 4055230 = (sctid 242984003), the verified Athena crosswalk target for
        Y31 (ICD10 relationship 45756514 -> 4055230). Why this target: it is the authoritative standard
        concept the parent Y31 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
mapping "Y3150.1" source="Y3150" target="242984003" relationship=source_is_broader_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        curated re-elevation (narrower): Source Y3150 = SE extension of WHO Y31 SNOMED CT 242984003 + place
        (commercial/service) + activity (sport). Verified Maps-to 45756514 (Y31) -> 4055230 (242984003,
        standard S). Intent matches (undetermined == unknown), but is MORE SPECIFIC than (veh.
        """
}
