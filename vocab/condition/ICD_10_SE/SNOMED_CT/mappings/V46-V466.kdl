// ICD-10-SE extension codes to SNOMED CT mappings, codes V46-V466
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V4600.1" source="V4600" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4600 = Swedish extension of V46.0 SNOMED CT 214640008. Parent V46.0 (Athena 45590251)
        crosswalks to SNOMED CT 437738 (Motor vehicle accident off public road). Target captures the
        nontraffic motor vehicle accident event; activity qualifier (sport) has no SNOMED CT
        representation. Broader: target fully contains the injury event, drops the activity detail. High
        tier: verified parent crosswalk, one-level breadth loss.
        """
}
mapping "V4601.1" source="V4601" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4601 = Swedish extension of V46.0 (car driver, nonmotor vehicle collision, nontraffic
        accident, leisure). Parent V46.0 (45590251) crosswalks to 437738. Broader mapping; activity not
        in SNOMED CT. High tier.
        """
}
mapping "V4602.1" source="V4602" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V4602 = Swedish extension of ICD-10 V46.0 (driver of car injured in nontraffic collision
        with nonmotor vehicle, while engaged in förvärvsarbete/paid work). The
        activity-at-time-of-accident suffix (Y93-style) has no SNOMED CT representation; the core clinical
        event is the accident. Target SNOMED CT 437738 (concept_code 214640008), which is the verified
        SNOMED CT 214640008 target for the parent V46.0. Target subsumes the source's accident axis but
        loses the activity dimension, hence broader. Moderate tier: mechanical crosswalk via parent
        V46.0, not independently re-verified for the Swedish extension.
        """
}
