    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W596.1" source="W596" target="220960005" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W596 SNOMED CT 220960005. Target. Source and target denote the same clinical concept at the
        same specificity level (injury mechanism + place, no activity modifier). Exact match
        crosswalk-verified.
        """
}
