// ICD-10-SE extension codes to SNOMED CT mappings, codes V33-V334
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V3300.1" source="V3300" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V3300 is a Swedish ICD-10-SE 5th-character extension of parent ICD-10 V33.0 (V33.0 =
        driver of three-wheeled motor vehicle injured in nontraffic collision with car/pick-up/van); the
        5th digit adds a Swedish SNOMED CT 214640008 36198007 axis (sport/work/leisure/vital activity)
        absent from the standard V-code and with no separate SNOMED CT representation. Parent V33.0 has an
        Athena crosswalk to SNOMED CT 437738 (Motor vehicle accident off public road); 444074 (Victim of
        vehicular AND/OR traffic accident). The parent's SNOMED CT target fully subsumes the clinical
        meaning (vehicle-occupant injury in a collision of this type); the activity axis is
        administrative context, not a clinical distinction, so target is broader. moderate: Athena
        crosswalk inherited from the parent, source-extension specificity (activity context) not
        independently re-verified in SNOMED CT.
        """
}
mapping "V3300.2" source="V3300" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
