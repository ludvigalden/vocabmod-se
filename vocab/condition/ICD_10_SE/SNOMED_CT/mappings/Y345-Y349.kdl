// ICD-10-SE extension codes to SNOMED CT mappings, codes Y345-Y349
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "Y345.1" source="Y345" target="269735005" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source Y345 SNOMED CT 269735005 = a Swedish ICD-10-SE national extension that subdivides Y34
        (Athena ICD10 concept 45756517) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 443272 = (sctid 269735005), the verified Athena crosswalk target for Y34
        (ICD10 relationship 45756517 -> 443272). Why this target: it is the authoritative standard
        concept the parent Y34 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
