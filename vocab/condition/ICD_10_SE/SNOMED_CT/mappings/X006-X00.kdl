// ICD-10-SE extension codes to SNOMED CT mappings, codes X006-X00
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X006.1" source="X006" target="217176002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X006 = SNOMED CT 217176002 (Swedish national extension). Base X00 Athena-crosswalks to
        SNOMED CT 432504 (concept_code 217176002) via ICD10 relationship 45756360 -> 432504. The Swedish
        extension subdivides the base event by a place/activity/qualifier axis with no distinct standard
        SNOMED CT clinical analogue; the underlying clinical event is unchanged. Target subsumes the source
        event -> broader. Confidence : verified Athena crosswalk on base X00, one-level broader (Swedish
        qualifier dropped).
        """
}
