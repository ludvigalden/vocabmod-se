// ICD-10-SE extension codes to SNOMED CT mappings, codes W54-W545
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W540.1" source="W540" target="217697000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" "SNOMED CT 217697000 [GPS] [IPS]"
}
mapping "W5400.1" source="W5400" target="37383006" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W5400 = Bitten or struck by dog - home/residential area - sports/exercise. Target SNOMED CT
        37383006. Athena crosswalk: ICD10 45756305 (W54) Maps to. Target subsumes source (mammal attack
        includes dog bite/strike). One-level breadth mismatch with verified crosswalk. High tier.
        Place+activity modifiers have no SNOMED CT external-cause equivalent.
        """
}
