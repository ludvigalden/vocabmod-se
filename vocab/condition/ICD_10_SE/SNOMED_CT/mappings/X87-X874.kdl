// ICD-10-SE extension codes to SNOMED CT mappings, codes X87-X874
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X870.1" source="X870" target="219186006" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source X870 SNOMED CT 219186006 = a Swedish ICD-10-SE national extension that subdivides X87
        (Athena ICD10 concept 45756455) by Swedish place/activity axes with no separate standard SNOMED CT
        analogue. Target SNOMED CT 440599 = (sctid 219186006), the verified Athena crosswalk target for X87
        (ICD10 relationship 45756455 -> 440599). Why this target: it is the authoritative standard
        concept the parent X87 maps to, and the SE subdivision is fully contained by it.
        mapping_type=broader (target subsumes the source). Confidence (high): verified crosswalk with a
        small, well-understood breadth mismatch. Athena-local research only.
        """
}
