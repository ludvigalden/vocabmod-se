// ICD-10-SE extension codes to SNOMED CT mappings, codes V727-V72
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7270.1" source="V7270" target="274913009" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7270 = Swedish extension of ICD-10 V72.7 SNOMED CT 274913009 36198007, activity =
        idrott/sport/motion. V72.7 has Athena crosswalk to SNOMED CT 433930 (Motor vehicle on road in
        collision) + 444074 (Victim of vehicular accident). Activity dimension lost; targets broader.
        Moderate confidence.
        """
}
