// ICD-10-SE extension codes to SNOMED CT mappings, codes W51-W515
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W510.1" source="W510" target="58538004" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source is a Swedish national extension of ICD-10 W51 SNOMED CT 58538004 with added place/activity
        specificity. Target SNOMED CT 4239303 (concept_code 58538004, standard_concept=S) is the Athena
        crosswalk target for base W51 (ICD10 concept 45756302). The target is semantically co-extensive
        with the event-type meaning of the source; place/activity suffix is circumstantial metadata.
        Mapping type broader because the target does not capture the place/activity specificity.
        Confidence (moderate): crosswalk inherited from parent W51; Swedish extension subcode has no
        direct OMOP entry.
        """
}
