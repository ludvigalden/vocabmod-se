// ICD-10-SE extension codes to SNOMED CT mappings, codes V600-V604
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V6000.1" source="V6000" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V6000 = Swedish extension of ICD-10 V60.0 (driver of heavy transport vehicle injured in
        collision with pedestrian or animal in a nontraffic accident) with activity modifier SNOMED CT
        214640008 36198007 (sport/exercise). The base V60.0 nontraffic-accident code crosswalks in
        Athena to SNOMED CT 437738 (Motor vehicle accident off public road, 214640008) and 444074 (Victim
        of vehicular AND/OR traffic accident, 36198007). Both are standard concepts and subsume the
        source (nontraffic accident context fully covered). The activity 7th character has no SNOMED CT
        representation, so broader rather than exact.
        """
}
mapping "V6000.2" source="V6000" target="36198007" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
