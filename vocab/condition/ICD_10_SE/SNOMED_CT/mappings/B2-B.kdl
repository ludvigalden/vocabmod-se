// ICD-10-SE extension codes to SNOMED CT mappings, codes B2-B
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "B249.1" source="B249" target="86406008" relationship=equivalent effect=omitted quality=60 {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source B249 SNOMED CT 86406008 = (B24, the unspecified HIV disease code). The ICD10 base B24
        (45547443) crosswalks in Athena to SNOMED CT 439727 (86406008). The unspecified framing of the
        source matches the unspecified/general HIV-infection concept exactly.
        """
}
