// ICD-10-SE extension codes to SNOMED CT mappings, codes C49
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "C499A.1" source="C499A" target="39000009" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499A SNOMED CT 39000009 = hemangiosarcoma, unspecified site. Target SNOMED CT 4191591
        (Hemangiosarcoma, 39000009). Histology matches exactly; source site unspecified, SNOMED CT concept
        is morphology-only. High tier: term-equivalent SNOMED CT concept.
        """
}
mapping "C499B.1" source="C499B" target="403986008" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499B SNOMED CT 403986008 = lymphangiosarcoma, unspecified site. Target SNOMED CT 4298141
        (Lymphangiosarcoma, 403986008). Histology matches exactly; source site unspecified. High tier:
        term-equivalent SNOMED CT concept.
        """
}
mapping "C499C.1" source="C499C" target="128768006" relationship=equivalent {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499C SNOMED CT 128768006 = endovascular papillary angioendothelioma (Dabska tumör),
        unspecified site. Target SNOMED CT 4030138 (Papillary intralymphatic angioendothelioma, 128768006).
        The Swedish endovaskulärt papillärt angioendoteliom is the Dabska tumör, clinically synonymous
        with papillary intralymphatic angioendothelioma (PILA); current SNOMED CT/WHO naming. High tier:
        term-equivalent (synonym) SNOMED CT concept.
        """
}
mapping "C499D.1" source="C499D" target="59238007" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499D SNOMED CT 372010005 59238007 = Enzinger's epithelioid sarcoma at unspecified site
        (Swedish national-extension 5th-char histology code under C49.9). Primary target 4244886 (SNOMED CT
        59238007) = Epithelioid sarcoma, the matching histology concept; source adds only a site
        qualifier, so the target subsumes the source on the site axis (broader). Alt 376647 (SNOMED CT
        372010005) = Primary malignant neoplasm of soft tissues, the OMOP crosswalk target for parent
        C49/C49.9 (lower confidence; loses histology). Moderate tier for primary: SNOMED CT-browser match
        on histology, site unspecified, athena crosswalk only at parent level.
        """
}
mapping "C499D.2" source="C499D" target="372010005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
}
mapping "C499E.1" source="C499E" target="372010005" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499E SNOMED CT 372010005 = Fibrosarcoma at unspecified site (Swedish national-extension
        histology subcode of C49.9). No general standard concept present in the athena SNOMED CT mirror;
        the only fibrosarcoma rows are site-specific (spleen 187822008, cutaneous 254748009, connective
        tissue 448139005, infantile 403996004) and would be narrower or partial rather than broader.
        Target 376647 = Primary malignant neoplasm of soft tissues, the athena Maps-to target for parent
        C49 and C49.9. Mapping up to the soft-tissue malignancy parent is the safest defensible target;
        histology axis is lost. Low tier: parent-level athena crosswalk only, histology specificity
        lost.
        """
}
mapping "C499F.1" source="C499F" target="254828009" relationship=source_is_narrower_than_target {
    confidence 0.71 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499F SNOMED CT 254828009 = Liposarcoma at unspecified site (Swedish national-extension
        histology subcode of C49.9). Target 4116070 = Liposarcoma, the matching histology concept with
        no site restriction; source adds only so target subsumes source on site axis (broader). Moderate
        tier: SNOMED CT-browser match on histology, site unspecified, no athena crosswalk at this code
        (parent C49/C49.9 crosswalk is one level up).
        """
}
mapping "C499G.1" source="C499G" target="28351005" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499G SNOMED CT 28351005 = Myxosarcoma at unspecified site (Swedish national-extension
        histology subcode of C49.9). Target 4151677 = Myxosarcoma, the matching histology concept;
        source adds only so target subsumes source on site axis (broader). Moderate tier: SNOMED CT-browser
        match on histology, no athena crosswalk at this code (parent C49/C49.9 crosswalk is one level
        up).
        """
}
