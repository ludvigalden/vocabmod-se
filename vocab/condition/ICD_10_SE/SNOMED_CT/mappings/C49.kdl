mapping "C499W.1" source="C499W" target="372010005" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499W SNOMED CT 372010005 = Other malignant tumors of connective and soft tissue at
        unspecified site (Swedish residual bucket, national-extension subcode of C49.9). Heterogeneous
        residual source; no single histology SNOMED CT target dominates. Target 376647 = Primary malignant
        neoplasm of soft tissues, the athena Maps-to target for parent C49 and C49.9; fully subsumes the
        source (broader). Low tier: residual bucket, parent-level athena crosswalk only, histology axis
        undefined.
        """
}
mapping "C499X.1" source="C499X" target="372010005" relationship=source_is_narrower_than_target effect=omitted quality=60 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source C499X SNOMED CT 372010005 = Unspecified malignant tumör of connective and soft tissue at
        unspecified site (Swedish national-extension subcode of C49.9). Target 376647 = Primary
        malignant neoplasm of soft tissues, the athena Maps-to target for parent C49 and C49.9; fully
        subsumes the source (broader). Moderate tier: athena crosswalk at parent level, unspecified
        source maps to the general soft-tissue malignancy concept (precedent).
        """
}
