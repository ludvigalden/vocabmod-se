// ICD-10-SE extension codes to SNOMED CT mappings, codes W39-W395
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W390.1" source="W390" target="218100007" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W390 = Swedish extension of WHO ICD-10 W39 SNOMED CT 218100007 with place context (home and
        residential area). Target = (Event, standard_concept=S). Athena crosswalk maps parent W39
        (concept 45756292) to 218100007. Swedish sub-code adds only non-clinical place context that does
        not change the condition concept; clinical equivalence to parent W39 is exact. High tier (not):
        no direct Athena crosswalk for the Swedish-specific code, inherited from parent.
        """
}
