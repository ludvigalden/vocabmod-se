mapping "D411A.1" source="D411A" target="95161002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D411A SNOMED CT 95161002 = Neoplasm of uncertain behavior of renal pelvis. WHO ICD-10 D41.1
        (45605363) Maps to SNOMED CT 442129 (95161002) in Athena. The SNOMED CT target is anatomically
        ureter-focused but is the standard concept OMOP designates for the renal-pelvis ICD-10 source;
        SNOMED CT lacks a separate renal-pelvis uncertain-behavior concept, so 442129 is broader
        (upper-urinary-tract grouping). Verified crosswalk with a small anatomical breadth mismatch:
        high, broader.
        """
}
mapping "D411B.1" source="D411B" target="95161002" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D411B SNOMED CT 95161002 = Neoplasm of unknown behavior of renal pelvis. Same SNOMED CT target
        442129 via WHO D41.1 crosswalk; broader (ureter-grouping target), high.
        """
}
mapping "D412A.1" source="D412A" target="95161002" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D412A SNOMED CT 95161002 = Neoplasm of uncertain behavior of ureter. Target SNOMED CT 442129 =
        (95161002). Exact clinical-concept equivalence — source and target denote the same disorder at
        the same specificity. WHO D41.2 is the ureter subcode and is its direct equivalent; the D41.1
        renal-pelvis row in this mirror also maps here (see D411), but for D41.2 ureter the match is
        exact.
        """
}
mapping "D412B.1" source="D412B" target="95161002" relationship=equivalent {
