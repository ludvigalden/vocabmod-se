// ICD-10-SE extension codes to SNOMED CT mappings, codes D40-D44
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "D400A.1" source="D400A" target="95014000" relationship=equivalent {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source D400A SNOMED CT 95014000 = Neoplasm of uncertain behavior of prostate. Target SNOMED CT 201527
        = (95014000). WHO ICD-10 D40.0 (45552351) Maps to 201527 in Athena. Exact equivalence.
        """
}
