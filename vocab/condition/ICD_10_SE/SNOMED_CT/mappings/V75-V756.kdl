// ICD-10-SE extension codes to SNOMED CT mappings, codes V75-V756
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "V7500.1" source="V7500" target="214640008" relationship=equivalent quality=100 {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V75.00 (SE ext of V75.0) = bus driver injured in non-traffic collision with railway
        train, sport activity. Base ICD10 V75.0 (45756027) Athena SNOMED 214640008 SNOMED CT 437738 (Motor
        vehicle accident off public road, 214640008). Non-traffic event so 444074 (Victim of vehicular
        AND/OR traffic accident) does not apply. Activity qualifier unmapped. Confidence :
        crosswalk-verified, activity extension not represented.
        """
}
mapping "V7501.1" source="V7501" target="214640008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V75.01 (SE ext of V75.0) = bus driver injured in non-traffic collision with railway
        train, leisure activity. Same base V75.0 crosswalk to 437738. Non-traffic event, no traffic
        victim concept. Activity unmapped.
        """
}
mapping "V7502.1" source="V7502" target="214640008" relationship=equivalent {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V75.02 (SE ext of V75.0) = bus driver injured in non-traffic collision with railway
        train, paid work. Same base V75.0 crosswalk to 437738. Non-traffic event. Activity unmapped.
        """
}
mapping "V7503.1" source="V7503" target="214640008" relationship=source_is_narrower_than_target {
    confidence 0.03 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source V7503 is a Swedish ICD-10 SE extension of parent V75.0 (bus occupant injured in collision
        with railway train, nontraffic accident) that adds an activity qualifier (SNOMED CT 214640008).
        Target SNOMED CT 437738 =. The activity qualifier has no SNOMED CT representation; the target fully
        captures the clinical accident event via the parent V75.0 Athena crosswalk. broader: target
        subsumes the source (source is a more specific instance with activity context the target lacks).
        Moderate tier : mechanical crosswalk via parent V75.x code, SE extension not independently
        re-verified in SNOMED CT browser.
        """
}
