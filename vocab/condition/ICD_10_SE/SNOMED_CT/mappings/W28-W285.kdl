// ICD-10-SE extension codes to SNOMED CT mappings, codes W28-W285
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "W280.1" source="W280" target="218017003" relationship=source_is_narrower_than_target {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    comment "en" """
        Source W280 = Swedish extension of W28 SNOMED CT 218017003 with place (home and residential area).
        Target SNOMED CT 435145 = (218017003), the verified Athena crosswalk target for base W28 (ICD10
        concept 45756281 -> 435145). Target is the standard concept; the [X]-prefixed place-specific
        SNOMED CT siblings (e.g. 220645005) are non-standard in OMOP. Target captures the core accident
        event but not the Swedish place qualifier; broader. High tier: verified crosswalk to parent,
        one-level breadth on the place axis.
        """
}
