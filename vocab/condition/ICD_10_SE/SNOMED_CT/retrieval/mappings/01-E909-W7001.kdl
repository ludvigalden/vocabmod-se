// ICD-10-SE retrieval adjudication mappings to SNOMED CT, codes E909-W7001
// Each mapping records a two-pass blinded rubric adjudication;
// targets referenced by code only.
// Individual Swedish diagnosis titles quoted in the rationales below are quotations from
// E-hälsomyndigheten, ICD-10-SE (svenska tilläggskoder), release 2026. They serve as
// adjudication evidence for the individual mappings; the classification itself is not
// redistributed.
context {
    collection "icd-10-se-snomed-ct-retrieval" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "E909.retr.1" source="E909" target="2492009" relationship=source_is_narrower_than_target preference=primary {
    confidence 0.87 scheme="vocabmod-se-confidence@1"
    rationale "en" "Two-pass blinded rubric adjudication: both passes accepted this SNOMED CT concept. Evidence: Condition (ICD-10-SE E909: rubbningar i nutrition och ämnesomsättning vid sjukdomar som klassificeras på annan plats); SNOMED CT 4090739 is entailed as the nutritional. Omissions recorded: metabolic disturbance component (ämnesomsättning), underlying disease classified elsewhere (vid sjukdomar som klassificeras på annan plats)."
}
