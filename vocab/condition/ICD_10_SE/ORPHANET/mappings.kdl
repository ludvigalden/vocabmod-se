// ICD-10-SE extension codes to Orphanet mappings, codes A389-M084A
context {
    collection "icd-10-se-orphanet" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="ORPHANET"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "A389.3" source="A389" target="36235" preference=alternative {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "H469.3" source="H469" target="499096" preference=alternative {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "M082A.4" source="M082A" target="85414" preference=alternative {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
}
mapping "M084A.2" source="M084A" target="85410" preference=alternative {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
}
