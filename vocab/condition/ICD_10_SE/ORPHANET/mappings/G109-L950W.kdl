// ICD-10-SE extension codes to Orphanet mappings, codes G109-L950W
// Derived, weak: an extension code inherits its ICD-10 parent's validated
// one-to-one Orphanet alignment as a narrower claim. Parents Orphanet aligns
// only to narrower or wider ORPHAcodes pass nothing on. Alignment data from
// Orphanet (Orphadata en_product1, data version 2026-06-23), © INSERM 1999,
// CC BY 4.0, accessed 2026-11-04; carried as codes only.
context {
    collection "icd-10-se-orphanet" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="ORPHANET"
}
defaults {
    mappings {
        preference "alternative"
        assessment-method "derived-parent-alignment"
    }
}
mapping "G109.orphanet.1" source="G109" target="399" relationship=source_is_narrower_than_target {
    confidence 2 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "Derived through the ICD-10 parent: Orphanet's validated ICD-10 alignment equates G10 with ORPHA:399 (Orphadata en_product1, data version 2026-06-23). The Swedish extension code G109 refines G10, so it is narrower than the target."
}
