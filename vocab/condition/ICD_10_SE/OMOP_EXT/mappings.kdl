// ICD-10-SE extension codes to OMOP concept mappings, code Z854A
context {
    collection "icd-10-se-omop-ext" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_EXT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
omop-binding "Z854A.omop" concept="Z854A" omop="OMOP_EXT:1340204"
