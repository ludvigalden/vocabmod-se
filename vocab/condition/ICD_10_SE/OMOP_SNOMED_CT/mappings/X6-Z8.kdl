// ICD-10-SE extension codes to OMOP SNOMED CT concept mappings, codes X6-Z8
// Standard targets: the OMOP ids resolve to SNOMED CT
// Condition concepts (standard in the OMOP CDM by domain knowledge;
// the source itself carries no standard flag).
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X600.3" source="X600" target="4233034" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        5th-char extension (.0 = initial encounter) under X60 SNOMED CT 439011002; base concept 439011002
        is standard SNOMED CT and encounter suffix preserved as custom
        """
}
