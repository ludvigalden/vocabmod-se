// ICD-10-SE extension codes to OMOP SNOMED CT concept mappings, codes R3-W7
// Standard targets: the OMOP ids resolve to SNOMED CT
// Condition concepts (standard in the OMOP CDM by domain knowledge;
// the source itself carries no standard flag).
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
