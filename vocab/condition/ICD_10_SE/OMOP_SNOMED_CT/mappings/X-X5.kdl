// ICD-10-SE extension codes to OMOP SNOMED CT concept mappings, codes X-X5
// Standard targets: the OMOP ids resolve to SNOMED CT
// Condition concepts (standard in the OMOP CDM by domain knowledge;
// the source itself carries no standard flag).
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "X100.2" source="X100" target="4054153" relationship=equivalent quality=100 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" "4-char external cause (contact with hot drinks) -> exact SNOMED CT match; crosswalk-verified"
}
mapping "X4100.3" source="X4100" target="44783281" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Accidental poisoning by antiepileptic/sedative/psychotropic drugs; SNOMED CT Accidental poisoning
        by psychotropic agent 699011008 covers only psychotropic subset of ICD scope
        """
}
mapping "X4101.3" source="X4101" target="441768" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        5th/6th-char extension of X41 (antiepileptic/sedative/psychotropic poisoning, home/play). No
        substance-specific standard SNOMED CT. Weak link to 218249005.
        """
}
mapping "X4108.3" source="X4108" target="44783281" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Swedish ext subcode of X41 (accidental poisoning by CNS drugs, housing) -> (699011008); base
        code concept, activity/location suffix preserved
        """
}
mapping "X4109.3" source="X4109" target="44783281" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        ICD X41 covers antiepileptics/sedatives/hypnotics/anti-Parkinsonism/psychotropic drugs; SNOMED CT
        candidate only covers psychotropic agents; subset match
        """
}
