        """
}
mapping "X4208.3" source="X4208" target="441768" relationship=equivalent preference=alternative effect=omitted quality=40 {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        X42 = accidental poisoning by narcotics and hallucinogens NEC.08 = Swedish activity qualifier.
