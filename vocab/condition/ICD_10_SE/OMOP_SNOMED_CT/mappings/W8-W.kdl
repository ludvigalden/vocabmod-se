context {
    collection "icd-10-se-omop-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
