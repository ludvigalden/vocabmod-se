// ICD-10-SE extension codes to OMOP SNOMED CT concept mappings, codes D8-G4
// Standard targets: the OMOP ids resolve to SNOMED CT
// Condition concepts (standard in the OMOP CDM by domain knowledge;
// the source itself carries no standard flag).
// Several sources map to the same target; each mapping is its own assertion.
context {
    collection "icd-10-se-omop-snomed-ct" version="2026.1"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "D824B.3" source="D824B" target="40389200" relationship=equivalent preference=alternative {
    confidence 4 scheme="vocabmod-se-confidence-unassessable@1"
    comment "en" """
        Swedish extension code B (recurrent episode) of D82.4 Hyperimmunoglobulin E syndrome; prior
        nonstandard 4177007 deprecated; standard replacement 191009009
        """
}
