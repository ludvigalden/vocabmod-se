// ICD-10-SE extension codes: the Swedish codes with no WHO analogue. Shared codes live in ICD-10;
// an extension code's parent may be one.
system "ICD_10_SE" kind=classification distribution=published publisher="se.ehalsomyndigheten" extends="ICD_10" default-locale="sv" {
    name "sv" "ICD-10-SE, svenska tilläggskoder"
}
release "2026" system="ICD_10_SE" label-source=registry imported-version="2017" {
    dependencies "ICD_10@2016"
}
context {
    system "ICD_10_SE" release="2026"
}
category "extension" {
    name "en" "Swedish five-character extension"
}
collection "icd-10-se-meddra" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-10-SE to MedDRA"
    authors "ludvig-alden"
    source system="ICD_10_SE" release="2026"
    target system="MEDDRA"
    defaults {
        mappings {
            claim-scope "icd-10-se-meddra@2026.1"
            relationship "equivalent"
        }
    }
    import "MEDDRA/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
collection "icd-10-se-omop-ext" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-10-SE to OMOP concepts"
    authors "ludvig-alden"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_EXT"
    import "OMOP_EXT/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
// Fallback tier: the source grades every row icd10cm_base_fallback
// (non-standard ICD-10-CM billing concepts), so the collection is
// preference=alternative throughout.
collection "icd-10-se-omop-icd-10-cm" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-10-SE to OMOP ICD-10-CM concepts"
    authors "ludvig-alden"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_ICD_10_CM"
    defaults {
        mappings {
            claim-scope "icd-10-se-omop-icd-10-cm@2026.1"
        }
    }
    import "OMOP_ICD_10_CM/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
// Standard targets: the OMOP ids resolve to SNOMED CT
// Condition concepts (standard in the OMOP CDM by domain knowledge;
// the source itself carries no standard flag).
collection "icd-10-se-omop-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-10-SE to OMOP SNOMED CT concepts"
    authors "ludvig-alden"
    source system="ICD_10_SE" release="2026"
    target system="OMOP_SNOMED_CT"
    import "OMOP_SNOMED_CT/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
collection "icd-10-se-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "ICD-10-SE to SNOMED CT"
    authors "ludvig-alden"
    source system="ICD_10_SE" release="2026"
    target system="SNOMED_CT" release="20251130"
    defaults {
        mappings {
            claim-scope "icd-10-se-snomed-ct@2026.1"
        }
    }
    import "SNOMED_CT/mappings/**/*.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
