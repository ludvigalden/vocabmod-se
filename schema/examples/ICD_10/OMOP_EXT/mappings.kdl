// WHO ICD-10 base codes to OMOP extension mappings. Excerpt: the
// excerpted concept's binding as the tree carries it.
context {
    collection "icd-10-omop-ext" version="2026.1"
    source system="ICD_10" release="2016"
    target system="OMOP_EXT"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
omop-binding "F178.omop" concept="F178" omop="OMOP_EXT:903654"
