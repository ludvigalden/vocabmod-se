// NPU laboratory tests to LOINC mappings, codes NPU01121-NPU01144
context {
    collection "npu-loinc" version="2026.1"
    source system="NPU" release="2025"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "NPU01121.1" source="NPU01121" target="1742-6" {
    comment "en" "loinc_target = 1742-6; specimen = Plasma"
}
mapping "NPU01144.1" source="NPU01144" target="6768-6" {
    comment "en" "loinc_target = 6768-6; specimen = Plasma"
}
