// Swedish hospital local laboratory test codes to NPU mappings, codes AB-ANJGAP ABL/PNA
context {
    collection "lab-se-npu" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="NPU"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "AB-ANJGAP ABL/PNA.2" source="AB-ANJGAP ABL/PNA" target="2100550000" preference=alternative
