// Swedish hospital local laboratory test codes to LOINC mappings, codes 25-HYDROXI-VITAMIN D
context {
    collection "lab-se-loinc" version="2026.1"
    source system="LAB_SE" release="2026"
    target system="LOINC"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "25-HYDROXI-VITAMIN D.1" source="25-HYDROXI-VITAMIN D" target="62290-2" {
    comment "en" "1,25 Dihydrox-vit.D = calcitriol/1,25-dihydroxyvitamin D in serum. Dict-resident."
}
