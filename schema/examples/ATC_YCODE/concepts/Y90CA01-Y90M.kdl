// The source's English name only restates the code ("ATC Y-code
// Y90CA02 (Y90CA02)") and is not imported.
context {
    system "ATC_YCODE" release="2026"
}
defaults {
    concepts {
        status "active"
        class "y-code"
    }
}
concept "Y90CA01" {
    name "sv" "exempelbeteckning"
}
concept "Y90CA02" {
    name "sv" "exempelbeteckning"
}

