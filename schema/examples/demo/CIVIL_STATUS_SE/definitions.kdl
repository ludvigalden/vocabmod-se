// Civilståndskoder: the civil-status value set the LISA register carries (SCB register data).
// Small register-local code set; no shared classification exists upstream.
system "CIVIL_STATUS_SE" kind=classification distribution=published publisher="se.scb" default-locale="sv" {
    name "sv" "Civilståndskoder (SCB)"
}
release "2024" system="CIVIL_STATUS_SE" label-source=registry
context {
    system "CIVIL_STATUS_SE" release="2024"
}
category "status" {
    name "en" "Civil status"
}
collection "civil-status-se-snomed-ct" version="2026.1" kind=mapping publisher="ludvig-alden" {
    title "en" "SCB civil status to SNOMED CT"
    authors "ludvig-alden"
    source system="CIVIL_STATUS_SE" release="2024"
    target system="SNOMED_CT" release="20251130"
    defaults {
        mappings {
            relationship "equivalent"
        }
    }
    import "SNOMED_CT/mappings.kdl" kind=fragment {
        project "defaults"
    }
}
import "concepts/**/*.kdl" kind=fragment
