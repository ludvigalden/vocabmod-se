// Swedish civil status codes, codes EP-Ä
context {
    system "CIVIL_STATUS_SE" release="2024"
}
defaults {
    concepts {
        status "active"
        class "status"
    }
}
concept "G" {
    name "sv" "Gift"
    name "en" "Married"
}
concept "OG" {
    name "sv" "Ogift"
    name "en" "Unmarried"
}