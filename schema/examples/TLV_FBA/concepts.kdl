// A consumable is a package of no drug product (facets.kdl). The
// package nests under its concept; its code is derived from it.
context {
    system "TLV_FBA" release="2026"
}
defaults {
    concepts {
        status "active"
        class "article"
    }
}
concept "200022" {
    name "sv" "exempelbeteckning"
    drug-package article-type="stomi"
}
concept "200031" {
    name "sv" "exempelbeteckning"
    drug-package article-type="stomi"
}
