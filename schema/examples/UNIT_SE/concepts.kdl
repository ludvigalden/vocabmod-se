// Codes are the Swedish unit spellings; the English glosses are the
// source's own names.
context {
    system "UNIT_SE" release="2017"
}
defaults {
    concepts {
        status "active"
        class "unit"
    }
}
concept "IE" {
    name "en" "International unit (Swedish IE)"
}
concept "IE/ml" {
    name "en" "International unit per milliliter"
}

defaults {
    concepts {
        status "active"
        class "unit"
    }
}
concept "mikrog/dos" {
    name "en" "Microgram per dose"
}

