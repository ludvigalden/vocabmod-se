// Varunummer 0–999. A package's product is its NPL product id (`@NPL`
// in the source); several packages share one product. The package nests
// under its concept; its code is derived from that concept.
context {
    system "TLV_VNR" release="2026"
}
defaults {
    concepts {
        status "active"
        class "package"
    }
}
concept "5" {
    name "sv" "exempelbeteckning"
    validity origin=imported {
        from "1970-01-01"
    }
    drug-package product="NPL:19980529000140"
}
concept "861" {
    name "sv" "exempelbeteckning"
    drug-package product="NPL:19980529000140"
}
