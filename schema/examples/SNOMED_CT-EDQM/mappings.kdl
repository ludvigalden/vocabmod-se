// SNOMED CT dose forms to EDQM Standard Terms, the collection's mappings.
context {
    collection "snomed-ct-edqm" version="2026.1"
    source system="SNOMED_CT" release="20251130"
    target system="EDQM"
}
defaults {
    mappings {
        preference "primary"
        assessment-method "source-default-granularity"
    }
}
mapping "1007391000202107.1" source="1007391000202107" target="10230000"
mapping "1163202003.1" source="1163202003" target="10501000"
