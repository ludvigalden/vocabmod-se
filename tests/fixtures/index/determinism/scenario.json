{
  "binary": "vocabmod-se",
  "description": "the statistical index is deterministic: two whole-tree runs emit byte-identical tables, all six files appear, and every census cross-check row matches",
  "heavy": true,
  "steps": [
    {
      "run": {
        "id": "run-a",
        "args": ["--root", "{fx-repo}", "index", "--out", "out-a"]
      }
    },
    {
      "run": {
        "id": "run-b",
        "args": ["--root", "{fx-repo}", "index", "--out", "out-b"]
      }
    }
  ],
  "checks": [
    {"determinism": {"trees": ["out-a", "out-b"]}},
    {
      "files-exist": {
        "paths": [
          "out-a/concepts.tsv",
          "out-a/designations.tsv",
          "out-a/mappings.tsv",
          "out-a/bindings.tsv",
          "out-a/summary.tsv",
          "out-a/census-check.tsv"
        ]
      }
    },
    {"column-uniform": {"file": "out-a/census-check.tsv", "column": "status", "value": "match"}}
  ]
}
