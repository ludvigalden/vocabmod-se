// Restates the committed `TRIAGE_SE` 263259005 with a designation the
// committed concept does not carry: a conflict, never a silent win.
context {
    system "TRIAGE_SE" release="2024"
}
defaults {
    concepts {
        status "active"
        class "code"
    }
}
concept "263259005" {
    name "sv" "Annat innehåll"
}
